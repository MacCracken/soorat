# --- error.cyr ---

# error.cyr — soorat's error codes (port of Rust 1.2.0's src/error.rs, M1 part a).
#
# A fallible soorat function returns a value-form Result whose Err payload is one of these codes:
# `var t, v = f(..); if (is_err_result(t) == 1) { .. v is the code .. }`. The golden token `E:Shader` is
# SR_ERR_SHADER: SR_ERR_ + snake(variant). The values follow the Rust variant order and are append-only (the
# Cyrius form of #[non_exhaustive]).
#
# The Rust variants carry a detail string (`Shader(String)`), and `Other` boxes a foreign error; a code carries
# neither (ADR 0002 #1). `sr_error_message(code)` gives thiserror's message up to its `{0}`, the part that
# doesn't depend on the payload.
#
# One code is Cyrius-only: SR_ERR_DESERIALIZE (ADR 0002 #19), a JSON reader's refusal, where Rust's serde_json returns
# its own error type rather than a RenderError (pravash's PV_ERR_DESERIALIZE is the precedent).
#
# `From<mabda::GpuError>` (Rust's `impl From`) arrives with mabda at M6, as `sr_error_from_gpu`; its five tests
# move there with it (docs/development/rust-test-ledger.md).

enum SrRenderError {
    SR_ERR_NONE = 0;
    SR_ERR_ADAPTER_NOT_FOUND = 1;
    SR_ERR_DEVICE_REQUEST = 2;
    SR_ERR_SURFACE_CONFIG = 3;
    SR_ERR_SURFACE_TEXTURE = 4;
    SR_ERR_SHADER = 5;
    SR_ERR_PIPELINE = 6;
    SR_ERR_TEXTURE = 7;
    SR_ERR_MODEL = 8;
    SR_ERR_WINDOW = 9;
    SR_ERR_SCREENSHOT = 10;
    SR_ERR_OTHER = 11;
    SR_ERR_DESERIALIZE = 12;
}

# The Rust variant name of an error code (`"Shader"`), "None" for SR_ERR_NONE, or "Unknown" for a value that is
# no code.
#must_use
fn sr_error_name(code): i64 {
    match code {
        SR_ERR_NONE => { return "None"; }
        SR_ERR_ADAPTER_NOT_FOUND => { return "AdapterNotFound"; }
        SR_ERR_DEVICE_REQUEST => { return "DeviceRequest"; }
        SR_ERR_SURFACE_CONFIG => { return "SurfaceConfig"; }
        SR_ERR_SURFACE_TEXTURE => { return "SurfaceTexture"; }
        SR_ERR_SHADER => { return "Shader"; }
        SR_ERR_PIPELINE => { return "Pipeline"; }
        SR_ERR_TEXTURE => { return "Texture"; }
        SR_ERR_MODEL => { return "Model"; }
        SR_ERR_WINDOW => { return "Window"; }
        SR_ERR_SCREENSHOT => { return "Screenshot"; }
        SR_ERR_OTHER => { return "Other"; }
        SR_ERR_DESERIALIZE => { return "Deserialize"; }
        _ => { return "Unknown"; }
    }
    return "Unknown";
}

# The Rust error's Display text up to its `{0}` (`"shader compilation failed"` for `shader compilation failed:
# {0}`). "no error" for SR_ERR_NONE, "other error" for SR_ERR_OTHER (Rust shows the boxed error's own text) and
# "unknown error" for a value that is no code.
#must_use
fn sr_error_message(code): i64 {
    match code {
        SR_ERR_NONE => { return "no error"; }
        SR_ERR_ADAPTER_NOT_FOUND => { return "GPU adapter not found"; }
        SR_ERR_DEVICE_REQUEST => { return "GPU device request failed"; }
        SR_ERR_SURFACE_CONFIG => { return "surface configuration failed"; }
        SR_ERR_SURFACE_TEXTURE => { return "surface texture acquisition failed"; }
        SR_ERR_SHADER => { return "shader compilation failed"; }
        SR_ERR_PIPELINE => { return "pipeline creation failed"; }
        SR_ERR_TEXTURE => { return "texture load failed"; }
        SR_ERR_MODEL => { return "model load failed"; }
        SR_ERR_WINDOW => { return "window creation failed"; }
        SR_ERR_SCREENSHOT => { return "screenshot failed"; }
        SR_ERR_OTHER => { return "other error"; }
        SR_ERR_DESERIALIZE => { return "deserialization error"; }
        _ => { return "unknown error"; }
    }
    return "unknown error";
}

# --- log.cyr ---

# log.cyr — soorat's tracing events, on sakshi (port plan §1.1: `tracing` → sakshi).
#
# Rust 1.2.0 emits `tracing` events under the targets `soorat::<module>` and leaves the subscriber to the
# application; soorat has no logging module of its own. Here an event is one sakshi line, `soorat::<module>:
# <message>`, at the event's level, so a consumer that configures sakshi (level, output, hook) sees soorat's
# events among its own. sakshi's default level is INFO, so WARN events reach stderr until the consumer changes it.
#
# Rust's events also carry fields (`near=1.0 far=1.0`). Those are left out until soorat has Rust's shortest
# round-trip f32 formatting, which the first module that needs it brings (ADR 0002 #17).

# Emits `msg` (a C string: "soorat::<module>: <message>") as a sakshi WARN event.
fn _sr_warn(msg): i64 {
    sakshi_warn(msg, strlen(msg));
    return 0;
}

# --- mathx.cyr ---

# mathx.cyr — Rust's f32 std semantics on top of the Cyrius builtins (M1 part b).
#
# Port plan §9.1. An f32 is its bits in the low 32 bits of an i64 (ganita's convention). Each helper mirrors one std
# f32 operation exactly as rustc 1.100 compiles it, where the stdlib or ganita's f32 tier differs:
# - `clamp` keeps a −0 input (ganita_f32_clamp turns it into +0, so `heat_map(−0)` would lose its sign bit) and lets
#   a NaN through;
# - `round` rounds half away from zero (ganita_f32_round and f64_round round ties to even: 0.5 → 0, Rust 1);
# - `as u8` saturates, NaN → 0.
#
# UPSTREAM(L8): cyrius:docs/development/issues/2026-11-15-f32-returns-consts-and-f16.md
#   return f32 values (not their bits) and use f32 `const`s once the language allows them; parity: every f32 row of
#   tests/golden/*.tsv.
#
# Arithmetic stays on ganita's native f32 tier (ganita_f32_add, _sub, _mul, _div: one f32 rounding each), which is
# Rust's sequence under D4 rule a.

# 1 when the f32 bits x are a NaN.
#must_use
fn _sr_f32_is_nan(x): i64 {
    var b = x & 0xFFFFFFFF;
    if ((b & 0x7F800000) == 0x7F800000 && (b & 0x007FFFFF) != 0) { return 1; }
    return 0;
}

# 1 when a < b as f32 values (0 when either is NaN). Widening is exact, so the f64 comparison is the f32 one.
#must_use
fn _sr_f32_lt(a, b): i64 {
    var x: f64 = f32_to(a & 0xFFFFFFFF);
    var y: f64 = f32_to(b & 0xFFFFFFFF);
    if (x < y) { return 1; }
    return 0;
}

# 1 when a ≤ b as f32 values (0 when either is NaN).
#must_use
fn _sr_f32_le(a, b): i64 {
    var x: f64 = f32_to(a & 0xFFFFFFFF);
    var y: f64 = f32_to(b & 0xFFFFFFFF);
    if (x <= y) { return 1; }
    return 0;
}

# a · b in native f32 (one rounding), as bits.
#must_use
fn _sr_f32_mul(a: f32, b: f32): i64 {
    var r: f32 = a * b;
    return r;
}

# a / b in native f32 (one rounding), as bits.
#must_use
fn _sr_f32_div(a: f32, b: f32): i64 {
    var r: f32 = a / b;
    return r;
}

# x restricted to [lo, hi], as Rust's `f32::clamp`: lo when x < lo, hi when x > hi, else x itself, bits kept (−0
# stays −0, a NaN stays NaN). Every caller passes lo ≤ hi, neither NaN (Rust panics otherwise).
#must_use
fn _sr_clamp32(x, lo, hi): i64 {
    var v: f64 = f32_to(x & 0xFFFFFFFF);
    var l: f64 = f32_to(lo & 0xFFFFFFFF);
    var h: f64 = f32_to(hi & 0xFFFFFFFF);
    if (v < l) { return lo & 0xFFFFFFFF; }
    if (v > h) { return hi & 0xFFFFFFFF; }
    return x & 0xFFFFFFFF;
}

# x rounded to the nearest integer, halfway cases away from zero, as Rust's `f32::round`: NaN, ±∞ and every |x| ≥ 2²³
# (already an integer) come back unchanged, and the sign is kept (round(−0.4) is −0). |x| + 0.5 is exact in f64 for
# |x| < 2²³, so floor(|x| + 0.5) is the rounded magnitude.
#must_use
fn _sr_round32(x): i64 {
    var b = x & 0xFFFFFFFF;
    var mag = b & 0x7FFFFFFF;
    if (mag >= 0x4B000000) { return b; }
    var v: f64 = f32_to(mag);
    var half: f64 = 0.5;
    var r: f64 = f64_floor(v + half);
    return f32_from(r) | (b & 0x80000000);
}

# x as u8, as Rust's saturating `as`: NaN → 0, below 0 → 0, above 255 → 255, else truncated toward zero.
#must_use
fn _sr_f32_to_u8(x): i64 {
    if (_sr_f32_is_nan(x) == 1) { return 0; }
    var v: f64 = f32_to(x & 0xFFFFFFFF);
    var zero: f64 = 0.0;
    var top: f64 = 255.0;
    if (v <= zero) { return 0; }
    if (v >= top) { return 255; }
    return f64_to(v);
}

# n (an i64) as f32 bits, rounded once to nearest with ties to even, as Rust's `n as f32` (serde reads a JSON integer
# into an f32 this way). Going through f64 would round twice above 2⁵³.
#must_use
fn _sr_i64_to_f32(n): i64 {
    if (n == 0) { return 0; }
    var sign = 0;
    var m = n;
    if (n < 0) {
        sign = 0x80000000;
        if (n == (0 - 9223372036854775807 - 1)) { return 0xDF000000; }
        m = 0 - n;
    }
    if (m < 16777216) { return f32_from(f64_from(m)) | sign; }
    var bl = 0;
    var t = m;
    while (t > 0) {
        bl = bl + 1;
        t = t >> 1;
    }
    var sh = bl - 24;
    var mant = m >> sh;
    var rem = m & ((1 << sh) - 1);
    var half = 1 << (sh - 1);
    if (rem > half || (rem == half && (mant & 1) == 1)) { mant = mant + 1; }
    var e = bl - 1;
    if (mant == 16777216) {
        mant = 8388608;
        e = e + 1;
    }
    return sign | ((e + 127) << 23) | (mant & 0x7FFFFF);
}

