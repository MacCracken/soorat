# Thresholds, each the last double before the result changes (bisection over bit patterns with
# MPFR's correctly rounded function): EXP_OVF the largest x with exp(x) finite, EXP_UNF the
# most negative x with exp(x) > 0 (below it exp(x) < 2^-1075 rounds to +0), the same for exp10,
# EXPM1_OVF the largest x with expm1(x) finite, EXPM1_M1 the most negative x with expm1(x) > −1.
var _SR_KM_CR_EXP_OVF = 0x40862E42FEFA39EF;   # 709.782712893384

var _SR_KM_CR_EXP_UNF = 0xC0874910D52D3051;   # -745.1332191019411

# ── constants (kimiya src/mathx.cyr) ─────────────────────────────────────────────────

# +∞ (0x7FF0000000000000), a compile-time constant.
const _SR_KM_INF = 1.0 / 0.0;

# ── functions (kimiya src/mathx.cyr) ─────────────────────────────────────────────────

# RN(2^e·(h + m + l)) for a normalised triple-double h + m + l in [0.99, 2.01] and any e, every result range: a normal
# result is RN3 then an exact scale (2^1024 in two steps; a significand that rounds up past DBL_MAX gives
# +∞, as IEEE overflow does, and every e > 1024 gives +∞ by 2^1023·2^1023; a normal result at e = −1023, h + m + l ≥ 2,
# scales by 2^(e + 1022) then 2^-1022, and an e below −2044 scales the subnormal-grid sum by 2^-1022, which rounds it to
# +0 as it must). A result below 2^-1022 is rounded ONCE, at the subnormal grid: with
# y = 2^(e + 1022)·(h + m + l) < 1 (each part scaled exactly), RN(1 + y) has its ulp at 2^-52, which is
# 2^-1074 after the final scale, and (RN(1 + y) − 1)·2^-1022 is exact (glibc's specialcase technique). The
# sum 1 + yh + ym + yl is rounded exactly: 1 + yh = a + b (Fast2Sum), and RN(a + b + RO(ym + yl)) =
# RN(a + b + ym + yl) because every breakpoint minus a − b is a multiple of ulp(yh), an even multiple of
# ulp(RO(ym + yl)), and rounding to odd keeps the order against those.
#must_use
fn _sr_km_cr_finish(e, h: f64, m: f64, l: f64): f64 {
    if (e >= 0 - 1021) {
        var z: f64 = _sr_km_rn3(h, m, l);
        if (e > 1023) {
            var s1: f64 = _sr_km_cr_pow2(1023);
            var o: f64 = z * s1;
            if (e > 1024) {
                o = o * s1;                  # past 2^1025·0.99: ±∞
            } else {
                o = o * 2.0;
            }
            return o;
        }
        var s2: f64 = _sr_km_cr_pow2(e);
        var y: f64 = z * s2;
        return y;
    }
    var h1, m1a = _sr_km_fast_two_sum(h, m);    # renormalised, so the sign tests below decide y < 1
    var m1, l1 = _sr_km_two_sum(m1a, l);
    var es = e + 1022;
    if (es < 0 - 1022) { es = 0 - 1022; }    # 2^e·2.01 < 2^-1075 already: the sum below rounds to 1, the result +0
    var s: f64 = _sr_km_cr_pow2(es);
    var yh: f64 = h1 * s;
    var ym: f64 = m1 * s;
    var yl: f64 = l1 * s;
    var normal = 0;
    if (yh > 1.0) { normal = 1; }
    if (yh == 1.0) {
        if (ym > 0.0) { normal = 1; }
        if (ym == 0.0 && yl >= 0.0) { normal = 1; }
    }
    var dmin: f64 = _sr_km_cr_pow2(0 - 1022);
    if (normal == 1) {                       # y ≥ 1: the result is at least 2^-1022 (e is −1022 or −1023)
        var z2: f64 = _sr_km_rn3(h, m, l);
        var y2: f64 = (z2 * s) * dmin;       # both scales exact: z2·2^(e + 1022) ≥ 1
        return y2;
    }
    var a, b = _sr_km_fast_two_sum(1.0, yh);
    var v: f64 = _sr_km_ro_sum(ym, yl);
    var w: f64 = _sr_km_rn3(a, b, v);
    var r: f64 = (w - 1.0) * dmin;
    return r;
}

# The fast core for e^(xh + xl), |xh| < 1180 and |xl| ≤ 2^-42: (hi, lo, E) with hi + lo = e^x/2^E within
# 2^-70. |xh| < 1180 keeps K = RN(xh·512/ln 2) below 871,700 < 2^20, which K·L1's exactness needs (L1 has 33 bits);
# past 745.2 (the ux tiers' 708 < |x| < 1024, and x·ln 10 up to 1179) the dropped K·L3 grows from 2^-79.2 to 2^-78.8,
# inside the bound's margin (0.9·2^-70 against ε = 2^-69). exp passes xl = 0; exp10 passes x·ln 10 as xh + xl (xl
# folds into the K·L2 term).
#must_use
fn _sr_km_exp_core(xh: f64, xl: f64): (f64, f64, i64) {
    var inv: f64 = _SR_KM_CR_EXP_INVLN2N;
    var l1: f64 = _SR_KM_CR_EXP_L1;
    var l2: f64 = _SR_KM_CR_EXP_L2;
    var tt: f64 = (xh * inv) + 6755399441055744.0;   # 1.5·2^52: rounds x·512/ln 2 to an integer
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = xh - (kd * l1);
    var s: f64 = (kd * l2) - xl;
    var r: f64 = rh - s;
    var rl: f64 = (rh - r) - s;
    var c: f64 = r + 49152.0;                         # 1.5·2^15: rounds r to a multiple of 2^-37
    var r1: f64 = c - 49152.0;
    var r2: f64 = r - r1;
    var p3: f64 = _SR_KM_CR_EXP_P3;
    var p4: f64 = _SR_KM_CR_EXP_P4;
    var p5: f64 = _SR_KM_CR_EXP_P5;
    var z: f64 = r * r;                       # Estrin: the code is latency-bound, so keep chains short
    var q: f64 = (z * (0.5 + (r * p3))) + ((z * z) * (p4 + (r * p5)));
    var a: f64 = load64(&_SR_KM_CR_EXP_T + ti);
    var b: f64 = load64(&_SR_KM_CR_EXP_T + ti + 8);
    var p1: f64 = a * r1;
    var hi: f64 = a + p1;
    var e1: f64 = p1 - (hi - a);
    var rlq: f64 = rl + q;
    var lo: f64 = (e1 + b) + ((a * (r2 + rlq)) + (b * (r + rlq)));
    return (hi, lo, e);
}

# The fast test with bound err (absolute, on hi + lo) and the scale for any E: (1, RN(2^E·(hi + lo))) or (0, 0)
# when the test fails. Normal results scale exactly (2^1024 in two steps, +∞ for every E > 1024, and 2^(E + 1022)
# then 2^-1022 at E = −1023; an E below −2044 scales by 2^-1022, so the result is +0 as it must be). A result that
# may be subnormal (E ≤ −1022 and 2^(E+1022)·(hi + lo) < 1, decided
# on hi + lo renormalised: the core's lo is not, when r1 = 0) is tested on the subnormal grid, rounding once:
# y = 2^(E+1022)·(hi + lo) (exact), 1 + y = a + b + yl with a + b = 1 + yh exactly, and the ends
# a + ((b + yl) ∓ ε') with ε' = err·2^(E+1022) + 2^-104 (|b + yl| ≤ 2^-52, so the two inner roundings are below
# 2^-104.4 at this scale, where the grid is 2^-52).
#must_use
fn _sr_km_exp_fin(hi: f64, lo: f64, e, err: f64): (i64, f64) {
    if (e >= 0 - 1021) {
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u != v) { return (0, 0.0); }
        if (e > 1023) {
            var s1: f64 = _sr_km_cr_pow2(1023);
            var o: f64 = u * s1;
            if (e > 1024) {
                o = o * s1;                  # past 2^1025·0.99: ±∞
            } else {
                o = o * 2.0;
            }
            return (1, o);
        }
        var s2: f64 = _sr_km_cr_pow2(e);
        var y: f64 = u * s2;
        return (1, y);
    }
    var es = e + 1022;
    if (es < 0 - 1022) { es = 0 - 1022; }    # 2^E·2 < 2^-1075 already: rounds to +0 below
    var s: f64 = _sr_km_cr_pow2(es);
    var hn: f64 = hi + lo;                   # hi + lo renormalised: lo can be up to 2^-38 when r1 = 0
    var ln: f64 = lo - (hn - hi);
    var yh: f64 = hn * s;
    var dmin: f64 = _sr_km_cr_pow2(0 - 1022);
    if (yh > 1.0 || (yh == 1.0 && ln >= 0.0)) {   # 2^E·(hi + lo) ≥ 2^-1022: a normal result (E is −1022 or −1023)
        var u2: f64 = hi + (lo - err);
        var v2: f64 = hi + (lo + err);
        if (u2 != v2) { return (0, 0.0); }
        var y2: f64 = (u2 * s) * dmin;       # both scales exact: u2·2^(E + 1022) ≥ 1
        return (1, y2);
    }
    var yl: f64 = ln * s;
    var a, b = _sr_km_fast_two_sum(1.0, yh);
    var w: f64 = b + yl;
    var tiny: f64 = 0x3970000000000000;     # 2^-104
    var err2: f64 = (err * s) + tiny;
    var u3: f64 = a + (w - err2);
    var v3: f64 = a + (w + err2);
    if (u3 != v3) { return (0, 0.0); }
    var r: f64 = (u3 - 1.0) * dmin;
    return (1, r);
}

# e^x, correctly rounded. exp(±0) = 1 (as every |x| < 2^-54: e^x is then within 2^-54 of 1, inside 1's
# rounding interval), exp(+∞) = +∞, exp(−∞) = +0, NaN for NaN; x above 709.782712893384 overflows to +∞, and
# below −745.1332191019411 (e^x < 2^-1075) rounds to +0. e^x is exact only at x = 0 (Lindemann–Weierstrass: e^x
# is transcendental for algebraic x ≠ 0), so no other argument is exact or a tie. The fast path covers
# 2^-54 ≤ |x| ≤ 708 (normal results, one scale), inline; the rest goes through _sr_km_cr_exp_fast.
#must_use
fn _sr_km_cr_exp(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    # |x| < 2^-54, |x| > 708 or NaN, in one compare: ax − bits(2^-54) is above bits(708) − bits(2^-54) as an
    # unsigned word (the sign flip makes the signed compare an unsigned one) exactly then.
    if (((ax - 0x3C90000000000000) ^ 0x8000000000000000) > 0x83F6200000000000) {
        var w, okw = _sr_km_cr_exp_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _sr_km_cr_exp_acc(x);
        return zw;
    }
    var inv: f64 = _SR_KM_CR_EXP_INVLN2N;
    var l1: f64 = _SR_KM_CR_EXP_L1;
    var l2: f64 = _SR_KM_CR_EXP_L2;
    var tt: f64 = (x * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = x - (kd * l1);
    var s: f64 = kd * l2;
    var r: f64 = rh - s;
    var rl: f64 = (rh - r) - s;
    var c: f64 = r + 49152.0;
    var r1: f64 = c - 49152.0;
    var r2: f64 = r - r1;
    var p3: f64 = _SR_KM_CR_EXP_P3;
    var p4: f64 = _SR_KM_CR_EXP_P4;
    var p5: f64 = _SR_KM_CR_EXP_P5;
    var z: f64 = r * r;                       # Estrin: the code is latency-bound, so keep chains short
    var q: f64 = (z * (0.5 + (r * p3))) + ((z * z) * (p4 + (r * p5)));
    var a: f64 = load64(&_SR_KM_CR_EXP_T + ti);
    var b: f64 = load64(&_SR_KM_CR_EXP_T + ti + 8);
    var p1: f64 = a * r1;
    var hi: f64 = a + p1;
    var e1: f64 = p1 - (hi - a);
    var rlq: f64 = rl + q;
    var lo: f64 = (e1 + b) + ((a * (r2 + rlq)) + (b * (r + rlq)));
    var err: f64 = 0x3BA0000000000000;      # 2^-69
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) {
        var sb = (e + 1023) << 52;
        var sc: f64 = sb;
        var y: f64 = u * sc;
        return y;
    }
    var za: f64 = _sr_km_cr_exp_acc(x);
    return za;
}

# The fast path alone, for every x: (RN(e^x), 1), or (0, 0) when the rounding test fails and the accurate path
# must decide. NaN, the tiny end, overflow and underflow first, then the fast core with the general finish
# (708 < x: E up to 1024; x < −708: subnormal results). For 2^-54 ≤ |x| ≤ 708 _sr_km_exp_core and _sr_km_exp_fin
# perform exactly the operations of _sr_km_cr_exp's inline path (E ≥ −1022 there, with hi > 1 at E = −1022), so
# this gives its result and its test.
#must_use
fn _sr_km_cr_exp_fast(x: f64): (f64, i64) {
    if (x != x) { return (x, 1); }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3C90000000000000) { return (1.0, 1); }
    var ovf: f64 = _SR_KM_CR_EXP_OVF;
    var unf: f64 = _SR_KM_CR_EXP_UNF;
    if (x > ovf) {
        var inf: f64 = _SR_KM_INF;
        return (inf, 1);
    }
    if (x < unf) { return (0.0, 1); }
    var hi, lo, e = _sr_km_exp_core(x, 0.0);
    var err: f64 = 0x3BA0000000000000;      # 2^-69
    var ok, y = _sr_km_exp_fin(hi, lo, e, err);
    return (y, ok);
}

# The accurate core: e^(y0 + y1 + y2) = 2^E·(h + m + l), (h, m, l) stored at out[0..2], E returned. The same
# K as the fast path; r = y − K·(L1 + L2 + L3 + L4) as a triple-double (K·L1 exact, K·L2 and K·L3
# TwoProducts, K·L4 rounded: below 2^-186 of error); e^r − 1 by Horner in triple-double to r^11/11!
# (truncation 2^-152); T_j = A + B + C + D renormalised (2^-159); h + m + l = T_j + T_j·(e^r − 1). Measured
# relative error 2^-155 against 400-bit MPFR.
#must_use
fn _sr_km_exp_acc_core(y0: f64, y1: f64, y2: f64, out): i64 {
    var inv: f64 = _SR_KM_CR_EXP_INVLN2N;
    var l1: f64 = _SR_KM_CR_EXP_L1;
    var l2: f64 = _SR_KM_CR_EXP_L2;
    var l3: f64 = _SR_KM_CR_EXP_L3;
    var l4: f64 = _SR_KM_CR_EXP_L4;
    var tt: f64 = (y0 * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = y0 - (kd * l1);
    var a2, a2e = _sr_km_two_prod(kd, l2);
    var a3, a3e = _sr_km_two_prod(kd, l3);
    var a4: f64 = kd * l4;
    var ra0, ra1, ra2 = _sr_km_td_add_d(rh, 0.0, 0.0, -a2);
    var rb0, rb1, rb2 = _sr_km_td_add_d(ra0, ra1, ra2, y1);
    var rc0, rc1, rc2 = _sr_km_td_add_d(rb0, rb1, rb2, -a2e);
    var rd0, rd1, rd2 = _sr_km_td_add_d(rc0, rc1, rc2, -a3);
    var re0, re1, re2 = _sr_km_td_add_d(rd0, rd1, rd2, y2);
    var a34: f64 = a3e + a4;
    var r0, r1, r2 = _sr_km_td_add_d(re0, re1, re2, -a34);
    var sh: f64 = load64(&_SR_KM_CR_EXP_ACC + 216);    # 1/11! (index 3·(11 − 2))
    var sm: f64 = load64(&_SR_KM_CR_EXP_ACC + 224);
    var sl: f64 = load64(&_SR_KM_CR_EXP_ACC + 232);
    var n = 10;
    while (n >= 2) {
        var th, tm, tl = _sr_km_td_mul(r0, r1, r2, sh, sm, sl);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_SR_KM_CR_EXP_ACC + off);
        var cm: f64 = load64(&_SR_KM_CR_EXP_ACC + off + 8);
        var cl: f64 = load64(&_SR_KM_CR_EXP_ACC + off + 16);
        var uh, um, ul = _sr_km_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _sr_km_td_mul(r0, r1, r2, sh, sm, sl);
    var wh, wm, wl = _sr_km_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _sr_km_td_mul(r0, r1, r2, wh, wm, wl);     # e^r − 1
    var ta: f64 = load64(&_SR_KM_CR_EXP_T + ti);
    var tb: f64 = load64(&_SR_KM_CR_EXP_T + ti + 8);
    var tc: f64 = load64(&_SR_KM_CR_EXP_T + ti + 16);
    var td: f64 = load64(&_SR_KM_CR_EXP_T + ti + 24);
    var t0, t1a = _sr_km_fast_two_sum(ta, tb);
    var t1, t2a = _sr_km_fast_two_sum(t1a, tc);
    var t2: f64 = t2a + td;
    var qh, qm, ql = _sr_km_td_mul(t0, t1, t2, ph, pm, pl);
    var zh, zm, zl = _sr_km_td_add(t0, t1, t2, qh, qm, ql);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
    return e;
}

# e^x for 2^-54 ≤ |x| < 2^-30, where Lefèvre–Muller's bound is 2^-158 (e^x is then 1 + x + x²/2 + …, and
# 1 + x is a short exact number): 1 + x = a + b exactly, q = x²/2 + x³/6 + x⁴/24 + x⁵/120 as a double-double
# to 2^-165 absolute (x² and x³ by TwoProduct, x³/6 by a corrected division; x⁶/720 < 2^-189 dropped), and
# RN(a + b + RO(qh + ql)) by _sr_km_rn3 (the rounding-to-odd argument of _sr_km_cr_finish: ulp(x) is an even
# multiple of ulp(q)).
#must_use
fn _sr_km_exp_tiny_acc(x: f64): f64 {
    var p, pe = _sr_km_two_prod(x, x);
    var a, ae = _sr_km_two_prod(x, p);
    var x3l: f64 = ae + (x * pe);
    var d3h: f64 = a / 6.0;
    var pp, pe2 = _sr_km_two_prod(d3h, 6.0);
    var d3l: f64 = (((a - pp) - pe2) + x3l) / 6.0;
    var ax: f64 = a * x;
    var x4: f64 = ax / 24.0;
    var x5: f64 = (ax * x) / 120.0;
    var hp: f64 = p * 0.5;
    var t, te = _sr_km_two_sum(hp, d3h);
    var lo: f64 = ((((pe * 0.5) + te) + d3l) + x4) + x5;
    var qh, ql = _sr_km_fast_two_sum(t, lo);
    var a1, b1 = _sr_km_fast_two_sum(1.0, x);
    var v: f64 = _sr_km_ro_sum(qh, ql);
    var r: f64 = _sr_km_rn3(a1, b1, v);
    return r;
}

# e^x by the accurate path alone, for every x (the fast path's fallback, and a test hook).
#must_use
fn _sr_km_cr_exp_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3C90000000000000) { return 1.0; }
    var ovf: f64 = _SR_KM_CR_EXP_OVF;
    var unf: f64 = _SR_KM_CR_EXP_UNF;
    if (x > ovf) { return _SR_KM_INF; }
    if (x < unf) { return 0.0; }
    if (ax < 0x3E10000000000000) {              # |x| < 2^-30
        var t: f64 = _sr_km_exp_tiny_acc(x);
        return t;
    }
    var buf: f64[3];
    var e = _sr_km_exp_acc_core(x, 0.0, 0.0, &buf);
    var r: f64 = _sr_km_cr_finish(e, buf[0], buf[1], buf[2]);
    return r;
}

# The ln fast core for the bits ui of a positive normal x (ebias −54 for a subnormal pre-scaled by 2^54):
# (hi, lo, err) with |hi + lo − ln x| < err minus the test's own rounding (the bound above).
#must_use
fn _sr_km_ln_core(ui, ebias): (f64, f64, f64) {
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_SR_KM_CR_LN_T + ti);
    var lh: f64 = load64(&_SR_KM_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_SR_KM_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _SR_KM_CR_LN_C3;
    var c4: f64 = _SR_KM_CR_LN_C4;
    var c5: f64 = _SR_KM_CR_LN_C5;
    var c6: f64 = _SR_KM_CR_LN_C6;
    var c7: f64 = _SR_KM_CR_LN_C7;
    var c8: f64 = _SR_KM_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0 + ebias;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _SR_KM_CR_LN_LN2H;
    var ln2m: f64 = _SR_KM_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    return (s2, lo, err);
}

# The special values ln and log10 share: (x for NaN, −∞ for ±0, the quiet NaN for x < 0 (−∞ included), +∞ for +∞;
# 1), or (0, 0) for a positive finite x. The one ladder of _sr_km_cr_ln_fast, _sr_km_cr_ln_acc, _sr_km_cr_log10_fast and
# _sr_km_cr_log10_acc (2.0.1).
#must_use
fn _sr_km_ln_special(x: f64): (f64, i64) {
    if (x != x) { return (x, 1); }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return (ninf, 1);
    }
    if (x < 0.0) {
        var nan: f64 = _sr_km_nan();               # the same quiet NaN on every target
        return (nan, 1);
    }
    if (x == _SR_KM_INF) { return (x, 1); }
    return (0.0, 0);
}

# ln(x), correctly rounded. ln(1) = +0, ln(±0) = −∞, ln(+∞) = +∞, NaN for NaN and x < 0 (−∞ included).
#must_use
fn _sr_km_cr_ln(x: f64): f64 {
    var ui = load64(&x);
    # x ≤ 0 (the sign bit), subnormal, ∞ or NaN: ui − bits(DBL_MIN) is at least bits(∞) − bits(DBL_MIN) as an
    # unsigned word (the unsigned range test of _sr_km_cr_exp).
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        var w, okw = _sr_km_cr_ln_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _sr_km_cr_ln_acc(x);
        return zw;
    }
    # _sr_km_ln_core's body, inline (a call and its three-value return cost about 14 ns here).
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_SR_KM_CR_LN_T + ti);
    var lh: f64 = load64(&_SR_KM_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_SR_KM_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _SR_KM_CR_LN_C3;
    var c4: f64 = _SR_KM_CR_LN_C4;
    var c5: f64 = _SR_KM_CR_LN_C5;
    var c6: f64 = _SR_KM_CR_LN_C6;
    var c7: f64 = _SR_KM_CR_LN_C7;
    var c8: f64 = _SR_KM_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _SR_KM_CR_LN_LN2H;
    var ln2m: f64 = _SR_KM_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    var u: f64 = s2 + (lo - err);
    var v: f64 = s2 + (lo + err);
    if (u == v) { return u; }
    var za: f64 = _sr_km_cr_ln_acc(x);
    return za;
}

# The fast path alone, for every x (as _sr_km_cr_exp_fast): the specials, a subnormal x scaled exactly by 2^54,
# then the core and its test, the operations of _sr_km_cr_ln's inline path.
#must_use
fn _sr_km_cr_ln_fast(x: f64): (f64, i64) {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        var sv, sp = _sr_km_ln_special(x);
        if (sp == 1) { return (sv, 1); }
        var p54: f64 = 0x4350000000000000;      # 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, err = _sr_km_ln_core(ui, eb);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) { return (u, 1); }
    return (0.0, 0);
}

# The accurate ln of a positive finite x ≠ 1 as a triple-double at out[0..2]: the fast path's E, j and the
# exact r; log1p(r) by Horner in triple-double on the exact r to r^16/16 (truncation 2^-144·|r|);
# E·ln 2 = E·LN2H (exact) + E·LN2M (TwoProduct) + E·LN2L (rounded, 2^-138); then E·ln2 + L_j + log1p(r)
# with at most 1.3 bits of cancellation. Measured relative error 2^-150.
fn _sr_km_ln_acc_td(x: f64, out) {
    var ui = load64(&x);
    var eb = 0;
    if (ui < 0x0010000000000000) {
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_SR_KM_CR_LN_T + ti);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var sh: f64 = load64(&_SR_KM_CR_LN_ACC + 336);     # −1/16 (index 3·(16 − 2))
    var sm: f64 = load64(&_SR_KM_CR_LN_ACC + 344);
    var sl: f64 = load64(&_SR_KM_CR_LN_ACC + 352);
    var n = 15;
    while (n >= 2) {
        var th, tm, tl = _sr_km_td_mul_d(sh, sm, sl, r);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_SR_KM_CR_LN_ACC + off);
        var cm: f64 = load64(&_SR_KM_CR_LN_ACC + off + 8);
        var cl: f64 = load64(&_SR_KM_CR_LN_ACC + off + 16);
        var uh, um, ul = _sr_km_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _sr_km_td_mul_d(sh, sm, sl, r);
    var wh, wm, wl = _sr_km_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _sr_km_td_mul_d(wh, wm, wl, r);       # log1p(r)
    var lh: f64 = load64(&_SR_KM_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_SR_KM_CR_LN_T + ti + 16);
    var ll: f64 = load64(&_SR_KM_CR_LN_T + ti + 24);
    var ef: f64 = f64_from(e0 + eb);
    var ln2h: f64 = _SR_KM_CR_LN_LN2H;
    var ln2m: f64 = _SR_KM_CR_LN_LN2M;
    var ln2l: f64 = _SR_KM_CR_LN_LN2L;
    var a0: f64 = ef * ln2h;
    var a1, a1e = _sr_km_two_prod(ef, ln2m);
    var a2: f64 = ef * ln2l;
    var h0, u0 = _sr_km_fast_two_sum(a0, a1);
    var a12: f64 = a1e + a2;
    var m0, l0 = _sr_km_two_sum(u0, a12);
    var bh, bm, bl = _sr_km_td_add(h0, m0, l0, lh, lm, ll);
    var zh, zm, zl = _sr_km_td_add(bh, bm, bl, ph, pm, pl);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
}

# ln by the accurate path alone, for every x.
#must_use
fn _sr_km_cr_ln_acc(x: f64): f64 {
    var sv, sp = _sr_km_ln_special(x);
    if (sp == 1) { return sv; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _sr_km_ln_acc_td(x, &buf);
    var r: f64 = _sr_km_rn3(buf[0], buf[1], buf[2]);
    return r;
}

# log10(x), correctly rounded. log10(10^k) = k (k = 0 … 22), log10(1) = +0, log10(±0) = −∞, log10(+∞) = +∞,
# NaN for NaN and x < 0. The ln core's (hi, lo, ε), then (hi + lo)·(IVH + IVM) (Dekker's product with IVH
# pre-split) and the rounding test, else the accurate path.
#must_use
fn _sr_km_cr_log10(x: f64): f64 {
    var ui = load64(&x);
    # x ≤ 0, subnormal, ∞ or NaN (the test of _sr_km_cr_ln): the fast path's own ladder, then the accurate path.
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        var w, okw = _sr_km_cr_log10_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _sr_km_cr_log10_acc(x);
        return zw;
    }
    # _sr_km_ln_core's body, inline as in _sr_km_cr_ln (2.0.1).
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var cl: f64 = load64(&_SR_KM_CR_LN_T + ti);
    var lh: f64 = load64(&_SR_KM_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_SR_KM_CR_LN_T + ti + 16);
    var r: f64 = ((mh * cl) - 1.0) + (ml * cl);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _SR_KM_CR_LN_C3;
    var c4: f64 = _SR_KM_CR_LN_C4;
    var c5: f64 = _SR_KM_CR_LN_C5;
    var c6: f64 = _SR_KM_CR_LN_C6;
    var c7: f64 = _SR_KM_CR_LN_C7;
    var c8: f64 = _SR_KM_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var ef: f64 = f64_from(e0);
    var ln2h: f64 = _SR_KM_CR_LN_LN2H;
    var ln2m: f64 = _SR_KM_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var apl: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var eln: f64 = ((apl * k49) + (ah * k83)) + (ae * k93);
    var hi: f64 = s2;
    var ivh: f64 = _SR_KM_CR_LN_IVH;
    var ivm: f64 = _SR_KM_CR_LN_IVM;
    var i1: f64 = _SR_KM_CR_LN_IVH1;
    var i2: f64 = _SR_KM_CR_LN_IVH2;
    var ph: f64 = hi * ivh;
    var c: f64 = 134217729.0 * hi;
    var h1: f64 = c - (c - hi);
    var h2: f64 = hi - h1;
    var pe: f64 = ((((h1 * i1) - ph) + (h1 * i2)) + (h2 * i1)) + (h2 * i2);
    var pl: f64 = pe + ((hi * ivm) + (lo * ivh));
    # The error: 0.4343·(ln's error) plus the product's roundings (hi·IVM, lo·IVH, pl's sum, the test's own:
    # below 2^-52.4·|lo| + 2^-101·|ph|, which eln's slack and 0.5 − 0.4343 cover) and IVL (2^-111·|ln x|):
    # err10 = eln/2 + 2^-100·|ph|.
    var ap: f64 = f64_abs(ph);
    var k100: f64 = 0x39B0000000000000;     # 2^-100
    var err: f64 = (eln * 0.5) + (ap * k100);
    var u: f64 = ph + (pl - err);
    var v: f64 = ph + (pl + err);
    if (u == v) { return u; }
    var za: f64 = _sr_km_cr_log10_acc(x);
    return za;
}

# The fast path alone: (its result, 1), or (0, 0) when its rounding test fails; the same operations as
# _sr_km_cr_log10 (used by the tests and scripts/oracle/cr_verify.py).
#must_use
fn _sr_km_cr_log10_fast(x: f64): (f64, i64) {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {   # as in _sr_km_cr_ln
        var sv, sp = _sr_km_ln_special(x);
        if (sp == 1) { return (sv, 1); }
        var p54: f64 = 0x4350000000000000;          # a subnormal x, scaled exactly by 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, eln = _sr_km_ln_core(ui, eb);
    var ivh: f64 = _SR_KM_CR_LN_IVH;
    var ivm: f64 = _SR_KM_CR_LN_IVM;
    var i1: f64 = _SR_KM_CR_LN_IVH1;
    var i2: f64 = _SR_KM_CR_LN_IVH2;
    var ph: f64 = hi * ivh;
    var c: f64 = 134217729.0 * hi;
    var h1: f64 = c - (c - hi);
    var h2: f64 = hi - h1;
    var pe: f64 = ((((h1 * i1) - ph) + (h1 * i2)) + (h2 * i1)) + (h2 * i2);
    var pl: f64 = pe + ((hi * ivm) + (lo * ivh));
    # The error: 0.4343·(ln's error) plus the product's roundings (hi·IVM, lo·IVH, pl's sum, the test's own:
    # below 2^-52.4·|lo| + 2^-101·|ph|, which eln's slack and 0.5 − 0.4343 cover) and IVL (2^-111·|ln x|):
    # err10 = eln/2 + 2^-100·|ph|.
    var ap: f64 = f64_abs(ph);
    var k100: f64 = 0x39B0000000000000;     # 2^-100
    var err: f64 = (eln * 0.5) + (ap * k100);
    var u: f64 = ph + (pl - err);
    var v: f64 = ph + (pl + err);
    if (u == v) { return (u, 1); }
    return (0.0, 0);
}

# log10 by the accurate path alone: the triple-double ln times 1/ln 10 = IVH + IVM + IVL.
#must_use
fn _sr_km_cr_log10_acc(x: f64): f64 {
    var sv, sp = _sr_km_ln_special(x);
    if (sp == 1) { return sv; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _sr_km_ln_acc_td(x, &buf);
    var ivh: f64 = _SR_KM_CR_LN_IVH;
    var ivm: f64 = _SR_KM_CR_LN_IVM;
    var ivl: f64 = _SR_KM_CR_LN_IVL;
    var zh, zm, zl = _sr_km_td_mul(buf[0], buf[1], buf[2], ivh, ivm, ivl);
    var r: f64 = _sr_km_rn3(zh, zm, zl);
    return r;
}

# --- acoustic_render.cyr ---

# acoustic_render.cyr — the goonj half of Rust 1.2.0's src/acoustic_render.rs (M5 part a): ray paths, portals and
# coupled decay curves drawn as lines. Part b adds the pressure slices, room modes and directivity balloons as meshes.
#
# **OPTIONAL**, as Rust gates it behind `acoustics`: bundled by the `[lib.acoustics]` profile after src/crmath_exp.cyr.
# It includes goonj 2.3.2 itself, and hisab 3.5.0 before it (goonj's HVec3).
#
# **Inputs are goonj's Cyrius types** (plan §2.5, ADR 0002 #29): f64 where Rust goonj 1.4's were f32. A
# RayVisualization (`soorat_ray_visualization_*`) holds a vec of RayPath, each a vec of RayBounce with 8 band energies
# (`ray_bounce_energy_after`); a Portal and a CoupledDecay are goonj structs read through their accessors; an HVec3 is
# three f64 (x, y, z).
#
# **Precision (D4 rule b, class E).** Rust computed in f32 from inputs goonj had already rounded to f32. Here every
# position is computed in f64 from goonj's f64 values and rounded once to f32. The value Rust hands its colour lerp
# (a ray segment's band-averaged energy, the decay's early fraction) is likewise computed in f64 and rounded once, and
# the colour from it is Rust's f32 sequence (`1 − x`, then `Color::lerp`), as viz's heat maps are (M3). The decay's exp
# and log10 are correctly rounded (src/crmath_exp.cyr), and its f32 constants (1e-10, 0.2, f32::EPSILON) are widened
# exactly.

include "lib/hisab.cyr"
include "lib/goonj.cyr"

# 0.2f32 and 1e-10f32, widened exactly; ln 10 correctly rounded (2.302585092994046).
var _SR_AC_0_2: f64 = f32_to(0x3E4CCCCD);
var _SR_AC_1E_10: f64 = f32_to(0x2EDBE6FF);
var _SR_AC_LN10 = 0x40026BB1BBB55516;

# The HVec3 v (three f64) rounded once to 3 f32 at out.
fn _sr_hv32(v, out) {
    var k = 0;
    while (k < 3) {
        var x: f64 = load64(v + k * 8);
        store32(out + k * 4, f32_from(x));
        k = k + 1;
    }
    return out;
}

# The energy a ray carries after bounce b: its 8 band energies averaged in f64 (summed in band order from −0, as
# Rust's `Sum` starts), clamped to [0, 1], or 0 when the average isn't finite; rounded once to f32 bits.
#must_use
fn _sr_ray_energy(b): i64 {
    var nz = 0x8000000000000000;
    var s: f64 = nz;
    var i = 0;
    while (i < NUM_BANDS) {
        var e: f64 = ray_bounce_energy_after(b, i);
        s = s + e;
        i = i + 1;
    }
    var nb: f64 = f64_from(NUM_BANDS);
    var avg: f64 = s / nb;
    var zero: f64 = 0.0;
    var one: f64 = 1.0;
    if (avg != avg || avg - avg != zero) { return 0; }
    if (avg < zero) { avg = zero; }
    if (avg > one) { avg = one; }
    return f32_from(avg);
}

# Draws each ray path of ray_viz (a goonj RayVisualization) into batch: a line from the source to the first bounce,
# then bounce to bounce, each coloured start_color.lerp(end_color, 1 − e) by the energy e the ray carries along it:
# 1 for the first segment, then each bounce's band-averaged energy (_sr_ray_energy). 1, or 0 when an allocation
# fails (the lines before it stay). Mirrors `ray_paths_to_lines`.
fn sr_ray_paths_to_lines(ray_viz, start_color, end_color, batch): i64 {
    _sr_debug("soorat::acoustic_render: building acoustic ray lines");
    var paths = soorat_ray_visualization_paths(ray_viz);
    if (paths == 0) { return 1; }
    var src[16];
    var prev[16];
    var pt[16];
    var col[16];
    _sr_hv32(soorat_ray_visualization_source(ray_viz), &src);
    var ok = 1;
    var np = vec_len(paths);
    var p = 0;
    while (p < np) {
        var bounces = ray_path_bounces(vec_get(paths, p));
        var nb = 0;
        if (bounces != 0) { nb = vec_len(bounces); }
        memcpy(&prev, &src, 12);
        var energy = _SR_C1;
        var k = 0;
        while (k < nb) {
            var b = vec_get(bounces, k);
            SrColor_lerp(start_color, end_color, _sr_f32_sub(_SR_C1, energy), &col);
            _sr_hv32(ray_bounce_point(b), &pt);
            if (SrLineBatch_line(batch, &prev, &pt, &col) == 0) { ok = 0; }
            memcpy(&prev, &pt, 12);
            energy = _sr_ray_energy(b);
            k = k + 1;
        }
        p = p + 1;
    }
    return ok;
}

# Stores the f64 point (x, y, z) rounded once to 3 f32 at out.
fn _sr_ac_pt(x: f64, y: f64, z: f64, out) {
    store32(out, f32_from(x));
    store32(out + 4, f32_from(y));
    store32(out + 8, f32_from(z));
    return out;
}

# Draws portal (a goonj Portal) into batch as a width × height rectangle centred on its position in the plane of its
# normal (right and up from normal_to_basis), then an arrow arrow_length (f32 bits) along the normal with a head
# 0.2 · arrow_length long: 7 lines, in Rust's order. The corners, tip and head are computed in f64 and rounded once.
# 1, or 0 when an allocation fails. Mirrors `portal_to_lines`.
fn sr_portal_to_lines(portal, color, arrow_length, batch): i64 {
    var pos = Portal_position(portal);
    var nv = Portal_normal(portal);
    var p0: f64 = load64(pos);
    var p1: f64 = load64(pos + 8);
    var p2: f64 = load64(pos + 16);
    var n0: f64 = load64(nv);
    var n1: f64 = load64(nv + 8);
    var n2: f64 = load64(nv + 16);
    var bas[48];
    _sr_normal_to_basis64(n0, n1, n2, &bas);
    var r0: f64 = load64(&bas);
    var r1: f64 = load64(&bas + 8);
    var r2: f64 = load64(&bas + 16);
    var u0: f64 = load64(&bas + 24);
    var u1: f64 = load64(&bas + 32);
    var u2: f64 = load64(&bas + 40);
    var half: f64 = 0.5;
    var wd: f64 = Portal_width(portal);
    var ht: f64 = Portal_height(portal);
    var hw: f64 = wd * half;
    var hh: f64 = ht * half;
    var c[64];
    _sr_ac_pt((p0 - (r0 * hw)) - (u0 * hh), (p1 - (r1 * hw)) - (u1 * hh), (p2 - (r2 * hw)) - (u2 * hh), &c);
    _sr_ac_pt((p0 + (r0 * hw)) - (u0 * hh), (p1 + (r1 * hw)) - (u1 * hh), (p2 + (r2 * hw)) - (u2 * hh), &c + 12);
    _sr_ac_pt((p0 + (r0 * hw)) + (u0 * hh), (p1 + (r1 * hw)) + (u1 * hh), (p2 + (r2 * hw)) + (u2 * hh), &c + 24);
    _sr_ac_pt((p0 - (r0 * hw)) + (u0 * hh), (p1 - (r1 * hw)) + (u1 * hh), (p2 - (r2 * hw)) + (u2 * hh), &c + 36);
    var ok = SrLineBatch_line(batch, &c, &c + 12, color);
    ok = ok & SrLineBatch_line(batch, &c + 12, &c + 24, color);
    ok = ok & SrLineBatch_line(batch, &c + 24, &c + 36, color);
    ok = ok & SrLineBatch_line(batch, &c + 36, &c, color);
    var len: f64 = f32_to(arrow_length);
    var t0: f64 = p0 + (n0 * len);
    var t1: f64 = p1 + (n1 * len);
    var t2: f64 = p2 + (n2 * len);
    var hs: f64 = len * _SR_AC_0_2;
    var b0: f64 = t0 - (n0 * hs);
    var b1: f64 = t1 - (n1 * hs);
    var b2: f64 = t2 - (n2 * hs);
    var ctr[16];
    var tip[16];
    var arm[16];
    _sr_ac_pt(p0, p1, p2, &ctr);
    _sr_ac_pt(t0, t1, t2, &tip);
    ok = ok & SrLineBatch_line(batch, &ctr, &tip, color);
    _sr_ac_pt(b0 + (r0 * hs), b1 + (r1 * hs), b2 + (r2 * hs), &arm);
    ok = ok & SrLineBatch_line(batch, &tip, &arm, color);
    _sr_ac_pt(b0 - (r0 * hs), b1 - (r1 * hs), b2 - (r2 * hs), &arm);
    ok = ok & SrLineBatch_line(batch, &tip, &arm, color);
    return ok;
}

# Draws decay (a goonj CoupledDecay) into batch as a double-slope decay curve with params (an SrDecayCurveParams):
# `steps` points over `time_range` seconds, x = origin.x + t · x_scale and y = origin.y − (dB / min(db_range, −1),
# clamped to [0, 1]) · y_scale, where dB = 10 log10(max(E, 1e-10)) and E = a·e^(−t/τ_early) + (1 − a)·e^(−t/τ_late),
# a = early_amplitude clamped to [0, 1], τ = RT60 / (6 ln 10) (f32::EPSILON for an RT60 ≤ 0). Each line is coloured
# color_early.lerp(color_late, 1 − early fraction). Nothing for fewer than 2 steps or a time range ≤ 0. 1, or 0 when
# an allocation fails. Mirrors `coupled_decay_to_lines`.
#
# UPSTREAM(L1): ganita:docs/development/issues/2026-11-09-correctly-rounded-exp-sin-cos-hypot.md
#   call ganita's f64 exp and log10 once they are correctly rounded, and drop src/crmath_exp.cyr;
#   parity: the coupled_decay_to_lines rows of tests/golden/acoustic_render.tsv (class E).
fn sr_coupled_decay_to_lines(decay, params, batch): i64 {
    var steps = load64(params + 32) & 0xFFFFFFFF;
    var tr: f64 = f32_to(load32(params + 12));
    var zero: f64 = 0.0;
    var one: f64 = 1.0;
    if (steps < 2 || tr <= zero) { return 1; }
    var ox: f64 = f32_to(load32(params));
    var oy: f64 = f32_to(load32(params + 4));
    var oz: f64 = f32_to(load32(params + 8));
    var dbr: f64 = f32_to(load32(params + 16));
    var xs: f64 = f32_to(load32(params + 20));
    var ys: f64 = f32_to(load32(params + 24));
    var fs: f64 = f64_from(steps - 1);
    var dt: f64 = tr / fs;
    var six: f64 = 6.0;
    var ln10: f64 = _SR_AC_LN10;
    var dc: f64 = six * ln10;
    var rte: f64 = CoupledDecay_rt60_early(decay);
    var rtl: f64 = CoupledDecay_rt60_late(decay);
    var tau_e: f64 = _SR_F32_EPS;
    var tau_l: f64 = _SR_F32_EPS;
    if (rte > zero) { tau_e = rte / dc; }
    if (rtl > zero) { tau_l = rtl / dc; }
    var ae: f64 = CoupledDecay_early_amplitude(decay);
    if (ae < zero) { ae = zero; }
    if (ae > one) { ae = one; }
    var al: f64 = one - ae;
    var neg1: f64 = 0.0 - one;
    var dmin: f64 = dbr;
    if (dbr != dbr || dbr > neg1) { dmin = neg1; }
    var ten: f64 = 10.0;
    var halfv: f64 = 0.5;
    var prev[16];
    var pt[16];
    var col[16];
    var ok = 1;
    var i = 0;
    while (i < steps) {
        var fi: f64 = f64_from(i);
        var t: f64 = fi * dt;
        var xe: f64 = _sr_km_cr_exp((zero - t) / tau_e);
        var xl: f64 = _sr_km_cr_exp((zero - t) / tau_l);
        var ee: f64 = ae * xe;
        var el: f64 = al * xl;
        var et: f64 = _sr_max64(ee + el, _SR_AC_1E_10);
        var lg: f64 = _sr_km_cr_log10(et);
        var db: f64 = ten * lg;
        var dn: f64 = db / dmin;
        if (dn < zero) { dn = zero; }
        if (dn > one) { dn = one; }
        _sr_ac_pt(ox + (t * xs), oy - (dn * ys), oz, &pt);
        var frac: f64 = halfv;
        if (et > _SR_AC_1E_10) { frac = ee / et; }
        SrColor_lerp(params + 40, params + 56, _sr_f32_sub(_SR_C1, f32_from(frac)), &col);
        if (i > 0 && SrLineBatch_line(batch, &prev, &pt, &col) == 0) { ok = 0; }
        memcpy(&prev, &pt, 12);
        i = i + 1;
    }
    return ok;
}
