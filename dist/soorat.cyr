    store32(t + 792, 0x3F1090F1); store32(t + 796, 0x3F12353E); store32(t + 800, 0x3F13DC51);
    store32(t + 804, 0x3F15862B); store32(t + 808, 0x3F1732CD); store32(t + 812, 0x3F18E239);
    store32(t + 816, 0x3F1A946F); store32(t + 820, 0x3F1C4971); store32(t + 824, 0x3F1E0141);
    store32(t + 828, 0x3F1FBBDF); store32(t + 832, 0x3F21794E); store32(t + 836, 0x3F23398E);
    store32(t + 840, 0x3F24FCA0); store32(t + 844, 0x3F26C286); store32(t + 848, 0x3F288B41);
    store32(t + 852, 0x3F2A56D3); store32(t + 856, 0x3F2C253D); store32(t + 860, 0x3F2DF680);
    store32(t + 864, 0x3F2FCA9E); store32(t + 868, 0x3F31A197); store32(t + 872, 0x3F337B6C);
