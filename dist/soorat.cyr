# Rust `shadow::CascadeUniforms`: 272 bytes.
struct SrCascadeUniforms { splits: SrV4; matrices_0: SrM4; matrices_1: SrM4; matrices_2: SrM4; matrices_3: SrM4; }
# Rust `vertex::Vertex2D`: 32 bytes.
struct SrVertex2D { position: SrV2; tex_coords: SrV2; color: SrV4; }
# Rust `vertex::Vertex3D`: 48 bytes.
struct SrVertex3D { position: SrV3; normal: SrV3; tex_coords: SrV2; color: SrV4; }
# Rust `vertex::SkinnedVertex3D`: 96 bytes.
struct SrSkinnedVertex3D {
    position: SrV3; normal: SrV3; tex_coords: SrV2; color: SrV4; tangent: SrV4; joints: SrU4; weights: SrV4;
}
# Rust `instancing::InstanceData`: 80 bytes.
struct SrInstanceData { model: SrM4; color: SrV4; }

# --- color.cyr ---

# color.cyr — Rust 1.2.0's src/color.rs (M1 part b): RGBA colours and the visualization colour maps.
#
# **Layout.** `SrColor` is 4 f32 (r, g, b, a; 16 bytes), passed by pointer; a result is written through an out
# pointer the caller owns, which may be an input. Its fields are read and written with load32 / store32 at 0, 4, 8
# and 12 (an f32 field assignment from bits is a type warning under --bounds). The constants are pointers to static
# colours (`SR_COLOR_WHITE`, …): read them, copy them, never write through them.
#
# **Precision (D4 rule a).** Colours are quantized outputs, so every function follows Rust's f32 sequence exactly,
# one native f32 rounding per operation (helpers with `: f32` parameters, as ganita's tier; one helper per formula,
# so lerp makes 4 calls rather than 12), with Rust's `clamp`, `round` and `as u8` (src/mathx.cyr): class A and B
# rows at 0 ulp (tests/golden/color.tsv).
#
# The `optics` functions (`from_prakash`, `to_prakash`, `from_temperature`, `from_wavelength`) arrive with
# prakash in M1 part b2; the serde round trip with bayan.

struct SrColor { r: f32; g: f32; b: f32; a: f32; }

# f32 bits used here: 0, 0.25, 0.5, 0.75, 1, −1, 255 and the Rec. 709 luma weights, from rustc.
var _SR_C0 = 0;
var _SR_C025 = 0x3E800000;
var _SR_C05 = 0x3F000000;
var _SR_C075 = 0x3F400000;
var _SR_C1 = 0x3F800000;
var _SR_CM1 = 0xBF800000;
var _SR_C255 = 0x437F0000;
var _SR_LUMA_R = 0x3E59B3D0;   # 0.2126f32
var _SR_LUMA_G = 0x3F371759;   # 0.7152f32
var _SR_LUMA_B = 0x3D93DD98;   # 0.0722f32

# One lerp component, x + (y − x)·t: native f32 (typed parameters), one rounding per operation, Rust's sequence.
#must_use
fn _sr_f32_lerp(x: f32, y: f32, t: f32): i64 {
    var r: f32 = x + ((y - x) * t);
    return r;
}

# (wr·r + wg·g) + wb·b in native f32, Rust's luminance sequence (the weights passed as f32 bits).
#must_use
fn _sr_f32_luma(wr: f32, r: f32, wg: f32, g: f32, wb: f32, b: f32): i64 {
    var s: f32 = ((wr * r) + (wg * g)) + (wb * b);
    return s;
}

# (r, g, b, a) / k in native f32, stored at out.
fn _sr_f32_div4(out, r: f32, g: f32, b: f32, a: f32, k: f32) {
    var qr: f32 = r / k;
    var qg: f32 = g / k;
    var qb: f32 = b / k;
    var qa: f32 = a / k;
    store32(out, qr);
    store32(out + 4, qg);
    store32(out + 8, qb);
    store32(out + 12, qa);
    return out;
}

# Writes the four component bits (r, g, b, a) to out.
fn _sr_color_set(out, r, g, b, a) {
    store32(out, r);
    store32(out + 4, g);
    store32(out + 8, b);
    store32(out + 12, a);
    return out;
}

# ── constants ────────────────────────────────────────────────────────────────────────
# Seven static colours, 16 bytes each, filled once at load. Mirror `Color::WHITE` … `Color::CORNFLOWER_BLUE`.

var _sr_color_consts: u8[112];
var SR_COLOR_WHITE = &_sr_color_consts;
var SR_COLOR_BLACK = &_sr_color_consts + 16;
var SR_COLOR_RED = &_sr_color_consts + 32;
var SR_COLOR_GREEN = &_sr_color_consts + 48;
var SR_COLOR_BLUE = &_sr_color_consts + 64;
var SR_COLOR_TRANSPARENT = &_sr_color_consts + 80;
var SR_COLOR_CORNFLOWER_BLUE = &_sr_color_consts + 96;

# Fills the static colours. Runs once, at load.
fn _sr_color_consts_init(): i64 {
    _sr_color_set(SR_COLOR_WHITE, _SR_C1, _SR_C1, _SR_C1, _SR_C1);
    _sr_color_set(SR_COLOR_BLACK, _SR_C0, _SR_C0, _SR_C0, _SR_C1);
    _sr_color_set(SR_COLOR_RED, _SR_C1, _SR_C0, _SR_C0, _SR_C1);
    _sr_color_set(SR_COLOR_GREEN, _SR_C0, _SR_C1, _SR_C0, _SR_C1);
    _sr_color_set(SR_COLOR_BLUE, _SR_C0, _SR_C0, _SR_C1, _SR_C1);
    _sr_color_set(SR_COLOR_TRANSPARENT, _SR_C0, _SR_C0, _SR_C0, _SR_C0);
    # 0.392f32, 0.584f32, 0.929f32
    _sr_color_set(SR_COLOR_CORNFLOWER_BLUE, 0x3EC8B439, 0x3F158106, 0x3F6DD2F2, _SR_C1);
    return 1;
}
var _sr_color_consts_ready = _sr_color_consts_init();

# ── Color ────────────────────────────────────────────────────────────────────────────

# The colour (r, g, b, a), from f32 bits, into out. Mirrors `Color::new` (whose finiteness check is a debug_assert,
# so a release build stores any value, as this does).
fn SrColor_new(r, g, b, a, out) {
    return _sr_color_set(out, r, g, b, a);
}

# (r, g, b) at full opacity, into out. Mirrors `Color::rgb`.
fn SrColor_rgb(r, g, b, out) {
    return _sr_color_set(out, r, g, b, _SR_C1);
}

# The colour of four bytes (0–255), each `x as f32 / 255.0` in f32, into out. Mirrors `Color::from_rgba8`.
fn SrColor_from_rgba8(r, g, b, a, out) {
    var fr = f32_from(f64_from(r & 0xFF));
    var fg = f32_from(f64_from(g & 0xFF));
    var fb = f32_from(f64_from(b & 0xFF));
    var fa = f32_from(f64_from(a & 0xFF));
    return _sr_f32_div4(out, fr, fg, fb, fa, _SR_C255);
}

# The colour of 0xRRGGBBAA, into out. Mirrors `Color::from_hex`.
fn SrColor_from_hex(hex, out) {
    return SrColor_from_rgba8((hex >> 24) & 0xFF, (hex >> 16) & 0xFF, (hex >> 8) & 0xFF, hex & 0xFF, out);
}

# Copies c's (r, g, b, a) to the f32 array out. Mirrors `Color::to_array` and `From<Color> for [f32; 4]`.
fn SrColor_to_array(c, out) {
    store64(out, load64(c));
    store64(out + 8, load64(c + 8));
    return out;
}

# One component as a byte: NaN → 0, else round(clamp(x, 0, 1) · 255) (the product rounded to f32 first).
#must_use
fn _sr_color_q8(x): i64 {
    if (_sr_f32_is_nan(x) == 1) { return 0; }
    return _sr_f32_to_u8(_sr_round32(ganita_f32_mul(_sr_clamp32(x, _SR_C0, _SR_C1), _SR_C255)));
}

# c as four bytes (r, g, b, a) at out: each component clamped to [0, 1], scaled by 255 and rounded half away from
# zero; NaN → 0. No colour-space conversion. Mirrors `Color::to_rgba8`.
fn SrColor_to_rgba8(c, out) {
    store8(out, _sr_color_q8(load32(c)));
    store8(out + 1, _sr_color_q8(load32(c + 4)));
    store8(out + 2, _sr_color_q8(load32(c + 8)));
    store8(out + 3, _sr_color_q8(load32(c + 12)));
    return out;
}

# c widened exactly to four f64 (r, g, b, a; 32 bytes) at out: a GPU clear colour. Mirrors `Color::to_wgpu`
# (wgpu::Color is four f64).
fn SrColor_to_wgpu(c, out) {
    var i = 0;
    while (i < 4) {
        var x: f64 = f32_to(load32(c + i * 4));
        store64(out + i * 8, x);
        i = i + 1;
    }
    return out;
}

# Rec. 709 luminance, (0.2126·r + 0.7152·g) + 0.0722·b in f32, as f32 bits. Mirrors `Color::luminance`.
#must_use
fn SrColor_luminance(c): i64 {
    return _sr_f32_luma(_SR_LUMA_R, load32(c), _SR_LUMA_G, load32(c + 4), _SR_LUMA_B, load32(c + 8));
}

# The colour a + (b − a)·t per component, with t (f32 bits) clamped to [0, 1] first (a NaN t gives NaN
# components, as Rust's does), into out. Mirrors `Color::lerp`.
fn SrColor_lerp(a, b, t, out) {
    var tc = _sr_clamp32(t, _SR_C0, _SR_C1);
    var r = _sr_f32_lerp(load32(a), load32(b), tc);
    var g = _sr_f32_lerp(load32(a + 4), load32(b + 4), tc);
    var bl = _sr_f32_lerp(load32(a + 8), load32(b + 8), tc);
    var al = _sr_f32_lerp(load32(a + 12), load32(b + 12), tc);
    return _sr_color_set(out, r, g, bl, al);
}

# White, into out. Mirrors `impl Default for Color`.
fn SrColor_default(out) {
    return SrColor_to_array(SR_COLOR_WHITE, out);
}

# The colour of an [f32; 4] (r, g, b, a), into out. Mirrors `From<[f32; 4]> for Color`.
fn SrColor_from_array4(arr, out) {
    return SrColor_new(load32(arr), load32(arr + 4), load32(arr + 8), load32(arr + 12), out);
}

# The opaque colour of an [f32; 3] (r, g, b), into out. Mirrors `From<[f32; 3]> for Color`.
fn SrColor_from_array3(arr, out) {
    return SrColor_rgb(load32(arr), load32(arr + 4), load32(arr + 8), out);
}

# ── colour maps ──────────────────────────────────────────────────────────────────────

# The 5-stop blue → cyan → green → yellow → red gradient at t (f32 bits), into out: t clamped to [0, 1], NaN → 0
# (blue). Each quarter interpolates one channel by s = (t − start) / 0.25 in f32. Mirrors
# `visualization_heat_map`.
fn sr_visualization_heat_map(t, out) {
    var v = _SR_C0;
    if (_sr_f32_is_nan(t) == 0) { v = _sr_clamp32(t, _SR_C0, _SR_C1); }
    if (_sr_f32_lt(v, _SR_C025) == 1) {
        var s0 = ganita_f32_div(v, _SR_C025);
        return _sr_color_set(out, _SR_C0, s0, _SR_C1, _SR_C1);
    }
    if (_sr_f32_lt(v, _SR_C05) == 1) {
        var s1 = ganita_f32_div(ganita_f32_sub(v, _SR_C025), _SR_C025);
        return _sr_color_set(out, _SR_C0, _SR_C1, ganita_f32_sub(_SR_C1, s1), _SR_C1);
    }
    if (_sr_f32_lt(v, _SR_C075) == 1) {
        var s2 = ganita_f32_div(ganita_f32_sub(v, _SR_C05), _SR_C025);
        return _sr_color_set(out, s2, _SR_C1, _SR_C0, _SR_C1);
    }
    var s3 = ganita_f32_div(ganita_f32_sub(v, _SR_C075), _SR_C025);
    return _sr_color_set(out, _SR_C1, ganita_f32_sub(_SR_C1, s3), _SR_C0, _SR_C1);
}

# The diverging map at v (f32 bits), into out: v clamped to [−1, 1], NaN → 0; red (v, 0, 0) for v ≥ 0 (−0
# included), blue (0, 0, −v) below. Mirrors `signed_value_color`.
fn sr_signed_value_color(v, out) {
    var c = _SR_C0;
    if (_sr_f32_is_nan(v) == 0) { c = _sr_clamp32(v, _SR_CM1, _SR_C1); }
    if (_sr_f32_lt(c, _SR_C0) == 0) {
        return _sr_color_set(out, c, _SR_C0, _SR_C0, _SR_C1);
    }
    return _sr_color_set(out, _SR_C0, _SR_C0, ganita_f32_neg(c), _SR_C1);
}

# --- lights.cyr ---

# lights.cyr — Rust 1.2.0's src/lights.rs (M1 part c): directional, point and spot lights packed for the GPU.
#
# `SrGpuLight` (64 bytes) and `SrLightArrayUniforms` (16 + 16 + 8 × 64 = 544 bytes) are src/layout.cyr's; these
# functions fill them through pointers the caller owns. Every value is copied, except a spot light's cone cosines:
# Rust's f32 `cos` is host glibc's, which misrounds about 1 % of arguments by 1 ulp (probe P3); ganita's f32 `cos`
# is correctly rounded, so those rows are class C against tests/golden/lights.cr.tsv (ADR 0002 #16).

# Maximum number of lights in one draw call. Mirrors `MAX_LIGHTS`.
var SR_MAX_LIGHTS = 8;

# Light type discriminator, packed into `position_type.w` as an f32. Mirrors `LightType` (append-only: the Cyrius
# form of #[non_exhaustive]).
enum SrLightType {
    SR_LIGHT_TYPE_DIRECTIONAL = 0;
    SR_LIGHT_TYPE_POINT = 1;
    SR_LIGHT_TYPE_SPOT = 2;
}

# f32 bits of 0, 1, 2 (the light types as f32) and 0.1 (the default ambient intensity).
var _SR_L0 = 0;
var _SR_L1 = 0x3F800000;
var _SR_L2 = 0x40000000;
var _SR_L01 = 0x3DCCCCCD;

# Writes one vec4 (four f32 bits) at p.
fn _sr_light_v4(p, x, y, z, w) {
    store32(p, x);
    store32(p + 4, y);
    store32(p + 8, z);
    store32(p + 12, w);
    return p;
}

# A directional light into out (an SrGpuLight): position_type = (direction, 0), color_intensity = (color,
# intensity), the rest zero. direction and color are 3 f32 each; intensity is f32 bits. Mirrors
# `GpuLight::directional`.
fn SrGpuLight_directional(direction, color, intensity, out) {
    _sr_light_v4(out, load32(direction), load32(direction + 4), load32(direction + 8), _SR_L0);
    _sr_light_v4(out + 16, _SR_L0, _SR_L0, _SR_L0, _SR_L0);
    _sr_light_v4(out + 32, load32(color), load32(color + 4), load32(color + 8), intensity);
    _sr_light_v4(out + 48, _SR_L0, _SR_L0, _SR_L0, _SR_L0);
    return out;
}

# A point light into out: position_type = (position, 1), direction_range = (0, 0, 0, range), color_intensity =
# (color, intensity). Mirrors `GpuLight::point`.
fn SrGpuLight_point(position, color, intensity, range, out) {
    _sr_light_v4(out, load32(position), load32(position + 4), load32(position + 8), _SR_L1);
    _sr_light_v4(out + 16, _SR_L0, _SR_L0, _SR_L0, range);
    _sr_light_v4(out + 32, load32(color), load32(color + 4), load32(color + 8), intensity);
    _sr_light_v4(out + 48, _SR_L0, _SR_L0, _SR_L0, _SR_L0);
    return out;
}

# A spot light into out: position_type = (position, 2), direction_range = (direction, range), color_intensity =
# (color, intensity), spot_params = (cos inner_cone, cos outer_cone, 0, 0). The cones are half-angles in radians, f32
# bits; their cosines are correctly rounded (ganita_f32_cos). Mirrors `GpuLight::spot`.
fn SrGpuLight_spot(position, direction, color, intensity, range, inner_cone, outer_cone, out) {
    _sr_light_v4(out, load32(position), load32(position + 4), load32(position + 8), _SR_L2);
    _sr_light_v4(out + 16, load32(direction), load32(direction + 4), load32(direction + 8), range);
    _sr_light_v4(out + 32, load32(color), load32(color + 4), load32(color + 8), intensity);
    _sr_light_v4(out + 48, ganita_f32_cos(inner_cone), ganita_f32_cos(outer_cone), _SR_L0, _SR_L0);
    return out;
}

# The default light array into out (an SrLightArrayUniforms): ambient (1, 1, 1, 0.1), no lights, every light slot
# zero. Mirrors `impl Default for LightArrayUniforms`.
fn SrLightArrayUniforms_default(out) {
    memset(out, 0, sizeof(SrLightArrayUniforms));
    _sr_light_v4(out, _SR_L1, _SR_L1, _SR_L1, _SR_L01);
    return out;
}

# Copies the first min(n, SR_MAX_LIGHTS) of the n SrGpuLight at lights into u's slots and sets light_count.x to
# that count as f32; the other slots and light_count.yzw keep their values. Mirrors
# `LightArrayUniforms::set_lights`.
fn SrLightArrayUniforms_set_lights(u, lights, n) {
    var count = n;
    if (count > SR_MAX_LIGHTS) { count = SR_MAX_LIGHTS; }
    if (count < 0) { count = 0; }
    store32(u + 16, f32_from(f64_from(count)));
    var i = 0;
    while (i < count) {
        var k = 0;
        while (k < 64) {
            store64(u + 32 + i * 64 + k, load64(lights + i * 64 + k));
            k = k + 8;
        }
        i = i + 1;
    }
    return u;
}

# Sets u's ambient to (color, intensity): color is 3 f32, intensity f32 bits. Mirrors
# `LightArrayUniforms::set_ambient`.
fn SrLightArrayUniforms_set_ambient(u, color, intensity) {
    _sr_light_v4(u, load32(color), load32(color + 4), load32(color + 8), intensity);
    return u;
}

# --- lod.cyr ---

# lod.cyr — Rust 1.2.0's src/lod.rs (M1 part c): distance-based level-of-detail selection.
#
# `SrLodChain` and `SrTerrainLod` own their arrays, allocated from the freelist (`fl_alloc`), so a consumer that
# rebuilds them doesn't grow the bump heap: free each with its `_drop` (port plan §9.4, ADR 0002 #6). Rust's `Vec`
# arguments are a pointer and a count here.
#
# **Precision (D4 rule a).** The outputs are indices, so the squared distances follow Rust's f32 sequence exactly
# (native f32 helpers): class A rows (tests/golden/lod.tsv).

# One level: its mesh index and its maximum squared distance (f32). Mirrors `LodLevel`.
struct SrLodLevel { mesh_index; max_distance_sq: f32; }

# A chain of levels, nearest first: `levels` points to `level_count` SrLodLevel (12 bytes each). Mirrors
# `LodChain`.
struct SrLodChain { levels; level_count; }

# Grid resolutions (u32) and their distance thresholds (f32), `count` of each. Mirrors `TerrainLod`.
struct SrTerrainLod { resolutions; distances; count; }

# x·x in native f32.
#must_use
fn _sr_f32_sq(x: f32): i64 {
    var r: f32 = x * x;
    return r;
}

# (a − b)² + (c − d)² + (e − f)², as ((dx·dx + dy·dy) + dz·dz) in native f32, Rust's sequence.
#must_use
fn _sr_f32_dist_sq(a: f32, b: f32, c: f32, d: f32, e: f32, f: f32): i64 {
    var dx: f32 = a - b;
    var dy: f32 = c - d;
    var dz: f32 = e - f;
    var r: f32 = ((dx * dx) + (dy * dy)) + (dz * dz);
    return r;
}

# A chain from the n distances (f32, nearest first): level i has mesh index i and max_distance_sq = d·d in f32.
# Returns an SrLodChain to free with SrLodChain_drop, or 0 when the allocation fails. Mirrors `LodChain::new`.
#must_use
fn SrLodChain_new(distances, n): i64 {
    var chain = fl_alloc(sizeof(SrLodChain));
    if (chain == 0) { return 0; }
    var levels = 0;
    if (n > 0) {
        levels = fl_alloc(n * sizeof(SrLodLevel));
        if (levels == 0) {
            fl_free(chain);
            return 0;
        }
    }
    var i = 0;
    while (i < n) {
        store64(levels + i * sizeof(SrLodLevel), i);
        store32(levels + i * sizeof(SrLodLevel) + 8, _sr_f32_sq(load32(distances + i * 4)));
        i = i + 1;
    }
    store64(chain, levels);
    store64(chain + 8, n);
    return chain;
}

# Frees a chain from SrLodChain_new (0 is ignored).
fn SrLodChain_drop(chain) {
    if (chain == 0) { return 0; }
    if (load64(chain) != 0) { fl_free(load64(chain)); }
    fl_free(chain);
    return 0;
}

# The mesh index of the first level whose max_distance_sq ≥ distance_sq (f32 bits), else the last level's (a NaN
# distance matches none), or 0 for an empty chain. Mirrors `LodChain::select`.
#must_use
fn SrLodChain_select(chain, distance_sq): i64 {
    var levels = load64(chain);
    var n = load64(chain + 8);
    var i = 0;
    while (i < n) {
        if (_sr_f32_le(distance_sq, load32(levels + i * sizeof(SrLodLevel) + 8)) == 1) {
            return load64(levels + i * sizeof(SrLodLevel));
        }
        i = i + 1;
    }
    if (n == 0) { return 0; }
    return load64(levels + (n - 1) * sizeof(SrLodLevel));
}

# SrLodChain_select at the squared distance between camera_pos and object_pos (3 f32 each), computed in f32 as Rust
# does. Mirrors `LodChain::select_from_positions`.
#must_use
fn SrLodChain_select_from_positions(chain, camera_pos, object_pos): i64 {
    var d = _sr_f32_dist_sq(load32(camera_pos), load32(object_pos), load32(camera_pos + 4), load32(object_pos + 4),
        load32(camera_pos + 8), load32(object_pos + 8));
    return SrLodChain_select(chain, d);
}

# The number of levels. Mirrors `LodChain::level_count`.
#must_use
fn SrLodChain_level_count(chain): i64 {
    return load64(chain + 8);
}

# A terrain LOD from nr resolutions (u32) and nd distance thresholds (f32), copied. Ok(an SrTerrainLod to free
# with SrTerrainLod_drop); Err(SR_ERR_PIPELINE) when nr != nd (Rust's message names both lengths) or an allocation
# fails. Mirrors `TerrainLod::new`.
fn SrTerrainLod_new(resolutions, nr, distances, nd): Result {
    if (nr != nd || nr < 0) { return Err(SR_ERR_PIPELINE); }
    var t = fl_alloc(sizeof(SrTerrainLod));
    if (t == 0) { return Err(SR_ERR_PIPELINE); }
    var res = 0;
    var dist = 0;
    if (nr > 0) {
        res = fl_alloc(nr * 4);
        dist = fl_alloc(nr * 4);
        if (res == 0 || dist == 0) {
            if (res != 0) { fl_free(res); }
            if (dist != 0) { fl_free(dist); }
            fl_free(t);
            return Err(SR_ERR_PIPELINE);
        }
    }
    var i = 0;
    while (i < nr) {
        store32(res + i * 4, load32(resolutions + i * 4));
        store32(dist + i * 4, load32(distances + i * 4));
        i = i + 1;
    }
    store64(t, res);
    store64(t + 8, dist);
    store64(t + 16, nr);
    return Ok(t);
}

# Frees a terrain LOD from SrTerrainLod_new (0 is ignored).
fn SrTerrainLod_drop(t) {
    if (t == 0) { return 0; }
    if (load64(t) != 0) { fl_free(load64(t)); }
    if (load64(t + 8) != 0) { fl_free(load64(t + 8)); }
    fl_free(t);
    return 0;
}

# The resolution of the first threshold ≥ distance (f32 bits), else the last resolution (a NaN distance matches
# none), or 8 when there are none. Mirrors `TerrainLod::select_resolution`.
#must_use
fn SrTerrainLod_select_resolution(t, distance): i64 {
    var res = load64(t);
    var dist = load64(t + 8);
    var n = load64(t + 16);
    var i = 0;
    while (i < n) {
        if (_sr_f32_le(distance, load32(dist + i * 4)) == 1) { return load32(res + i * 4) & 0xFFFFFFFF; }
        i = i + 1;
    }
    if (n == 0) { return 8; }
    return load32(res + (n - 1) * 4) & 0xFFFFFFFF;
}

# --- sprite.cyr ---

# sprite.cyr — Rust 1.2.0's src/sprite.rs (M2 part a): UV rectangles, sprites and sprite batches.
#
# **Layout.** `SrUvRect` is 4 f32 (16 bytes). `SrSprite` is 68 bytes, its fields reordered from Rust's for alignment
# (it is no GPU type): texture_id (u64) at 0, z_order (an i32, sign-extended into 8 bytes) at 8, x, y, width,
# height and rotation (f32) at 16–32, color (an SrColor) at 36, uv (an SrUvRect) at 52. Fields are read and written at
# those offsets (the `_SR_SP_*` constants; tests/sprite.tcyr checks them against the compiled struct). A sprite or
# rectangle result is written through an out pointer; Rust's builders (`with_color(mut self, …) -> Self`) set the
# field in place and return the sprite.
#
# **Precision (D4 rule a).** `center` and `bounds` are Rust's f32 sequence (native f32 helpers); `from_pixel_rect`
# divides in f64 and narrows once, as Rust does: class A and B rows at 0 ulp (tests/golden/sprite.tsv).
#
# **SrSpriteBatch** owns a growable array of sprites from the freelist (`fl_alloc`), so a batch reused every frame
# (`clear`, then `push`) allocates nothing once it has reached its size; free it with SrSpriteBatch_drop. Its
# `sprites` field points at `len` sprites, 68 bytes apart. `sort_by_z` is stable, as Rust's `sort_by_key` is: it sorts
# the keys `(z << 32) | index`, which are all distinct, so ties keep their order, and an already sorted batch costs
# one pass (ADR 0002 #20).

struct SrUvRect { u_min: f32; v_min: f32; u_max: f32; v_max: f32; }
struct SrSprite { texture_id; z_order; x: f32; y: f32; width: f32; height: f32; rotation: f32; color: SrColor;
    uv: SrUvRect; }
struct SrSpriteBatch { sprites; len; cap; keys; scratch; }

# SrSprite field offsets.
const _SR_SP_TEX = 0;
const _SR_SP_Z = 8;
const _SR_SP_X = 16;
const _SR_SP_Y = 20;
const _SR_SP_W = 24;
const _SR_SP_H = 28;
const _SR_SP_ROT = 32;
const _SR_SP_COLOR = 36;
const _SR_SP_UV = 52;
const _SR_SPRITE_SIZE = 68;

# f32 bits of 0, 0.5, 1 and 64.
var _SR_S0 = 0;
var _SR_SHALF = 0x3F000000;
var _SR_S1 = 0x3F800000;
var _SR_S64 = 0x42800000;

# ── UvRect ───────────────────────────────────────────────────────────────────────────

# The full texture, (0, 0) to (1, 1): a pointer to a static rectangle, filled at load. Read or copy it. Mirrors
# `UvRect::FULL`.
var _sr_uv_full_data: u8[16];
var SR_UV_RECT_FULL = &_sr_uv_full_data;

# Writes (u_min, v_min, u_max, v_max) to out.
fn _sr_uv_set(out, u0, v0, u1, v1) {
    store32(out, u0);
    store32(out + 4, v0);
    store32(out + 8, u1);
    store32(out + 12, v1);
    return out;
}
var _sr_uv_full_ready = _sr_uv_set(SR_UV_RECT_FULL, _SR_S0, _SR_S0, _SR_S1, _SR_S1);

# Copies 16 bytes (a UvRect or a Color).
fn _sr_copy16(dst, src) {
    store64(dst, load64(src));
    store64(dst + 8, load64(src + 8));
    return dst;
}

# The full texture, into out. Mirrors `impl Default for UvRect`.
fn SrUvRect_default(out) {
    return _sr_copy16(out, SR_UV_RECT_FULL);
}

# The UV rectangle of the pixel rectangle (x, y, w, h) in an atlas_w × atlas_h atlas, into out: each coordinate
# divided in f64 (so x + w can't overflow) and narrowed once. The full texture when either atlas dimension is 0. The
# arguments are u32 values. Mirrors `UvRect::from_pixel_rect`.
fn SrUvRect_from_pixel_rect(x, y, w, h, atlas_w, atlas_h, out) {
    if (atlas_w == 0 || atlas_h == 0) { return SrUvRect_default(out); }
    var aw: f64 = f64_from(atlas_w & 0xFFFFFFFF);
    var ah: f64 = f64_from(atlas_h & 0xFFFFFFFF);
    var fx: f64 = f64_from(x & 0xFFFFFFFF);
    var fy: f64 = f64_from(y & 0xFFFFFFFF);
    var fw: f64 = f64_from(w & 0xFFFFFFFF);
    var fh: f64 = f64_from(h & 0xFFFFFFFF);
    var u0: f64 = fx / aw;
    var v0: f64 = fy / ah;
    var u1: f64 = (fx + fw) / aw;
    var v1: f64 = (fy + fh) / ah;
    return _sr_uv_set(out, f32_from(u0), f32_from(v0), f32_from(u1), f32_from(v1));
}

# The quad corners' UVs, [top-left, top-right, bottom-right, bottom-left] as 4 (u, v) pairs (8 f32), into out.
# Mirrors `UvRect::corners`.
fn SrUvRect_corners(uv, out) {
    var u0 = load32(uv);
    var v0 = load32(uv + 4);
    var u1 = load32(uv + 8);
    var v1 = load32(uv + 12);
    store32(out, u0);
    store32(out + 4, v0);
    store32(out + 8, u1);
    store32(out + 12, v0);
    store32(out + 16, u1);
    store32(out + 20, v1);
    store32(out + 24, u0);
    store32(out + 28, v1);
    return out;
}

# ── Sprite ───────────────────────────────────────────────────────────────────────────

# Copies a sprite (68 bytes).
fn _sr_sprite_copy(dst, src) {
    var k = 0;
    while (k < 64) {
        store64(dst + k, load64(src + k));
        k = k + 8;
    }
    store32(dst + 64, load32(src + 64));
    return dst;
}

# The default sprite into out: 64 × 64 at (0, 0), no rotation, white, texture 0, z 0, the full texture. Mirrors
# `impl Default for Sprite`.
fn SrSprite_default(out) {
    store64(out + _SR_SP_TEX, 0);
    store64(out + _SR_SP_Z, 0);
    store32(out + _SR_SP_X, _SR_S0);
    store32(out + _SR_SP_Y, _SR_S0);
    store32(out + _SR_SP_W, _SR_S64);
    store32(out + _SR_SP_H, _SR_S64);
    store32(out + _SR_SP_ROT, _SR_S0);
    _sr_copy16(out + _SR_SP_COLOR, SR_COLOR_WHITE);
    _sr_copy16(out + _SR_SP_UV, SR_UV_RECT_FULL);
    return out;
}

# A default sprite at (x, y), width × height (f32 bits), into out. Mirrors `Sprite::new`.
fn SrSprite_new(x, y, width, height, out) {
    SrSprite_default(out);
    store32(out + _SR_SP_X, x);
    store32(out + _SR_SP_Y, y);
    store32(out + _SR_SP_W, width);
    store32(out + _SR_SP_H, height);
    return out;
}

# Sets s's tint to the colour at color; returns s. Mirrors `Sprite::with_color`.
fn SrSprite_with_color(s, color) {
    _sr_copy16(s + _SR_SP_COLOR, color);
    return s;
}

# Sets s's rotation (radians, f32 bits); returns s. Mirrors `Sprite::with_rotation`.
fn SrSprite_with_rotation(s, radians) {
    store32(s + _SR_SP_ROT, radians);
    return s;
}

# Sets s's texture id (a u64); returns s. Mirrors `Sprite::with_texture`.
fn SrSprite_with_texture(s, id) {
    store64(s + _SR_SP_TEX, id);
    return s;
}

# Sets s's z-order to z as an i32 (the low 32 bits, sign-extended); returns s. Mirrors `Sprite::with_z_order`.
fn SrSprite_with_z_order(s, z) {
    store64(s + _SR_SP_Z, ((z & 0xFFFFFFFF) ^ 0x80000000) - 0x80000000);
    return s;
}

# Sets s's UV rectangle to the one at uv; returns s. Mirrors `Sprite::with_uv`.
fn SrSprite_with_uv(s, uv) {
    _sr_copy16(s + _SR_SP_UV, uv);
    return s;
}

# p + q / 2 in native f32.
#must_use
fn _sr_f32_add_half(p: f32, q: f32, two: f32): i64 {
    var r: f32 = p + (q / two);
    return r;
}

# p + q in native f32.
#must_use
fn _sr_f32_add(p: f32, q: f32): i64 {
    var r: f32 = p + q;
    return r;
}

# s's centre, (x + width / 2, y + height / 2) in f32, as 2 f32 at out. Mirrors `Sprite::center`.
fn SrSprite_center(s, out) {
    var two = 0x40000000;
    store32(out, _sr_f32_add_half(load32(s + _SR_SP_X), load32(s + _SR_SP_W), two));
    store32(out + 4, _sr_f32_add_half(load32(s + _SR_SP_Y), load32(s + _SR_SP_H), two));
    return out;
}

# s's bounding box (min_x, min_y, max_x, max_y) = (x, y, x + width, y + height) in f32, as 4 f32 at out. Mirrors
# `Sprite::bounds`.
fn SrSprite_bounds(s, out) {
    var x = load32(s + _SR_SP_X);
    var y = load32(s + _SR_SP_Y);
    store32(out, x);
    store32(out + 4, y);
    store32(out + 8, _sr_f32_add(x, load32(s + _SR_SP_W)));
    store32(out + 12, _sr_f32_add(y, load32(s + _SR_SP_H)));
    return out;
}

# ── SpriteBatch ──────────────────────────────────────────────────────────────────────

# An empty batch with room for capacity sprites (none allocated when 0): an SrSpriteBatch to free with
# SrSpriteBatch_drop, or 0 when an allocation fails. Mirrors `SpriteBatch::with_capacity`.
#must_use
fn SrSpriteBatch_with_capacity(capacity): i64 {
    var b = fl_calloc(sizeof(SrSpriteBatch));
    if (b == 0) { return 0; }
    if (capacity > 0) {
        var p = fl_alloc(capacity * _SR_SPRITE_SIZE);
        if (p == 0) {
            fl_free(b);
            return 0;
        }
        store64(b, p);
        store64(b + 16, capacity);
    }
    return b;
}

# An empty batch: an SrSpriteBatch to free with SrSpriteBatch_drop, or 0. Mirrors `SpriteBatch::new`.
#must_use
fn SrSpriteBatch_new(): i64 {
    return SrSpriteBatch_with_capacity(0);
}

# Frees b and its arrays (0 is ignored).
fn SrSpriteBatch_drop(b) {
    if (b == 0) { return 0; }
    if (load64(b) != 0) { fl_free(load64(b)); }
    if (load64(b + 24) != 0) { fl_free(load64(b + 24) - 8); }
    if (load64(b + 32) != 0) { fl_free(load64(b + 32)); }
    fl_free(b);
    return 0;
}

# Appends a copy of the sprite at s, doubling the array when it is full (4 at first, as Rust's Vec does): 1, or 0 when
# the allocation fails (the batch is unchanged). Mirrors `SpriteBatch::push`.
fn SrSpriteBatch_push(b, s): i64 {
    var len = load64(b + 8);
    var cap = load64(b + 16);
    if (len == cap) {
        var ncap = cap * 2;
        if (ncap < 4) { ncap = 4; }
        var p = fl_alloc(ncap * _SR_SPRITE_SIZE);
        if (p == 0) { return 0; }
        var old = load64(b);
        var i = 0;
        while (i < len) {
            _sr_sprite_copy(p + i * _SR_SPRITE_SIZE, old + i * _SR_SPRITE_SIZE);
            i = i + 1;
        }
        if (old != 0) { fl_free(old); }
        store64(b, p);
        store64(b + 16, ncap);
    }
    _sr_sprite_copy(load64(b) + len * _SR_SPRITE_SIZE, s);
    store64(b + 8, len + 1);
    return 1;
}

# Empties b, keeping its capacity. Mirrors `SpriteBatch::clear`.
fn SrSpriteBatch_clear(b) {
    store64(b + 8, 0);
    return b;
}

# The number of sprites. Mirrors `SpriteBatch::len`.
#must_use
fn SrSpriteBatch_len(b): i64 {
    return load64(b + 8);
}

# 1 when b holds no sprite. Mirrors `SpriteBatch::is_empty`.
#must_use
fn SrSpriteBatch_is_empty(b): i64 {
    if (load64(b + 8) == 0) { return 1; }
    return 0;
}

# The sprite at index i (a pointer into the batch, valid until the next push or sort).
#must_use
fn SrSpriteBatch_get(b, i): i64 {
    return load64(b) + i * _SR_SPRITE_SIZE;
}

# Sorts b's sprites by z-order, ascending, keeping the order of equal z (stable): 1, or 0 when the scratch arrays
# can't be allocated (the batch is unchanged). Mirrors `SpriteBatch::sort_by_z`.
fn SrSpriteBatch_sort_by_z(b): i64 {
    var n = load64(b + 8);
    var sp = load64(b);
    var i = 1;
    while (i < n && load64(sp + i * _SR_SPRITE_SIZE + _SR_SP_Z) >= load64(sp + (i - 1) * _SR_SPRITE_SIZE + _SR_SP_Z)) {
        i = i + 1;
    }
    if (i >= n) { return 1; }
    # The scratch arrays track the capacity: allocated once, reused by every later sort.
    var cap = load64(b + 16);
    if (load64(b + 32) == 0 || _sr_batch_scratch_cap(b) < cap) {
        if (_sr_batch_scratch(b, cap) == 0) { return 0; }
    }
    var keys = load64(b + 24);
    var scratch = load64(b + 32);
    var k = 0;
    while (k < n) {
        store64(keys + k * 8, (load64(sp + k * _SR_SPRITE_SIZE + _SR_SP_Z) << 32) | k);
        k = k + 1;
    }
    _sr_sort_i64(keys, n);
    var j = 0;
    while (j < n) {
        _sr_sprite_copy(scratch + j * _SR_SPRITE_SIZE, sp + (load64(keys + j * 8) & 0xFFFFFFFF) * _SR_SPRITE_SIZE);
        j = j + 1;
    }
    store64(b, scratch);
    store64(b + 32, sp);
    return 1;
}

# The capacity the scratch arrays were allocated for (the word before the keys array).
#must_use
fn _sr_batch_scratch_cap(b): i64 {
    var keys = load64(b + 24);
    if (keys == 0) { return 0; }
    return load64(keys - 8);
}

# (Re)allocates b's keys and sprite scratch arrays for cap sprites: 1, or 0.
fn _sr_batch_scratch(b, cap): i64 {
    var kb = fl_alloc(cap * 8 + 8);
    var sb = fl_alloc(cap * _SR_SPRITE_SIZE);
    if (kb == 0 || sb == 0) {
        if (kb != 0) { fl_free(kb); }
        if (sb != 0) { fl_free(sb); }
        return 0;
    }
    store64(kb, cap);
    if (load64(b + 24) != 0) { fl_free(load64(b + 24) - 8); }
    if (load64(b + 32) != 0) { fl_free(load64(b + 32)); }
    store64(b + 24, kb + 8);
    store64(b + 32, sb);
    return 1;
}

# --- batch.cyr ---

# batch.cyr — Rust 1.2.0's src/batch.rs (M2 part a): sprite batches → Vertex2D quads and indices.
#
# Each sprite becomes 4 `SrVertex2D` (32 bytes: position, tex_coords, color; src/layout.cyr) and 6 indices, the two
# triangles (0, 1, 2) and (2, 3, 0) offset by 4 per sprite. The u16 forms stop at SR_MAX_SPRITES_PER_BATCH sprites
# (65,535 / 4); the u32 forms have no limit.
#
# **Buffers (ADR 0002 #6).** Rust returns two `Vec`s, or refills the caller's (`_into`). Here `_into` writes into
# caller memory: vertices must hold n × 32 bytes and indices n × 12 (u16) or n × 24 (u32) bytes, n the sprites
# emitted, which `sr_batch_sprite_count` gives. The allocating forms take an allocator (a frame arena, `alloc_via`)
# and fill an SrQuadData with the two arrays and their counts.
#
# **Precision (D4 rule a; plan §5, class B).** Each corner is Rust's f32 sequence: c = (x + w·0.5, y + h·0.5), the
# corner (±w·0.5, ±h·0.5) rotated as (cx·cos − cy·sin) + c. The rotation's sin and cos are correctly rounded
# (ganita's f32 tier) where Rust's are host glibc's, so rows where glibc misrounds are class C against
# tests/golden/sprite.cr.tsv (ADR 0002 #16). A rotation of ±0 skips them (sin 0, cos 1), as Rust does.

# The most sprites one u16-indexed batch holds. Mirrors `MAX_SPRITES_PER_BATCH`.
var SR_MAX_SPRITES_PER_BATCH = 16383;

# The arrays an allocating form returns: `vertices` (vertex_count SrVertex2D) and `indices` (index_count u16 or u32).
struct SrQuadData { vertices; vertex_count; indices; index_count; }

# The number of sprites a u16 form emits for b (all of them, up to SR_MAX_SPRITES_PER_BATCH), or a u32 form
# (all of them) when u32 is 1.
#must_use
fn sr_batch_sprite_count(b, u32): i64 {
    var n = SrSpriteBatch_len(b);
    if (u32 == 0 && n > SR_MAX_SPRITES_PER_BATCH) { return SR_MAX_SPRITES_PER_BATCH; }
    return n;
}

# One corner: position ((kx·cos − ky·sin) + cx, (kx·sin + ky·cos) + cy) in native f32, stored at v.
fn _sr_corner(v, kx: f32, ky: f32, c: f32, s: f32, cx: f32, cy: f32) {
    var px: f32 = ((kx * c) - (ky * s)) + cx;
    var py: f32 = ((kx * s) + (ky * c)) + cy;
    store32(v, px);
    store32(v + 4, py);
    return v;
}

# The centre and half extents of (x, y, w, h) in native f32, into the 4 words at out: cx = x + w·0.5,
# cy = y + h·0.5, hw = w·0.5, hh = h·0.5.
fn _sr_center_half2(out, x: f32, y: f32, w: f32, h: f32, half: f32) {
    var hw: f32 = w * half;
    var hh: f32 = h * half;
    var cx: f32 = x + hw;
    var cy: f32 = y + hh;
    store64(out, cx);
    store64(out + 8, cy);
    store64(out + 16, hw);
    store64(out + 24, hh);
    return out;
}

# Writes the sprite at s as 4 SrVertex2D at v (128 bytes): Rust's `sprite_quad` and `emit_quad`'s vertices.
fn _sr_emit_quad(s, v) {
    var ch[32];
    _sr_center_half2(&ch, load32(s + _SR_SP_X), load32(s + _SR_SP_Y), load32(s + _SR_SP_W), load32(s + _SR_SP_H),
      _SR_SHALF);
    var cx = load64(&ch) & 0xFFFFFFFF;
    var cy = load64(&ch + 8) & 0xFFFFFFFF;
    var hw = load64(&ch + 16) & 0xFFFFFFFF;
    var hh = load64(&ch + 24) & 0xFFFFFFFF;
    var nhw = hw ^ 0x80000000;
    var nhh = hh ^ 0x80000000;
    var rot = load32(s + _SR_SP_ROT);
    var sn = _SR_S0;
    var cs = _SR_S1;
    if ((rot & 0x7FFFFFFF) != 0) {
        sn = ganita_f32_sin(rot);
        cs = ganita_f32_cos(rot);
    }
    _sr_corner(v, nhw, nhh, cs, sn, cx, cy);
    _sr_corner(v + 32, hw, nhh, cs, sn, cx, cy);
    _sr_corner(v + 64, hw, hh, cs, sn, cx, cy);
    _sr_corner(v + 96, nhw, hh, cs, sn, cx, cy);
    var uv = s + _SR_SP_UV;
    var u0 = load32(uv);
    var v0 = load32(uv + 4);
    var u1 = load32(uv + 8);
    var v1 = load32(uv + 12);
    store32(v + 8, u0);
    store32(v + 12, v0);
    store32(v + 40, u1);
    store32(v + 44, v0);
    store32(v + 72, u1);
    store32(v + 76, v1);
    store32(v + 104, u0);
    store32(v + 108, v1);
    var c0 = load64(s + _SR_SP_COLOR);
    var c1 = load64(s + _SR_SP_COLOR + 8);
    var j = 0;
    while (j < 4) {
        store64(v + j * 32 + 16, c0);
        store64(v + j * 32 + 24, c1);
        j = j + 1;
    }
    return v;
}

# Writes the first n sprites of b as quads at vertices, and their indices at indices: u16 when u32 is 0, else u32.
fn _sr_batch_emit(b, n, vertices, indices, u32) {
    var sp = load64(b);
    var i = 0;
    while (i < n) {
        _sr_emit_quad(sp + i * _SR_SPRITE_SIZE, vertices + i * 128);
        var base = i * 4;
        if (u32 == 0) {
            var p = indices + i * 12;
            store16(p, base);
            store16(p + 2, base + 1);
            store16(p + 4, base + 2);
            store16(p + 6, base + 2);
            store16(p + 8, base + 3);
            store16(p + 10, base);
        } else {
            var q = indices + i * 24;
            store32(q, base);
            store32(q + 4, base + 1);
            store32(q + 8, base + 2);
            store32(q + 12, base + 2);
            store32(q + 16, base + 3);
            store32(q + 20, base);
        }
        i = i + 1;
    }
    return n;
}

# Writes b's quads (up to SR_MAX_SPRITES_PER_BATCH sprites) at vertices and their u16 indices at indices, which must
# hold sr_batch_sprite_count(b, 0) × 32 and × 12 bytes. Returns the number of sprites written. Mirrors
# `batch_to_vertices_into`.
fn sr_batch_to_vertices_into(b, vertices, indices): i64 {
    return _sr_batch_emit(b, sr_batch_sprite_count(b, 0), vertices, indices, 0);
}

# As sr_batch_to_vertices_into for every sprite, with u32 indices (n × 24 bytes). Mirrors
# `batch_to_vertices_u32_into`.
fn sr_batch_to_vertices_u32_into(b, vertices, indices): i64 {
    return _sr_batch_emit(b, sr_batch_sprite_count(b, 1), vertices, indices, 1);
}

# Allocates the arrays from the allocator a (a frame arena) and fills them, into out: out, or 0 when an allocation
# fails.
fn _sr_batch_alloc(b, a, out, u32) {
    var n = sr_batch_sprite_count(b, u32);
    var isz = 12;
    if (u32 == 1) { isz = 24; }
    var vb = 0;
    var ib = 0;
    if (n > 0) {
        vb = alloc_via(a, n * 128);
        ib = alloc_via(a, n * isz);
        if (vb == 0 || ib == 0) { return 0; }
    }
    _sr_batch_emit(b, n, vb, ib, u32);
    store64(out, vb);
    store64(out + 8, n * 4);
    store64(out + 16, ib);
    store64(out + 24, n * 6);
    return out;
}

# b's quads and u16 indices (up to SR_MAX_SPRITES_PER_BATCH sprites), allocated from a, into the SrQuadData out:
# out, or 0. Mirrors `batch_to_vertices`.
fn sr_batch_to_vertices(b, a, out) {
    return _sr_batch_alloc(b, a, out, 0);
}

# b's quads and u32 indices (every sprite), allocated from a, into out: out, or 0. Mirrors `batch_to_vertices_u32`.
fn sr_batch_to_vertices_u32(b, a, out) {
    return _sr_batch_alloc(b, a, out, 1);
}

# --- text.cyr ---

# text.cyr — Rust 1.2.0's src/text.rs (M2 part b): a fixed-width bitmap font atlas and text laid out as sprites.
#
# `SrBitmapFont` is eight words (texture_id; glyph_width, glyph_height, columns, atlas_width, atlas_height,
# glyph_count as u32; first_char as u8), filled by the caller as Rust's struct literal is. `SrTextBatch` wraps an
# `SrSpriteBatch` (its `batch`), freed by SrTextBatch_drop.
#
# **Text.** Rust takes a `&str` and walks its chars; here the text is a pointer and a byte length, decoded as UTF-8
# (src/mathx.cyr): a byte that begins no well-formed sequence counts as one character, U+FFFD, which a Rust string
# can't contain (ADR 0002 #21). Each character, at index i, is a sprite at x + i·char_w; a space is skipped but still
# advances i.
#
# **Precision (D4 rule a).** char_w = glyph_width as f32 · scale and each position are Rust's f32 sequence; the UVs
# come from SrUvRect_from_pixel_rect: class A rows (tests/golden/text.tsv).

struct SrBitmapFont { texture_id; glyph_width; glyph_height; columns; atlas_width; atlas_height; first_char;
    glyph_count; }
struct SrTextBatch { batch; }

# a · b as u32, saturating at u32::MAX (a, b < 2³²).
#must_use
fn _sr_u32_sat_mul(a, b): i64 {
    if (b != 0 && a > 0xFFFFFFFF / b) { return 0xFFFFFFFF; }
    return a * b;
}

# The UV rectangle of code point ch's glyph, into out: glyph (ch − first_char) when that is below glyph_count, else
# glyph 0; its cell (index % columns, index / columns) in glyph-sized pixels (saturating). The full texture when the
# atlas or its column count is 0. Mirrors `BitmapFont::glyph_uv`.
fn SrBitmapFont_glyph_uv(font, ch, out) {
    var cols = load64(font + 24) & 0xFFFFFFFF;
    var aw = load64(font + 32) & 0xFFFFFFFF;
    var ah = load64(font + 40) & 0xFFFFFFFF;
    if (aw == 0 || ah == 0 || cols == 0) { return SrUvRect_default(out); }
    var first = load64(font + 48) & 0xFF;
    var index = 0;
    if (ch >= first && ch - first < (load64(font + 56) & 0xFFFFFFFF)) { index = ch - first; }
    var gw = load64(font + 8) & 0xFFFFFFFF;
    var gh = load64(font + 16) & 0xFFFFFFFF;
    var x = _sr_u32_sat_mul(index % cols, gw);
    var y = _sr_u32_sat_mul(index / cols, gh);
    return SrUvRect_from_pixel_rect(x, y, gw, gh, aw, ah, out);
}

# An empty text batch with room for chars sprites: an SrTextBatch to free with SrTextBatch_drop, or 0. Mirrors
# `TextBatch::with_capacity`.
#must_use
fn SrTextBatch_with_capacity(chars): i64 {
    var tb = fl_alloc(sizeof(SrTextBatch));
    if (tb == 0) { return 0; }
    var b = SrSpriteBatch_with_capacity(chars);
    if (b == 0) {
        fl_free(tb);
        return 0;
    }
    store64(tb, b);
    return tb;
}

# An empty text batch, or 0. Mirrors `TextBatch::new`.
#must_use
fn SrTextBatch_new(): i64 {
    return SrTextBatch_with_capacity(0);
}

# An empty text batch, or 0. Mirrors `impl Default for TextBatch`.
#must_use
fn SrTextBatch_default(): i64 {
    return SrTextBatch_new();
}

# Frees tb and its sprites (0 is ignored).
fn SrTextBatch_drop(tb) {
    if (tb == 0) { return 0; }
    SrSpriteBatch_drop(load64(tb));
    fl_free(tb);
    return 0;
}

# (p + i·w) in native f32.
#must_use
fn _sr_f32_madd(p: f32, i: f32, w: f32): i64 {
    var r: f32 = p + (i * w);
    return r;
}

# Lays out the len bytes of UTF-8 text at (x, y), each glyph scale × its atlas size, tinted color, with z-order z: one
# sprite per character but spaces. 1, or 0 when an allocation fails (the sprites before it stay).
fn _sr_text_draw(tb, font, text, len, x, y, scale, color, z): i64 {
    var cw = _sr_f32_mul(_sr_i64_to_f32(load64(font + 8) & 0xFFFFFFFF), scale);
    var chh = _sr_f32_mul(_sr_i64_to_f32(load64(font + 16) & 0xFFFFFFFF), scale);
    var tex = load64(font);
    var s[_SR_SPRITE_SIZE];
    var uv[16];
    var cp[8];
    var at = 0;
    var i = 0;
    while (at < len) {
        at = at + _sr_utf8_next(text, len, at, &cp);
        var ch = load64(&cp);
        if (ch != 32) {
            SrBitmapFont_glyph_uv(font, ch, &uv);
            SrSprite_new(_sr_f32_madd(x, _sr_i64_to_f32(i), cw), y, cw, chh, &s);
            SrSprite_with_z_order(SrSprite_with_uv(SrSprite_with_texture(SrSprite_with_color(&s, color), tex), &uv), z);
            if (SrSpriteBatch_push(load64(tb), &s) == 0) { return 0; }
        }
        i = i + 1;
    }
    return 1;
}

# Adds the len bytes of UTF-8 text at (x, y) (f32 bits), scaled by scale and tinted color (an SrColor), z-order 0:
# 1, or 0 when an allocation fails. Mirrors `TextBatch::draw_text`.
fn SrTextBatch_draw_text(tb, font, text, len, x, y, scale, color): i64 {
    return _sr_text_draw(tb, font, text, len, x, y, scale, color, 0);
}

# As SrTextBatch_draw_text, at z-order z (an i32). Mirrors `TextBatch::draw_text_z`.
fn SrTextBatch_draw_text_z(tb, font, text, len, x, y, scale, color, z): i64 {
    return _sr_text_draw(tb, font, text, len, x, y, scale, color, z);
}

# Empties tb, keeping its capacity. Mirrors `TextBatch::clear`.
fn SrTextBatch_clear(tb) {
    SrSpriteBatch_clear(load64(tb));
    return tb;
}

# 1 when tb holds no glyph. Mirrors `TextBatch::is_empty`.
#must_use
fn SrTextBatch_is_empty(tb): i64 {
    return SrSpriteBatch_is_empty(load64(tb));
}

# The number of glyph sprites. Mirrors `TextBatch::len`.
#must_use
fn SrTextBatch_len(tb): i64 {
    return SrSpriteBatch_len(load64(tb));
}

# --- ui.cyr ---

# ui.cyr — Rust 1.2.0's src/ui.rs (M2 part b): screen-space panels and labels, batched as sprites.
#
# `SrUiPanel` (48 bytes: texture_id, z_order, then x, y, width, height as f32 at 16–28, color at 32) and `SrUiLabel`
# (52 bytes: text, text_len, z_order, then x, y, scale at 24–32, color at 36) are values the caller owns; builders set
# a field and return the value. A label **borrows** its text: Rust's `UiLabel` owns a `String`, here the label holds the
# caller's pointer and byte length, which must stay valid while the label is used (ADR 0002 #21). `SrUiBatch` holds a
# sprite batch of panels and a text batch, freed by SrUiBatch_drop.

struct SrUiPanel { texture_id; z_order; x: f32; y: f32; width: f32; height: f32; color: SrColor; }
struct SrUiLabel { text; text_len; z_order; x: f32; y: f32; scale: f32; color: SrColor; }
struct SrUiBatch { panels; text; }

# ── UiPanel ──────────────────────────────────────────────────────────────────────────

# A white, untextured panel at (x, y), width × height (f32 bits), z-order 0, into out. Mirrors `UiPanel::new`.
fn SrUiPanel_new(x, y, width, height, out) {
    store64(out, 0);
    store64(out + 8, 0);
    store32(out + 16, x);
    store32(out + 20, y);
    store32(out + 24, width);
    store32(out + 28, height);
    _sr_copy16(out + 32, SR_COLOR_WHITE);
    return out;
}

# Sets p's colour; returns p. Mirrors `UiPanel::with_color`.
fn SrUiPanel_with_color(p, color) {
    _sr_copy16(p + 32, color);
    return p;
}

# Sets p's texture id; returns p. Mirrors `UiPanel::with_texture`.
fn SrUiPanel_with_texture(p, id) {
    store64(p, id);
    return p;
}

# Sets p's z-order (an i32); returns p. Mirrors `UiPanel::with_z_order`.
fn SrUiPanel_with_z_order(p, z) {
    store64(p + 8, ((z & 0xFFFFFFFF) ^ 0x80000000) - 0x80000000);
    return p;
}

# ── UiLabel ──────────────────────────────────────────────────────────────────────────

# A label of the len bytes of UTF-8 text (borrowed) at (x, y), scale 1, white, z-order 0, into out. Mirrors
# `UiLabel::new`.
fn SrUiLabel_new(text, len, x, y, out) {
    store64(out, text);
    store64(out + 8, len);
    store64(out + 16, 0);
    store32(out + 24, x);
    store32(out + 28, y);
    store32(out + 32, 0x3F800000);
    _sr_copy16(out + 36, SR_COLOR_WHITE);
    return out;
}

# Sets l's scale (f32 bits); returns l. Mirrors `UiLabel::with_scale`.
fn SrUiLabel_with_scale(l, scale) {
    store32(l + 32, scale);
    return l;
}

# Sets l's colour; returns l. Mirrors `UiLabel::with_color`.
fn SrUiLabel_with_color(l, color) {
    _sr_copy16(l + 36, color);
    return l;
}

# Sets l's z-order (an i32); returns l. Mirrors `UiLabel::with_z_order`.
fn SrUiLabel_with_z_order(l, z) {
    store64(l + 16, ((z & 0xFFFFFFFF) ^ 0x80000000) - 0x80000000);
    return l;
}

# ── UiBatch ──────────────────────────────────────────────────────────────────────────

# An empty UI batch: an SrUiBatch to free with SrUiBatch_drop, or 0. Mirrors `UiBatch::new`.
#must_use
fn SrUiBatch_new(): i64 {
    var u = fl_alloc(sizeof(SrUiBatch));
    if (u == 0) { return 0; }
    var p = SrSpriteBatch_new();
    var t = SrTextBatch_new();
    if (p == 0 || t == 0) {
        SrSpriteBatch_drop(p);
        SrTextBatch_drop(t);
        fl_free(u);
        return 0;
    }
    store64(u, p);
    store64(u + 8, t);
    return u;
}

# An empty UI batch, or 0. Mirrors `impl Default for UiBatch`.
#must_use
fn SrUiBatch_default(): i64 {
    return SrUiBatch_new();
}

# Frees u and its batches (0 is ignored).
fn SrUiBatch_drop(u) {
    if (u == 0) { return 0; }
    SrSpriteBatch_drop(load64(u));
    SrTextBatch_drop(load64(u + 8));
    fl_free(u);
    return 0;
}

# Adds the panel at p as a sprite: 1, or 0 when an allocation fails. Mirrors `UiBatch::add_panel`.
fn SrUiBatch_add_panel(u, p): i64 {
    var s[_SR_SPRITE_SIZE];
    SrSprite_new(load32(p + 16), load32(p + 20), load32(p + 24), load32(p + 28), &s);
    SrSprite_with_z_order(SrSprite_with_texture(SrSprite_with_color(&s, p + 32), load64(p)), load64(p + 8));
    return SrSpriteBatch_push(load64(u), &s);
}

# Adds the label at l in font's glyphs: 1, or 0 when an allocation fails. Mirrors `UiBatch::add_label`.
fn SrUiBatch_add_label(u, font, l): i64 {
    return SrTextBatch_draw_text_z(load64(u + 8), font, load64(l), load64(l + 8), load32(l + 24), load32(l + 28),
      load32(l + 32), l + 36, load64(l + 16));
}

# Empties both batches. Mirrors `UiBatch::clear`.
fn SrUiBatch_clear(u) {
    SrSpriteBatch_clear(load64(u));
    SrTextBatch_clear(load64(u + 8));
    return u;
}

# 1 when u holds no panel and no glyph. Mirrors `UiBatch::is_empty`.
#must_use
fn SrUiBatch_is_empty(u): i64 {
    if (SrSpriteBatch_is_empty(load64(u)) == 1 && SrTextBatch_is_empty(load64(u + 8)) == 1) { return 1; }
    return 0;
}

# --- debug_geom.cyr ---

# debug_geom.cyr — the geometry half of Rust 1.2.0's src/debug_draw.rs (M2 part b): debug lines and wire shapes.
#
# `SrLineBatch` owns a growable array of `SrLineVertex` (28 bytes: position, color; src/layout.cyr) from the
# freelist, two per line, freed by SrLineBatch_drop; `clear` keeps the capacity, so a batch reused every frame
# allocates nothing (as SrSpriteBatch). Points are 3 f32 and colours SrColor, by pointer. The line pipeline that draws
# them is M6 (MB1). `collider` (Rust's `physics-debug` feature, impetus) is src/debug_collider.cyr, its own profile.
#
# **Precision (D4 rule a).** Every coordinate is Rust's f32 sequence: c + r·cos, the step τ / segments and the angle
# step · i in f32. The angles' sin and cos are correctly rounded (ganita's f32 tier) where Rust's are host glibc's, so
# rows where glibc misrounds are class C against tests/golden/debug.cr.tsv (ADR 0002 #16).

struct SrLineBatch { vertices; len; cap; }

# f32 bits of 0, 1, −1 and τ (`std::f32::consts::TAU`).
var _SR_D0 = 0;
var _SR_D1 = 0x3F800000;
var _SR_DM1 = 0xBF800000;
var _SR_DTAU = 0x40C90FDB;

# An empty batch with room for lines lines: an SrLineBatch to free with SrLineBatch_drop, or 0. Mirrors
# `LineBatch::with_capacity`.
#must_use
fn SrLineBatch_with_capacity(lines): i64 {
    var b = fl_calloc(sizeof(SrLineBatch));
    if (b == 0) { return 0; }
    if (lines > 0) {
        var p = fl_alloc(lines * 2 * 28);
        if (p == 0) {
            fl_free(b);
            return 0;
        }
        store64(b, p);
        store64(b + 16, lines * 2);
    }
    return b;
}

# An empty batch, or 0. Mirrors `LineBatch::new`.
#must_use
fn SrLineBatch_new(): i64 {
    return SrLineBatch_with_capacity(0);
}

# Frees b and its vertices (0 is ignored).
fn SrLineBatch_drop(b) {
    if (b == 0) { return 0; }
    if (load64(b) != 0) { fl_free(load64(b)); }
    fl_free(b);
    return 0;
}

# Makes room for 2 more vertices, doubling (from 8): 1, or 0 when the allocation fails.
fn _sr_line_room(b): i64 {
    var len = load64(b + 8);
    var cap = load64(b + 16);
    if (len + 2 <= cap) { return 1; }
    var ncap = cap * 2;
    if (ncap < 8) { ncap = 8; }
    var p = fl_alloc(ncap * 28);
    if (p == 0) { return 0; }
    var old = load64(b);
    var k = 0;
    while (k < len * 28) {
        store32(p + k, load32(old + k));
        k = k + 4;
    }
    if (old != 0) { fl_free(old); }
    store64(b, p);
    store64(b + 16, ncap);
    return 1;
}

# Writes one SrLineVertex (x, y, z, color) at v.
fn _sr_line_vertex(v, x, y, z, color) {
    store32(v, x);
    store32(v + 4, y);
    store32(v + 8, z);
    store64(v + 12, load64(color));
    store64(v + 20, load64(color + 8));
    return v;
}

# Appends the line (ax, ay, az) → (bx, by, bz) (f32 bits) in color: 1, or 0 when an allocation fails. The two vertices
# are written inline: one call per line, not four (port-parity §3.2).
fn _sr_line6(b, ax, ay, az, bx, by, bz, color): i64 {
    var len = load64(b + 8);
    if (len + 2 > load64(b + 16)) {
        if (_sr_line_room(b) == 0) { return 0; }
    }
    var v = load64(b) + len * 28;
    var c0 = load64(color);
    var c1 = load64(color + 8);
    store32(v, ax);
    store32(v + 4, ay);
    store32(v + 8, az);
    store64(v + 12, c0);
    store64(v + 20, c1);
    store32(v + 28, bx);
    store32(v + 32, by);
    store32(v + 36, bz);
    store64(v + 40, c0);
    store64(v + 48, c1);
    store64(b + 8, len + 2);
    return 1;
}

# Appends the line a → b (3 f32 each) in color: 1, or 0 when an allocation fails. Mirrors `LineBatch::line`.
fn SrLineBatch_line(b, pa, pb, color): i64 {
    return _sr_line6(b, load32(pa), load32(pa + 4), load32(pa + 8), load32(pb), load32(pb + 4), load32(pb + 8), color);
}

# Appends the 12 edges of the box min → max (bottom face, top face, then the verticals, as Rust orders them): 1, or 0.
# Mirrors `LineBatch::wire_box`.
fn SrLineBatch_wire_box(b, min, max, color): i64 {
    var x0 = load32(min);
    var y0 = load32(min + 4);
    var z0 = load32(min + 8);
    var x1 = load32(max);
    var y1 = load32(max + 4);
    var z1 = load32(max + 8);
    var ok = _sr_line6(b, x0, y0, z0, x1, y0, z0, color);
    ok = ok & _sr_line6(b, x1, y0, z0, x1, y0, z1, color);
    ok = ok & _sr_line6(b, x1, y0, z1, x0, y0, z1, color);
    ok = ok & _sr_line6(b, x0, y0, z1, x0, y0, z0, color);
    ok = ok & _sr_line6(b, x0, y1, z0, x1, y1, z0, color);
    ok = ok & _sr_line6(b, x1, y1, z0, x1, y1, z1, color);
    ok = ok & _sr_line6(b, x1, y1, z1, x0, y1, z1, color);
    ok = ok & _sr_line6(b, x0, y1, z1, x0, y1, z0, color);
    ok = ok & _sr_line6(b, x0, y0, z0, x0, y1, z0, color);
    ok = ok & _sr_line6(b, x1, y0, z0, x1, y1, z0, color);
    ok = ok & _sr_line6(b, x1, y0, z1, x1, y1, z1, color);
    ok = ok & _sr_line6(b, x0, y0, z1, x0, y1, z1, color);
    return ok;
}

# c + r·k in native f32.
#must_use
fn _sr_f32_cpr(c: f32, r: f32, k: f32): i64 {
    var v: f32 = c + (r * k);
    return v;
}

# τ / segments in native f32 (segments a u32, converted as Rust's `as f32`).
#must_use
fn _sr_circle_step(segments): i64 {
    return _sr_f32_div(_SR_DTAU, _sr_i64_to_f32(segments & 0xFFFFFFFF));
}

# The (sin, cos) table of the angles step · i, i = 0 … segments, for the last segment count used up to
# _SR_TRIG_MAX: a circle or sphere drawn again with the same count reuses it (the values are the ones it would
# compute). Not thread-safe: module state, as src/json.cyr's arena.
var _SR_TRIG_MAX = 256;
var _sr_trig_data: u8[4112];
var _sr_trig_n = 0 - 1;

# The angle step · i in native f32, and its correctly rounded sin and cos, into the 2 words at out (sin, cos).
fn _sr_circle_sc_compute(step, i, out) {
    var a = _sr_f32_mul(step, _sr_i64_to_f32(i));
    store64(out, ganita_f32_sin(a));
    store64(out + 8, ganita_f32_cos(a));
    return out;
}

# A pointer to the (sin, cos) pairs (2 words each) of the angles step · i for i = 0 … segments: the cached table when
# segments ≤ _SR_TRIG_MAX (filled now if it holds another count), else 0 (the caller computes each angle).
fn _sr_trig_table(segments, step): i64 {
    if (segments > _SR_TRIG_MAX) { return 0; }
    var t = &_sr_trig_data;
    if (_sr_trig_n != segments) {
        store64(t, 0);
        store64(t + 8, 0x3F800000);
        var i = 1;
        while (i <= segments) {
            _sr_circle_sc_compute(step, i, t + i * 16);
            i = i + 1;
        }
        _sr_trig_n = segments;
    }
    return t;
}

# The (sin, cos) of angle i into out, from the table tab when there is one.
fn _sr_circle_sc(tab, step, i, out) {
    if (tab != 0) {
        store64(out, load64(tab + i * 16));
        store64(out + 8, load64(tab + i * 16 + 8));
        return out;
    }
    return _sr_circle_sc_compute(step, i, out);
}

# The 8 values c + r·k a circle segment needs, in native f32, at out (8 words): x·pc, x·nc, y·pc, y·nc, y·ps, y·ns,
# z·ps, z·ns, where x, y, z are the centre's coordinates.
fn _sr_circle_pts(out, x: f32, y: f32, z: f32, r: f32, pc: f32, ps: f32, nc: f32, ns: f32) {
    var a: f32 = x + (r * pc);
    var b: f32 = x + (r * nc);
    var c: f32 = y + (r * pc);
    var d: f32 = y + (r * nc);
    var e: f32 = y + (r * ps);
    var f: f32 = y + (r * ns);
    var g: f32 = z + (r * ps);
    var h: f32 = z + (r * ns);
    store64(out, a);
    store64(out + 8, b);
    store64(out + 16, c);
    store64(out + 24, d);
    store64(out + 32, e);
    store64(out + 40, f);
    store64(out + 48, g);
    store64(out + 56, h);
    return out;
}

# Appends a circle of radius r about center in the XZ plane as segments lines, starting at angle 0: 1, or 0. Nothing
# when segments is 0. Mirrors `LineBatch::wire_circle`.
fn SrLineBatch_wire_circle(b, center, radius, segments, color): i64 {
    if ((segments & 0xFFFFFFFF) == 0) { return 1; }
    var c0 = load32(center);
    var c1 = load32(center + 4);
    var c2 = load32(center + 8);
    var n = segments & 0xFFFFFFFF;
    var step = _sr_circle_step(n);
    var tab = _sr_trig_table(n, step);
    var ps = _SR_D0;
    var pc = _SR_D1;
    var sc[16];
    var q[64];
    var ok = 1;
    var i = 1;
    while (i <= n) {
        _sr_circle_sc(tab, step, i, &sc);
        var ns = load64(&sc) & 0xFFFFFFFF;
        var nc = load64(&sc + 8) & 0xFFFFFFFF;
        _sr_circle_pts(&q, c0, c1, c2, radius, pc, ps, nc, ns);
        var ax = load64(&q) & 0xFFFFFFFF;
        var bx = load64(&q + 8) & 0xFFFFFFFF;
        var az = load64(&q + 48) & 0xFFFFFFFF;
        var bz = load64(&q + 56) & 0xFFFFFFFF;
        ok = ok & _sr_line6(b, ax, c1, az, bx, c1, bz, color);
        ps = ns;
        pc = nc;
        i = i + 1;
    }
    return ok;
}

# Appends three great circles of radius r about center (XZ, XY and YZ planes), segments lines each, interleaved per
# segment as Rust does: 1, or 0. Nothing when segments is 0. Mirrors `LineBatch::wire_sphere`.
fn SrLineBatch_wire_sphere(b, center, radius, segments, color): i64 {
    if ((segments & 0xFFFFFFFF) == 0) { return 1; }
    var c0 = load32(center);
    var c1 = load32(center + 4);
    var c2 = load32(center + 8);
    var n = segments & 0xFFFFFFFF;
    var step = _sr_circle_step(n);
    var tab = _sr_trig_table(n, step);
    var ps = _SR_D0;
    var pc = _SR_D1;
    var sc[16];
    var q[64];
    var ok = 1;
    var i = 1;
    while (i <= n) {
        _sr_circle_sc(tab, step, i, &sc);
        var ns = load64(&sc) & 0xFFFFFFFF;
        var nc = load64(&sc + 8) & 0xFFFFFFFF;
        _sr_circle_pts(&q, c0, c1, c2, radius, pc, ps, nc, ns);
        var xpc = load64(&q) & 0xFFFFFFFF;
        var xnc = load64(&q + 8) & 0xFFFFFFFF;
        var ypc = load64(&q + 16) & 0xFFFFFFFF;
        var ync = load64(&q + 24) & 0xFFFFFFFF;
        var yps = load64(&q + 32) & 0xFFFFFFFF;
        var yns = load64(&q + 40) & 0xFFFFFFFF;
        var zps = load64(&q + 48) & 0xFFFFFFFF;
        var zns = load64(&q + 56) & 0xFFFFFFFF;
        ok = ok & _sr_line6(b, xpc, c1, zps, xnc, c1, zns, color);
        ok = ok & _sr_line6(b, xpc, yps, c2, xnc, yns, c2, color);
        ok = ok & _sr_line6(b, c0, ypc, zps, c0, ync, zns, color);
        ps = ns;
        pc = nc;
        i = i + 1;
    }
    return ok;
}

# ceil(x) for an f32 x, as f32 bits (NaN and ±∞ unchanged; −0 kept).
#must_use
fn _sr_ceil32(x): i64 {
    var b = x & 0xFFFFFFFF;
    if ((b & 0x7FFFFFFF) >= 0x4B000000) { return b; }
    var v: f64 = f32_to(b);
    var nv: f64 = 0.0 - v;
    var fl: f64 = f64_floor(nv);
    var r: f64 = 0.0 - fl;
    return f32_from(r) | (b & 0x80000000);
}

# x as i32, as Rust's saturating `as`: NaN → 0, beyond the range → i32::MIN / MAX, else truncated.
#must_use
fn _sr_f32_to_i32(x): i64 {
    if (_sr_f32_is_nan(x) == 1) { return 0; }
    var v: f64 = f32_to(x & 0xFFFFFFFF);
    var top: f64 = 2147483647.0;
    var bottom: f64 = 0.0 - 2147483648.0;
    if (v >= top) { return 2147483647; }
    if (v <= bottom) { return 0 - 2147483648; }
    return f64_to(v);
}

# 1 when the f32 x ≤ 0 (0 for NaN).
#must_use
fn _sr_f32_le0(x): i64 {
    return _sr_f32_le(x, 0);
}

# Appends a grid on the XZ plane (y = 0) from −half_extent to half_extent, a line along Z and one along X at each
# multiple of spacing, i·spacing for i in −count … count, count = ceil(half_extent / spacing) as i32: 1, or 0. Nothing
# when spacing ≤ 0 or half_extent ≤ 0 (a NaN passes, as in Rust: count 0). Mirrors `LineBatch::grid`.
fn SrLineBatch_grid(b, half_extent, spacing, color): i64 {
    if (_sr_f32_le0(spacing) == 1 || _sr_f32_le0(half_extent) == 1) { return 1; }
    var count = _sr_f32_to_i32(_sr_ceil32(_sr_f32_div(half_extent, spacing)));
    var nh = half_extent ^ 0x80000000;
    var ok = 1;
    var i = 0 - count;
    while (i <= count) {
        var pos = _sr_f32_mul(_sr_i64_to_f32(i), spacing);
        ok = ok & _sr_line6(b, pos, _SR_D0, nh, pos, _SR_D0, half_extent, color);
        ok = ok & _sr_line6(b, nh, _SR_D0, pos, half_extent, _SR_D0, pos, color);
        i = i + 1;
    }
    return ok;
}

# p − q in native f32.
#must_use
fn _sr_f32_sub(p: f32, q: f32): i64 {
    var r: f32 = p - q;
    return r;
}

# Appends a capsule about center: circles at ± half_height (XZ plane), and four vertical lines at (±r, 0) and
# (0, ±r): 1, or 0. Mirrors `LineBatch::wire_capsule`.
fn SrLineBatch_wire_capsule(b, center, half_height, radius, segments, color): i64 {
    var top[12];
    var bot[12];
    store32(&top, load32(center));
    store32(&top + 4, _sr_f32_add(load32(center + 4), half_height));
    store32(&top + 8, load32(center + 8));
    store32(&bot, load32(center));
    store32(&bot + 4, _sr_f32_sub(load32(center + 4), half_height));
    store32(&bot + 8, load32(center + 8));
    var ok = SrLineBatch_wire_circle(b, &top, radius, segments, color);
    ok = ok & SrLineBatch_wire_circle(b, &bot, radius, segments, color);
    var dirs[64];
    store64(&dirs, _SR_D1);
    store64(&dirs + 8, _SR_D0);
    store64(&dirs + 16, _SR_DM1);
    store64(&dirs + 24, _SR_D0);
    store64(&dirs + 32, _SR_D0);
    store64(&dirs + 40, _SR_D1);
    store64(&dirs + 48, _SR_D0);
    store64(&dirs + 56, _SR_DM1);
    var k = 0;
    while (k < 4) {
        var dx = load64(&dirs + k * 16);
        var dz = load64(&dirs + k * 16 + 8);
        var tx = _sr_f32_cpr(load32(&top), radius, dx);
        var tz = _sr_f32_cpr(load32(&top + 8), radius, dz);
        var bx2 = _sr_f32_cpr(load32(&bot), radius, dx);
        var bz2 = _sr_f32_cpr(load32(&bot + 8), radius, dz);
        ok = ok & _sr_line6(b, tx, load32(&top + 4), tz, bx2, load32(&bot + 4), bz2, color);
        k = k + 1;
    }
    return ok;
}

# Empties b, keeping its capacity. Mirrors `LineBatch::clear`.
fn SrLineBatch_clear(b) {
    store64(b + 8, 0);
    return b;
}

# The number of lines (vertices / 2). Mirrors `LineBatch::line_count`.
#must_use
fn SrLineBatch_line_count(b): i64 {
    return load64(b + 8) / 2;
}

# 1 when b holds no vertex. Mirrors `LineBatch::is_empty`.
#must_use
fn SrLineBatch_is_empty(b): i64 {
    if (load64(b + 8) == 0) { return 1; }
    return 0;
}

# The number of vertices (2 per line) at b's `vertices`.
#must_use
fn SrLineBatch_vertex_count(b): i64 {
    return load64(b + 8);
}

# --- viz.cyr ---

# viz.cyr — Rust 1.2.0's src/viz.rs (M3 part a): the helpers soorat's science visualizations share (M5), and the
# lattice the sphere uses.
#
# Rust keeps the module crate-private (its items are `pub` only for the oracle hooks); here its names are soorat's
# own, `sr_` like the rest. Rust's closures (`color_at(ix, iz)`, `height(ix, iz)`) are a function and a context
# pointer, called through `fncall` (`&fn` gives the address): `color_fn(ctx, ix, iz, out)` writes 4 f32 at out,
# `height_fn(ctx, ix, iz)` returns f32 bits, a height field's `color_fn(ctx, ix, iz, y, out)` also gets the height. A
# mesh is written into an `SrMeshData` from the caller's allocator (`alloc_via`, a frame arena: ADR 0002 #6).
#
# **Precision (D4 rule b, ADR 0002 #4).** Positions, normals and texture coordinates are GPU geometry: each output is
# Rust's formula evaluated in f64 from its f32 inputs and rounded once, class E against `<module>.e.tsv` where that
# differs from Rust's f32 sequence. A struct's f32 fields (a grid's `dx`) are inputs, as they are in Rust. The
# normalizations (`unit_t` and the rest) are f64 already and narrow once, as Rust does: class A.

# A mesh: vertex_count SrVertex3D (48 bytes each) at vertices, index_count u32 at indices, and its glTF material's
# index, or SR_MATERIAL_NONE (Rust's `material_index: Option<usize>`). Mirrors `MeshData` (src/gltf_loader.rs).
struct SrMeshData { vertices; vertex_count; indices; index_count; material_index; }
# No material (Rust's `None`): usize::MAX, which no glTF material index reaches. Every mesh built here has none.
var SR_MATERIAL_NONE = 0 - 1;
struct SrXzGrid { nx; nz; origin_x: f32; origin_z: f32; y: f32; dx: f32; dz: f32; }
struct SrHeightField { cols; rows; origin_x: f32; origin_z: f32; dx: f32; dz: f32; }

# The most quads a u32-indexed heatmap holds (u32::MAX / 4). Mirrors `MAX_QUADS`.
var SR_MAX_QUADS = 1073741823;
# The cap on a visualization's tessellation. Mirrors `MAX_SEGMENTS`.
var SR_MAX_SEGMENTS = 1024;

# A quad's two triangles on the XZ plane, counter-clockwise about +Y: a pointer to 6 u32. Mirrors `XZ_QUAD_INDICES`.
var _sr_xz_quad_data: u8[24];
var SR_XZ_QUAD_INDICES = &_sr_xz_quad_data;

fn _sr_xz_quad_init(): i64 {
    store32(SR_XZ_QUAD_INDICES, 0);
    store32(SR_XZ_QUAD_INDICES + 4, 3);
    store32(SR_XZ_QUAD_INDICES + 8, 2);
    store32(SR_XZ_QUAD_INDICES + 12, 0);
    store32(SR_XZ_QUAD_INDICES + 16, 2);
    store32(SR_XZ_QUAD_INDICES + 20, 1);
    return 1;
}
var _sr_xz_quad_ready = _sr_xz_quad_init();

# f32::EPSILON and f64::EPSILON, widened / as bits.
var _SR_VIZ_EPS32: f64 = f32_to(0x34000000);
var _SR_VIZ_EPS64: f64 = 0.0000000000000002220446049250313;

# ── sizes and ranges ─────────────────────────────────────────────────────────────────

# The product of the n dimensions at dims (8-byte words): Some(product), or None when it overflows (Rust's usize is
# u64; this one stops at i64::MAX, which no allocation reaches). Mirrors `grid_len`.
#must_use
fn sr_grid_len(dims, n): Option {
    var acc = 1;
    var i = 0;
    while (i < n) {
        var d = load64(dims + i * 8);
        if (d < 0) { return None(); }
        if (d != 0 && acc > 9223372036854775807 / d) { return None(); }
        acc = acc * d;
        i = i + 1;
    }
    return Some(acc);
}

# 1 when a grid of the n dimensions at dims is non-empty and its data (data_len values) covers it; 0 otherwise,
# warning (soorat::viz) when the data is short or the size overflows. what names the grid in Rust's event. Mirrors
# `grid_is_backed`.
#must_use
fn sr_grid_is_backed(dims, n, data_len, what): i64 {
    var t, v = sr_grid_len(dims, n);
    if (is_none(t) == 1) {
        _sr_warn("soorat::viz: visualization grid size overflows — skipping");
        return 0;
    }
    if (v == 0) { return 0; }
    if (v <= data_len) { return 1; }
    _sr_warn("soorat::viz: visualization grid larger than its data — skipping");
    return 0;
}

# 1 when the f64 x is finite.
#must_use
fn _sr_f64_finite(x: f64): i64 {
    var d: f64 = x - x;
    var zero: f64 = 0.0;
    if (d == zero) { return 1; }
    return 0;
}

# The smallest and largest finite values of the n f64 at values: Some(out) with (min, max) at out, or None when
# none is finite; as Rust's `f64::min` / `max` fold, a tie (+0 against −0) takes the later value. Mirrors
# `finite_min_max`.
fn sr_finite_min_max(values, n, out): Option {
    var found = 0;
    var lo: f64 = 0.0;
    var hi: f64 = 0.0;
    var i = 0;
    while (i < n) {
        var v: f64 = load64(values + i * 8);
        if (_sr_f64_finite(v) == 1) {
            if (found == 0) {
                lo = v;
                hi = v;
                found = 1;
            } else {
                # Rust's `lo.min(v)` / `hi.max(v)`: equal operands (±0 included) give v.
                if (v <= lo) { lo = v; }
                if (v >= hi) { hi = v; }
            }
        }
        i = i + 1;
    }
    if (found == 0) { return None(); }
    store64(out, lo);
    store64(out + 8, hi);
    return Some(out);
}

# x narrowed to f32 and clamped to [lo, hi] (f32 bits), as Rust's `(x as f32).clamp(lo, hi)`.
#must_use
fn _sr_narrow_clamp(x: f64, lo, hi): i64 {
    return _sr_clamp32(f32_from(x), lo, hi);
}

# max(|min|, |max|), ignoring a NaN operand as Rust's `f64::max` does.
#must_use
fn _sr_abs_scale(mn: f64, mx: f64): f64 {
    var a: f64 = _sr_abs64(mn);
    var b: f64 = _sr_abs64(mx);
    var r: f64 = _sr_max64(a, b);
    return r;
}

# v's place in [min, max] as f32 bits in [0, 1]; 0 for a non-finite v or a range that is NaN or ≤ f64::EPSILON.
# The arguments are f64 bits. Mirrors `unit_t`.
#must_use
fn sr_unit_t(v: f64, mn: f64, mx: f64): i64 {
    var range: f64 = mx - mn;
    if (_sr_f64_finite(v) == 0 || range != range || range <= _SR_VIZ_EPS64) { return 0; }
    var q: f64 = (v - mn) / range;
    return _sr_narrow_clamp(q, 0, 0x3F800000);
}

# v / max(|min|, |max|) as f32 bits in [−1, 1]; 0 for a non-finite v or a scale that is NaN or ≤ f64::EPSILON.
# Mirrors `signed_t`.
#must_use
fn sr_signed_t(v: f64, mn: f64, mx: f64): i64 {
    var scale: f64 = _sr_abs_scale(mn, mx);
    if (_sr_f64_finite(v) == 0 || scale != scale || scale <= _SR_VIZ_EPS64) { return 0; }
    var q: f64 = v / scale;
    return _sr_narrow_clamp(q, 0xBF800000, 0x3F800000);
}

# |v| / max(|min|, |max|) as f32 bits in [0, 1]; 0 as sr_signed_t. Mirrors `magnitude_t`.
#must_use
fn sr_magnitude_t(v: f64, mn: f64, mx: f64): i64 {
    var scale: f64 = _sr_abs_scale(mn, mx);
    if (_sr_f64_finite(v) == 0 || scale != scale || scale <= _SR_VIZ_EPS64) { return 0; }
    var av: f64 = _sr_abs64(v);
    var q: f64 = av / scale;
    return _sr_narrow_clamp(q, 0, 0x3F800000);
}

# The heat-map colour of t with its alpha replaced by alpha (f32 bits), as 4 f32 at out. Mirrors `heat_rgba`.
fn sr_heat_rgba(t, alpha, out) {
    sr_visualization_heat_map(t, out);
    store32(out + 12, alpha);
    return out;
}

# The signed colour of t with alpha alpha, as 4 f32 at out. Mirrors `signed_rgba`.
fn sr_signed_rgba(t, alpha, out) {
    sr_signed_value_color(t, out);
    store32(out + 12, alpha);
    return out;
}

# base's r, g, b with alpha clamped to [0, 1] (0 when not finite), as 4 f32 at out. Mirrors `with_alpha`.
fn sr_with_alpha(base, alpha, out) {
    var a = 0;
    if ((alpha & 0x7F800000) != 0x7F800000) { a = _sr_clamp32(alpha, 0, 0x3F800000); }
    store32(out, load32(base));
    store32(out + 4, load32(base + 4));
    store32(out + 8, load32(base + 8));
    store32(out + 12, a);
    return out;
}

# ── meshes ───────────────────────────────────────────────────────────────────────────

# Rounds (x, y, z) once to f32 and stores them at p.
fn _sr_put3(p, x: f64, y: f64, z: f64) {
    store32(p, f32_from(x));
    store32(p + 4, f32_from(y));
    store32(p + 8, f32_from(z));
    return p;
}

# Rounds (u, w) once to f32 and stores them at p.
fn _sr_put2(p, u: f64, w: f64) {
    store32(p, f32_from(u));
    store32(p + 4, f32_from(w));
    return p;
}

# Fills out (an SrMeshData) with an empty mesh; returns out.
fn _sr_mesh_empty(out) {
    store64(out, 0);
    store64(out + 8, 0);
    store64(out + 16, 0);
    store64(out + 24, 0);
    store64(out + 32, SR_MATERIAL_NONE);
    return out;
}

# Allocates nv vertices and ni indices from a into out: 1, or 0 when an allocation fails (out empty).
fn _sr_mesh_alloc(a, out, nv, ni): i64 {
    _sr_mesh_empty(out);
    var vb = 0;
    var ib = 0;
    if (nv > 0) { vb = alloc_via(a, nv * 48); }
    if (ni > 0) { ib = alloc_via(a, ni * 4); }
    if ((nv > 0 && vb == 0) || (ni > 0 && ib == 0)) { return 0; }
    store64(out, vb);
    store64(out + 8, nv);
    store64(out + 16, ib);
    store64(out + 24, ni);
    return 1;
}

# A colour-per-cell heatmap on the XZ plane at height y: one quad of 4 vertices (normal +Y) per cell, (ix, iz) at
# (origin + i·d … origin + (i + 1)·d), UVs i / n, coloured by color_fn(ctx, ix, iz, out). Empty when the grid is
# empty or has more than SR_MAX_QUADS cells (warning). Into out (an SrMeshData) from the allocator a: out, or 0.
# Mirrors `xz_heatmap_mesh`.
fn sr_xz_heatmap_mesh(grid, color_fn, ctx, a, out) {
    var nx = load64(grid);
    var nz = load64(grid + 8);
    if (nx <= 0 || nz <= 0 || nx > 9223372036854775807 / nz) { return _sr_mesh_empty(out); }
    var cells = nx * nz;
    if (cells > SR_MAX_QUADS) {
        _sr_warn("soorat::viz: heatmap exceeds u32 index range — skipping");
        return _sr_mesh_empty(out);
    }
    if (_sr_mesh_alloc(a, out, cells * 4, cells * 6) == 0) { return 0; }
    var vb = load64(out);
    var ib = load64(out + 16);
    var ox: f64 = f32_to(load32(grid + 16));
    var oz: f64 = f32_to(load32(grid + 20));
    var gy: f64 = f32_to(load32(grid + 24));
    var dx: f64 = f32_to(load32(grid + 28));
    var dz: f64 = f32_to(load32(grid + 32));
    var one: f64 = 1.0;
    var inx: f64 = one / f64_from(nx);
    var inz: f64 = one / f64_from(nz);
    var color[16];
    var k = 0;
    var iz = 0;
    while (iz < nz) {
        var fz: f64 = f64_from(iz);
        var z0: f64 = oz + (fz * dz);
        var z1: f64 = z0 + dz;
        var v0: f64 = fz * inz;
        var fz1: f64 = f64_from(iz + 1);
        var v1: f64 = fz1 * inz;
        var ix = 0;
        while (ix < nx) {
            fncall4(color_fn, ctx, ix, iz, &color);
            var fx: f64 = f64_from(ix);
            var x0: f64 = ox + (fx * dx);
            var x1: f64 = x0 + dx;
            var u0: f64 = fx * inx;
            var fx1: f64 = f64_from(ix + 1);
            var u1: f64 = fx1 * inx;
            var v = vb + k * 192;
            _sr_put3(v, x0, gy, z0);
            _sr_put2(v + 24, u0, v0);
            _sr_put3(v + 48, x1, gy, z0);
            _sr_put2(v + 72, u1, v0);
            _sr_put3(v + 96, x1, gy, z1);
            _sr_put2(v + 120, u1, v1);
            _sr_put3(v + 144, x0, gy, z1);
            _sr_put2(v + 168, u0, v1);
            var j = 0;
            while (j < 4) {
                var q = v + j * 48;
                store32(q + 12, 0);
                store32(q + 16, 0x3F800000);
                store32(q + 20, 0);
                store64(q + 32, load64(&color));
                store64(q + 40, load64(&color + 8));
                j = j + 1;
            }
            var base = k * 4;
            var m = 0;
            while (m < 6) {
                store32(ib + (k * 6 + m) * 4, base + load32(SR_XZ_QUAD_INDICES + m * 4));
                m = m + 1;
            }
            k = k + 1;
            ix = ix + 1;
        }
        iz = iz + 1;
    }
    return out;
}

# The negated slope across sample i of a row or column (stride apart, n samples) of the f32 heights at h, by central
# difference (one-sided at the ends), in f64: (h[lo] − h[hi]) / ((hi − lo)·step), 0 when that span is NaN or within
# f32::EPSILON of 0.
#must_use
fn _sr_neg_slope(h, i, stride, n, step: f64): f64 {
    var lo = i - 1;
    if (lo < 0) { lo = 0; }
    var hi = i + 1;
    if (hi > n - 1) { hi = n - 1; }
    var span: f64 = f64_from(hi - lo) * step;
    var zero: f64 = 0.0;
    var as: f64 = _sr_abs64(span);
    if (span != span || as <= _SR_VIZ_EPS32) { return zero; }
    var a: f64 = f32_to(load32(h + lo * stride * 4));
    var b: f64 = f32_to(load32(h + hi * stride * 4));
    var r: f64 = (a - b) / span;
    return r;
}

# A height-field mesh: a vertex per sample (cols × rows), at (origin_x + ix·dx, height, origin_z + iz·dz), its normal
# from the central-difference slopes, UVs ix / (cols − 1), coloured by color_fn(cctx, ix, iz, y, out); heights from
# height_fn(hctx, ix, iz), a non-finite one read as 0. Two triangles per cell, counter-clockwise about +Y. Empty
# for 0 samples or more than u32::MAX (warning). Into out from the allocator a: out, or 0. Mirrors
# `heightfield_mesh`.
fn sr_heightfield_mesh(hf, height_fn, hctx, color_fn, cctx, a, out) {
    var cols = load64(hf);
    var rows = load64(hf + 8);
    if (cols <= 0 || rows <= 0 || cols > 9223372036854775807 / rows) { return _sr_mesh_empty(out); }
    var count = cols * rows;
    if (count > 4294967295) {
        _sr_warn("soorat::viz: height field exceeds u32 index range — skipping");
        return _sr_mesh_empty(out);
    }
    var quads = (cols - 1) * (rows - 1);
    var hs = alloc_via(a, count * 4);
    if (hs == 0) { return 0; }
    if (_sr_mesh_alloc(a, out, count, quads * 6) == 0) { return 0; }
    var vb = load64(out);
    var ib = load64(out + 16);
    var iz = 0;
    while (iz < rows) {
        var ix = 0;
        while (ix < cols) {
            var h = fncall3(height_fn, hctx, ix, iz) & 0xFFFFFFFF;
            if ((h & 0x7F800000) == 0x7F800000) { h = 0; }
            store32(hs + (iz * cols + ix) * 4, h);
            ix = ix + 1;
        }
        iz = iz + 1;
    }
    var one: f64 = 1.0;
    var cu = cols - 1;
    if (cu < 1) { cu = 1; }
    var cv = rows - 1;
    if (cv < 1) { cv = 1; }
    var inv_u: f64 = one / f64_from(cu);
    var inv_v: f64 = one / f64_from(cv);
    var ox: f64 = f32_to(load32(hf + 16));
    var oz: f64 = f32_to(load32(hf + 20));
    var dx: f64 = f32_to(load32(hf + 24));
    var dz: f64 = f32_to(load32(hf + 28));
    iz = 0;
    while (iz < rows) {
        var row = hs + iz * cols * 4;
        var ix2 = 0;
        while (ix2 < cols) {
            var yb = load32(row + ix2 * 4);
            var y: f64 = f32_to(yb);
            var sx: f64 = _sr_neg_slope(row, ix2, 1, cols, dx);
            var sz: f64 = _sr_neg_slope(hs + ix2 * 4, iz, cols, rows, dz);
            var len: f64 = f64_sqrt(((sx * sx) + one) + (sz * sz));
            var fx: f64 = f64_from(ix2);
            var fz: f64 = f64_from(iz);
            var v = vb + (iz * cols + ix2) * 48;
            _sr_put3(v, ox + (fx * dx), y, oz + (fz * dz));
            _sr_put3(v + 12, sx / len, one / len, sz / len);
            _sr_put2(v + 24, fx * inv_u, fz * inv_v);
            fncall5(color_fn, cctx, ix2, iz, yb, v + 32);
            ix2 = ix2 + 1;
        }
        iz = iz + 1;
    }
    var k = 0;
    var r = 0;
    while (r < rows - 1) {
        var c = 0;
        while (c < cols - 1) {
            var tl = r * cols + c;
            var p = ib + k * 24;
            store32(p, tl);
            store32(p + 4, tl + cols);
            store32(p + 8, tl + 1);
            store32(p + 12, tl + 1);
            store32(p + 16, tl + cols);
            store32(p + 20, tl + cols + 1);
            k = k + 1;
            c = c + 1;
        }
        r = r + 1;
    }
    return out;
}

# The triangle indices of a (rows + 1) × (cols + 1) vertex lattice, two per cell, (tl, tr, bl) and (tr, br, bl):
# rows · cols · 6 u32 allocated from a, or 0 (also for an empty lattice). Mirrors `lattice_indices`.
fn sr_lattice_indices(rows, cols, a): i64 {
    var n = rows * cols * 6;
    if (n <= 0) { return 0; }
    var ib = alloc_via(a, n * 4);
    if (ib == 0) { return 0; }
    _sr_lattice_into(rows, cols, ib);
    return ib;
}

# Writes the lattice indices of sr_lattice_indices at ib.
fn _sr_lattice_into(rows, cols, ib) {
    var stride = cols + 1;
    var k = 0;
    var r = 0;
    while (r < rows) {
        var c = 0;
        while (c < cols) {
            var tl = r * stride + c;
            var p = ib + k * 24;
            store32(p, tl);
            store32(p + 4, tl + 1);
            store32(p + 8, tl + stride);
            store32(p + 12, tl + 1);
            store32(p + 16, tl + stride + 1);
            store32(p + 20, tl + stride);
            k = k + 1;
            c = c + 1;
        }
        r = r + 1;
    }
    return ib;
}

# --- primitives.cyr ---

# primitives.cyr — Rust 1.2.0's src/primitives.rs (M3 part a): unit cube, UV sphere, plane and cylinder meshes.
#
# Each writes an `SrMeshData` (src/viz.cyr) from the caller's allocator a: out, or 0 when an allocation fails.
# Vertices are SrVertex3D (48 bytes), white; triangles wind counter-clockwise seen from outside, as Rust's do.
#
# **Precision (D4 rule b; plan §6.2, tessellation).** The sphere's, cylinder's and plane's vertices are Rust's
# formulas evaluated in f64 and rounded once: the angle step · i and its sin and cos are f64, where Rust rounds the
# angle to f32 before its f32 sin/cos. Rust's f32 constants (`PI`, `TAU`) are widened exactly, so the formula is
# Rust's. Class E against tests/golden/primitives.e.tsv where that differs from Rust's f32 result. The cube is
# constants: class A.

var _SR_PI32: f64 = f32_to(0x40490FDB);     # std::f32::consts::PI
var _SR_TAU32: f64 = f32_to(0x40C90FDB);    # std::f32::consts::TAU

# White, as an SrVertex3D's color (two words).
var _SR_WHITE_LO = 0x3F8000003F800000;
var _SR_WHITE_HI = 0x3F8000003F800000;

# Writes one vertex's colour (white) at the vertex v.
fn _sr_v3d_white(v) {
    store64(v + 32, _SR_WHITE_LO);
    store64(v + 40, _SR_WHITE_HI);
    return v;
}

# Writes a vertex of f32 bits: position (px, py, pz), normal (nx, ny, nz), UV (u, w), white.
fn _sr_v3d_bits(v, px, py, pz, nx, ny, nz, u, w) {
    store32(v, px);
    store32(v + 4, py);
    store32(v + 8, pz);
    store32(v + 12, nx);
    store32(v + 16, ny);
    store32(v + 20, nz);
    store32(v + 24, u);
    store32(v + 28, w);
    return _sr_v3d_white(v);
}

# ── cube ─────────────────────────────────────────────────────────────────────────────

# f32 bits of 0, ±0.5 and ±1.
var _SR_P0 = 0;
var _SR_PH = 0x3F000000;
var _SR_NH = 0xBF000000;
var _SR_P1 = 0x3F800000;
var _SR_N1 = 0xBF800000;

# One cube face: normal (nx, ny, nz) and corners ca … cd, each an (x, y, z) of ±0.5 given as sign bits (bit 2 x,
# bit 1 y, bit 0 z: 1 is +0.5), UVs (0, 1), (1, 1), (1, 0), (0, 0); indices base + 0 1 2 2 3 0.
fn _sr_cube_face(vb, ib, f, nx, ny, nz, ca, cb, cc, cd) {
    var corners[32];
    store64(&corners, ca);
    store64(&corners + 8, cb);
    store64(&corners + 16, cc);
    store64(&corners + 24, cd);
    var uvs[64];
    store64(&uvs, _SR_P0);
    store64(&uvs + 8, _SR_P1);
    store64(&uvs + 16, _SR_P1);
    store64(&uvs + 24, _SR_P1);
    store64(&uvs + 32, _SR_P1);
    store64(&uvs + 40, _SR_P0);
    store64(&uvs + 48, _SR_P0);
    store64(&uvs + 56, _SR_P0);
    var j = 0;
    while (j < 4) {
        var c = load64(&corners + j * 8);
        var x = _SR_NH;
        var y = _SR_NH;
        var z = _SR_NH;
        if ((c & 4) != 0) { x = _SR_PH; }
        if ((c & 2) != 0) { y = _SR_PH; }
        if ((c & 1) != 0) { z = _SR_PH; }
        _sr_v3d_bits(vb + (f * 4 + j) * 48, x, y, z, nx, ny, nz, load64(&uvs + j * 16), load64(&uvs + j * 16 + 8));
        j = j + 1;
    }
    var base = f * 4;
    var p = ib + f * 24;
    store32(p, base);
    store32(p + 4, base + 1);
    store32(p + 8, base + 2);
    store32(p + 12, base + 2);
    store32(p + 16, base + 3);
    store32(p + 20, base);
    return 0;
}

# The unit cube centred at the origin: 6 faces of 4 vertices (24) with their own normals, 36 indices. Mirrors `cube`.
fn sr_cube(a, out) {
    if (_sr_mesh_alloc(a, out, 24, 36) == 0) { return 0; }
    var vb = load64(out);
    var ib = load64(out + 16);
    # +Z, −Z, +X, −X, +Y, −Y, corners as (x, y, z) sign bits in Rust's order.
    _sr_cube_face(vb, ib, 0, _SR_P0, _SR_P0, _SR_P1, 1, 5, 7, 3);
    _sr_cube_face(vb, ib, 1, _SR_P0, _SR_P0, _SR_N1, 4, 0, 2, 6);
    _sr_cube_face(vb, ib, 2, _SR_P1, _SR_P0, _SR_P0, 5, 4, 6, 7);
    _sr_cube_face(vb, ib, 3, _SR_N1, _SR_P0, _SR_P0, 0, 1, 3, 2);
    _sr_cube_face(vb, ib, 4, _SR_P0, _SR_P1, _SR_P0, 3, 7, 6, 2);
    _sr_cube_face(vb, ib, 5, _SR_P0, _SR_N1, _SR_P0, 0, 4, 5, 1);
    return out;
}

# ── sphere ───────────────────────────────────────────────────────────────────────────

# A UV sphere of radius 0.5: (rings + 1) × (segments + 1) vertices, ring y at φ = (y / rings)·π, column x at
# θ = (x / segments)·τ, normal (sin φ cos θ, cos φ, sin φ sin θ), UV (x / segments, y / rings); the lattice's
# triangles (sr_lattice_indices). segments is at least 3 and rings at least 2. Each column's cos θ and sin θ are
# computed once, into 16·(segments + 1) bytes of scratch from a, not once per ring. Mirrors `sphere`.
fn sr_sphere(segments, rings, a, out) {
    var seg = segments & 0xFFFFFFFF;
    var rng = rings & 0xFFFFFFFF;
    if (seg < 3) { seg = 3; }
    if (rng < 2) { rng = 2; }
    var trig = alloc_via(a, (seg + 1) * 16);
    if (trig == 0) { return 0; }
    if (_sr_mesh_alloc(a, out, (rng + 1) * (seg + 1), rng * seg * 6) == 0) { return 0; }
    var vb = load64(out);
    var half: f64 = 0.5;
    var fseg: f64 = f64_from(seg);
    var frng: f64 = f64_from(rng);
    var k = 0;
    while (k <= seg) {
        var fk: f64 = f64_from(k);
        var tk: f64 = (fk / fseg) * _SR_TAU32;
        store64(trig + k * 16, f64_cos(tk));
        store64(trig + k * 16 + 8, f64_sin(tk));
        k = k + 1;
    }
    k = 0;
    var y = 0;
    while (y <= rng) {
        var fy: f64 = f64_from(y);
        var vv: f64 = fy / frng;
        var phi: f64 = vv * _SR_PI32;
        var sp: f64 = f64_sin(phi);
        var cp: f64 = f64_cos(phi);
        var x = 0;
        while (x <= seg) {
            var fx: f64 = f64_from(x);
            var u: f64 = fx / fseg;
            var ct: f64 = load64(trig + x * 16);
            var st: f64 = load64(trig + x * 16 + 8);
            var nx: f64 = sp * ct;
            var nz: f64 = sp * st;
            var v = vb + k * 48;
            _sr_put3(v, nx * half, cp * half, nz * half);
            _sr_put3(v + 12, nx, cp, nz);
            _sr_put2(v + 24, u, vv);
            _sr_v3d_white(v);
            k = k + 1;
            x = x + 1;
        }
        y = y + 1;
    }
    _sr_lattice_into(rng, seg, load64(out + 16));
    return out;
}

# ── plane ────────────────────────────────────────────────────────────────────────────

# A unit plane on XZ centred at the origin, normal +Y: (n + 1)² vertices at (x / n − 0.5, 0, z / n − 0.5), UV
# (x / n, z / n), two triangles per cell (tl, bl, tr), (tr, bl, br); n = subdivisions, at least 1. Mirrors `plane`.
fn sr_plane(subdivisions, a, out) {
    var divs = subdivisions & 0xFFFFFFFF;
    if (divs < 1) { divs = 1; }
    var cols = divs + 1;
    if (_sr_mesh_alloc(a, out, cols * cols, divs * divs * 6) == 0) { return 0; }
    var vb = load64(out);
    var ib = load64(out + 16);
    var half: f64 = 0.5;
    var fd: f64 = f64_from(divs);
    var z = 0;
    while (z < cols) {
        var fz: f64 = f64_from(z);
        var tz: f64 = fz / fd;
        var x = 0;
        while (x < cols) {
            var fx: f64 = f64_from(x);
            var tx: f64 = fx / fd;
            var v = vb + (z * cols + x) * 48;
            _sr_put3(v, tx - half, 0.0, tz - half);
            store32(v + 12, 0);
            store32(v + 16, 0x3F800000);
            store32(v + 20, 0);
            _sr_put2(v + 24, tx, tz);
            _sr_v3d_white(v);
            x = x + 1;
        }
        z = z + 1;
    }
    var k = 0;
    z = 0;
    while (z < divs) {
        var x2 = 0;
        while (x2 < divs) {
            var tl = z * cols + x2;
            var p = ib + k * 24;
            store32(p, tl);
            store32(p + 4, tl + cols);
            store32(p + 8, tl + 1);
            store32(p + 12, tl + 1);
            store32(p + 16, tl + cols);
            store32(p + 20, tl + cols + 1);
            k = k + 1;
            x2 = x2 + 1;
        }
        z = z + 1;
    }
    return out;
}

# ── cylinder ─────────────────────────────────────────────────────────────────────────

# A cylinder of radius 0.5 and height 1 about Y: two side rings of segments + 1 vertices at angles (τ / segments)·i,
# then a top and a bottom cap (centre plus a ring of segments), 4·segments + 4 vertices and 12·segments indices.
# segments is at least 3. Mirrors `cylinder`.
fn sr_cylinder(segments, a, out) {
    var seg = segments & 0xFFFFFFFF;
    if (seg < 3) { seg = 3; }
    if (_sr_mesh_alloc(a, out, 4 * seg + 4, 12 * seg) == 0) { return 0; }
    var vb = load64(out);
    var ib = load64(out + 16);
    var half: f64 = 0.5;
    var fseg: f64 = f64_from(seg);
    var step: f64 = _SR_TAU32 / fseg;
    var k = 0;
    var yi = 0;
    while (yi <= 1) {
        var y: f64 = f64_from(yi) - half;
        var i = 0;
        while (i <= seg) {
            var fi: f64 = f64_from(i);
            var ang: f64 = step * fi;
            var nx: f64 = f64_cos(ang);
            var nz: f64 = f64_sin(ang);
            var v = vb + k * 48;
            _sr_put3(v, nx * half, y, nz * half);
            store32(v + 12, f32_from(nx));
            store32(v + 16, 0);
            store32(v + 20, f32_from(nz));
            _sr_put2(v + 24, fi / fseg, f64_from(yi));
            _sr_v3d_white(v);
            k = k + 1;
            i = i + 1;
        }
        yi = yi + 1;
    }
    var ring = seg + 1;
    var n = 0;
    var s = 0;
    while (s < seg) {
        var p = ib + n * 4;
        store32(p, s);
        store32(p + 4, s + ring);
        store32(p + 8, s + 1);
        store32(p + 12, s + ring);
        store32(p + 16, s + ring + 1);
        store32(p + 20, s + 1);
        n = n + 6;
        s = s + 1;
    }
    var cap = 0;
    while (cap < 2) {
        var cy = _SR_PH;
        var ny = _SR_P1;
        if (cap == 1) {
            cy = _SR_NH;
            ny = _SR_N1;
        }
        var center = k;
        _sr_v3d_bits(vb + k * 48, 0, cy, 0, 0, ny, 0, _SR_PH, _SR_PH);
        k = k + 1;
        var j = 0;
        while (j < seg) {
            var fj: f64 = f64_from(j);
            var a2: f64 = step * fj;
            var c: f64 = f64_cos(a2) * half;
            var sn: f64 = f64_sin(a2) * half;
            var v2 = vb + k * 48;
            store32(v2, f32_from(c));
            store32(v2 + 4, cy);
            store32(v2 + 8, f32_from(sn));
            store32(v2 + 12, 0);
            store32(v2 + 16, ny);
            store32(v2 + 20, 0);
            _sr_put2(v2 + 24, c + half, sn + half);
            _sr_v3d_white(v2);
            k = k + 1;
            j = j + 1;
        }
        var t = 0;
        while (t < seg) {
            var nxt = t + 1;
            if (nxt >= seg) { nxt = 0; }
            var q = ib + n * 4;
            store32(q, center);
            if (cap == 0) {
                store32(q + 4, center + 1 + nxt);
                store32(q + 8, center + 1 + t);
            } else {
                store32(q + 4, center + 1 + t);
                store32(q + 8, center + 1 + nxt);
            }
            n = n + 3;
            t = t + 1;
        }
        cap = cap + 1;
    }
    return out;
}

# --- terrain.cyr ---

# terrain.cyr — Rust 1.2.0's src/terrain.rs (M3 part a): height-map terrain meshes.
#
# `SrTerrainConfig` (width, depth as u32; world_width, world_depth, height_scale as f32 at 16, 20, 24) is filled by
# the caller, or by SrTerrainConfig_default. `SrTerrainData` is an SrMeshData (src/viz.cyr) without the material
# index, as Rust's `TerrainData` is. The mesh is sr_heightfield_mesh's, so its geometry is class E (D4 rule b); the
# HeightField's f32 fields (origin = −world · 0.5, d = world / cells) are Rust's f32 values. `create_terrain_mesh`
# uploads to the GPU: M6.

struct SrTerrainConfig { width; depth; world_width: f32; world_depth: f32; height_scale: f32; }
struct SrTerrainData { vertices; vertex_count; indices; index_count; }

# 64 × 64 cells over 64 × 64 world units, heights × 10, into out. Mirrors `impl Default for TerrainConfig`.
fn SrTerrainConfig_default(out) {
    store64(out, 64);
    store64(out + 8, 64);
    store32(out + 16, 0x42800000);
    store32(out + 20, 0x42800000);
    store32(out + 24, 0x41200000);
    return out;
}

# The terrain's height-callback context: the heights, how many, the row length and the scale.
struct _SrTerrainCtx { heights; n; cols; scale; }

# heights[iz·cols + ix] · scale in f32, or 0 past the end of the heights (sr_heightfield_mesh's height_fn).
fn _sr_terrain_height(ctx, ix, iz): i64 {
    var i = iz * load64(ctx + 16) + ix;
    if (i >= load64(ctx + 8)) { return 0; }
    return _sr_f32_mul(load32(load64(ctx) + i * 4), load64(ctx + 24));
}

# White (sr_heightfield_mesh's color_fn).
fn _sr_terrain_white(ctx, ix, iz, y, out) {
    store64(out, 0x3F8000003F800000);
    store64(out + 8, 0x3F8000003F800000);
    return out;
}

# Sets the terrain data out to nv vertices at vb and ni indices at ib; returns out.
fn _sr_terrain_set(out, vb, nv, ib, ni) {
    store64(out, vb);
    store64(out + 8, nv);
    store64(out + 16, ib);
    store64(out + 24, ni);
    return out;
}

# The terrain mesh of config over the n heights at heights (row-major, (width + 1) × (depth + 1); a missing sample is 0,
# with a DEBUG event), into out (an SrTerrainData) from the allocator a: out, or 0 when an allocation fails. Empty,
# with a WARN event, when width or depth is 0. Mirrors `generate_terrain`.
fn sr_generate_terrain(config, heights, n, a, out) {
    var w = load64(config) & 0xFFFFFFFF;
    var d = load64(config + 8) & 0xFFFFFFFF;
    if (w == 0 || d == 0) {
        _sr_warn("soorat::terrain: generate_terrain: width or depth is 0 — returning empty terrain");
        return _sr_terrain_set(out, 0, 0, 0, 0);
    }
    var cols = w + 1;
    var rows = d + 1;
    if (n < cols * rows) {
        _sr_debug("soorat::terrain: generate_terrain: heightmap shorter than grid — missing samples are 0");
    }
    var hf: SrHeightField;
    hf.cols = cols;
    hf.rows = rows;
    var hp = &hf;
    var ww = load32(config + 16);
    var wd = load32(config + 20);
    var half = 0x3F000000;
    store32(hp + 16, _sr_f32_mul(ww ^ 0x80000000, half));
    store32(hp + 20, _sr_f32_mul(wd ^ 0x80000000, half));
    store32(hp + 24, _sr_f32_div(ww, _sr_i64_to_f32(w)));
    store32(hp + 28, _sr_f32_div(wd, _sr_i64_to_f32(d)));
    var ctx: _SrTerrainCtx;
    ctx.heights = heights;
    ctx.n = n;
    ctx.cols = cols;
    ctx.scale = load32(config + 24);
    var m: SrMeshData;
    var mp = &m;
    if (sr_heightfield_mesh(hp, &_sr_terrain_height, &ctx, &_sr_terrain_white, 0, a, mp) == 0) {
        _sr_terrain_set(out, 0, 0, 0, 0);
        return 0;
    }
    return _sr_terrain_set(out, load64(mp), load64(mp + 8), load64(mp + 16), load64(mp + 24));
}

# A zero height map for a width × depth terrain: (width + 1)·(depth + 1) f32 zeros allocated from a, or 0. Mirrors
# `flat_heightmap` (its length is (width + 1)·(depth + 1)).
fn sr_flat_heightmap(width, depth, a): i64 {
    var n = ((width & 0xFFFFFFFF) + 1) * ((depth & 0xFFFFFFFF) + 1);
    var p = alloc_via(a, n * 4);
    if (p == 0) { return 0; }
    memset(p, 0, n * 4);
    return p;
}

# --- animation.cyr ---

# animation.cyr — Rust 1.2.0's src/animation.rs (M3 part b): joints and skeletons, joint matrices, joint uniforms,
# keyframe brackets and interpolation, slerp, sampler pairing and clip sampling. `load_gltf_animations` is part c.
#
# **Types** (ADR 0002 #24). Rust's `Vec`s are a pointer and a count the caller owns (a frame arena for per-frame
# work, the loader's arena for a loaded clip):
# - `SrJoint` (112 bytes): parent (i64; −1 for a root), inverse_bind (16 f32), translation, rotation (x, y, z, w) and
#   scale (f32), at 0, 8, 72, 84 and 100.
# - `SrSkeleton`: joints (SrJoint array) and joint_count.
# - `SrKeyframe` (40 bytes): time (f32), and its value as a pointer and a length (len f32), as Rust's `Vec<f32>`;
#   plus in_tangent and out_tangent (len f32 each, or 0), which Rust has no place for: a CUBICSPLINE key's (#13).
# - `SrAnimationChannel` (40 bytes): joint_index, property (SR_ANIMATION_PROPERTY_*), keyframes, keyframe_count, and
#   interpolation (SR_INTERPOLATION_*; Rust drops it).
# - `SrAnimationClip` (40 bytes): name and name_len, duration (f32), channels and channel_count.
#
# **Precision** (D4, plan §7). Brackets, linear interpolation and the time wrap are Rust's f32 sequence: class A.
# Joint chains, local transforms and slerp are class E: Rust's formula in f64 from the f32 inputs, rounded once. A
# chain accumulates its world transforms in f64 and rounds each joint's matrix once, so the leaf of a 64-joint chain
# carries one rounding, not 64 levels of them. slerp's acos and sin are correctly rounded (src/crmath.cyr).
# CUBICSPLINE channels play back as the glTF cubic Hermite spline, in f64 rounded once (class R, ADR 0002 #13).
#
# **Scratch.** The world transforms (128 × 16 f64), the joint states and the ancestor chain live in module state,
# allocated once on first use (as debug_geom's trig cache is module state): joint matrices allocate nothing per call,
# and are not reentrant.

# The most joints a skin poses. Mirrors `MAX_JOINTS`.
var SR_MAX_JOINTS = 128;

# What a channel animates. Mirrors `AnimationProperty`.
enum SrAnimationProperty {
    SR_ANIMATION_PROPERTY_TRANSLATION = 0;
    SR_ANIMATION_PROPERTY_ROTATION = 1;
    SR_ANIMATION_PROPERTY_SCALE = 2;
}

# A glTF sampler's interpolation. STEP is paired into duplicate-time keys and plays back linearly, as in Rust;
# CUBICSPLINE keeps its tangents and plays back as the Hermite spline (ADR 0002 #13).
enum SrInterpolation {
    SR_INTERPOLATION_LINEAR = 0;
    SR_INTERPOLATION_STEP = 1;
    SR_INTERPOLATION_CUBICSPLINE = 2;
}

# Where a time falls in a track (sr_bracket): no keys, one key, or between two.
enum SrBracketKind {
    SR_BRACKET_NONE = 0;
    SR_BRACKET_AT = 1;
    SR_BRACKET_BETWEEN = 2;
}

struct SrJoint { parent; inverse_bind: SrM4; translation: SrV3; rotation: SrV4; scale: SrV3; }
struct SrSkeleton { joints; joint_count; }
struct SrKeyframe { time: f32; _pad0: f32; value; len; in_tangent; out_tangent; }
struct SrAnimationChannel { joint_index; property; keyframes; keyframe_count; interpolation; }
struct SrAnimationClip { name; name_len; duration: f32; _pad0: f32; channels; channel_count; }

# The joint-chain scratch, allocated once (17,536 bytes from the global allocator) on first use: the world transforms
# (128 × 16 f64) at 0, the joint states (128 bytes) at 16384, the ancestor chain (128 indices) at 16512.
var _sr_anim_scratch = 0;

# The joint-chain scratch, or 0 when its one allocation fails.
#must_use
fn _sr_anim_scratch_get(): i64 {
    if (_sr_anim_scratch == 0) { _sr_anim_scratch = alloc(17536); }
    return _sr_anim_scratch;
}

# Copies n bytes (a multiple of 8) from src to dst a word at a time; returns dst.
fn _sr_copy_words(dst, src, n) {
    var i = 0;
    while (i < n) {
        store64(dst + i, load64(src + i));
        i = i + 8;
    }
    return dst;
}

# ── joints, uniforms ─────────────────────────────────────────────────────────────────

# A root joint at rest (parent −1, identity inverse bind, zero translation, identity rotation, unit scale), into out.
# Mirrors `impl Default for Joint`.
fn SrJoint_default(out) {
    store64(out, 0 - 1);
    _sr_copy_words(out + 8, SR_IDENTITY_MAT4, 64);
    store64(out + 72, 0);
    store64(out + 80, 0);
    store64(out + 88, 0);
    store32(out + 96, 0x3F800000);
    store32(out + 100, 0x3F800000);
    store32(out + 104, 0x3F800000);
    store32(out + 108, 0x3F800000);
    return out;
}

# Joint uniforms with a count of 0 and every matrix the identity, into out (an SrJointUniforms). Mirrors
# `impl Default for JointUniforms`.
fn SrJointUniforms_default(out) {
    store64(out, 0);
    store64(out + 8, 0);
    var i = 0;
    while (i < 128) {
        _sr_copy_words(out + 16 + i * 64, SR_IDENTITY_MAT4, 64);
        i = i + 1;
    }
    return out;
}

# Copies the first min(n, SR_MAX_JOINTS) of the n matrices at matrices (16 f32 each) into u and sets its count (x of
# joint_count, as f32); the other matrices and joint_count's y, z, w are kept. Mirrors `JointUniforms::set_joints`.
fn SrJointUniforms_set_joints(u, matrices, n) {
    var c = n;
    if (c > SR_MAX_JOINTS) { c = SR_MAX_JOINTS; }
    if (c < 0) { c = 0; }
    store32(u, _sr_i64_to_f32(c));
    _sr_copy_words(u + 16, matrices, c * 64);
    return u;
}

# The joint's local transform T·R·S (16 f32, column-major) into out: sr_compose_trs, rounded once (class E). Mirrors
# `local_transform`.
fn sr_local_transform(joint, out) {
    return sr_compose_trs(joint + 72, joint + 84, joint + 100, out);
}

# The joint's local transform in f64 (16 f64 at m), unrounded: sr_compose_trs's formula.
fn _sr_compose_trs64(j, m) {
    var x: f64 = f32_to(load32(j + 84));
    var y: f64 = f32_to(load32(j + 88));
    var z: f64 = f32_to(load32(j + 92));
    var w: f64 = f32_to(load32(j + 96));
    var one: f64 = 1.0;
    var two: f64 = 2.0;
    var zero: f64 = 0.0;
    var r00: f64 = one - (two * ((y * y) + (z * z)));
    var r01: f64 = two * ((x * y) + (w * z));
    var r02: f64 = two * ((x * z) - (w * y));
    var r10: f64 = two * ((x * y) - (w * z));
    var r11: f64 = one - (two * ((x * x) + (z * z)));
    var r12: f64 = two * ((y * z) + (w * x));
    var r20: f64 = two * ((x * z) + (w * y));
    var r21: f64 = two * ((y * z) - (w * x));
    var r22: f64 = one - (two * ((x * x) + (y * y)));
    var s0: f64 = f32_to(load32(j + 100));
    var s1: f64 = f32_to(load32(j + 104));
    var s2: f64 = f32_to(load32(j + 108));
    var t0: f64 = f32_to(load32(j + 72));
    var t1: f64 = f32_to(load32(j + 76));
    var t2: f64 = f32_to(load32(j + 80));
    store64(m, s0 * r00);
    store64(m + 8, s0 * r01);
    store64(m + 16, s0 * r02);
    store64(m + 24, zero);
    store64(m + 32, s1 * r10);
    store64(m + 40, s1 * r11);
    store64(m + 48, s1 * r12);
    store64(m + 56, zero);
    store64(m + 64, s2 * r20);
    store64(m + 72, s2 * r21);
    store64(m + 80, s2 * r22);
    store64(m + 88, zero);
    store64(m + 96, t0);
    store64(m + 104, t1);
    store64(m + 112, t2);
    store64(m + 120, one);
    return m;
}

# a · b (a: 16 f64; b: 16 f32, widened) rounded once to 16 f32 at out: a joint matrix.
fn _sr_mul64_round(a, b, out) {
    var a00: f64 = load64(a + 0);
    var a01: f64 = load64(a + 8);
    var a02: f64 = load64(a + 16);
    var a03: f64 = load64(a + 24);
    var a10: f64 = load64(a + 32);
    var a11: f64 = load64(a + 40);
    var a12: f64 = load64(a + 48);
    var a13: f64 = load64(a + 56);
    var a20: f64 = load64(a + 64);
    var a21: f64 = load64(a + 72);
    var a22: f64 = load64(a + 80);
    var a23: f64 = load64(a + 88);
    var a30: f64 = load64(a + 96);
    var a31: f64 = load64(a + 104);
    var a32: f64 = load64(a + 112);
    var a33: f64 = load64(a + 120);
    var b00: f64 = f32_to(load32(b + 0));
    var b01: f64 = f32_to(load32(b + 4));
    var b02: f64 = f32_to(load32(b + 8));
    var b03: f64 = f32_to(load32(b + 12));
    var b10: f64 = f32_to(load32(b + 16));
    var b11: f64 = f32_to(load32(b + 20));
    var b12: f64 = f32_to(load32(b + 24));
    var b13: f64 = f32_to(load32(b + 28));
    var b20: f64 = f32_to(load32(b + 32));
    var b21: f64 = f32_to(load32(b + 36));
    var b22: f64 = f32_to(load32(b + 40));
    var b23: f64 = f32_to(load32(b + 44));
    var b30: f64 = f32_to(load32(b + 48));
    var b31: f64 = f32_to(load32(b + 52));
    var b32: f64 = f32_to(load32(b + 56));
    var b33: f64 = f32_to(load32(b + 60));
    var z: f64 = 0.0;
    var r00: f64 = (((z + (a00 * b00)) + (a10 * b01)) + (a20 * b02)) + (a30 * b03);
    var r01: f64 = (((z + (a01 * b00)) + (a11 * b01)) + (a21 * b02)) + (a31 * b03);
    var r02: f64 = (((z + (a02 * b00)) + (a12 * b01)) + (a22 * b02)) + (a32 * b03);
    var r03: f64 = (((z + (a03 * b00)) + (a13 * b01)) + (a23 * b02)) + (a33 * b03);
    var r10: f64 = (((z + (a00 * b10)) + (a10 * b11)) + (a20 * b12)) + (a30 * b13);
    var r11: f64 = (((z + (a01 * b10)) + (a11 * b11)) + (a21 * b12)) + (a31 * b13);
    var r12: f64 = (((z + (a02 * b10)) + (a12 * b11)) + (a22 * b12)) + (a32 * b13);
    var r13: f64 = (((z + (a03 * b10)) + (a13 * b11)) + (a23 * b12)) + (a33 * b13);
    var r20: f64 = (((z + (a00 * b20)) + (a10 * b21)) + (a20 * b22)) + (a30 * b23);
    var r21: f64 = (((z + (a01 * b20)) + (a11 * b21)) + (a21 * b22)) + (a31 * b23);
    var r22: f64 = (((z + (a02 * b20)) + (a12 * b21)) + (a22 * b22)) + (a32 * b23);
    var r23: f64 = (((z + (a03 * b20)) + (a13 * b21)) + (a23 * b22)) + (a33 * b23);
    var r30: f64 = (((z + (a00 * b30)) + (a10 * b31)) + (a20 * b32)) + (a30 * b33);
    var r31: f64 = (((z + (a01 * b30)) + (a11 * b31)) + (a21 * b32)) + (a31 * b33);
    var r32: f64 = (((z + (a02 * b30)) + (a12 * b31)) + (a22 * b32)) + (a32 * b33);
    var r33: f64 = (((z + (a03 * b30)) + (a13 * b31)) + (a23 * b32)) + (a33 * b33);
    store32(out + 0, f32_from(r00));
    store32(out + 4, f32_from(r01));
    store32(out + 8, f32_from(r02));
    store32(out + 12, f32_from(r03));
    store32(out + 16, f32_from(r10));
    store32(out + 20, f32_from(r11));
    store32(out + 24, f32_from(r12));
    store32(out + 28, f32_from(r13));
    store32(out + 32, f32_from(r20));
    store32(out + 36, f32_from(r21));
    store32(out + 40, f32_from(r22));
    store32(out + 44, f32_from(r23));
    store32(out + 48, f32_from(r30));
    store32(out + 52, f32_from(r31));
    store32(out + 56, f32_from(r32));
    store32(out + 60, f32_from(r33));
    return out;
}

# out = a · TRS(joint j) in f64 (a: 16 f64; out: 16 f64): _sr_compose_trs64's matrix, kept in locals rather than
# stored and reloaded, then sr_mul_mat4's sums in its order with no rounding.
fn _sr_mul64_trs(a, j, out) {
    var a00: f64 = load64(a + 0);
    var a01: f64 = load64(a + 8);
    var a02: f64 = load64(a + 16);
    var a03: f64 = load64(a + 24);
    var a10: f64 = load64(a + 32);
    var a11: f64 = load64(a + 40);
    var a12: f64 = load64(a + 48);
    var a13: f64 = load64(a + 56);
    var a20: f64 = load64(a + 64);
    var a21: f64 = load64(a + 72);
    var a22: f64 = load64(a + 80);
    var a23: f64 = load64(a + 88);
    var a30: f64 = load64(a + 96);
    var a31: f64 = load64(a + 104);
    var a32: f64 = load64(a + 112);
    var a33: f64 = load64(a + 120);
    var x: f64 = f32_to(load32(j + 84));
    var y: f64 = f32_to(load32(j + 88));
    var z: f64 = f32_to(load32(j + 92));
    var w: f64 = f32_to(load32(j + 96));
    var one: f64 = 1.0;
    var two: f64 = 2.0;
    var zero: f64 = 0.0;
    var s0: f64 = f32_to(load32(j + 100));
    var s1: f64 = f32_to(load32(j + 104));
    var s2: f64 = f32_to(load32(j + 108));
    var b00: f64 = s0 * (one - (two * ((y * y) + (z * z))));
    var b01: f64 = s0 * (two * ((x * y) + (w * z)));
    var b02: f64 = s0 * (two * ((x * z) - (w * y)));
    var b10: f64 = s1 * (two * ((x * y) - (w * z)));
    var b11: f64 = s1 * (one - (two * ((x * x) + (z * z))));
    var b12: f64 = s1 * (two * ((y * z) + (w * x)));
    var b20: f64 = s2 * (two * ((x * z) + (w * y)));
    var b21: f64 = s2 * (two * ((y * z) - (w * x)));
    var b22: f64 = s2 * (one - (two * ((x * x) + (y * y))));
    var b30: f64 = f32_to(load32(j + 72));
    var b31: f64 = f32_to(load32(j + 76));
    var b32: f64 = f32_to(load32(j + 80));
    store64(out + 0, (((zero + (a00 * b00)) + (a10 * b01)) + (a20 * b02)) + (a30 * zero));
    store64(out + 8, (((zero + (a01 * b00)) + (a11 * b01)) + (a21 * b02)) + (a31 * zero));
    store64(out + 16, (((zero + (a02 * b00)) + (a12 * b01)) + (a22 * b02)) + (a32 * zero));
    store64(out + 24, (((zero + (a03 * b00)) + (a13 * b01)) + (a23 * b02)) + (a33 * zero));
    store64(out + 32, (((zero + (a00 * b10)) + (a10 * b11)) + (a20 * b12)) + (a30 * zero));
    store64(out + 40, (((zero + (a01 * b10)) + (a11 * b11)) + (a21 * b12)) + (a31 * zero));
    store64(out + 48, (((zero + (a02 * b10)) + (a12 * b11)) + (a22 * b12)) + (a32 * zero));
    store64(out + 56, (((zero + (a03 * b10)) + (a13 * b11)) + (a23 * b12)) + (a33 * zero));
    store64(out + 64, (((zero + (a00 * b20)) + (a10 * b21)) + (a20 * b22)) + (a30 * zero));
    store64(out + 72, (((zero + (a01 * b20)) + (a11 * b21)) + (a21 * b22)) + (a31 * zero));
    store64(out + 80, (((zero + (a02 * b20)) + (a12 * b21)) + (a22 * b22)) + (a32 * zero));
    store64(out + 88, (((zero + (a03 * b20)) + (a13 * b21)) + (a23 * b22)) + (a33 * zero));
    store64(out + 96, (((zero + (a00 * b30)) + (a10 * b31)) + (a20 * b32)) + (a30 * one));
    store64(out + 104, (((zero + (a01 * b30)) + (a11 * b31)) + (a21 * b32)) + (a31 * one));
    store64(out + 112, (((zero + (a02 * b30)) + (a12 * b31)) + (a22 * b32)) + (a32 * one));
    store64(out + 120, (((zero + (a03 * b30)) + (a13 * b31)) + (a23 * b32)) + (a33 * one));
    return out;
}

# ── world transforms, joint matrices ─────────────────────────────────────────────────

# Joint i's parent when it is in range and not i itself, else −1 (a root).
#must_use
fn _sr_parent_of(joints, i, n): i64 {
    var p = load64(joints + i * 112);
    if (p >= 0 && p < n && p != i) { return p; }
    return 0 - 1;
}

# Fills the scratch world transforms (f64) of the n ≤ SR_MAX_JOINTS joints: one forward pass when every parent
# precedes its child (and resolve is 0), else Rust's general walk (each unresolved ancestor chain climbed once, then
# resolved top-down; a parent out of range, the joint itself, or closing a cycle makes a root). Returns n, or 0 when
# the scratch can't be allocated.
fn _sr_world64(joints, n, resolve): i64 {
    var w = _sr_anim_scratch_get();
    if (w == 0) { return 0; }
    var sorted = 1 - resolve;
    var i = 0;
    while (sorted == 1 && i < n) {
        var p = load64(joints + i * 112);
        if (p >= i) { sorted = 0; }
        i = i + 1;
    }
    if (sorted == 1) {
        i = 0;
        while (i < n) {
            var pj = load64(joints + i * 112);
            if (pj >= 0) {
                _sr_mul64_trs(w + pj * 128, joints + i * 112, w + i * 128);
            } else {
                _sr_compose_trs64(joints + i * 112, w + i * 128);
            }
            i = i + 1;
        }
        return n;
    }
    var st = w + 16384;
    var ch = w + 16512;
    i = 0;
    while (i < n) {
        store8(st + i, 0);
        i = i + 1;
    }
    var start = 0;
    while (start < n) {
        if (load8(st + start) != 2) {
            var len = 0;
            var j = start;
            var climbing = 1;
            while (climbing == 1) {
                store8(st + j, 1);
                store64(ch + len * 8, j);
                len = len + 1;
                var up = _sr_parent_of(joints, j, n);
                if (up >= 0 && load8(st + up) == 0) { j = up; } else { climbing = 0; }
            }
            while (len > 0) {
                len = len - 1;
                var k = load64(ch + len * 8);
                var pk = _sr_parent_of(joints, k, n);
                if (pk >= 0 && load8(st + pk) == 2) {
                    _sr_mul64_trs(w + pk * 128, joints + k * 112, w + k * 128);
                } else {
                    _sr_compose_trs64(joints + k * 112, w + k * 128);
                }
                store8(st + k, 2);
            }
        }
        start = start + 1;
    }
    return n;
}

# The world transforms (16 f32 each, rounded once from f64) of the first min(n, SR_MAX_JOINTS) of the n joints, into
# out; returns how many (0 when the scratch can't be allocated). resolve 1 forces the general walk. The oracle hooks
# `world_transforms(_resolved)`.
fn _sr_world_out(joints, n, out, resolve): i64 {
    var c = n;
    if (c > SR_MAX_JOINTS) { c = SR_MAX_JOINTS; }
    if (c < 0) { c = 0; }
    c = _sr_world64(joints, c, resolve);
    var w = _sr_anim_scratch;
    var i = 0;
    while (i < c * 16) {
        var x: f64 = load64(w + i * 8);
        store32(out + i * 4, f32_from(x));
        i = i + 1;
    }
    return c;
}

# World transforms by the library's own path (one pass when parents precede children). Mirrors `world_transforms`.
fn sr_world_transforms(joints, n, out): i64 { return _sr_world_out(joints, n, out, 0); }

# World transforms by the general walk alone. Mirrors the oracle's `world_transforms_resolved`.
fn sr_world_transforms_resolved(joints, n, out): i64 { return _sr_world_out(joints, n, out, 1); }

# The skeleton's joint matrices, world transform · inverse bind for each of its first SR_MAX_JOINTS joints (16 f32
# each, rounded once from f64), into out (room for SR_MAX_JOINTS matrices: an SrJointUniforms' joints will do); returns
# how many (0 when the one-time scratch allocation fails). Mirrors `Skeleton::compute_joint_matrices`.
fn SrSkeleton_compute_joint_matrices(sk, out): i64 {
    var joints = load64(sk);
    var c = load64(sk + 8);
    if (c > SR_MAX_JOINTS) { c = SR_MAX_JOINTS; }
    if (c < 0) { c = 0; }
    c = _sr_world64(joints, c, 0);
    var w = _sr_anim_scratch;
    var i = 0;
    while (i < c) {
        _sr_mul64_round(w + i * 128, joints + i * 112 + 8, out + i * 64);
        i = i + 1;
    }
    return c;
}

# ── slerp ────────────────────────────────────────────────────────────────────────────

# (q0, q1, q2, q3) / its length, rounded once to 4 f32 at out; the identity (0, 0, 0, 1) when the length is not finite
# or ≤ 1e-12f32. The length is √(((q0² + q1²) + q2²) + q3²) in f64.
fn _sr_quat_unit(q0: f64, q1: f64, q2: f64, q3: f64, out) {
    var ss: f64 = (((q0 * q0) + (q1 * q1)) + (q2 * q2)) + (q3 * q3);
    var ln: f64 = f64_sqrt(ss);
    var lim: f64 = f32_to(0x2B8CBCCC);
    if (_sr_f64_finite(ln) == 1 && ln > lim) {
        store32(out, f32_from(q0 / ln));
        store32(out + 4, f32_from(q1 / ln));
        store32(out + 8, f32_from(q2 / ln));
        store32(out + 12, f32_from(q3 / ln));
        return out;
    }
    store64(out, 0);
    store64(out + 8, 0x3F80000000000000);
    return out;
}

# The shortest-path slerp of the quaternions a and b (x, y, z, w; 4 f32 each) at t (f32 bits), normalized (the identity
# when degenerate), into out. Rust's formula in f64, rounded once (class E): cos = ((a0b0 + a1b1) + a2b2) + a3b3; b and
# cos negated when cos < 0; weights (1 − t, t) when cos > 0.9995f32, else sin((1 − t)θ) / sin θ and sin(tθ) / sin θ with
# θ = acos(clamp(cos, −1, 1)). acos and sin are correctly rounded (src/crmath.cyr): with ganita's, a 1-ulp difference
# survives the final rounding wherever the weights cancel. Mirrors `slerp`.
#
# UPSTREAM(L1): ganita:docs/development/issues/2026-11-09-correctly-rounded-exp-sin-cos-hypot.md
#   call ganita's f64 acos and sin once they are correctly rounded, and drop src/crmath.cyr's vendored copies;
#   parity: the slerp, interpolate_rotation and AnimationClip::sample rows of tests/golden/animation.tsv (class E).
fn sr_slerp(a, b, t, out) {
    var a0: f64 = f32_to(load32(a));
    var a1: f64 = f32_to(load32(a + 4));
    var a2: f64 = f32_to(load32(a + 8));
    var a3: f64 = f32_to(load32(a + 12));
    var bb0 = load32(b);
    var bb1 = load32(b + 4);
    var bb2 = load32(b + 8);
    var bb3 = load32(b + 12);
    var b0: f64 = f32_to(bb0);
    var b1: f64 = f32_to(bb1);
    var b2: f64 = f32_to(bb2);
    var b3: f64 = f32_to(bb3);
    var c: f64 = (((a0 * b0) + (a1 * b1)) + (a2 * b2)) + (a3 * b3);
    var zero: f64 = 0.0;
    if (c < zero) {
        b0 = f32_to(bb0 ^ 0x80000000);
        b1 = f32_to(bb1 ^ 0x80000000);
        b2 = f32_to(bb2 ^ 0x80000000);
        b3 = f32_to(bb3 ^ 0x80000000);
        c = zero - c;
    }
    var tt: f64 = f32_to(t & 0xFFFFFFFF);
    var one: f64 = 1.0;
    var wa: f64 = one - tt;
    var wb: f64 = tt;
    var sw: f64 = f32_to(0x3F7FDF3B);
    var near = 0;
    if (c > sw) { near = 1; }
    if (near == 0) {
        var m1: f64 = zero - one;
        var cc: f64 = c;
        if (cc < m1) { cc = m1; }
        if (cc > one) { cc = one; }
        var th: f64 = _sr_km_cr_acos(cc);
        var sn: f64 = _sr_km_cr_sin(th);
        wa = _sr_km_cr_sin(wa * th) / sn;
        wb = _sr_km_cr_sin(tt * th) / sn;
    }
    var q0: f64 = (wa * a0) + (wb * b0);
    var q1: f64 = (wa * a1) + (wb * b1);
    var q2: f64 = (wa * a2) + (wb * b2);
    var q3: f64 = (wa * a3) + (wb * b3);
    return _sr_quat_unit(q0, q1, q2, q3, out);
}

# ── brackets, interpolation ──────────────────────────────────────────────────────────

# Rust 1.100's `partition_point(|k| k.time <= time)` over the n keys: its branch-free binary search (the loop count
# depends only on n), so an unsorted track gives Rust's index too.
#must_use
fn _sr_partition_point(keys, n, time): i64 {
    var size = n;
    var base = 0;
    while (size > 1) {
        var half = size / 2;
        if (_sr_f32_le(load32(keys + (base + half) * 40), time) == 1) { base = base + half; }
        size = size - half;
    }
    return base + _sr_f32_le(load32(keys + base * 40), time);
}

# Where time (f32 bits) falls in the n keys (time-sorted): SR_BRACKET_NONE for no keys; SR_BRACKET_AT with the key's
# index at out (the first key for one key, a NaN time or a time ≤ the first key's; the last for one ≥ the last key's);
# SR_BRACKET_BETWEEN with the two keys' indices and t ∈ [0, 1] (f32: (time − a) / (b − a), clamped; 0 when
# |b − a| ≤ f32::EPSILON) at out, out + 8, out + 16. Rust's f32 sequence (class A). Mirrors `bracket`.
fn sr_bracket(keys, n, time, out): i64 {
    if (n <= 0) { return SR_BRACKET_NONE; }
    var tb = time & 0xFFFFFFFF;
    if (n == 1 || _sr_f32_is_nan(tb) == 1 || _sr_f32_le(tb, load32(keys)) == 1) {
        store64(out, 0);
        return SR_BRACKET_AT;
    }
    if (_sr_f32_le(load32(keys + (n - 1) * 40), tb) == 1) {
        store64(out, n - 1);
        return SR_BRACKET_AT;
    }
    var hi = _sr_partition_point(keys, n, tb);
    if (hi < 1) { hi = 1; }
    if (hi > n - 1) { hi = n - 1; }
    var ta = load32(keys + (hi - 1) * 40);
    var dt = _sr_f32_sub(load32(keys + hi * 40), ta) & 0xFFFFFFFF;
    var t = 0;
    if (_sr_f32_lt(0x34000000, dt & 0x7FFFFFFF) == 1) {
        t = _sr_clamp32(_sr_f32_div(_sr_f32_sub(tb, ta), dt), 0, 0x3F800000);
    }
    store64(out, hi - 1);
    store64(out + 8, hi);
    store64(out + 16, t & 0xFFFFFFFF);
    return SR_BRACKET_BETWEEN;
}

# The value of a bracket (kind, br from sr_bracket) by linear interpolation: the key's own for SR_BRACKET_AT,
# a + (b − a)·t per component in f32 (as many as the shorter key has) for SR_BRACKET_BETWEEN. Writes the first cap
# components to out; returns how many there are (0 for SR_BRACKET_NONE).
fn _sr_lerp_bracket(keys, kind, br, out, cap): i64 {
    if (kind == SR_BRACKET_NONE) { return 0; }
    var ka = keys + load64(br) * 40;
    var va = load64(ka + 8);
    var m = load64(ka + 16);
    var i = 0;
    if (kind == SR_BRACKET_AT) {
        while (i < m && i < cap) {
            store32(out + i * 4, load32(va + i * 4));
            i = i + 1;
        }
        return m;
    }
    var kb = keys + load64(br + 8) * 40;
    var vb = load64(kb + 8);
    if (load64(kb + 16) < m) { m = load64(kb + 16); }
    var t = load64(br + 16);
    while (i < m && i < cap) {
        store32(out + i * 4, _sr_f32_lerp(load32(va + i * 4), load32(vb + i * 4), t));
        i = i + 1;
    }
    return m;
}

# The n keys' linear interpolation at time (f32 bits): its first cap components into out; returns how many components
# it has (0 for no keys). Class A. Mirrors `interpolate_keyframes`.
fn sr_interpolate_keyframes(keys, n, time, out, cap): i64 {
    var br[24];
    var kind = sr_bracket(keys, n, time, &br);
    return _sr_lerp_bracket(keys, kind, &br, out, cap);
}

# A rotation track at time: the slerp of the two keys around it when both have ≥ 4 components (4 components),
# otherwise linear interpolation. Its first cap components into out; returns how many it has. Mirrors
# `interpolate_rotation`.
fn sr_interpolate_rotation(keys, n, time, out, cap): i64 {
    var br[24];
    var kind = sr_bracket(keys, n, time, &br);
    if (kind == SR_BRACKET_BETWEEN) {
        var ka = keys + load64(&br) * 40;
        var kb = keys + load64(&br + 8) * 40;
        if (load64(ka + 16) >= 4 && load64(kb + 16) >= 4) {
            var q[16];
            sr_slerp(load64(ka + 8), load64(kb + 8), load64(&br + 16), &q);
            var i = 0;
            while (i < 4 && i < cap) {
                store32(out + i * 4, load32(&q + i * 4));
                i = i + 1;
            }
            return 4;
        }
    }
    return _sr_lerp_bracket(keys, kind, &br, out, cap);
}

# Component i of the f32 array p as f64, or 0 when p is 0 (a missing tangent).
fn _sr_tan(p, i): i64 {
    if (p == 0) { return 0; }
    var x: f64 = f32_to(load32(p + i * 4));
    return x;
}

# A CUBICSPLINE track at time (ADR 0002 #13): outside or at the ends, and between keys less than f32::EPSILON apart,
# as sr_interpolate_keyframes; between keys a and b at s (the bracket's t), the glTF cubic Hermite spline in f64
# from the f32 inputs, rounded once (class R):
#   p = (((h00·va + h10·(dt·out_a)) + h01·vb) + h11·(dt·in_b)),  dt = time_b − time_a,
#   h00 = (2s³ − 3s²) + 1, h10 = (s³ − 2s²) + s, h01 = 3s² − 2s³, h11 = s³ − s²  (s² = s·s, s³ = s²·s),
# a missing tangent counting as 0. A rotation (rot 1, ≥ 4 components) is normalized as slerp's result is. Its first
# cap components into out; returns how many it has.
fn sr_interpolate_cubic(keys, n, time, out, cap, rot): i64 {
    var br[24];
    var kind = sr_bracket(keys, n, time, &br);
    if (kind != SR_BRACKET_BETWEEN) { return _sr_lerp_bracket(keys, kind, &br, out, cap); }
    var ka = keys + load64(&br) * 40;
    var kb = keys + load64(&br + 8) * 40;
    var m = load64(ka + 16);
    if (load64(kb + 16) < m) { m = load64(kb + 16); }
    var ta: f64 = f32_to(load32(ka));
    var tb: f64 = f32_to(load32(kb));
    var dt: f64 = tb - ta;
    var s: f64 = f32_to(load64(&br + 16));
    var one: f64 = 1.0;
    var two: f64 = 2.0;
    var three: f64 = 3.0;
    var s2: f64 = s * s;
    var s3: f64 = s2 * s;
    var h00: f64 = ((two * s3) - (three * s2)) + one;
    var h10: f64 = (s3 - (two * s2)) + s;
    var h01: f64 = (three * s2) - (two * s3);
    var h11: f64 = s3 - s2;
    var va = load64(ka + 8);
    var vb = load64(kb + 8);
    var oa = load64(ka + 32);
    var ib = load64(kb + 24);
    var p[32];
    var i = 0;
    while (i < m && (i < cap || (rot == 1 && i < 4))) {
        var x: f64 = f32_to(load32(va + i * 4));
        var y: f64 = f32_to(load32(vb + i * 4));
        var u: f64 = _sr_tan(oa, i);
        var w: f64 = _sr_tan(ib, i);
        var v: f64 = (((h00 * x) + (h10 * (dt * u))) + (h01 * y)) + (h11 * (dt * w));
        if (i < 4) { store64(&p + i * 8, v); }
        if (rot == 0 || m < 4) {
            if (i < cap) { store32(out + i * 4, f32_from(v)); }
        }
        i = i + 1;
    }
    if (rot == 1 && m >= 4) {
        var q[16];
        _sr_quat_unit(load64(&p), load64(&p + 8), load64(&p + 16), load64(&p + 24), &q);
        i = 0;
        while (i < 4 && i < cap) {
            store32(out + i * 4, load32(&q + i * 4));
            i = i + 1;
        }
        return 4;
    }
    return m;
}

# ── sampler pairing ──────────────────────────────────────────────────────────────────

# Sets the keyframe key to time (f32 bits) and the len f32 at value, with no tangents; returns key.
fn _sr_key_set(key, time, value, len) {
    store64(key, time & 0xFFFFFFFF);
    store64(key + 8, value);
    store64(key + 16, len);
    store64(key + 24, 0);
    store64(key + 32, 0);
    return key;
}

# Pairs a glTF sampler's nt input times (f32 at times) with its nv outputs (width f32 each, at values) by mode
# (SR_INTERPOLATION_*), into the channel ch: its keyframes (allocated from a; each key's value, and a CUBICSPLINE
# key's tangents, point into values, which must outlive the channel), keyframe_count and interpolation. LINEAR pairs
# them one to one; CUBICSPLINE takes the (in-tangent, value, out-tangent) triplets, keeping the tangents Rust drops
# (ADR 0002 #13); STEP adds a duplicate-time key with the previous value before every key after the first, so linear
# playback holds each value. 1, or 0 when the allocation fails (ch then has no keys). Mirrors `build_keyframes`.
fn sr_build_keyframes(ch, times, nt, values, nv, width, mode, a): i64 {
    var stride = width * 4;
    var n = nt;
    if (nv < n) { n = nv; }
    var count = n;
    if (mode == SR_INTERPOLATION_CUBICSPLINE) {
        var nk = 0;
        if (nv > 1) { nk = (nv - 2) / 3 + 1; }
        count = nt;
        if (nk < count) { count = nk; }
    }
    if (mode == SR_INTERPOLATION_STEP && n > 0) { count = 2 * n - 1; }
    if (count < 0) { count = 0; }
    store64(ch + 16, 0);
    store64(ch + 24, 0);
    store64(ch + 32, mode);
    var keys = 0;
    if (count > 0) {
        keys = alloc_via(a, count * 40);
        if (keys == 0) { return 0; }
    }
    var o = 0;
    if (mode == SR_INTERPOLATION_STEP) {
        var k = 0;
        while (k < n) {
            if (k > 0) {
                _sr_key_set(keys + o * 40, load32(times + k * 4), values + (k - 1) * stride, width);
                o = o + 1;
            }
            _sr_key_set(keys + o * 40, load32(times + k * 4), values + k * stride, width);
            o = o + 1;
            k = k + 1;
        }
    } elif (mode == SR_INTERPOLATION_CUBICSPLINE) {
        while (o < count) {
            var key = keys + o * 40;
            _sr_key_set(key, load32(times + o * 4), values + (3 * o + 1) * stride, width);
            store64(key + 24, values + 3 * o * stride);
            if (3 * o + 2 < nv) { store64(key + 32, values + (3 * o + 2) * stride); }
            o = o + 1;
        }
    } else {
        while (o < count) {
            _sr_key_set(keys + o * 40, load32(times + o * 4), values + o * stride, width);
            o = o + 1;
        }
    }
    store64(ch + 16, keys);
    store64(ch + 24, count);
    return 1;
}

# ── clip sampling ────────────────────────────────────────────────────────────────────

# Rust's `f32::rem_euclid(x, y)`: r = x % y (exact), and r + |y| in f32 when r < 0.
#must_use
fn _sr_f32_rem_euclid(x, y): i64 {
    var r = _sr_f32_fmod(x, y);
    if (_sr_f32_lt(r, 0) == 1) { return _sr_f32_add(r, y & 0x7FFFFFFF); }
    return r;
}

# Poses the skeleton sk at time (f32 bits): the time wraps into [0, duration) (negative times backwards) when the
# duration is > 0 and the time finite, else 0. Each channel whose joint exists sets that joint's translation or scale
# (when its value has ≥ 3 components) or rotation (≥ 4): linear interpolation, slerp for rotations, the Hermite spline
# for CUBICSPLINE channels. Mirrors `AnimationClip::sample`.
fn SrAnimationClip_sample(clip, sk, time) {
    var dur = load32(clip + 16);
    var tb = time & 0xFFFFFFFF;
    var t = 0;
    if (_sr_f32_lt(0, dur) == 1 && (tb & 0x7F800000) != 0x7F800000) { t = _sr_f32_rem_euclid(tb, dur); }
    var joints = load64(sk);
    var nj = load64(sk + 8);
    var chs = load64(clip + 24);
    var nc = load64(clip + 32);
    var v[16];
    var c = 0;
    while (c < nc) {
        var ch = chs + c * 40;
        var ji = load64(ch);
        if (ji >= 0 && ji < nj) {
            var j = joints + ji * 112;
            var prop = load64(ch + 8);
            var keys = load64(ch + 16);
            var nk = load64(ch + 24);
            var rot = 0;
            if (prop == SR_ANIMATION_PROPERTY_ROTATION) { rot = 1; }
            var got = 0;
            if (load64(ch + 32) == SR_INTERPOLATION_CUBICSPLINE) {
                got = sr_interpolate_cubic(keys, nk, t, &v, 4, rot);
            } elif (rot == 1) {
                got = sr_interpolate_rotation(keys, nk, t, &v, 4);
            } else {
                got = sr_interpolate_keyframes(keys, nk, t, &v, 4);
            }
            if (prop == SR_ANIMATION_PROPERTY_TRANSLATION && got >= 3) {
                store64(j + 72, load64(&v));
                store32(j + 80, load32(&v + 8));
            }
            if (rot == 1 && got >= 4) {
                store64(j + 84, load64(&v));
                store64(j + 92, load64(&v + 8));
            }
            if (prop == SR_ANIMATION_PROPERTY_SCALE && got >= 3) {
                store64(j + 100, load64(&v));
                store32(j + 108, load32(&v + 8));
            }
        }
        c = c + 1;
    }
    return clip;
}

# --- shadow_math.cyr ---

# shadow_math.cyr — Rust 1.2.0's src/shadow.rs, its CPU half (M4 part a): the directional light matrices, practical
# cascade splits, the point-light cube faces, the atlas tile math, and the uniforms' defaults. The depth maps, the
# atlas texture, the cascaded maps and the pass are GPU objects (M7).
#
# **Precision** (D4, plan §7). The matrices and the splits are class E: Rust's formula in f64 from the f32 inputs
# (constants widened exactly), rounded once. A directional matrix normalizes, crosses and dots in f64; a point light's
# face is perspective_90 · look_at, both in f64, multiplied in f64 and rounded once; a split's `powf` is ganita's f64
# pow. The guards decide as Rust's do (an f32 difference is below 1e-10f32 exactly when the f64 one is). The atlas math
# is u32 and f32 as Rust's (class A).

# Default shadow map resolution. Mirrors `DEFAULT_SHADOW_MAP_SIZE`.
var SR_DEFAULT_SHADOW_MAP_SIZE = 2048;
# The most cascades. Mirrors `MAX_CASCADES`.
var SR_MAX_CASCADES = 4;

# An atlas for the CPU tile math: size and tile_size (u32). Mirrors `ShadowAtlasConfig`.
struct SrShadowAtlasConfig { size; tile_size; }
# A point light's six cube-face view-projection matrices (+X, −X, +Y, −Y, +Z, −Z). Mirrors `PointShadowMap`.
struct SrPointShadowMap {
    face_matrices_0: SrM4; face_matrices_1: SrM4; face_matrices_2: SrM4; face_matrices_3: SrM4; face_matrices_4: SrM4;
    face_matrices_5: SrM4;
}

# ── uniforms ─────────────────────────────────────────────────────────────────────────

# Both matrices the identity, into out (an SrShadowUniforms). Mirrors `impl Default for ShadowUniforms`.
fn SrShadowUniforms_default(out) {
    _sr_mat4_set_identity(out);
    _sr_mat4_set_identity(out + 64);
    return out;
}

# Splits (10, 30, 100, 500) and four identity matrices, into out (an SrCascadeUniforms). Mirrors
# `impl Default for CascadeUniforms`.
fn SrCascadeUniforms_default(out) {
    store32(out, 0x41200000);
    store32(out + 4, 0x41F00000);
    store32(out + 8, 0x42C80000);
    store32(out + 12, 0x43FA0000);
    var i = 0;
    while (i < 4) {
        _sr_mat4_set_identity(out + 16 + i * 64);
        i = i + 1;
    }
    return out;
}

# ── directional lights ───────────────────────────────────────────────────────────────

# The orthographic light-space matrix of a directional light centred on the world origin. Mirrors
# `directional_light_matrix`.
fn sr_directional_light_matrix(direction, extent, near, far, out) {
    var c[16];
    store64(&c, 0);
    store64(&c + 8, 0);
    return sr_directional_light_matrix_at(direction, &c, extent, near, far, out);
}

# The orthographic light-space matrix (16 f32, column-major) of a directional light looking along direction (3 f32,
# not necessarily unit), its frustum centred on center (3 f32) with half-size extent and depth range [near, far]
# along the direction (f32 bits), into out. The identity, with a WARN event, for an extent that is NaN or ≤ 0, or
# |far − near| NaN or below 1e-10. The basis: d = normalize3(direction); right = normalize3(d × up_ref), up_ref the
# X axis when |d.y| > 0.99 and Y otherwise; up = right × d; the matrix is proj · view built directly (rows right/extent,
# up/extent, d/(far − near), translated by −center). In f64, rounded once (class E). Mirrors
# `directional_light_matrix_at`.
fn sr_directional_light_matrix_at(direction, center, extent, near, far, out) {
    var eb = extent & 0xFFFFFFFF;
    if (_sr_f32_is_nan(eb) == 1 || _sr_f32_le(eb, 0) == 1) {
        _sr_warn("soorat::shadow: directional_light_matrix: extent <= 0 — returning identity matrix");
        return _sr_mat4_set_identity(out);
    }
    var n: f64 = f32_to(near & 0xFFFFFFFF);
    var f: f64 = f32_to(far & 0xFFFFFFFF);
    var fmn: f64 = f - n;
    var span: f64 = _sr_abs64(fmn);
    if (span != span || span < _SR_1E_10) {
        _sr_warn("soorat::shadow: directional_light_matrix: far ≈ near — returning identity matrix");
        return _sr_mat4_set_identity(out);
    }
    var zero: f64 = 0.0;
    var one: f64 = 1.0;
    var m1: f64 = zero - one;
    var x: f64 = f32_to(load32(direction));
    var y: f64 = f32_to(load32(direction + 4));
    var z: f64 = f32_to(load32(direction + 8));
    var dl: f64 = f64_sqrt(((x * x) + (y * y)) + (z * z));
    var d0: f64 = zero;
    var d1: f64 = zero;
    var d2: f64 = one;
    if (_sr_tiny(dl) == 0) {
        d0 = x / dl;
        d1 = y / dl;
        d2 = z / dl;
    }
    var u0: f64 = zero;
    var u1: f64 = one;
    var u2: f64 = zero;
    var ad1: f64 = _sr_abs64(d1);
    if (ad1 > _SR_0_99) {
        u0 = one;
        u1 = zero;
    }
    var cx: f64 = (d1 * u2) - (d2 * u1);
    var cy: f64 = (d2 * u0) - (d0 * u2);
    var cz: f64 = (d0 * u1) - (d1 * u0);
    var rl: f64 = f64_sqrt(((cx * cx) + (cy * cy)) + (cz * cz));
    var r0: f64 = zero;
    var r1: f64 = zero;
    var r2: f64 = one;
    if (_sr_tiny(rl) == 0) {
        r0 = cx / rl;
        r1 = cy / rl;
        r2 = cz / rl;
    }
    var p0: f64 = (r1 * d2) - (r2 * d1);
    var p1: f64 = (r2 * d0) - (r0 * d2);
    var p2: f64 = (r0 * d1) - (r1 * d0);
    var c0: f64 = f32_to(load32(center));
    var c1: f64 = f32_to(load32(center + 4));
    var c2: f64 = f32_to(load32(center + 8));
    var ef: f64 = f32_to(eb);
    var sx: f64 = one / ef;
    var sz: f64 = one / fmn;
    var nsx: f64 = m1 * sx;
    var rc: f64 = ((r0 * c0) + (r1 * c1)) + (r2 * c2);
    var pc: f64 = ((p0 * c0) + (p1 * c1)) + (p2 * c2);
    var dc: f64 = ((d0 * c0) + (d1 * c1)) + (d2 * c2);
    var ndc: f64 = m1 * dc;
    store32(out, f32_from(sx * r0));
    store32(out + 4, f32_from(sx * p0));
    store32(out + 8, f32_from(sz * d0));
    store32(out + 12, 0);
    store32(out + 16, f32_from(sx * r1));
    store32(out + 20, f32_from(sx * p1));
    store32(out + 24, f32_from(sz * d1));
    store32(out + 28, 0);
    store32(out + 32, f32_from(sx * r2));
    store32(out + 36, f32_from(sx * p2));
    store32(out + 40, f32_from(sz * d2));
    store32(out + 44, 0);
    store32(out + 48, f32_from(nsx * rc));
    store32(out + 52, f32_from(nsx * pc));
    store32(out + 56, f32_from(sz * (ndc - n)));
    store32(out + 60, 0x3F800000);
    return out;
}

# ── cascade splits ───────────────────────────────────────────────────────────────────

# The count + 1 practical cascade split distances (Nvidia GPU Gems 3) from near to far, into out (room for
# max(count, 1) + 1 f32): split i = λ·near·(far/near)^(i/count) + (1 − λ)·(near + (far − near)·i/count), in f64
# rounded once (class E). The inputs are sanitized as Rust's: a near that is not finite and positive becomes 0.001,
# far is at least near (near when not finite), λ is clamped to [0, 1] (0.5 when NaN), count is at least 1. Returns
# how many distances it wrote. Mirrors `compute_practical_splits`.
fn sr_compute_practical_splits(near, far, count, lambda, out): i64 {
    var nb = near & 0xFFFFFFFF;
    if (_sr_f32_lt(0, nb) == 0 || (nb & 0x7F800000) == 0x7F800000) { nb = 0x3A83126F; }
    var fb = far & 0xFFFFFFFF;
    if ((fb & 0x7F800000) == 0x7F800000) {
        fb = nb;
    } elif (_sr_f32_lt(fb, nb) == 1) {
        fb = nb;
    }
    var lb = lambda & 0xFFFFFFFF;
    if (_sr_f32_is_nan(lb) == 1) {
        lb = 0x3F000000;
    } else {
        lb = _sr_clamp32(lb, 0, 0x3F800000);
    }
    var cnt = count;
    if (cnt < 1) { cnt = 1; }
    var n: f64 = f32_to(nb);
    var f: f64 = f32_to(fb);
    var l: f64 = f32_to(lb);
    var one: f64 = 1.0;
    var fc: f64 = f64_from(cnt);
    var q: f64 = f / n;
    store32(out, nb);
    var i = 1;
    while (i < cnt) {
        var fi: f64 = f64_from(i);
        var ratio: f64 = fi / fc;
        var pw: f64 = f64_pow(q, ratio);
        var lg: f64 = n * pw;
        var un: f64 = n + ((f - n) * ratio);
        var v: f64 = (l * lg) + ((one - l) * un);
        store32(out + i * 4, f32_from(v));
        i = i + 1;
    }
    store32(out + cnt * 4, fb);
    return cnt + 1;
}

# ── point lights ─────────────────────────────────────────────────────────────────────

# a · b (16 f64 each, column-major) rounded once to 16 f32 at out: sr_mul_mat4's sums in f64, unrounded until the end.
fn _sr_mul64x64_round(a, b, out) {
    var a00: f64 = load64(a + 0);
    var a01: f64 = load64(a + 8);
    var a02: f64 = load64(a + 16);
    var a03: f64 = load64(a + 24);
    var a10: f64 = load64(a + 32);
    var a11: f64 = load64(a + 40);
    var a12: f64 = load64(a + 48);
    var a13: f64 = load64(a + 56);
    var a20: f64 = load64(a + 64);
    var a21: f64 = load64(a + 72);
    var a22: f64 = load64(a + 80);
    var a23: f64 = load64(a + 88);
    var a30: f64 = load64(a + 96);
    var a31: f64 = load64(a + 104);
    var a32: f64 = load64(a + 112);
    var a33: f64 = load64(a + 120);
    var b00: f64 = load64(b + 0);
    var b01: f64 = load64(b + 8);
    var b02: f64 = load64(b + 16);
    var b03: f64 = load64(b + 24);
    var b10: f64 = load64(b + 32);
    var b11: f64 = load64(b + 40);
    var b12: f64 = load64(b + 48);
    var b13: f64 = load64(b + 56);
    var b20: f64 = load64(b + 64);
    var b21: f64 = load64(b + 72);
    var b22: f64 = load64(b + 80);
    var b23: f64 = load64(b + 88);
    var b30: f64 = load64(b + 96);
    var b31: f64 = load64(b + 104);
    var b32: f64 = load64(b + 112);
    var b33: f64 = load64(b + 120);
    var z: f64 = 0.0;
    var r00: f64 = (((z + (a00 * b00)) + (a10 * b01)) + (a20 * b02)) + (a30 * b03);
    var r01: f64 = (((z + (a01 * b00)) + (a11 * b01)) + (a21 * b02)) + (a31 * b03);
    var r02: f64 = (((z + (a02 * b00)) + (a12 * b01)) + (a22 * b02)) + (a32 * b03);
    var r03: f64 = (((z + (a03 * b00)) + (a13 * b01)) + (a23 * b02)) + (a33 * b03);
    var r10: f64 = (((z + (a00 * b10)) + (a10 * b11)) + (a20 * b12)) + (a30 * b13);
    var r11: f64 = (((z + (a01 * b10)) + (a11 * b11)) + (a21 * b12)) + (a31 * b13);
    var r12: f64 = (((z + (a02 * b10)) + (a12 * b11)) + (a22 * b12)) + (a32 * b13);
    var r13: f64 = (((z + (a03 * b10)) + (a13 * b11)) + (a23 * b12)) + (a33 * b13);
    var r20: f64 = (((z + (a00 * b20)) + (a10 * b21)) + (a20 * b22)) + (a30 * b23);
    var r21: f64 = (((z + (a01 * b20)) + (a11 * b21)) + (a21 * b22)) + (a31 * b23);
    var r22: f64 = (((z + (a02 * b20)) + (a12 * b21)) + (a22 * b22)) + (a32 * b23);
    var r23: f64 = (((z + (a03 * b20)) + (a13 * b21)) + (a23 * b22)) + (a33 * b23);
    var r30: f64 = (((z + (a00 * b30)) + (a10 * b31)) + (a20 * b32)) + (a30 * b33);
    var r31: f64 = (((z + (a01 * b30)) + (a11 * b31)) + (a21 * b32)) + (a31 * b33);
    var r32: f64 = (((z + (a02 * b30)) + (a12 * b31)) + (a22 * b32)) + (a32 * b33);
    var r33: f64 = (((z + (a03 * b30)) + (a13 * b31)) + (a23 * b32)) + (a33 * b33);
    store32(out + 0, f32_from(r00));
    store32(out + 4, f32_from(r01));
    store32(out + 8, f32_from(r02));
    store32(out + 12, f32_from(r03));
    store32(out + 16, f32_from(r10));
    store32(out + 20, f32_from(r11));
    store32(out + 24, f32_from(r12));
    store32(out + 28, f32_from(r13));
    store32(out + 32, f32_from(r20));
    store32(out + 36, f32_from(r21));
    store32(out + 40, f32_from(r22));
    store32(out + 44, f32_from(r23));
    store32(out + 48, f32_from(r30));
    store32(out + 52, f32_from(r31));
    store32(out + 56, f32_from(r32));
    store32(out + 60, f32_from(r33));
    return out;
}

# perspective_90(near, far) as 16 f64 at m: sr_perspective_90's entries unrounded (the identity, with its WARN event,
# when |near − far| < 1e-10).
fn _sr_persp90_64(near, far, m) {
    var zero: f64 = 0.0;
    var one: f64 = 1.0;
    var i = 0;
    while (i < 16) {
        store64(m + i * 8, zero);
        i = i + 1;
    }
    store64(m, one);
    store64(m + 40, one);
    var n: f64 = f32_to(near & 0xFFFFFFFF);
    var f: f64 = f32_to(far & 0xFFFFFFFF);
    var diff: f64 = n - f;
    var adiff: f64 = _sr_abs64(diff);
    if (adiff < _SR_1E_10) {
        _sr_warn("soorat::math_util: perspective_90: near ≈ far — returning identity matrix");
        store64(m + 80, one);
        store64(m + 120, one);
        return m;
    }
    var nf: f64 = one / diff;
    var m10: f64 = f * nf;
    var m14: f64 = (n * f) * nf;
    var m11: f64 = zero - one;
    store64(m + 80, m10);
    store64(m + 88, m11);
    store64(m + 112, m14);
    return m;
}

# look_at(pos, dir, up) as 16 f64 at m: sr_look_at's entries unrounded.
fn _sr_look_at64(pos, dir, up, m) {
    var zero: f64 = 0.0;
    var one: f64 = 1.0;
    var m1: f64 = zero - one;
    var dx: f64 = f32_to(load32(dir));
    var dy: f64 = f32_to(load32(dir + 4));
    var dz: f64 = f32_to(load32(dir + 8));
    var fl: f64 = f64_sqrt(((dx * dx) + (dy * dy)) + (dz * dz));
    var f0: f64 = zero;
    var f1: f64 = zero;
    var f2: f64 = one;
    if (_sr_tiny(fl) == 0) {
        f0 = dx / fl;
        f1 = dy / fl;
        f2 = dz / fl;
    }
    var w0: f64 = f32_to(load32(up));
    var w1: f64 = f32_to(load32(up + 4));
    var w2: f64 = f32_to(load32(up + 8));
    var cx: f64 = (f1 * w2) - (f2 * w1);
    var cy: f64 = (f2 * w0) - (f0 * w2);
    var cz: f64 = (f0 * w1) - (f1 * w0);
    var sl: f64 = f64_sqrt(((cx * cx) + (cy * cy)) + (cz * cz));
    var s0: f64 = zero;
    var s1: f64 = zero;
    var s2: f64 = one;
    if (_sr_tiny(sl) == 0) {
        s0 = cx / sl;
        s1 = cy / sl;
        s2 = cz / sl;
    }
    var u0: f64 = (s1 * f2) - (s2 * f1);
    var u1: f64 = (s2 * f0) - (s0 * f2);
    var u2: f64 = (s0 * f1) - (s1 * f0);
    var p0: f64 = f32_to(load32(pos));
    var p1: f64 = f32_to(load32(pos + 4));
    var p2: f64 = f32_to(load32(pos + 8));
    var tx: f64 = ((s0 * p0) + (s1 * p1)) + (s2 * p2);
    var ty: f64 = ((u0 * p0) + (u1 * p1)) + (u2 * p2);
    var tz: f64 = ((f0 * p0) + (f1 * p1)) + (f2 * p2);
    store64(m, s0);
    store64(m + 8, u0);
    store64(m + 16, m1 * f0);
    store64(m + 24, zero);
    store64(m + 32, s1);
    store64(m + 40, u1);
    store64(m + 48, m1 * f1);
    store64(m + 56, zero);
    store64(m + 64, s2);
    store64(m + 72, u2);
    store64(m + 80, m1 * f2);
    store64(m + 88, zero);
    store64(m + 96, m1 * tx);
    store64(m + 104, m1 * ty);
    store64(m + 112, tz);
    store64(m + 120, one);
    return m;
}

# The six cube-face directions and up vectors (f32), +X, −X, +Y, −Y, +Z, −Z: Rust's table.
var _sr_cube_faces_data: u8[144];
var _SR_CUBE_FACES = &_sr_cube_faces_data;
var _sr_cube_faces_ready = _sr_cube_faces_init();
fn _sr_cube_faces_init(): i64 {
    var p = _SR_CUBE_FACES;
    var one = 0x3F800000;
    var m1 = 0xBF800000;
    _sr_face_set(p, one, 0, 0, 0, m1, 0);
    _sr_face_set(p + 24, m1, 0, 0, 0, m1, 0);
    _sr_face_set(p + 48, 0, one, 0, 0, 0, one);
    _sr_face_set(p + 72, 0, m1, 0, 0, 0, m1);
    _sr_face_set(p + 96, 0, 0, one, 0, m1, 0);
    _sr_face_set(p + 120, 0, 0, m1, 0, m1, 0);
    return 1;
}

# Writes a face's direction (dx, dy, dz) and up (ux, uy, uz), f32 bits, at p.
fn _sr_face_set(p, dx, dy, dz, ux, uy, uz) {
    store32(p, dx);
    store32(p + 4, dy);
    store32(p + 8, dz);
    store32(p + 12, ux);
    store32(p + 16, uy);
    store32(p + 20, uz);
    return p;
}

# The six cube-face view-projection matrices of a point light at position (3 f32) with depth range [near, far]
# (f32 bits), into out (an SrPointShadowMap): perspective_90(near, far) · look_at(position, face, up) for +X, −X, +Y,
# −Y, +Z, −Z, both factors and the product in f64, rounded once (class E). Mirrors `PointShadowMap::new`.
fn SrPointShadowMap_new(position, near, far, out) {
    var proj[128];
    var view[128];
    _sr_persp90_64(near, far, &proj);
    var i = 0;
    while (i < 6) {
        var fp = _SR_CUBE_FACES + i * 24;
        _sr_look_at64(position, fp, fp + 12, &view);
        _sr_mul64x64_round(&proj, &view, out + i * 64);
        i = i + 1;
    }
    return out;
}

# ── the atlas ────────────────────────────────────────────────────────────────────────

# Tiles per atlas row: size / max(tile_size, 1), at least 1 (u32). Mirrors `atlas_columns`.
#must_use
fn sr_atlas_columns(size, tile_size): i64 {
    var t = tile_size & 0xFFFFFFFF;
    if (t < 1) { t = 1; }
    var c = (size & 0xFFFFFFFF) / t;
    if (c < 1) { c = 1; }
    return c;
}

# a · b saturated to u32::MAX, for u32 a and b.
#must_use
fn _sr_sat_mul_u32(a, b): i64 {
    if (b != 0 && a > 4294967295 / b) { return 4294967295; }
    return a * b;
}

# The pixel viewport (x, y, w, h) of tile index in an atlas with columns tiles per row (at least 1) of tile_size
# pixels, as 4 u32 at out: x and y saturate at u32::MAX. Mirrors `tile_viewport_in`.
fn sr_tile_viewport_in(columns, tile_size, index, out) {
    var c = columns & 0xFFFFFFFF;
    if (c < 1) { c = 1; }
    var t = tile_size & 0xFFFFFFFF;
    var i = index & 0xFFFFFFFF;
    store32(out, _sr_sat_mul_u32(i % c, t));
    store32(out + 4, _sr_sat_mul_u32(i / c, t));
    store32(out + 8, t);
    store32(out + 12, t);
    return out;
}

# The UV rectangle (u, v, w, h) of tile index, as 4 f32 at out: scale = tile_size / max(size, 1) and (col·scale,
# row·scale, scale, scale), in f32 as Rust's (`as f32` one rounding each). Mirrors `tile_uv_in`.
fn sr_tile_uv_in(columns, tile_size, size, index, out) {
    var c = columns & 0xFFFFFFFF;
    if (c < 1) { c = 1; }
    var s = size & 0xFFFFFFFF;
    if (s < 1) { s = 1; }
    var i = index & 0xFFFFFFFF;
    var scale = _sr_f32_div(_sr_i64_to_f32(tile_size & 0xFFFFFFFF), _sr_i64_to_f32(s));
    store32(out, _sr_f32_mul(_sr_i64_to_f32(i % c), scale));
    store32(out + 4, _sr_f32_mul(_sr_i64_to_f32(i / c), scale));
    store32(out + 8, scale);
    store32(out + 12, scale);
    return out;
}

# Tile index's viewport in the atlas config (an SrShadowAtlasConfig), as 4 u32 at out. Mirrors `tile_viewport`.
fn sr_tile_viewport(config, index, out) {
    var t = load64(config + 8);
    return sr_tile_viewport_in(sr_atlas_columns(load64(config), t), t, index, out);
}

# Tile index's UV rectangle in the atlas config, as 4 f32 at out. Mirrors `tile_uv`.
fn sr_tile_uv(config, index, out) {
    var t = load64(config + 8);
    return sr_tile_uv_in(sr_atlas_columns(load64(config), t), t, load64(config), index, out);
}

# --- env_cpu.cyr ---

# env_cpu.cyr — Rust 1.2.0's src/environment.rs, its CPU half (M4 part b): the cube faces' codecs, the 2×2 box
# downsample and the CPU mip chain, with mabda's `mip_level_count`. The environment map and the IBL bind group are GPU
# objects (M7). Rust keeps these crate-private; the golden rows reach them through the oracle hooks.
#
# A face is RGBA8 sRGB (SR_FACE_SRGB8, 4 bytes a texel) or RGBA16 float (SR_FACE_F16, 8). Decoding reads the sRGB
# table and the f16 conversion of src/tables.cyr (class A); the box filter is Rust's f32 sequence (class B, exact);
# sRGB encoding is the correctly rounded `linear_to_srgb`'s bytes (class C, bound 0, ADR 0002 #16), found by threshold
# search rather than a pow per channel (ADR 0002 #27).

# A cube face's encoding. Mirrors the crate-private `FaceEncoding`.
enum SrFaceEncoding {
    SR_FACE_SRGB8 = 0;
    SR_FACE_F16 = 1;
}

# The mip levels of a w × h texture: ⌊log₂ max(w, h)⌋ + 1, or 1 for a zero edge. Mirrors mabda's `mip_level_count`
# (soorat's `texture::mip_level_count` re-exports it).
#must_use
fn sr_mip_level_count(width, height): i64 {
    var w = width & 0xFFFFFFFF;
    var h = height & 0xFFFFFFFF;
    if (w == 0 || h == 0) { return 1; }
    var m = w;
    if (h > m) { m = h; }
    var n = 0;
    while (m > 0) {
        n = n + 1;
        m = m >> 1;
    }
    return n;
}

# Bytes per texel of the encoding enc: 4 or 8.
#must_use
fn sr_face_bytes_per_texel(enc): i64 {
    if (enc == SR_FACE_F16) { return 8; }
    return 4;
}

# Decodes the len bytes at bytes (a trailing partial texel ignored) into linear RGBA texels (4 f32 each) at out;
# returns how many. sRGB: the colour bytes through the decode table, alpha / 255 in f32. f16: each half widened.
# Mirrors `FaceEncoding::decode`.
fn sr_face_decode(enc, bytes, len, out): i64 {
    var bpt = sr_face_bytes_per_texel(enc);
    var n = len / bpt;
    var k = 0;
    var f255 = 0x437F0000;
    while (k < n) {
        var p = bytes + k * bpt;
        var q = out + k * 16;
        if (enc == SR_FACE_F16) {
            store32(q, _sr_f16_to_f32(load16(p)));
            store32(q + 4, _sr_f16_to_f32(load16(p + 2)));
            store32(q + 8, _sr_f16_to_f32(load16(p + 4)));
            store32(q + 12, _sr_f16_to_f32(load16(p + 6)));
        } else {
            store32(q, _sr_srgb8_decode(load8(p)));
            store32(q + 4, _sr_srgb8_decode(load8(p + 1)));
            store32(q + 8, _sr_srgb8_decode(load8(p + 2)));
            store32(q + 12, _sr_f32_div(_sr_gl_u8f(load8(p + 3)), f255));
        }
        k = k + 1;
    }
    return n;
}

# The f32 bits of the byte b.
#must_use
fn _sr_gl_u8f(b): i64 { return f32_from(f64_from(b & 0xFF)); }

# The sRGB byte of the linear l (f32 bits) the direct way: `(linear_to_srgb(l).clamp(0, 1) · 255).round() as u8`, with
# linear_to_srgb's pow correctly rounded (about 270 ns).
#must_use
fn _sr_srgb_byte_direct(l): i64 {
    return _sr_color_q8(_sr_linear_to_srgb(l));
}

# The 255 encode thresholds: entry k (1 … 255) is the smallest non-negative f32 (bits) whose sRGB byte is at least k.
# Found once, by binary search over the f32 bit patterns with the direct encoding (about 2 ms).
var _sr_srgb_thr = 0;
fn _sr_srgb_thresholds(): i64 {
    if (_sr_srgb_thr != 0) { return _sr_srgb_thr; }
    var t = alloc(256 * 8);
    if (t == 0) { return 0; }
    var k = 1;
    while (k < 256) {
        var lo = 0;
        var hi = 0x7F800000;
        while (lo < hi) {
            var mid = lo + (hi - lo) / 2;
            if (_sr_srgb_byte_direct(mid) >= k) { hi = mid; } else { lo = mid + 1; }
        }
        store64(t + k * 8, lo);
        k = k + 1;
    }
    _sr_srgb_thr = t;
    return t;
}

# The sRGB byte of the linear l (f32 bits), bit-identical to _sr_srgb_byte_direct without its pow: the count of
# thresholds at or below l. Exact because the byte is a non-decreasing function of l: linear_to_srgb is monotone on
# each side of its knee (a correctly rounded pow, then a positive scale and a constant offset), and at the knee both
# sides encode to byte 10, far from a rounding boundary; the clamp and the rounding are monotone. NaN, −0 and the
# negatives give 0, as the direct encoding does.
#must_use
fn _sr_srgb_byte(l): i64 {
    var b = l & 0xFFFFFFFF;
    if (b >= 0x7F800001) { return 0; }
    var t = _sr_srgb_thresholds();
    if (t == 0) { return _sr_srgb_byte_direct(b); }
    var lo = 0;
    var hi = 255;
    while (lo < hi) {
        var mid = (lo + hi + 1) / 2;
        if (load64(t + mid * 8) <= b) { lo = mid; } else { hi = mid - 1; }
    }
    return lo;
}

# Encodes the n linear RGBA texels at texels into out; returns the bytes written. sRGB: each colour channel
# `(linear_to_srgb(c).clamp(0, 1) · 255).round() as u8`, alpha without the transfer. f16: each channel to its half,
# little-endian. The sRGB bytes come from the encode thresholds (_sr_srgb_byte), which give the direct encoding's bytes
# without its pow. Mirrors `FaceEncoding::encode`.
fn sr_face_encode(enc, texels, n, out): i64 {
    var bpt = sr_face_bytes_per_texel(enc);
    var k = 0;
    while (k < n) {
        var t = texels + k * 16;
        var q = out + k * bpt;
        if (enc == SR_FACE_F16) {
            var c = 0;
            while (c < 4) {
                var h = _sr_f32_to_f16(load32(t + c * 4));
                store8(q + c * 2, h & 0xFF);
                store8(q + c * 2 + 1, (h >> 8) & 0xFF);
                c = c + 1;
            }
        } else {
            store8(q, _sr_srgb_byte(load32(t)));
            store8(q + 1, _sr_srgb_byte(load32(t + 4)));
            store8(q + 2, _sr_srgb_byte(load32(t + 8)));
            store8(q + 3, _sr_color_q8(load32(t + 12)));
        }
        k = k + 1;
    }
    return n * bpt;
}

# The 2×2 box downsample of the size × size linear image src (n texels) into out: max(size / 2, 1)² texels, each
# channel 0.25 · (((a + b) + c) + d) in f32 over the block at (2x, 2y), an odd edge clamped to the last texel. Returns
# the texels written: 0 for size 0 or n < size². Mirrors `downsample`.
fn sr_downsample(src, n, size, out): i64 {
    if (size <= 0 || n < size * size) { return 0; }
    var last = size - 1;
    var dst = size / 2;
    if (dst < 1) { dst = 1; }
    var quarter = 0x3E800000;
    var y = 0;
    while (y < dst) {
        var y0 = 2 * y;
        if (y0 > last) { y0 = last; }
        var y1 = 2 * y + 1;
        if (y1 > last) { y1 = last; }
        var x = 0;
        while (x < dst) {
            var x0 = 2 * x;
            if (x0 > last) { x0 = last; }
            var x1 = 2 * x + 1;
            if (x1 > last) { x1 = last; }
            var a = src + (y0 * size + x0) * 16;
            var b = src + (y0 * size + x1) * 16;
            var c = src + (y1 * size + x0) * 16;
            var d = src + (y1 * size + x1) * 16;
            var o = out + (y * dst + x) * 16;
            var ch = 0;
            while (ch < 16) {
                var ab = _sr_f32_add(load32(a + ch), load32(b + ch));
                var s = _sr_f32_add(_sr_f32_add(ab, load32(c + ch)), load32(d + ch));
                store32(o + ch, _sr_f32_mul(quarter, s));
                ch = ch + 4;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return dst * dst;
}

# The CPU mip chain of one size × size face (len bytes at face, encoding enc): levels 1 … mip_count − 1, each the box
# filter of the one before in linear space, encoded. Into out, 24 bytes a level (edge size, bytes pointer, byte
# length), every buffer from the allocator a. Returns the level count (0 when mip_count ≤ 1), or −1 when an allocation
# fails. A face shorter than size² texels gives empty levels, as in Rust. Mirrors `face_mip_chain`.
fn sr_face_mip_chain(enc, face, len, size, mip_count, a, out): i64 {
    if (mip_count <= 1) { return 0; }
    var bpt = sr_face_bytes_per_texel(enc);
    var n = len / bpt;
    var level = alloc_via(a, n * 16 + 16);
    var next = alloc_via(a, n * 16 + 16);
    if (level == 0 || next == 0) { return 0 - 1; }
    n = sr_face_decode(enc, face, len, level);
    var ls = size;
    var i = 1;
    while (i < mip_count) {
        var m = sr_downsample(level, n, ls, next);
        ls = ls / 2;
        if (ls < 1) { ls = 1; }
        var bytes = alloc_via(a, m * bpt + 8);
        if (bytes == 0) { return 0 - 1; }
        var bl = sr_face_encode(enc, next, m, bytes);
        var o = out + (i - 1) * 24;
        store64(o, ls);
        store64(o + 8, bytes);
        store64(o + 16, bl);
        var t = level;
        level = next;
        next = t;
        n = m;
        i = i + 1;
    }
    return mip_count - 1;
}

# --- pbr_material.cyr ---

# pbr_material.cyr — Rust 1.2.0's src/pbr_material.rs, its core half (M4 part b): MaterialUniforms' constructors. The
# layout is src/layout.cyr's (M1); the `optics` half (`from_ior`, the BRDF LUT) is src/pbr_optics.cyr.

# White, non-metallic, roughness 0.5, the pads 0, into out (an SrMaterialUniforms). Mirrors
# `impl Default for MaterialUniforms`.
fn SrMaterialUniforms_default(out) {
    store64(out, 0x3F8000003F800000);
    store64(out + 8, 0x3F8000003F800000);
    store32(out + 16, 0);
    store32(out + 20, 0x3F000000);
    store64(out + 24, 0);
    return out;
}

# A material of base_color (an SrColor) with metallic (f32 bits) and roughness, the pads 0, into out.
fn _sr_material(base_color, metallic, roughness, out) {
    _sr_copy16(out, base_color);
    store32(out + 16, metallic);
    store32(out + 20, roughness & 0xFFFFFFFF);
    store64(out + 24, 0);
    return out;
}

# A dielectric (metallic 0). Mirrors `MaterialUniforms::dielectric`.
fn SrMaterialUniforms_dielectric(base_color, roughness, out) {
    return _sr_material(base_color, 0, roughness, out);
}

# A metal (metallic 1). Mirrors `MaterialUniforms::metal`.
fn SrMaterialUniforms_metal(base_color, roughness, out) {
    return _sr_material(base_color, 0x3F800000, roughness, out);
}

# --- render_graph.cyr ---

# render_graph.cyr — Rust 1.2.0's src/render_graph.rs (M4 part c): named render passes with dependencies, ordered for
# execution.
#
# soorat's own CPU code, not mabda's `rg_*`. mabda's render graph records GPU work (compute, render and copy nodes with
# the resources each reads and writes); this one orders named passes, as Rust's does (ADR 0002 #28).
#
# **Ownership.** SrRenderGraph_new returns a graph from the freelist; free it with SrRenderGraph_drop. A pass's name and
# its dependencies' names are the graph's own copies, as Rust's `String`s are, so the caller's text may go. A name is
# bytes with a length (any byte, NUL included), and each copy is NUL-terminated as well. Every pass is an
# SrRenderPassNode at a fixed address for the graph's life: `get_pass` and `execution_order` hand out those pointers.
# Its `dependencies` point at `dep_count` (name, length) pairs, 16 bytes apart.
#
# **Lookup** scans the passes by length and bytes, where Rust hashes. A graph holds tens of passes, and the scan
# allocates nothing.
#
# **Order.** `execution_order` is Rust's depth-first search made iterative, so the order is Rust's for every graph,
# with no recursion and no allocation. Each pass carries the search's scratch: `_mark` (0 unvisited, 1 on the path,
# 2 done), `_next` (the dependency it reaches next) and `_parent` (the pass that reached it). The search skips a
# dependency on a missing or disabled pass, and one that closes a cycle (with a WARN event, as Rust warns), so cyclic
# passes still run, in the order the search finishes them.

enum SrPassType {
    SR_PASS_TYPE_SHADOW = 0;
    SR_PASS_TYPE_GEOMETRY = 1;
    SR_PASS_TYPE_SSAO = 2;
    SR_PASS_TYPE_BLOOM = 3;
    SR_PASS_TYPE_POST_PROCESS = 4;
    SR_PASS_TYPE_DEBUG = 5;
    SR_PASS_TYPE_UI = 6;
    SR_PASS_TYPE_COMPUTE = 7;
    SR_PASS_TYPE_CUSTOM = 8;
}

struct SrRenderPassNode { name; name_len; dependencies; dep_count; dep_cap; pass_type; enabled; _mark; _next; _parent; }
struct SrRenderGraph { nodes; count; cap; }

# SrRenderPassNode field offsets.
const _SR_RP_NAME = 0;
const _SR_RP_LEN = 8;
const _SR_RP_DEPS = 16;
const _SR_RP_DCOUNT = 24;
const _SR_RP_DCAP = 32;
const _SR_RP_TYPE = 40;
const _SR_RP_ON = 48;
const _SR_RP_MARK = 56;
const _SR_RP_NEXT = 64;
const _SR_RP_PARENT = 72;

# A NUL-terminated copy of the len bytes at p from the freelist, or 0 when the allocation fails.
#must_use
fn _sr_rg_copy(p, len): i64 {
    var c = fl_alloc(len + 1);
    if (c == 0) { return 0; }
    memcpy(c, p, len);
    store8(c + len, 0);
    return c;
}

# The pass of g named by the len bytes at p, or 0.
#must_use
fn _sr_rg_find(g, p, len): i64 {
    var nodes = load64(g);
    var n = load64(g + 8);
    var i = 0;
    while (i < n) {
        var nd = load64(nodes + i * 8);
        if (load64(nd + _SR_RP_LEN) == len && memeq(load64(nd + _SR_RP_NAME), p, len) == 1) { return nd; }
        i = i + 1;
    }
    return 0;
}

# Frees a pass, its name and its dependency names.
fn _sr_rg_node_free(nd) {
    var deps = load64(nd + _SR_RP_DEPS);
    var n = load64(nd + _SR_RP_DCOUNT);
    var k = 0;
    while (k < n) {
        fl_free(load64(deps + k * 16));
        k = k + 1;
    }
    if (deps != 0) { fl_free(deps); }
    fl_free(load64(nd + _SR_RP_NAME));
    fl_free(nd);
    return 0;
}

# An empty graph: an SrRenderGraph to free with SrRenderGraph_drop, or 0 when the allocation fails. Mirrors
# `RenderGraph::new`.
#must_use
fn SrRenderGraph_new(): i64 {
    return fl_calloc(sizeof(SrRenderGraph));
}

# An empty graph, as SrRenderGraph_new. Mirrors `impl Default for RenderGraph`.
#must_use
fn SrRenderGraph_default(): i64 {
    return SrRenderGraph_new();
}

# Frees g, its passes and their names (0 is ignored). The pass pointers it handed out go with it.
fn SrRenderGraph_drop(g) {
    if (g == 0) { return 0; }
    var nodes = load64(g);
    var n = load64(g + 8);
    var i = 0;
    while (i < n) {
        _sr_rg_node_free(load64(nodes + i * 8));
        i = i + 1;
    }
    if (nodes != 0) { fl_free(nodes); }
    fl_free(g);
    return 0;
}

# Adds a pass named by the len bytes at name, of pass_type (an SR_PASS_TYPE_*), enabled and with no dependencies.
# Re-adding a name sets that pass's type and enables it, keeping its dependencies (with a DEBUG event), rather than
# adding a second pass. 1, or 0 when an allocation fails (the graph is unchanged). Mirrors `RenderGraph::add_pass`.
fn SrRenderGraph_add_pass(g, name, len, pass_type): i64 {
    var nd = _sr_rg_find(g, name, len);
    if (nd != 0) {
        _sr_debug("soorat::render_graph: render graph pass re-added — updating in place");
        store64(nd + _SR_RP_TYPE, pass_type);
        store64(nd + _SR_RP_ON, 1);
        return 1;
    }
    var n = load64(g + 8);
    var cap = load64(g + 16);
    if (n == cap) {
        var ncap = cap * 2;
        if (ncap < 4) { ncap = 4; }
        var p = fl_alloc(ncap * 8);
        if (p == 0) { return 0; }
        var old = load64(g);
        if (old != 0) {
            memcpy(p, old, n * 8);
            fl_free(old);
        }
        store64(g, p);
        store64(g + 16, ncap);
    }
    nd = fl_calloc(sizeof(SrRenderPassNode));
    if (nd == 0) { return 0; }
    var c = _sr_rg_copy(name, len);
    if (c == 0) {
        fl_free(nd);
        return 0;
    }
    store64(nd + _SR_RP_NAME, c);
    store64(nd + _SR_RP_LEN, len);
    store64(nd + _SR_RP_TYPE, pass_type);
    store64(nd + _SR_RP_ON, 1);
    store64(load64(g) + n * 8, nd);
    store64(g + 8, n + 1);
    return 1;
}

# Makes the pass named by pass (pass_len bytes) depend on the one named by dep (dep_len bytes), which then runs first.
# The dependency is a name: it may name a pass added later, or none. A pass that isn't in g is ignored, as in Rust.
# 1, or 0 when an allocation fails (the graph is unchanged). Mirrors `RenderGraph::add_dependency`.
fn SrRenderGraph_add_dependency(g, pass, pass_len, dep, dep_len): i64 {
    var nd = _sr_rg_find(g, pass, pass_len);
    if (nd == 0) { return 1; }
    var n = load64(nd + _SR_RP_DCOUNT);
    var cap = load64(nd + _SR_RP_DCAP);
    if (n == cap) {
        var ncap = cap * 2;
        if (ncap < 4) { ncap = 4; }
        var p = fl_alloc(ncap * 16);
        if (p == 0) { return 0; }
        var old = load64(nd + _SR_RP_DEPS);
        if (old != 0) {
            memcpy(p, old, n * 16);
            fl_free(old);
        }
        store64(nd + _SR_RP_DEPS, p);
        store64(nd + _SR_RP_DCAP, ncap);
    }
    var c = _sr_rg_copy(dep, dep_len);
    if (c == 0) { return 0; }
    var at = load64(nd + _SR_RP_DEPS) + n * 16;
    store64(at, c);
    store64(at + 8, dep_len);
    store64(nd + _SR_RP_DCOUNT, n + 1);
    return 1;
}

# Enables (enabled non-zero) or disables the pass named by the len bytes at name; a name not in g is ignored. Mirrors
# `RenderGraph::set_enabled`.
fn SrRenderGraph_set_enabled(g, name, len, enabled) {
    var nd = _sr_rg_find(g, name, len);
    if (nd == 0) { return 0; }
    var on = 0;
    if (enabled != 0) { on = 1; }
    store64(nd + _SR_RP_ON, on);
    return 0;
}

# Writes the enabled passes in execution order to out (room for SrRenderGraph_pass_count(g) pass pointers) and
# returns how many: every pass after the passes it depends on, the passes taken in the order they were added. A
# disabled pass is left out and not searched through. A dependency that closes a cycle is skipped with a WARN event.
# Mirrors `RenderGraph::execution_order`, which returns the passes' names.
fn SrRenderGraph_execution_order(g, out): i64 {
    _sr_debug("soorat::render_graph: computing render graph execution order");
    var nodes = load64(g);
    var n = load64(g + 8);
    var i = 0;
    while (i < n) {
        store64(load64(nodes + i * 8) + _SR_RP_MARK, 0);
        i = i + 1;
    }
    var k = 0;
    i = 0;
    while (i < n) {
        var cur = load64(nodes + i * 8);
        if (load64(cur + _SR_RP_MARK) == 0 && load64(cur + _SR_RP_ON) != 0) {
            store64(cur + _SR_RP_MARK, 1);
            store64(cur + _SR_RP_NEXT, 0);
            store64(cur + _SR_RP_PARENT, 0);
            while (cur != 0) {
                var nx = load64(cur + _SR_RP_NEXT);
                if (nx < load64(cur + _SR_RP_DCOUNT)) {
                    store64(cur + _SR_RP_NEXT, nx + 1);
                    var de = load64(cur + _SR_RP_DEPS) + nx * 16;
                    var d = _sr_rg_find(g, load64(de), load64(de + 8));
                    if (d != 0 && load64(d + _SR_RP_ON) != 0 && load64(d + _SR_RP_MARK) != 2) {
                        if (load64(d + _SR_RP_MARK) == 1) {
                            _sr_warn("soorat::render_graph: render graph cycle detected — skipping cyclic dependency");
                        } else {
                            store64(d + _SR_RP_MARK, 1);
                            store64(d + _SR_RP_NEXT, 0);
                            store64(d + _SR_RP_PARENT, cur);
                            cur = d;
                        }
                    }
                } else {
                    store64(cur + _SR_RP_MARK, 2);
                    store64(out + k * 8, cur);
                    k = k + 1;
                    cur = load64(cur + _SR_RP_PARENT);
                }
            }
        }
        i = i + 1;
    }
    return k;
}

# The pass named by the len bytes at name (an SrRenderPassNode), or 0 for None. Mirrors `RenderGraph::get_pass`.
#must_use
fn SrRenderGraph_get_pass(g, name, len): i64 {
    return _sr_rg_find(g, name, len);
}

# The number of passes. Mirrors `RenderGraph::pass_count`.
#must_use
fn SrRenderGraph_pass_count(g): i64 {
    return load64(g + 8);
}

# The number of enabled passes. Mirrors `RenderGraph::enabled_count`.
#must_use
fn SrRenderGraph_enabled_count(g): i64 {
    var nodes = load64(g);
    var n = load64(g + 8);
    var c = 0;
    var i = 0;
    while (i < n) {
        if (load64(load64(nodes + i * 8) + _SR_RP_ON) != 0) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# Adds the pass named by the C string name: 1, or 0 when an allocation fails.
fn _sr_rg_add(g, name, pass_type): i64 {
    return SrRenderGraph_add_pass(g, name, strlen(name), pass_type);
}

# Makes the pass named by the C string pass depend on the C string dep: 1, or 0 when an allocation fails.
fn _sr_rg_dep(g, pass, dep): i64 {
    return SrRenderGraph_add_dependency(g, pass, strlen(pass), dep, strlen(dep));
}

# The standard forward graph: shadow, geometry, debug, ui and post_process, each depending on the one before. A graph
# to free with SrRenderGraph_drop, or 0 when an allocation fails. Mirrors `RenderGraph::forward`.
#must_use
fn SrRenderGraph_forward(): i64 {
    var g = SrRenderGraph_new();
    if (g == 0) { return 0; }
    var ok = _sr_rg_add(g, "shadow", SR_PASS_TYPE_SHADOW);
    ok = ok & _sr_rg_add(g, "geometry", SR_PASS_TYPE_GEOMETRY);
    ok = ok & _sr_rg_dep(g, "geometry", "shadow");
    ok = ok & _sr_rg_add(g, "debug", SR_PASS_TYPE_DEBUG);
    ok = ok & _sr_rg_dep(g, "debug", "geometry");
    ok = ok & _sr_rg_add(g, "ui", SR_PASS_TYPE_UI);
    ok = ok & _sr_rg_dep(g, "ui", "debug");
    ok = ok & _sr_rg_add(g, "post_process", SR_PASS_TYPE_POST_PROCESS);
    ok = ok & _sr_rg_dep(g, "post_process", "ui");
    if (ok == 0) {
        SrRenderGraph_drop(g);
        return 0;
    }
    return g;
}

# The forward graph with SSAO and bloom after geometry, which post_process also waits for. A graph to free with
# SrRenderGraph_drop, or 0 when an allocation fails. Mirrors `RenderGraph::forward_with_effects`.
#must_use
fn SrRenderGraph_forward_with_effects(): i64 {
    var g = SrRenderGraph_new();
    if (g == 0) { return 0; }
    var ok = _sr_rg_add(g, "shadow", SR_PASS_TYPE_SHADOW);
    ok = ok & _sr_rg_add(g, "geometry", SR_PASS_TYPE_GEOMETRY);
    ok = ok & _sr_rg_dep(g, "geometry", "shadow");
    ok = ok & _sr_rg_add(g, "ssao", SR_PASS_TYPE_SSAO);
    ok = ok & _sr_rg_dep(g, "ssao", "geometry");
    ok = ok & _sr_rg_add(g, "bloom", SR_PASS_TYPE_BLOOM);
    ok = ok & _sr_rg_dep(g, "bloom", "geometry");
    ok = ok & _sr_rg_add(g, "debug", SR_PASS_TYPE_DEBUG);
    ok = ok & _sr_rg_dep(g, "debug", "geometry");
    ok = ok & _sr_rg_add(g, "ui", SR_PASS_TYPE_UI);
    ok = ok & _sr_rg_dep(g, "ui", "debug");
    ok = ok & _sr_rg_add(g, "post_process", SR_PASS_TYPE_POST_PROCESS);
    ok = ok & _sr_rg_dep(g, "post_process", "ssao");
    ok = ok & _sr_rg_dep(g, "post_process", "bloom");
    ok = ok & _sr_rg_dep(g, "post_process", "ui");
    if (ok == 0) {
        SrRenderGraph_drop(g);
        return 0;
    }
    return g;
}

# --- acoustic.cyr ---

# acoustic.cyr — the producer-free half of Rust 1.2.0's src/acoustic_render.rs (M5 part a): its colour mode, the two
# parameter structs and their defaults, and `acoustic_heat_map`. Rust compiles these without the `acoustics` feature,
# so they are in `[lib]`. The renderers, which read goonj's types, are src/acoustic_render.cyr in the
# `[lib.acoustics]` profile.
#
# **Layout.** `SrAcousticVisParams` (32 bytes): color_mode (an SR_ACOUSTIC_COLOR_MODE_*) at 0, base_color (an SrColor)
# at 8, alpha (f32) at 24. `SrDecayCurveParams` (72 bytes): origin as origin_0 … origin_2 (f32, Cyrius has no array
# fields) at 0, time_range, db_range, x_scale and y_scale (f32) at 12–24, steps (a u32 in an 8-byte slot) at 32,
# color_early and color_late (SrColor) at 40 and 56.

enum SrAcousticColorMode {
    SR_ACOUSTIC_COLOR_MODE_PRESSURE = 0;
    SR_ACOUSTIC_COLOR_MODE_SIGNED_PRESSURE = 1;
    SR_ACOUSTIC_COLOR_MODE_ENERGY = 2;
}

struct SrAcousticVisParams { color_mode; base_color: SrColor; alpha: f32; _pad0: f32; }
struct SrDecayCurveParams { origin_0: f32; origin_1: f32; origin_2: f32; time_range: f32; db_range: f32; x_scale: f32;
    y_scale: f32; _pad0: f32; steps; color_early: SrColor; color_late: SrColor; }

# The default parameters into out: Pressure, cornflower blue, alpha 1. Mirrors `impl Default for AcousticVisParams`.
fn SrAcousticVisParams_default(out) {
    store64(out, SR_ACOUSTIC_COLOR_MODE_PRESSURE);
    memcpy(out + 8, SR_COLOR_CORNFLOWER_BLUE, 16);
    store32(out + 24, _SR_C1);
    store32(out + 28, 0);
    return out;
}

# The default decay-curve parameters into out: origin 0, 3 s, −60 dB, scales 1, 100 steps, green early and red late.
# Mirrors `impl Default for DecayCurveParams`.
fn SrDecayCurveParams_default(out) {
    store32(out, 0);
    store32(out + 4, 0);
    store32(out + 8, 0);
    store32(out + 12, 0x40400000);
    store32(out + 16, 0xC2700000);
    store32(out + 20, _SR_C1);
    store32(out + 24, _SR_C1);
    store32(out + 28, 0);
    store64(out + 32, 100);
    memcpy(out + 40, SR_COLOR_GREEN, 16);
    memcpy(out + 56, SR_COLOR_RED, 16);
    return out;
}

# The heat-map colour of t (f32 bits) into out: `visualization_heat_map`'s. Mirrors `acoustic_heat_map`.
fn sr_acoustic_heat_map(t, out) {
    return sr_visualization_heat_map(t, out);
}

# --- thermo.cyr ---

# thermo.cyr — the producer-free half of Rust 1.2.0's src/thermo_render.rs (M5 part c): its colour mode, the two
# parameter structs and their defaults, and `thermal_heat_map`. Rust compiles these without the `thermo` feature, so
# they are in `[lib]`. The renderers, which read ushma's types, are src/thermo_render.cyr in the `[lib.thermo]`
# profile.
#
# **Layout.** `SrThermalVisParams` (32 bytes): color_mode (an SR_THERMAL_COLOR_MODE_*) at 0, base_color (an SrColor)
# at 8, alpha (f32) at 24. `SrCycleDiagramParams` (52 bytes): origin as origin_0 … origin_2 (f32, Cyrius has no array
# fields) at 0, x_scale and y_scale (f32) at 12 and 16, ts_color and pv_color (SrColor) at 20 and 36.

enum SrThermalColorMode {
    SR_THERMAL_COLOR_MODE_TEMPERATURE = 0;
    SR_THERMAL_COLOR_MODE_ALPHA_BLEND = 1;
}

struct SrThermalVisParams { color_mode; base_color: SrColor; alpha: f32; _pad0: f32; }
struct SrCycleDiagramParams { origin_0: f32; origin_1: f32; origin_2: f32; x_scale: f32; y_scale: f32;
    ts_color: SrColor; pv_color: SrColor; }

# The default parameters into out: Temperature, red, alpha 1. Mirrors `impl Default for ThermalVisParams`.
fn SrThermalVisParams_default(out) {
    store64(out, SR_THERMAL_COLOR_MODE_TEMPERATURE);
    memcpy(out + 8, SR_COLOR_RED, 16);
    store32(out + 24, _SR_C1);
    store32(out + 28, 0);
    return out;
}

# The default diagram parameters into out: origin 0, scales 1, a red T-s and a (0.2, 0.5, 1, 1) P-v diagram. Mirrors
# `impl Default for CycleDiagramParams`.
fn SrCycleDiagramParams_default(out) {
    store32(out, 0);
    store32(out + 4, 0);
    store32(out + 8, 0);
    store32(out + 12, _SR_C1);
    store32(out + 16, _SR_C1);
    memcpy(out + 20, SR_COLOR_RED, 16);
    store32(out + 36, 0x3E4CCCCD);
    store32(out + 40, 0x3F000000);
    store32(out + 44, _SR_C1);
    store32(out + 48, _SR_C1);
    return out;
}

# The heat-map colour of t (f32 bits) into out: `visualization_heat_map`'s. Mirrors `thermal_heat_map`.
fn sr_thermal_heat_map(t, out) {
    return sr_visualization_heat_map(t, out);
}

# --- fluid.cyr ---

# fluid.cyr — the producer-free half of Rust 1.2.0's src/fluid_render.rs (M5 part d): its colour mode, the particle
# colour parameters and their defaults, and `fluid_heat_map`. Rust compiles these without the `fluids` feature, so they
# are in `[lib]`. The renderers, which read pravash's types, are src/fluid_render.cyr in the `[lib.fluids]` profile.
#
# **Layout.** `SrParticleColorParams` (48 bytes): color_mode (an SR_FLUID_COLOR_MODE_*) at 0, base_color (an SrColor) at
# 8, max_velocity (f32) at 24, max_density and max_pressure (f64) at 32 and 40.

enum SrFluidColorMode {
    SR_FLUID_COLOR_MODE_SOLID = 0;
    SR_FLUID_COLOR_MODE_VELOCITY = 1;
    SR_FLUID_COLOR_MODE_DENSITY = 2;
    SR_FLUID_COLOR_MODE_PRESSURE = 3;
}

struct SrParticleColorParams { color_mode; base_color: SrColor; max_velocity: f32; _pad0: f32; max_density: f64;
    max_pressure: f64; }

# The default parameters into out: Solid, white, max_velocity 10, max_density and max_pressure 1000. Mirrors
# `impl Default for ParticleColorParams`.
fn SrParticleColorParams_default(out) {
    store64(out, SR_FLUID_COLOR_MODE_SOLID);
    memcpy(out + 8, SR_COLOR_WHITE, 16);
    store32(out + 24, 0x41200000);
    store32(out + 28, 0);
    store64(out + 32, 0x408F400000000000);
    store64(out + 40, 0x408F400000000000);
    return out;
}

# The heat-map colour of t (f32 bits) into out: `visualization_heat_map`'s. Mirrors `fluid_heat_map`.
fn sr_fluid_heat_map(t, out) {
    return sr_visualization_heat_map(t, out);
}
