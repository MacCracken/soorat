    joints_6: SrM4; joints_7: SrM4; joints_8: SrM4; joints_9: SrM4; joints_10: SrM4; joints_11: SrM4; joints_12: SrM4;
    joints_13: SrM4; joints_14: SrM4; joints_15: SrM4; joints_16: SrM4; joints_17: SrM4; joints_18: SrM4;
    joints_19: SrM4; joints_20: SrM4; joints_21: SrM4; joints_22: SrM4; joints_23: SrM4; joints_24: SrM4;
    joints_25: SrM4; joints_26: SrM4; joints_27: SrM4; joints_28: SrM4; joints_29: SrM4; joints_30: SrM4;
    joints_31: SrM4; joints_32: SrM4; joints_33: SrM4; joints_34: SrM4; joints_35: SrM4; joints_36: SrM4;
    joints_37: SrM4; joints_38: SrM4; joints_39: SrM4; joints_40: SrM4; joints_41: SrM4; joints_42: SrM4;
    joints_43: SrM4; joints_44: SrM4; joints_45: SrM4; joints_46: SrM4; joints_47: SrM4; joints_48: SrM4;
    joints_49: SrM4; joints_50: SrM4; joints_51: SrM4; joints_52: SrM4; joints_53: SrM4; joints_54: SrM4;
    joints_55: SrM4; joints_56: SrM4; joints_57: SrM4; joints_58: SrM4; joints_59: SrM4; joints_60: SrM4;
    joints_61: SrM4; joints_62: SrM4; joints_63: SrM4; joints_64: SrM4; joints_65: SrM4; joints_66: SrM4;
    joints_67: SrM4; joints_68: SrM4; joints_69: SrM4; joints_70: SrM4; joints_71: SrM4; joints_72: SrM4;
    joints_73: SrM4; joints_74: SrM4; joints_75: SrM4; joints_76: SrM4; joints_77: SrM4; joints_78: SrM4;
    joints_79: SrM4; joints_80: SrM4; joints_81: SrM4; joints_82: SrM4; joints_83: SrM4; joints_84: SrM4;
    joints_85: SrM4; joints_86: SrM4; joints_87: SrM4; joints_88: SrM4; joints_89: SrM4; joints_90: SrM4;
    joints_91: SrM4; joints_92: SrM4; joints_93: SrM4; joints_94: SrM4; joints_95: SrM4; joints_96: SrM4;
