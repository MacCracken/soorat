# gltf.cyr — Rust 1.2.0's src/gltf_loader.rs `load_gltf_meshes` and src/animation.rs `load_gltf_animations` (M3 part
# c, D6): binary glTF (GLB) and JSON-text glTF on bayan's JSON tree.
#
# **OPTIONAL** (ADR 0002 #25). Rust's `gltf` dependency is unconditional; here the loader is the `[lib.gltf]` profile
# (dist/soorat-gltf.cyr), outside `[lib]`, because bayan carries ~372 KB of tables into any binary that includes it
# (#19). A consumer that loads glTF takes the bundle and adds "bayan" to its stdlib leaves.
#
# **What it reproduces.** Rust's loaders call `gltf::Gltf::from_slice` (gltf 1.4.1, default features: `names` on,
# `extras` and `extensions` off), so their verdict is gltf-json's: serde's types (a missing required field, `null` where
# the field is not an `Option`, a float where an integer goes, an index as `value as u32`) and the derived `validate()`
# (index bounds, enum values, the accessor, primitive, camera, texture and root hooks). `_sr_gv_*` transcribe those
# structs field by field. Then the loaders read the accessors as gltf's reader does: views and strides, sparse
# accessors (a base view or zeros, then gltf's peek-ahead merge), the normalized integer formats (`x as f32 · (1 /
# 255)` and so on, `max(−1)` for the signed ones), a node's matrix decomposed in f32 as `Transform::decomposed` does.
#
# **Where it can't copy Rust** (ADR 0002 #14), the row is named in the harness:
# - Rust 1.2.0 panics on 11 of the corpus's inputs (a stride below the element size, a POSITION accessor out of range,
#   a float or u32 index or rotation type, an i16 UV, an unknown target path on a joint, a channel's node out of range,
#   an image with a view and no MIME type or with neither view nor URI, and, under overflow checks, a header length
#   below 12 or an accessor count of 0). Here each is Err(SR_ERR_MODEL), or a skipped primitive for the count of 0.
# - bayan refuses 3 documents serde accepts: a duplicate key, an integer above i64::MAX, nesting deeper than 128.
# - An object written as a JSON array (serde reads a struct's fields by position) is refused here.
# - A decimal in the JSON reads correctly rounded (bayan's f64, then f32); serde_json misrounds about 1 % of
#   adversarial 20-digit decimals (tests/golden/gltf.cr.tsv).
#
# **API.** `sr_load_gltf_meshes(bytes, len, a, out)` and `sr_load_gltf_animations(bytes, len, a, out)` return 0, or
# SR_ERR_MODEL with the reason in `sr_gltf_last_error()`. Their results (`SrGltfMeshes`, `SrGltfAnimations`) and
# every array in them come from the caller's allocator a: images are copies, keyframe values and tangents point into
# a too. The JSON tree lives on a decode arena, module state reset by each call: not thread-safe. A tree takes about
# 20× its document's size, so cap an untrusted document's size before loading it.

struct SrGltfMeshes { meshes; mesh_count; images; image_count; }
struct SrGltfAnimations { skeletons; skeleton_count; clips; clip_count; }

# ── state ────────────────────────────────────────────────────────────────────────────

var _sr_gl_arena = 0;
var _sr_gl_err = 0;
var _sr_gl_root = 0;
var _sr_gl_bin = 0;
var _sr_gl_bin_len = 0;
# The 13 top-level arrays (tree nodes, 0 when absent) and their lengths, by SR_GL_C_*.
var _sr_gl_coll = 0;
var _sr_gl_clen = 0;

enum SrGltfCollection {
    SR_GL_C_ACCESSORS = 0;
    SR_GL_C_ANIMATIONS = 1;
    SR_GL_C_BUFFERS = 2;
    SR_GL_C_VIEWS = 3;
    SR_GL_C_CAMERAS = 4;
    SR_GL_C_IMAGES = 5;
    SR_GL_C_MATERIALS = 6;
    SR_GL_C_MESHES = 7;
    SR_GL_C_NODES = 8;
    SR_GL_C_SAMPLERS = 9;
    SR_GL_C_SCENES = 10;
    SR_GL_C_SKINS = 11;
    SR_GL_C_TEXTURES = 12;
}

# Why the last load failed (a C string), or 0 after a success.
#must_use
fn sr_gltf_last_error(): i64 { return _sr_gl_err; }

# Records the first failure's reason; returns 0.
fn _sr_gl_fail(msg): i64 {
    if (_sr_gl_err == 0) { _sr_gl_err = msg; }
    return 0;
}

# ── JSON tree helpers ────────────────────────────────────────────────────────────────

#must_use
fn _sr_jg(obj, key): i64 { return bayan_json_v_obj_get_by_cstr(obj, key); }
#must_use
fn _sr_jlen(a): i64 { return bayan_json_v_arr_len(a); }
#must_use
fn _sr_jat(a, i): i64 { return bayan_json_v_arr_get(a, i); }
#must_use
fn _sr_jtag(v): i64 { return bayan_json_v_tag(v); }

# obj's member key unless absent or null: the node, or 0 (Rust's `Option` reads null as None).
#must_use
fn _sr_jopt(obj, key): i64 {
    var v = _sr_jg(obj, key);
    if (v == 0) { return 0; }
    if (_sr_jtag(v) == JTAG_NULL) { return 0; }
    return v;
}

# An integer member read as gltf reads it (validated already): its value, or dflt when absent or null.
#must_use
fn _sr_jint_or(obj, key, dflt): i64 {
    var v = _sr_jopt(obj, key);
    if (v == 0) { return dflt; }
    return bayan_json_v_int(v);
}

# An index member: its value as u32 (`value as u32`, as gltf's Index reads one), or −1 when absent or null.
#must_use
fn _sr_jidx(obj, key): i64 {
    var v = _sr_jopt(obj, key);
    if (v == 0) { return 0 - 1; }
    return bayan_json_v_int(v) & 0xFFFFFFFF;
}

# 1 when the string node s holds the C string lit.
#must_use
fn _sr_jstr_is(s, lit): i64 {
    if (s == 0) { return 0; }
    if (_sr_jtag(s) != JTAG_STR) { return 0; }
    var t = bayan_json_v_str(s);
    var n = strlen(lit);
    if (str_len(t) != n) { return 0; }
    return memeq(str_data(t), lit, n);
}

# Collection c's array node (0 when absent) and length.
#must_use
fn _sr_gl_arr(c): i64 { return load64(_sr_gl_coll + c * 8); }
#must_use
fn _sr_gl_n(c): i64 { return load64(_sr_gl_clen + c * 8); }
#must_use
fn _sr_gl_item(c, i): i64 { return _sr_jat(_sr_gl_arr(c), i); }

# ── the schema (gltf-json 1.4.1) ─────────────────────────────────────────────────────

# How a field may be missing: required, an `Option` (missing or null is None), or `#[serde(default)]` (missing is the
# default, null is refused).
enum SrGltfPresence {
    _SR_F_REQ = 0;
    _SR_F_OPT = 1;
    _SR_F_DEF = 2;
}

# What a field holds.
enum SrGltfKind {
    _SR_K_U64 = 1;
    _SR_K_U32 = 2;
    _SR_K_IDX = 3;
    _SR_K_IDXN = 4;
    _SR_K_IDXS = 5;
    _SR_K_F32 = 6;
    _SR_K_F32N = 7;
    _SR_K_F32S = 8;
    _SR_K_BOOL = 9;
    _SR_K_STR = 10;
    _SR_K_STRS = 11;
    _SR_K_ENUMU = 12;
    _SR_K_ENUMS = 13;
    _SR_K_OBJ = 14;
    _SR_K_OBJS = 15;
    _SR_K_ANY = 16;
    _SR_K_VOID = 17;
    _SR_K_EMPTY = 18;
    _SR_K_ATTRS = 19;
}

# The integer enums (`Checked<_>` read through `visit_u64`, then `value as u32`).
enum SrGltfEnumU {
    _SR_EU_MODE = 1;
    _SR_EU_COMPONENT = 2;
    _SR_EU_INDEX_COMPONENT = 3;
    _SR_EU_MAG = 4;
    _SR_EU_MIN = 5;
    _SR_EU_WRAP = 6;
    _SR_EU_TARGET = 7;
}

# The string enums.
enum SrGltfEnumS {
    _SR_ES_TYPE = 1;
    _SR_ES_INTERP = 2;
    _SR_ES_ALPHA = 3;
    _SR_ES_CAMERA = 4;
}

# 1 when the u32 v is a valid value of the integer enum e.
#must_use
fn _sr_gl_enum_u(e, v): i64 {
    if (e == _SR_EU_MODE) { if (v <= 6) { return 1; } return 0; }
    if (e == _SR_EU_COMPONENT) {
        if (v >= 5120 && v <= 5123) { return 1; }
        if (v == 5125 || v == 5126) { return 1; }
        return 0;
    }
    if (e == _SR_EU_INDEX_COMPONENT) {
        if (v == 5121 || v == 5123 || v == 5125) { return 1; }
        return 0;
    }
    if (e == _SR_EU_MAG) { if (v == 9728 || v == 9729) { return 1; } return 0; }
    if (e == _SR_EU_MIN) {
        if (v == 9728 || v == 9729) { return 1; }
        if (v >= 9984 && v <= 9987) { return 1; }
        return 0;
    }
    if (e == _SR_EU_WRAP) {
        if (v == 33071 || v == 33648 || v == 10497) { return 1; }
        return 0;
    }
    if (v == 34962 || v == 34963) { return 1; }
    return 0;
}

# 1 when the string node s is a valid value of the string enum e.
#must_use
fn _sr_gl_enum_s(e, s): i64 {
    if (e == _SR_ES_TYPE) {
        if (_sr_jstr_is(s, "SCALAR") == 1 || _sr_jstr_is(s, "VEC2") == 1 || _sr_jstr_is(s, "VEC3") == 1) { return 1; }
        if (_sr_jstr_is(s, "VEC4") == 1 || _sr_jstr_is(s, "MAT2") == 1 || _sr_jstr_is(s, "MAT3") == 1) { return 1; }
        return _sr_jstr_is(s, "MAT4");
    }
    if (e == _SR_ES_INTERP) {
        if (_sr_jstr_is(s, "LINEAR") == 1 || _sr_jstr_is(s, "STEP") == 1) { return 1; }
        return _sr_jstr_is(s, "CUBICSPLINE");
    }
    if (e == _SR_ES_ALPHA) {
        if (_sr_jstr_is(s, "OPAQUE") == 1 || _sr_jstr_is(s, "MASK") == 1) { return 1; }
        return _sr_jstr_is(s, "BLEND");
    }
    if (_sr_jstr_is(s, "perspective") == 1) { return 1; }
    return _sr_jstr_is(s, "orthographic");
}

# 1 when v is a JSON number serde reads into an f32: an integer, or a float whose f64 is finite (serde_json refuses
# `1e400`; `1e300` is fine, and `as f32` makes it +∞).
#must_use
fn _sr_gl_is_num(v): i64 {
    var t = _sr_jtag(v);
    if (t == JTAG_INT) { return 1; }
    if (t != JTAG_FLOAT) { return 0; }
    var x: f64 = bayan_json_v_float(v);
    return _sr_f64_finite(x);
}

# 1 when v is a JSON integer in 0 … 2^63 − 1 (serde's u64; bayan refuses larger ones).
#must_use
fn _sr_gl_is_uint(v): i64 {
    if (_sr_jtag(v) != JTAG_INT) { return 0; }
    if (bayan_json_v_int(v) < 0) { return 0; }
    return 1;
}

# Checks an index value v into collection c (u32 by truncation, then in bounds): 1, or 0 with the reason recorded.
fn _sr_gl_chk_idx(v, c, bound): i64 {
    if (_sr_gl_is_uint(v) == 0) { return _sr_gl_fail("an index is not a non-negative integer"); }
    if (bound == 1 && (bayan_json_v_int(v) & 0xFFFFFFFF) >= _sr_gl_n(c)) {
        return _sr_gl_fail("an index is out of bounds");
    }
    return 1;
}

# A Rust u32 parse of [p + i, p + l) (an optional '+', then digits, below 2^32): 1 when it parses.
#must_use
fn _sr_gl_u32_ok(p, i, l): i64 {
    var k = i;
    if (k < l && load8(p + k) == 43) { k = k + 1; }
    if (k >= l) { return 0; }
    var n = 0;
    while (k < l) {
        var c = load8(p + k);
        if (c < 48 || c > 57) { return 0; }
        n = n * 10 + (c - 48);
        if (n > 4294967295) { return 0; }
        k = k + 1;
    }
    return 1;
}

# A semantic name (an attribute key, a Str): 1 POSITION, 2 NORMAL, 3 TANGENT, 4 COLOR_n, 5 TEXCOORD_n, 6 JOINTS_n,
# 7 WEIGHTS_n, or 0 (Invalid: `_` names are Invalid too, without gltf's `extras` feature). The set n is in
# _sr_gl_sem_set.
var _sr_gl_sem_set = 0;
fn _sr_gl_semantic(s): i64 {
    var p = str_data(s);
    var l = str_len(s);
    _sr_gl_sem_set = 0;
    if (l == 8 && memeq(p, "POSITION", 8) == 1) { return 1; }
    if (l == 6 && memeq(p, "NORMAL", 6) == 1) { return 2; }
    if (l == 7 && memeq(p, "TANGENT", 7) == 1) { return 3; }
    var kind = 0;
    var pre = 0;
    if (l >= 6 && memeq(p, "COLOR_", 6) == 1) { kind = 4; pre = 6; }
    if (l >= 9 && memeq(p, "TEXCOORD_", 9) == 1) { kind = 5; pre = 9; }
    if (l >= 7 && memeq(p, "JOINTS_", 7) == 1) { kind = 6; pre = 7; }
    if (l >= 8 && memeq(p, "WEIGHTS_", 8) == 1) { kind = 7; pre = 8; }
    if (kind == 0) { return 0; }
    if (_sr_gl_u32_ok(p, pre, l) == 0) { return 0; }
    var k = pre;
    if (load8(p + k) == 43) { k = k + 1; }
    var n = 0;
    while (k < l) {
        n = n * 10 + (load8(p + k) - 48);
        k = k + 1;
    }
    _sr_gl_sem_set = n;
    return kind;
}

# Checks obj's member key: kind (_SR_K_*), presence (_SR_F_*), and arg (a collection, an enum, a length, or a struct
# validator's address). Returns the member's node, or 0 when it is absent or null (or a failure was recorded).
fn _sr_gf(obj, key, kind, presence, arg): i64 {
    var v = _sr_jg(obj, key);
    if (v == 0) {
        if (presence == _SR_F_REQ) { return _sr_gl_fail("a required field is missing"); }
        return 0;
    }
    var t = _sr_jtag(v);
    if (t == JTAG_NULL) {
        if (presence == _SR_F_OPT) { return 0; }
        return _sr_gl_fail("a field that is not optional is null");
    }
    var i = 0;
    var n = 0;
    if (kind == _SR_K_U64) {
        if (_sr_gl_is_uint(v) == 0) { return _sr_gl_fail("an unsigned integer field is not one"); }
    } elif (kind == _SR_K_U32) {
        if (_sr_gl_is_uint(v) == 0 || bayan_json_v_int(v) > 4294967295) {
            return _sr_gl_fail("a u32 field is not one");
        }
    } elif (kind == _SR_K_IDX) {
        if (_sr_gl_chk_idx(v, arg, 1) == 0) { return 0; }
    } elif (kind == _SR_K_IDXN) {
        if (_sr_gl_chk_idx(v, arg, 0) == 0) { return 0; }
    } elif (kind == _SR_K_IDXS) {
        if (t != JTAG_ARR) { return _sr_gl_fail("an index list is not an array"); }
        n = _sr_jlen(v);
        while (i < n) {
            if (_sr_gl_chk_idx(_sr_jat(v, i), arg, 1) == 0) { return 0; }
            i = i + 1;
        }
    } elif (kind == _SR_K_F32) {
        if (_sr_gl_is_num(v) == 0) { return _sr_gl_fail("a number field is not a number"); }
    } elif (kind == _SR_K_F32N || kind == _SR_K_F32S) {
        if (t != JTAG_ARR) { return _sr_gl_fail("a number list is not an array"); }
        n = _sr_jlen(v);
        if (kind == _SR_K_F32N && n != arg) { return _sr_gl_fail("a fixed-length number list has the wrong length"); }
        while (i < n) {
            if (_sr_gl_is_num(_sr_jat(v, i)) == 0) { return _sr_gl_fail("a number list holds a non-number"); }
            i = i + 1;
        }
    } elif (kind == _SR_K_BOOL) {
        if (t != JTAG_BOOL) { return _sr_gl_fail("a boolean field is not a boolean"); }
    } elif (kind == _SR_K_STR) {
        if (t != JTAG_STR) { return _sr_gl_fail("a string field is not a string"); }
    } elif (kind == _SR_K_STRS) {
        if (t != JTAG_ARR) { return _sr_gl_fail("a string list is not an array"); }
        n = _sr_jlen(v);
        while (i < n) {
            if (_sr_jtag(_sr_jat(v, i)) != JTAG_STR) { return _sr_gl_fail("a string list holds a non-string"); }
            i = i + 1;
        }
    } elif (kind == _SR_K_ENUMU) {
        if (_sr_gl_is_uint(v) == 0) { return _sr_gl_fail("an enum field is not an unsigned integer"); }
        if (_sr_gl_enum_u(arg, bayan_json_v_int(v) & 0xFFFFFFFF) == 0) {
            return _sr_gl_fail("an enum value is invalid");
        }
    } elif (kind == _SR_K_ENUMS) {
        if (t != JTAG_STR) { return _sr_gl_fail("an enum field is not a string"); }
        if (_sr_gl_enum_s(arg, v) == 0) { return _sr_gl_fail("an enum value is invalid"); }
    } elif (kind == _SR_K_OBJ) {
        if (t != JTAG_OBJ) { return _sr_gl_fail("an object field is not an object"); }
        fncall1(arg, v);
    } elif (kind == _SR_K_OBJS) {
        if (t != JTAG_ARR) { return _sr_gl_fail("an object list is not an array"); }
        n = _sr_jlen(v);
        while (i < n) {
            var e = _sr_jat(v, i);
            if (_sr_jtag(e) != JTAG_OBJ) { return _sr_gl_fail("an object list holds a non-object"); }
            fncall1(arg, e);
            i = i + 1;
        }
    } elif (kind == _SR_K_VOID) {
        # `extras` without gltf's `extras` feature: a struct of one defaulted unit field. serde reads it from an
        # object (members ignored), or from an array of none or one null.
        if (t == JTAG_ARR) {
            n = _sr_jlen(v);
            if (n == 0) { return v; }
            if (n == 1 && _sr_jtag(_sr_jat(v, 0)) == JTAG_NULL) { return v; }
            return _sr_gl_fail("extras is an array of values");
        }
        if (t != JTAG_OBJ) { return _sr_gl_fail("extras is not an object"); }
    } elif (kind == _SR_K_EMPTY) {
        # `extensions` without the `extensions` feature: a struct with no fields, from an object or an empty array.
        if (t == JTAG_ARR && _sr_jlen(v) == 0) { return v; }
        if (t != JTAG_OBJ) { return _sr_gl_fail("extensions is not an object"); }
    } elif (kind == _SR_K_ATTRS) {
        if (t != JTAG_OBJ) { return _sr_gl_fail("attributes is not an object"); }
        n = bayan_json_v_obj_len(v);
        while (i < n) {
            if (_sr_gl_semantic(bayan_json_v_obj_key(v, i)) == 0) {
                return _sr_gl_fail("an attribute's semantic is invalid");
            }
            if (_sr_gl_chk_idx(bayan_json_v_obj_val(v, i), SR_GL_C_ACCESSORS, 1) == 0) { return 0; }
            i = i + 1;
        }
    }
    return v;
}

# The `extensions` and `extras` every gltf-json struct carries.
fn _sr_gv_ext(o) {
    _sr_gf(o, "extensions", _SR_K_EMPTY, _SR_F_OPT, 0);
    _sr_gf(o, "extras", _SR_K_VOID, _SR_F_DEF, 0);
    return 0;
}

fn _sr_gv_asset(o) {
    _sr_gf(o, "copyright", _SR_K_STR, _SR_F_OPT, 0);
    _sr_gf(o, "generator", _SR_K_STR, _SR_F_OPT, 0);
    _sr_gf(o, "minVersion", _SR_K_STR, _SR_F_OPT, 0);
    _sr_gf(o, "version", _SR_K_STR, _SR_F_REQ, 0);
    return _sr_gv_ext(o);
}

fn _sr_gv_buffer(o) {
    _sr_gf(o, "byteLength", _SR_K_U64, _SR_F_DEF, 0);
    _sr_gf(o, "name", _SR_K_STR, _SR_F_OPT, 0);
    _sr_gf(o, "uri", _SR_K_STR, _SR_F_OPT, 0);
    return _sr_gv_ext(o);
}

fn _sr_gv_view(o) {
    _sr_gf(o, "buffer", _SR_K_IDX, _SR_F_REQ, SR_GL_C_BUFFERS);
    _sr_gf(o, "byteLength", _SR_K_U64, _SR_F_REQ, 0);
    _sr_gf(o, "byteOffset", _SR_K_U64, _SR_F_OPT, 0);
    var st = _sr_gf(o, "byteStride", _SR_K_U64, _SR_F_OPT, 0);
    if (st != 0) {
        var s = bayan_json_v_int(st);
        if (s < 4 || s > 252) { _sr_gl_fail("byteStride is outside 4 … 252"); }
    }
    _sr_gf(o, "name", _SR_K_STR, _SR_F_OPT, 0);
    _sr_gf(o, "target", _SR_K_ENUMU, _SR_F_OPT, _SR_EU_TARGET);
    return _sr_gv_ext(o);
}

fn _sr_gv_sparse_indices(o) {
    _sr_gf(o, "bufferView", _SR_K_IDX, _SR_F_REQ, SR_GL_C_VIEWS);
    _sr_gf(o, "byteOffset", _SR_K_U64, _SR_F_DEF, 0);
    _sr_gf(o, "componentType", _SR_K_ENUMU, _SR_F_REQ, _SR_EU_INDEX_COMPONENT);
    return _sr_gv_ext(o);
}

fn _sr_gv_sparse_values(o) {
    _sr_gf(o, "bufferView", _SR_K_IDX, _SR_F_REQ, SR_GL_C_VIEWS);
    _sr_gf(o, "byteOffset", _SR_K_U64, _SR_F_DEF, 0);
    return _sr_gv_ext(o);
}

fn _sr_gv_sparse(o) {
    _sr_gf(o, "count", _SR_K_U64, _SR_F_REQ, 0);
    _sr_gf(o, "indices", _SR_K_OBJ, _SR_F_REQ, &_sr_gv_sparse_indices);
    _sr_gf(o, "values", _SR_K_OBJ, _SR_F_REQ, &_sr_gv_sparse_values);
    return _sr_gv_ext(o);
}

fn _sr_gv_accessor(o) {
    var bv = _sr_gf(o, "bufferView", _SR_K_IDX, _SR_F_OPT, SR_GL_C_VIEWS);
    _sr_gf(o, "byteOffset", _SR_K_U64, _SR_F_OPT, 0);
    _sr_gf(o, "count", _SR_K_U64, _SR_F_REQ, 0);
    _sr_gf(o, "componentType", _SR_K_ENUMU, _SR_F_REQ, _SR_EU_COMPONENT);
    _sr_gf(o, "type", _SR_K_ENUMS, _SR_F_REQ, _SR_ES_TYPE);
    _sr_gf(o, "min", _SR_K_ANY, _SR_F_OPT, 0);
    _sr_gf(o, "max", _SR_K_ANY, _SR_F_OPT, 0);
    _sr_gf(o, "name", _SR_K_STR, _SR_F_OPT, 0);
    _sr_gf(o, "normalized", _SR_K_BOOL, _SR_F_DEF, 0);
    var sp = _sr_gf(o, "sparse", _SR_K_OBJ, _SR_F_OPT, &_sr_gv_sparse);
    if (bv == 0 && sp == 0) { _sr_gl_fail("an accessor has neither a bufferView nor sparse"); }
    return _sr_gv_ext(o);
}

fn _sr_gv_target(o) {
