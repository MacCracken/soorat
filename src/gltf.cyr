# [f32; 3] from a serde_json Value (the POSITION accessor's min and max): an array of exactly three numbers.
#must_use
fn _sr_gl_is_f32x3(v): i64 {
    if (v == 0) { return 0; }
    if (_sr_jtag(v) != JTAG_ARR || _sr_jlen(v) != 3) { return 0; }
    var i = 0;
    while (i < 3) {
        if (_sr_gl_is_num(_sr_jat(v, i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# A primitive, and gltf-json's hook: POSITION is required, and its accessor needs `min` and `max` as [f32; 3]. Rust
# indexes `accessors[POSITION]` before the bound is reported, so a POSITION out of range panics it (ADR 0002 #14).
fn _sr_gv_primitive(o) {
    var at = _sr_gf(o, "attributes", _SR_K_ATTRS, _SR_F_REQ, 0);
    _sr_gf(o, "indices", _SR_K_IDX, _SR_F_OPT, SR_GL_C_ACCESSORS);
    _sr_gf(o, "material", _SR_K_IDX, _SR_F_OPT, SR_GL_C_MATERIALS);
    _sr_gf(o, "mode", _SR_K_ENUMU, _SR_F_DEF, _SR_EU_MODE);
    _sr_gf(o, "targets", _SR_K_OBJS, _SR_F_OPT, &_sr_gv_morph);
    _sr_gv_ext(o);
    if (at == 0 || _sr_jtag(at) != JTAG_OBJ) { return 0; }
    var pv = _sr_jg(at, "POSITION");
    if (pv == 0) { return _sr_gl_fail("a primitive has no POSITION"); }
    if (_sr_jtag(pv) != JTAG_INT) { return 0; }
    var pi = bayan_json_v_int(pv) & 0xFFFFFFFF;
    if (pi >= _sr_gl_n(SR_GL_C_ACCESSORS)) { return _sr_gl_fail("POSITION's accessor is out of bounds"); }
    var pa = _sr_gl_item(SR_GL_C_ACCESSORS, pi);
    if (_sr_gl_is_f32x3(_sr_jopt(pa, "min")) == 0) { return _sr_gl_fail("POSITION's accessor has no [f32; 3] min"); }
    if (_sr_gl_is_f32x3(_sr_jopt(pa, "max")) == 0) { return _sr_gl_fail("POSITION's accessor has no [f32; 3] max"); }
    return 0;
}

