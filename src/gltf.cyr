# An animation: gltf-json validates its samplers and each channel's sampler bound, not the channels' targets (they
# are read, and a bad one panics Rust, only when animations load).
fn _sr_gv_animation(o) {
    var cs = _sr_gf(o, "channels", _SR_K_OBJS, _SR_F_REQ, &_sr_gv_channel);
    _sr_gf(o, "name", _SR_K_STR, _SR_F_OPT, 0);
    var ss = _sr_gf(o, "samplers", _SR_K_OBJS, _SR_F_REQ, &_sr_gv_anim_sampler);
    if (cs != 0 && ss != 0) {
        var i = 0;
        while (i < _sr_jlen(cs)) {
            var si = _sr_jg(_sr_jat(cs, i), "sampler");
            if (si != 0 && _sr_jtag(si) == JTAG_INT && (bayan_json_v_int(si) & 0xFFFFFFFF) >= _sr_jlen(ss)) {
                _sr_gl_fail("a channel's sampler is out of bounds");
            }
            i = i + 1;
        }
    }
    return _sr_gv_ext(o);
}

