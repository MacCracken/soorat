# color.cyr — Rust 1.2.0's src/color.rs (M1 part b): RGBA colours and the visualization colour maps.
#
# **Layout.** `SrColor` is 4 f32 (r, g, b, a; 16 bytes), passed by pointer; a result is written through an out
# pointer the caller owns, which may be an input. Its fields are read and written with load32 / store32 at 0, 4, 8
# and 12 (an f32 field assignment from bits is a type warning under --bounds). The constants are pointers to static
# colours (`SR_COLOR_WHITE`, …): read them, copy them, never write through them.
#
# **Precision (ADR 0003, ADR 0002 #33).** Every output is the correct value: its formula's exact value, rounded once.
# - `luminance` and `lerp` are sums of products that are exact in f64, rounded once through `_sr_cr_sum_f32`
#   (src/crsum.cyr). Luminance takes Rec. 709's exact weights, (2126·r + 7152·g + 722·b) / 10,000.
# - `to_rgba8` scales in f64 (exact) and rounds half away from zero, Rust's documented `round`.
# - `from_rgba8`, the heat map and the signed map are exact in f32: one correctly rounded division, Sterbenz
#   subtractions and scalings by 4.
# Rust's f32 sequence was wrong on 239 of these rows (to_rgba8 97, luminance 71, lerp 71); tests/golden/color.tsv
# holds the correct values (class A).
#
# The `optics` functions (`from_prakash`, `to_prakash`, `from_temperature`, `from_wavelength`) arrive with
# prakash in M1 part b2; the serde round trip with bayan.

struct SrColor { r: f32; g: f32; b: f32; a: f32; }

# f32 bits used here: 0, 0.25, 0.5, 0.75, 1, −1 and 255, from rustc; and the f64 constants of the exact paths.
var _SR_C0 = 0;
var _SR_C025 = 0x3E800000;
var _SR_C05 = 0x3F000000;
var _SR_C075 = 0x3F400000;
var _SR_C1 = 0x3F800000;
var _SR_CM1 = 0xBF800000;
var _SR_C255 = 0x437F0000;
var _SR_COL_255: f64 = 255.0;
var _SR_COL_HALF: f64 = 0.5;
# Rec. 709's luma weights times 10,000 (exact), and the 10,000.
var _SR_LUMA_NR: f64 = 2126.0;
var _SR_LUMA_NG: f64 = 7152.0;
var _SR_LUMA_NB: f64 = 722.0;
var _SR_LUMA_K: f64 = 10000.0;

# One lerp component, x + (y − x)·t: native f32 (typed parameters), one rounding per operation, Rust's sequence.
# PART0(animation, acoustic_render): not the correct value (see `_sr_color_lerp1`). src/animation.cyr's linear tracks
# and `_sr_color_lerp_f32seq` keep it until Part 0c re-derives those rows, recorded from Rust (ADR 0003).
#must_use
fn _sr_f32_lerp(x: f32, y: f32, t: f32): i64 {
    var r: f32 = x + ((y - x) * t);
    return r;
}

# One lerp component, x + (y − x)·t for t in [0, 1] (f32 bits), correctly rounded: Rust's formula in f64 with an error
# bound, and where that can't decide, x + y·t − x·t through `_sr_cr_sum3_f32` (each product exact in f64). A zero
# result takes the formula's IEEE 754 sign (the f64 evaluation's, exact when the result is 0 because its operands
# are). A non-finite x, y or t gives IEEE 754's special value.
#must_use
fn _sr_color_lerp1(x, y, t): i64 {
    var a: f64 = f32_to(x);
    var b: f64 = f32_to(y);
    var tt: f64 = f32_to(t);
    var d: f64 = b - a;
    var f: f64 = a + (d * tt);
    var zero: f64 = 0.0;
    var fin: f64 = (a - a) + ((b - b) + (tt - tt));   # 0 unless an operand is an infinity or a NaN
    if (fin != zero) { return f32_from(f); }
    # The fast path: f, Rust's formula in f64, is within 3u·(|b − a| + |f|) of the exact value (u = 2^-53, t ≤ 1),
    # bounded here with 2^-50, 2.7 times that. When the whole interval rounds to one f32, that is the answer.
    var ad: f64 = d;
    if (ad < zero) { ad = zero - ad; }
    var af: f64 = f;
    if (af < zero) { af = zero - af; }
    var err: f64 = (ad + af) * _SR_CRS_EPS;
    var lo = f32_from(f - err);
    if (err != zero) {
        if (lo == f32_from(f + err)) { return lo; }
    }
    # The exact path: x + y·t − x·t, each product exact in f64.
    var z0 = 0;
    if (f == zero) { z0 = f32_from(f); }
    var bt: f64 = b * tt;
    var at: f64 = zero - (a * tt);
    var one: f64 = 1.0;
    return _sr_cr_sum3_f32(a, bt, at, one, z0);
}

# (r, g, b, a) / k in native f32, stored at out.
fn _sr_f32_div4(out, r: f32, g: f32, b: f32, a: f32, k: f32) {
    var qr: f32 = r / k;
    var qg: f32 = g / k;
    var qb: f32 = b / k;
    var qa: f32 = a / k;
    store32(out, qr);
    store32(out + 4, qg);
    store32(out + 8, qb);
    store32(out + 12, qa);
    return out;
}

# Writes the four component bits (r, g, b, a) to out.
fn _sr_color_set(out, r, g, b, a) {
    store32(out, r);
    store32(out + 4, g);
    store32(out + 8, b);
    store32(out + 12, a);
    return out;
}

# ── constants ────────────────────────────────────────────────────────────────────────
# Seven static colours, 16 bytes each, filled once at load. Mirror `Color::WHITE` … `Color::CORNFLOWER_BLUE`.

var _sr_color_consts: u8[112];
var SR_COLOR_WHITE = &_sr_color_consts;
var SR_COLOR_BLACK = &_sr_color_consts + 16;
var SR_COLOR_RED = &_sr_color_consts + 32;
var SR_COLOR_GREEN = &_sr_color_consts + 48;
var SR_COLOR_BLUE = &_sr_color_consts + 64;
var SR_COLOR_TRANSPARENT = &_sr_color_consts + 80;
var SR_COLOR_CORNFLOWER_BLUE = &_sr_color_consts + 96;

# Fills the static colours. Runs once, at load.
fn _sr_color_consts_init(): i64 {
    _sr_color_set(SR_COLOR_WHITE, _SR_C1, _SR_C1, _SR_C1, _SR_C1);
    _sr_color_set(SR_COLOR_BLACK, _SR_C0, _SR_C0, _SR_C0, _SR_C1);
    _sr_color_set(SR_COLOR_RED, _SR_C1, _SR_C0, _SR_C0, _SR_C1);
    _sr_color_set(SR_COLOR_GREEN, _SR_C0, _SR_C1, _SR_C0, _SR_C1);
    _sr_color_set(SR_COLOR_BLUE, _SR_C0, _SR_C0, _SR_C1, _SR_C1);
    _sr_color_set(SR_COLOR_TRANSPARENT, _SR_C0, _SR_C0, _SR_C0, _SR_C0);
    # 0.392f32, 0.584f32, 0.929f32
    _sr_color_set(SR_COLOR_CORNFLOWER_BLUE, 0x3EC8B439, 0x3F158106, 0x3F6DD2F2, _SR_C1);
    return 1;
}
var _sr_color_consts_ready = _sr_color_consts_init();

# ── Color ────────────────────────────────────────────────────────────────────────────

# The colour (r, g, b, a), from f32 bits, into out. Mirrors `Color::new` (whose finiteness check is a debug_assert,
# so a release build stores any value, as this does).
fn SrColor_new(r, g, b, a, out) {
    return _sr_color_set(out, r, g, b, a);
}

# (r, g, b) at full opacity, into out. Mirrors `Color::rgb`.
fn SrColor_rgb(r, g, b, out) {
    return _sr_color_set(out, r, g, b, _SR_C1);
}

# The colour of four bytes (0–255), each `x as f32 / 255.0` in f32, into out. Mirrors `Color::from_rgba8`.
fn SrColor_from_rgba8(r, g, b, a, out) {
    var fr = f32_from(f64_from(r & 0xFF));
    var fg = f32_from(f64_from(g & 0xFF));
    var fb = f32_from(f64_from(b & 0xFF));
    var fa = f32_from(f64_from(a & 0xFF));
    return _sr_f32_div4(out, fr, fg, fb, fa, _SR_C255);
}

# The colour of 0xRRGGBBAA, into out. Mirrors `Color::from_hex`.
fn SrColor_from_hex(hex, out) {
    return SrColor_from_rgba8((hex >> 24) & 0xFF, (hex >> 16) & 0xFF, (hex >> 8) & 0xFF, hex & 0xFF, out);
}

# Copies c's (r, g, b, a) to the f32 array out. Mirrors `Color::to_array` and `From<Color> for [f32; 4]`.
fn SrColor_to_array(c, out) {
    store64(out, load64(c));
    store64(out + 8, load64(c + 8));
    return out;
}

# One component as a byte: NaN → 0, else round(clamp(x, 0, 1) · 255), the product exact in f64 (24 + 8 bits) and
# rounded half away from zero (Rust's documented `round`), so the byte is the correct one.
#must_use
fn _sr_color_q8(x): i64 {
    if (_sr_f32_is_nan(x) == 1) { return 0; }
    var v: f64 = f32_to(_sr_clamp32(x, _SR_C0, _SR_C1));
    var p: f64 = v * _SR_COL_255;
    var fl: f64 = f64_floor(p);
    var k = f64_to(fl);
    var fr: f64 = p - fl;
    if (fr >= _SR_COL_HALF) { k = k + 1; }
    return k;
}

# PART0(env): Rust's byte, round(clamp(x, 0, 1) · 255) with the product rounded to f32 first, which is not always the
# correct byte (ADR 0002 #33). src/env_cpu.cyr's sRGB face encoding keeps it until Part 0c re-derives the `env` rows,
# recorded from Rust (ADR 0003).
#must_use
fn _sr_color_q8_f32seq(x): i64 {
    if (_sr_f32_is_nan(x) == 1) { return 0; }
    return _sr_f32_to_u8(_sr_round32(ganita_f32_mul(_sr_clamp32(x, _SR_C0, _SR_C1), _SR_C255)));
}

# c as four bytes (r, g, b, a) at out: each component clamped to [0, 1], scaled by 255 and rounded half away from
# zero; NaN → 0. No colour-space conversion. Mirrors `Color::to_rgba8`.
fn SrColor_to_rgba8(c, out) {
    store8(out, _sr_color_q8(load32(c)));
    store8(out + 1, _sr_color_q8(load32(c + 4)));
    store8(out + 2, _sr_color_q8(load32(c + 8)));
    store8(out + 3, _sr_color_q8(load32(c + 12)));
    return out;
}

# c widened exactly to four f64 (r, g, b, a; 32 bytes) at out: a GPU clear colour. Mirrors `Color::to_wgpu`
# (wgpu::Color is four f64).
fn SrColor_to_wgpu(c, out) {
    var i = 0;
    while (i < 4) {
        var x: f64 = f32_to(load32(c + i * 4));
        store64(out + i * 8, x);
        i = i + 1;
    }
    return out;
}

# Rec. 709 luminance, 0.2126·r + 0.7152·g + 0.0722·b with the standard's exact weights, correctly rounded, as f32
# bits: (2126·r + 7152·g + 722·b) / 10,000, each product exact in f64, through `_sr_cr_sum_f32`. A zero takes the
# formula's IEEE 754 sign; a non-finite component gives IEEE 754's special value. Mirrors `Color::luminance`.
#must_use
fn SrColor_luminance(c): i64 {
    var r: f64 = f32_to(load32(c));
    var g: f64 = f32_to(load32(c + 4));
    var b: f64 = f32_to(load32(c + 8));
    var tr: f64 = _SR_LUMA_NR * r;
    var tg: f64 = _SR_LUMA_NG * g;
    var tb: f64 = _SR_LUMA_NB * b;
    var f: f64 = (tr + tg) + tb;
    var zero: f64 = 0.0;
    var fin: f64 = (r - r) + ((g - g) + (b - b));   # 0 unless a component is an infinity or a NaN
    if (fin != zero) {
        var fk: f64 = f / _SR_LUMA_K;
        return f32_from(fk);
    }
    # The fast path inline (as _sr_cr_sum3_f32's): the f64 sum and its error bound.
    var a0: f64 = tr;
    if (a0 < zero) { a0 = zero - a0; }
    var a1: f64 = tg;
    if (a1 < zero) { a1 = zero - a1; }
    var a2: f64 = tb;
    if (a2 < zero) { a2 = zero - a2; }
    var q: f64 = f / _SR_LUMA_K;
    var aq: f64 = q;
    if (aq < zero) { aq = zero - aq; }
    var err: f64 = ((((a0 + a1) + a2) * _SR_CRS_EPS3) / _SR_LUMA_K) + (aq * _SR_CRS_EPS);
    var lo = f32_from(q - err);
    if (err != zero) {
        if (lo == f32_from(q + err)) { return lo; }
    }
    var z0 = 0;
    if (f == zero) { z0 = f32_from(f); }
    return _sr_cr_sum3_f32(tr, tg, tb, _SR_LUMA_K, z0);
}

# The colour a + (b − a)·t per component, with t (f32 bits) clamped to [0, 1] first (a NaN t gives NaN
# components, as Rust's does), into out. Mirrors `Color::lerp`.
fn SrColor_lerp(a, b, t, out) {
    var tc = _sr_clamp32(t, _SR_C0, _SR_C1);
    var r = _sr_color_lerp1(load32(a), load32(b), tc);
    var g = _sr_color_lerp1(load32(a + 4), load32(b + 4), tc);
    var bl = _sr_color_lerp1(load32(a + 8), load32(b + 8), tc);
    var al = _sr_color_lerp1(load32(a + 12), load32(b + 12), tc);
    return _sr_color_set(out, r, g, bl, al);
}

# PART0(acoustic_render): Rust's lerp, a + (b − a)·t per component in its f32 sequence, which is up to 4 ulp off the
# correct value (ADR 0002 #33), into out. src/acoustic_render.cyr's ray and decay colours keep it until Part 0c
# re-derives the `acoustic_render` rows, recorded from Rust (ADR 0003).
fn _sr_color_lerp_f32seq(a, b, t, out) {
    var tc = _sr_clamp32(t, _SR_C0, _SR_C1);
    var r = _sr_f32_lerp(load32(a), load32(b), tc);
    var g = _sr_f32_lerp(load32(a + 4), load32(b + 4), tc);
    var bl = _sr_f32_lerp(load32(a + 8), load32(b + 8), tc);
    var al = _sr_f32_lerp(load32(a + 12), load32(b + 12), tc);
    return _sr_color_set(out, r, g, bl, al);
}

# White, into out. Mirrors `impl Default for Color`.
fn SrColor_default(out) {
    return SrColor_to_array(SR_COLOR_WHITE, out);
}

# The colour of an [f32; 4] (r, g, b, a), into out. Mirrors `From<[f32; 4]> for Color`.
fn SrColor_from_array4(arr, out) {
    return SrColor_new(load32(arr), load32(arr + 4), load32(arr + 8), load32(arr + 12), out);
}

# The opaque colour of an [f32; 3] (r, g, b), into out. Mirrors `From<[f32; 3]> for Color`.
fn SrColor_from_array3(arr, out) {
    return SrColor_rgb(load32(arr), load32(arr + 4), load32(arr + 8), out);
}

# ── colour maps ──────────────────────────────────────────────────────────────────────

# The 5-stop blue → cyan → green → yellow → red gradient at t (f32 bits), into out: t clamped to [0, 1], NaN → 0
# (blue). Each quarter interpolates one channel by s = (t − start) / 0.25 in f32. Mirrors
# `visualization_heat_map`.
fn sr_visualization_heat_map(t, out) {
    var v = _SR_C0;
    if (_sr_f32_is_nan(t) == 0) { v = _sr_clamp32(t, _SR_C0, _SR_C1); }
    if (_sr_f32_lt(v, _SR_C025) == 1) {
        var s0 = ganita_f32_div(v, _SR_C025);
        return _sr_color_set(out, _SR_C0, s0, _SR_C1, _SR_C1);
    }
    if (_sr_f32_lt(v, _SR_C05) == 1) {
        var s1 = ganita_f32_div(ganita_f32_sub(v, _SR_C025), _SR_C025);
        return _sr_color_set(out, _SR_C0, _SR_C1, ganita_f32_sub(_SR_C1, s1), _SR_C1);
    }
    if (_sr_f32_lt(v, _SR_C075) == 1) {
        var s2 = ganita_f32_div(ganita_f32_sub(v, _SR_C05), _SR_C025);
        return _sr_color_set(out, s2, _SR_C1, _SR_C0, _SR_C1);
    }
    var s3 = ganita_f32_div(ganita_f32_sub(v, _SR_C075), _SR_C025);
    return _sr_color_set(out, _SR_C1, ganita_f32_sub(_SR_C1, s3), _SR_C0, _SR_C1);
}

# The diverging map at v (f32 bits), into out: v clamped to [−1, 1], NaN → 0; red (v, 0, 0) for v ≥ 0 (−0
# included), blue (0, 0, −v) below. Mirrors `signed_value_color`.
fn sr_signed_value_color(v, out) {
    var c = _SR_C0;
    if (_sr_f32_is_nan(v) == 0) { c = _sr_clamp32(v, _SR_CM1, _SR_C1); }
    if (_sr_f32_lt(c, _SR_C0) == 0) {
        return _sr_color_set(out, c, _SR_C0, _SR_C0, _SR_C1);
    }
    return _sr_color_set(out, _SR_C0, _SR_C0, ganita_f32_neg(c), _SR_C1);
}
