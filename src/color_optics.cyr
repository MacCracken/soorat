# color_optics.cyr — Rust 1.2.0's `optics` half of src/color.rs (M1 part b2): Color ⇄ prakash.
#
# **OPTIONAL** (ADR 0002 #9, #18). Rust gates these behind the `optics` Cargo feature; here the file is outside
# `[lib]` and is bundled by the `[lib.optics]` profile as dist/soorat-optics.cyr. It includes prakash itself. A
# consumer that wants it takes that bundle, declares prakash 2.15.2 and enables `optics`; nothing in soorat's core
# depends on it. (ranga's `spectral` is the precedent.)
#
# **Two allocators.** prakash's `Rgb` (24 bytes: r, g, b as f64) comes from the bump allocator.
# - `SrColor_from_prakash` only reads one, and clamps per channel itself. prakash's `rgb_clamp` would allocate a
#   copy.
# - `SrColor_to_prakash` writes into an `Rgb` the caller owns (`var rgb: Rgb;` works), so it allocates nothing;
#   Rust returns one by value.
# - `SrColor_from_temperature` and `SrColor_from_wavelength` call prakash's `color_temperature_to_rgb` and
#   `wavelength_to_rgb`, each of which returns a fresh `Rgb`: **24 bytes on the bump heap per call**, never freed.
#   Call them at setup, not per frame.
#
# UPSTREAM(L21): prakash:docs/development/issues/2026-11-15-allocation-free-rgb-results.md
#   call prakash's out-pointer forms once they ship, and drop the 24 B per call; parity: the
#   `Color::from_temperature` and `Color::from_wavelength` rows of tests/golden/color_optics.tsv (class A).
#
# **Precision.** Each channel is clamped to [0, 1] in f64 (Rust's `f64::clamp`: −0 and NaN kept) and narrowed once to
# f32 (ties to even). That is correct by construction for `from_prakash` and `to_prakash`. For `from_temperature` and
# `from_wavelength`, the correct value (ADR 0003, the composition rule) is that narrowing of prakash's *correct*
# result: each channel's exact value rounded once to f64. The exact values are Tanner Helland's fit with his published
# coefficients, and the piecewise-linear approximation with 0.3 and 0.7 exact. So these two are correct wherever
# prakash's f64 is. tests/golden/color_optics.tsv (class A, scripts/oracle/validate.py) is right on every active row.
# Seven rows wait on prakash, named `Color::from_*_prakash` and pending in tests/parity_features.tcyr:
#
# UPSTREAM(L26): prakash:docs/development/issues/2026-11-19-temperature-fit-green-exponent-is-not-tanner-hellands.md
#   prakash's green exponent above 6,600 K is −0.07551484937, the fit's −0.0755148492. 5 rows (13,600, 19,600 and
#   34,700 K among them) get a green 1 ulp low; parity: they pass once a prakash with the fix is pinned.
# UPSTREAM(L27): prakash:docs/development/issues/2026-11-19-temperature-and-wavelength-rgb-are-not-correctly-rounded.md
#   prakash's f64 is up to 9 ulp off (353 where the blue fit cancels) for temperature, and 2 for wavelength. That
#   matters only within that error of an f32 midpoint; parity: the 2 emitted rows there pass once prakash's results
#   are correctly rounded.

include "lib/prakash.cyr"

# The f64 x (bits) clamped to [0, 1] as Rust's `f64::clamp` does (−0 and NaN kept), narrowed to f32 bits.
#must_use
fn _sr_optics_q(x): i64 {
    var v: f64 = x;
    var zero: f64 = 0.0;
    var one: f64 = 1.0;
    if (v < zero) { return f32_from(zero); }
    if (v > one) { return f32_from(one); }
    return f32_from(v);
}

# The colour of the prakash Rgb rgb (each channel clamped to [0, 1], narrowed to f32) with alpha (f32 bits), into out.
# rgb is only read. Mirrors `Color::from_prakash`.
fn SrColor_from_prakash(rgb, alpha, out) {
    store32(out, _sr_optics_q(Rgb_r(rgb)));
    store32(out + 4, _sr_optics_q(Rgb_g(rgb)));
    store32(out + 8, _sr_optics_q(Rgb_b(rgb)));
    store32(out + 12, alpha);
    return out;
}

# c's r, g and b widened exactly to f64, into the prakash Rgb out (24 bytes the caller owns); alpha is dropped.
# Mirrors `Color::to_prakash`, which returns the Rgb by value.
fn SrColor_to_prakash(c, out) {
    var r: f64 = f32_to(load32(c));
    var g: f64 = f32_to(load32(c + 4));
    var b: f64 = f32_to(load32(c + 8));
    Rgb_set_r(out, r);
    Rgb_set_g(out, g);
    Rgb_set_b(out, b);
    return out;
}

# The opaque colour of a blackbody at kelvin (f64 bits), by prakash's `color_temperature_to_rgb`, into out. Leaves
# prakash's 24-byte Rgb on the bump heap (UPSTREAM L21 above). Mirrors `Color::from_temperature`.
fn SrColor_from_temperature(kelvin, out) {
    var rgb = color_temperature_to_rgb(kelvin);
    return SrColor_from_prakash(rgb, 0x3F800000, out);
}

# The opaque colour of the wavelength nm (f64 bits, nanometres), by prakash's `wavelength_to_rgb`, into out:
# Some(out), or None outside 380–780 nm (a NaN included). Leaves prakash's 24-byte Rgb on the bump heap when it
# succeeds (UPSTREAM L21 above). Mirrors `Color::from_wavelength`.
fn SrColor_from_wavelength(nm, out): Option {
    var err[8];
    var rgb = wavelength_to_rgb(nm, &err);
    if (rgb == 0) { return None(); }
    SrColor_from_prakash(rgb, 0x3F800000, out);
    return Some(out);
}
