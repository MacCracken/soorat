# (−1)^k/(2k + 1) for k = 1 … 8 as triple-doubles (index 3·(k − 1)): the accurate atan series.
var _SR_KM_CR_ATAN_ACC: i64[24] = {
    0xBFD5555555555555, 0xBC75555555555555, 0xB915555555555555,
    0x3FC999999999999A, 0xBC6999999999999A, 0x390999999999999A,
    0xBFC2492492492492, 0xBC62492492492492, 0xB902492492492492,
    0x3FBC71C71C71C71C, 0x3C5C71C71C71C71C, 0x38FC71C71C71C71C,
    0xBFB745D1745D1746, 0x3C4745D1745D1746, 0xB8D745D1745D1746,
    0x3FB3B13B13B13B14, 0xBC53B13B13B13B14, 0x38F3B13B13B13B14,
    0xBFB1111111111111, 0xBC31111111111111, 0xB8B1111111111111,
    0x3FAE1E1E1E1E1E1E, 0x3C2E1E1E1E1E1E1E, 0x38AE1E1E1E1E1E1E
};

# ── functions (kimiya src/mathx.cyr) ─────────────────────────────────────────────────

# The quiet NaN Rust's f64::NAN is (0x7FF8000000000000). The parity rules match any NaN.
#must_use
fn _sr_km_nan(): f64 {
    var n: f64 = 0x7FF8000000000000;
    return n;
}

# a + b = s + e exactly (Knuth's TwoSum).
#must_use
fn _sr_km_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var bb: f64 = s - a;
    var e: f64 = (a - (s - bb)) + (b - bb);
    return (s, e);
}

# a + b = s + e exactly, for |a| ≥ |b| or a = 0 (Dekker's FastTwoSum): s = RN(a + b).
#must_use
fn _sr_km_fast_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var e: f64 = b - (s - a);
    return (s, e);
}

# a·b = p + e exactly (Dekker's TwoProduct with Veltkamp's 2²⁷ + 1 split), for |a|, |b| < 2⁹⁹⁶
# and no underflow in e.
#must_use
fn _sr_km_two_prod(a: f64, b: f64): (f64, f64) {
    var p: f64 = a * b;
    var split: f64 = 134217729.0;
    var ca: f64 = split * a;
    var ah: f64 = ca - (ca - a);
    var al: f64 = a - ah;
    var cb: f64 = split * b;
    var bh: f64 = cb - (cb - b);
    var bl: f64 = b - bh;
    var e: f64 = (al * bl) - (((p - (ah * bh)) - (al * bh)) - (ah * bl));
    return (p, e);
}

# RO(a + b): a + b rounded to odd (of the two doubles around an inexact sum, the one with an odd last
# bit; exact sums are returned as they are). TwoSum's error e gives the side of the exact sum; an inexact
# sum is never 0, so the bit step stays in range.
#must_use
fn _sr_km_ro_sum(a: f64, b: f64): f64 {
    var s, e = _sr_km_two_sum(a, b);
    if (e == 0.0) { return s; }
    var sb = load64(&s);
    if ((sb & 1) != 0) { return s; }
    var up = 0;
    if (e > 0.0) { up = 1; }
    var pos = 0;
    if (s > 0.0) { pos = 1; }
    if (up == pos) { sb = sb + 1; } else { sb = sb - 1; }   # away from zero is the larger magnitude word
    var r: f64 = sb;
    return r;
}

# RN(a + b + c) exactly, for any three doubles without underflow in the TwoSums: Boldo and Melquiond's
# rounding-to-odd algorithm ("Emulation of FMA and correctly rounded sums", IEEE TC 2008): b + c = uh + ul
# and a + uh = th + tl exactly, then RN(th + RO(tl + ul)). (300,000 adversarial triples — ties, near-ties,
# binade edges, cancellation — agree with exact rational rounding.)
#must_use
fn _sr_km_rn3(a: f64, b: f64, c: f64): f64 {
    var uh, ul = _sr_km_two_sum(b, c);
    var th, tl = _sr_km_two_sum(a, uh);
    var v: f64 = _sr_km_ro_sum(tl, ul);
    var z: f64 = th + v;
    return z;
}

# Triple-doubles (h, m, l), normalised (|m| ≲ ulp(h), |l| ≲ ulp(m)). Every step is TwoSum or TwoProduct
# (exact) except the rounded sums of the third-order terms and the dropped products below 2^-158 of the
# result, so each operation's error is below 2^-155·max(|a|, |b|) for a sum and 2^-153·|a·b| for a
# product. The renormalising TwoSums keep the sum exact whatever the magnitudes, so a cancellation costs
# only its relative factor.
#must_use
fn _sr_km_td_add(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var s0, e0 = _sr_km_two_sum(a0, b0);
    var s1, e1 = _sr_km_two_sum(a1, b1);
    var s2: f64 = a2 + b2;
    var t1, f1 = _sr_km_two_sum(e0, s1);
    var t2: f64 = (f1 + e1) + s2;
    var h, u = _sr_km_two_sum(s0, t1);
    var m, l = _sr_km_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2) + d.
#must_use
fn _sr_km_td_add_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var s0, e0 = _sr_km_two_sum(a0, d);
    var t1, f1 = _sr_km_two_sum(e0, a1);
    var t2: f64 = f1 + a2;
    var h, u = _sr_km_two_sum(s0, t1);
    var m, l = _sr_km_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2)·(b0, b1, b2): a0b0, a0b1, a1b0 exact (TwoProduct), the 2^-106 terms rounded, the 2^-159 ones
# (a1b2, a2b1, a2b2) dropped.
#must_use
fn _sr_km_td_mul(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var p0, q0 = _sr_km_two_prod(a0, b0);
    var p1, q1 = _sr_km_two_prod(a0, b1);
    var p2, q2 = _sr_km_two_prod(a1, b0);
    var r: f64 = ((a0 * b2) + (a1 * b1)) + (a2 * b0);
    var s1, e1 = _sr_km_two_sum(p1, p2);
    var s2, e2 = _sr_km_two_sum(q0, s1);
    var t: f64 = (((e1 + e2) + q1) + q2) + r;
    var h, u = _sr_km_two_sum(p0, s2);
    var m, l = _sr_km_two_sum(u, t);
    return (h, m, l);
}

# (a0, a1, a2)·d for a double d.
#must_use
fn _sr_km_td_mul_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var p0, q0 = _sr_km_two_prod(a0, d);
    var p1, q1 = _sr_km_two_prod(a1, d);
    var r: f64 = a2 * d;
    var s, e = _sr_km_two_sum(q0, p1);
    var t: f64 = (e + q1) + r;
    var h, u = _sr_km_two_sum(p0, s);
    var m, l = _sr_km_two_sum(u, t);
    return (h, m, l);
}

# 2^e as a double, for −1022 ≤ e ≤ 1023.
#must_use
fn _sr_km_cr_pow2(e): f64 {
    var b = (e + 1023) << 52;
    var r: f64 = b;
    return r;
}

# Payne–Hanek reduction for 2^20 ≤ x < 2^1024 (bits ux of a positive finite x): returns k with x·2/π = k + f,
# |f| ≤ 1/2 (only k mod 4 is meaningful), and r = f·π/2 as a triple-double at out[0..2]. x = m·2^e (m the 53-bit
# significand, e ≥ −32); bits j < e − 1 of 2/π add multiples of 4 to m·2^e·2/π and are skipped, the 288 bits
# from e − 1 on are W (9 limbs of 32 bits from _SR_KM_CR_TWOPI), the rest add below m·2^(e − (e − 1) − 287) =
# m·2^-286 < 2^-233. m·W mod 2^288 is computed exactly in base-2^32 columns (each product of 32-bit halves fits
# 64 bits, unsigned); its top 2 bits are k mod 4, the next 286 the fraction, centred into [−1/2, 1/2) by a
# two's-complement negation, then summed limb by limb into a triple-double (each step's error below 2^-155 of
# the sum) and multiplied by π/2 (2^-153).
fn _sr_km_ph_reduce(ux, out): i64 {
    var m = (ux & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
    var e = (ux >> 52) - 1075;
    var m1 = m >> 32;
    var m0 = m & 0xFFFFFFFF;
    var p = e + 62;                               # bit e − 1 of 2/π sits at position e − 1 + 63 of the table
    var w = p >> 5;
    var s = p & 31;
    var col: i64[10];
    var k = 0;
    while (k < 10) {
        col[k] = 0;
        k = k + 1;
    }
    k = 0;
    while (k < 9) {                               # limb k (weight 2^(32k)) is window word 8 − k
        var hw = load64(&_SR_KM_CR_TWOPI + 8 * (w + 8 - k));
        var lw = load64(&_SR_KM_CR_TWOPI + 8 * (w + 9 - k));
        var v = ((hw << s) | (lw >> (32 - s))) & 0xFFFFFFFF;
        var a = m0 * v;                           # < 2^64: the exact product, as an unsigned word
        var b = m1 * v;                           # < 2^53
        col[k] = col[k] + (a & 0xFFFFFFFF);
        col[k + 1] = col[k + 1] + (a >> 32) + (b & 0xFFFFFFFF);
        if (k < 8) { col[k + 2] = col[k + 2] + (b >> 32); }
        k = k + 1;
    }
    k = 0;
    while (k < 8) {                               # carries; each column is below 2^35
        col[k + 1] = col[k + 1] + (col[k] >> 32);
        col[k] = col[k] & 0xFFFFFFFF;
        k = k + 1;
    }
    var top = col[8] & 0xFFFFFFFF;
    var q = top >> 30;
    col[8] = top & 0x3FFFFFFF;
    var neg = 0;
    if ((top & 0x20000000) != 0) {                # f ≥ 1/2: f − 1 = −(2^286 − F)·2^-286
        neg = 1;
        q = q + 1;
        var c = 1;
        k = 0;
        while (k < 9) {
            var mask = 0xFFFFFFFF;
            if (k == 8) { mask = 0x3FFFFFFF; }
            var t = (mask - col[k]) + c;
            col[k] = t & mask;
            c = t >> 32;
            k = k + 1;
        }
    }
    var lead: f64 = f64_from(col[8]);
    var s30: f64 = 0x3E10000000000000;            # 2^-30
    var h: f64 = lead * s30;
    var mm: f64 = 0.0;
    var l: f64 = 0.0;
    k = 7;
    while (k >= 0) {
        var lf: f64 = f64_from(col[k]);
        var sc: f64 = _sr_km_cr_pow2(32 * k - 286);
        var d: f64 = lf * sc;                     # exact: 32 bits at a normal scale
        var h2, m2, l2 = _sr_km_td_add_d(h, mm, l, d);
        h = h2;
        mm = m2;
        l = l2;
        k = k - 1;
    }
    var ph: f64 = _SR_KM_CR_SC_PIO2H;
    var pm: f64 = _SR_KM_CR_SC_PIO2M;
    var pl: f64 = _SR_KM_CR_SC_PIO2L;
    var rh, rm, rl = _sr_km_td_mul(h, mm, l, ph, pm, pl);
    if (neg == 1) {
        rh = -rh;
        rm = -rm;
        rl = -rl;
    }
    store64(out, rh);
    store64(out + 8, rm);
    store64(out + 16, rl);
    return q;
}

# The fast evaluation of ±sin r / ±cos r (q = 0: sin r, 1: cos r, 2: −sin r, 3: −cos r) for r = rh + rl,
# |r| ≤ π/4 + 2^-30, |rl| ≤ 2^-53·|rh|, with the reduction's absolute error dr: (hi, lo, err) with
# |hi + lo − f| < err less the test's own rounding (the bound above).
#must_use
fn _sr_km_sc_eval(q, rh: f64, rl: f64, dr: f64): (f64, f64, f64) {
    var cc: f64 = rh + 26388279066624.0;          # 1.5·2^44: rounds rh to a multiple of 2^-8
    var ad: f64 = cc - 26388279066624.0;
    var i = load64(&cc) - 0x42B8000000000000;
    var th: f64 = rh - ad;                        # exact, |th| ≤ 2^-9
    var ai = i;
    if (i < 0) { ai = 0 - i; }
    var off = ai * 64;
    var sa: f64 = load64(&_SR_KM_CR_SC_T + off);
    var sb: f64 = load64(&_SR_KM_CR_SC_T + off + 8);
    var ca: f64 = load64(&_SR_KM_CR_SC_T + off + 32);
    var cb: f64 = load64(&_SR_KM_CR_SC_T + off + 40);
    if (i < 0) {
        sa = -sa;
        sb = -sb;
    }
    var ua: f64 = sa;
    var ub: f64 = sb;
    var va: f64 = ca;
    var vb: f64 = cb;
    if ((q & 1) == 1) {
        ua = ca;
        ub = cb;
        va = -sa;
        vb = -sb;
    }
    if ((q & 2) == 2) {
        ua = -ua;
        ub = -ub;
        va = -va;
        vb = -vb;
    }
    var t1: f64 = th;
    var t2: f64 = 0.0;
    if (i != 0) {
        var ct: f64 = th + 98304.0;               # 1.5·2^16: rounds th to a multiple of 2^-36
        t1 = ct - 98304.0;
        t2 = th - t1;
    }
    var p1: f64 = va * t1;                        # exact
    var hi: f64 = ua + p1;
    var e1: f64 = p1 - (hi - ua);
    var s3: f64 = _SR_KM_CR_SC_S3;
    var s5: f64 = _SR_KM_CR_SC_S5;
    var s7: f64 = _SR_KM_CR_SC_S7;
    var c4: f64 = _SR_KM_CR_SC_C4;
    var c6: f64 = _SR_KM_CR_SC_C6;
    var z: f64 = th * th;
    var cm1: f64 = z * ((z * (c4 + (z * c6))) - 0.5);
    var sm: f64 = (th * z) * (s3 + (z * (s5 + (z * s7))));
    var uf: f64 = ua + ub;
    var vf: f64 = va + vb;
    var small: f64 = (e1 + (va * t2)) + (vb * th);
    var mid: f64 = (vf * sm) + (rl * (vf - (uf * th)));
    var big: f64 = ub + (uf * cm1);
    var lo: f64 = (small + mid) + big;
    var aua: f64 = f64_abs(ua);
    var ahi: f64 = f64_abs(hi);
    var k68: f64 = 0x3BB0000000000000;            # 2^-68
    var k69: f64 = 0x3BA0000000000000;            # 2^-69
    var err: f64 = ((aua * k68) + (ahi * k69)) + dr;
    return (hi, lo, err);
}

# The fast core for a = |x|, 2^-27 ≤ a < +∞ (bits ax), sel = 0 for sin, 1 for cos: (hi, lo, err) for f(a).
#must_use
fn _sr_km_sc_core(ax, sel): (f64, f64, f64) {
    var a: f64 = ax;
    if (ax >= 0x4130000000000000) {               # a ≥ 2^20: Payne–Hanek
        var rb: f64[3];
        var kp = _sr_km_ph_reduce(ax, &rb);
        var ph, pl, pe = _sr_km_sc_eval((kp + sel) & 3, rb[0], rb[1], 0.0);
        return (ph, pl, pe);
    }
    var inv: f64 = _SR_KM_CR_SC_INVPIO2;
    var p1: f64 = _SR_KM_CR_SC_P1;
    var p2: f64 = _SR_KM_CR_SC_P2;
    var p3: f64 = _SR_KM_CR_SC_P3;
    var tt: f64 = (a * inv) + 6755399441055744.0; # 1.5·2^52: rounds a·2/π to an integer
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var d1: f64 = a - (kd * p1);                  # exact
    var q2: f64 = kd * p2;                        # exact
    var nq2: f64 = -q2;
    var s: f64 = d1 + nq2;                        # TwoSum(d1, −k·P2)
    var bb: f64 = s - d1;
    var e: f64 = (d1 - (s - bb)) + (nq2 - bb);
    var w: f64 = e - (kd * p3);
    var rh: f64 = s + w;                          # Fast2Sum: |rl| ≤ 2^-53·|rh|
    var rl: f64 = w - (rh - s);
    var k119: f64 = 0x3880000000000000;           # 2^-119
    var dr: f64 = kd * k119;
    var hi, lo, err = _sr_km_sc_eval((k + sel) & 3, rh, rl, dr);
    return (hi, lo, err);
}

# The accurate reduction of a = |x| ≥ 2^-27 (bits ax): k and r = a − k·π/2 as a triple-double at out[0..2].
fn _sr_km_sc_reduce_acc(ax, out): i64 {
    if (ax >= 0x4130000000000000) {
        var kp = _sr_km_ph_reduce(ax, out);
        return kp;
    }
    var a: f64 = ax;
    var inv: f64 = _SR_KM_CR_SC_INVPIO2;
    var p1: f64 = _SR_KM_CR_SC_P1;
    var p2: f64 = _SR_KM_CR_SC_P2;
    var tt: f64 = (a * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var d1: f64 = a - (kd * p1);
    var q2: f64 = kd * p2;
    var h, m = _sr_km_two_sum(d1, -q2);
    var l: f64 = 0.0;
    var n = 0;
    while (n < 3) {                               # k·P3, k·P4, k·P5 by TwoProduct
        var pv: f64 = _SR_KM_CR_SC_P3;
        if (n == 1) { pv = _SR_KM_CR_SC_P4; }
        if (n == 2) { pv = _SR_KM_CR_SC_P5; }
        var ph, pe = _sr_km_two_prod(kd, pv);
        var a0, a1, a2 = _sr_km_td_add_d(h, m, l, -ph);
        var b0, b1, b2 = _sr_km_td_add_d(a0, a1, a2, -pe);
        h = b0;
        m = b1;
        l = b2;
        n = n + 1;
    }
    store64(out, h);
    store64(out + 8, m);
    store64(out + 16, l);
    return k;
}

# U·cos t + V·sin t in triple-double for quadrant q, from buf = S (sin a), C (cos a), sin t, cos t (four
# triple-doubles, 12 words), at out[0..2].
fn _sr_km_sc_comb(q, buf, out) {
    var uo = 0;                                   # U = S, V = C (sin type) or U = C, V = −S (cos type)
    var vo = 24;
    var vs: f64 = 1.0;
    if ((q & 1) == 1) {
        uo = 24;
        vo = 0;
        vs = -1.0;
    }
    var us: f64 = 1.0;
    if ((q & 2) == 2) {
        us = -1.0;
        vs = -vs;
    }
    var u0: f64 = load64(buf + uo);
    var u1: f64 = load64(buf + uo + 8);
    var u2: f64 = load64(buf + uo + 16);
    var v0: f64 = load64(buf + vo);
    var v1: f64 = load64(buf + vo + 8);
    var v2: f64 = load64(buf + vo + 16);
    var c0: f64 = load64(buf + 72);
    var c1: f64 = load64(buf + 80);
    var c2: f64 = load64(buf + 88);
    var s0: f64 = load64(buf + 48);
    var s1: f64 = load64(buf + 56);
    var s2: f64 = load64(buf + 64);
    var ah, am, al = _sr_km_td_mul(u0 * us, u1 * us, u2 * us, c0, c1, c2);   # ±1 scalings are exact
    var bh, bm, bl = _sr_km_td_mul(v0 * vs, v1 * vs, v2 * vs, s0, s1, s2);
    var rh, rm, rl = _sr_km_td_add(ah, am, al, bh, bm, bl);
    store64(out, rh);
    store64(out + 8, rm);
    store64(out + 16, rl);
}

# The accurate f_q(r) for r = r0 + r1 + r2 at out[0..2], and f_(q+1)(r) at out[3..5] when both = 1.
fn _sr_km_sc_acc_td(q, r0: f64, r1: f64, r2: f64, both, out) {
    var cc: f64 = r0 + 26388279066624.0;
    var ad: f64 = cc - 26388279066624.0;
    var i = load64(&cc) - 0x42B8000000000000;
    var t0: f64 = r0 - ad;                        # exact
    var th, tm, tl = _sr_km_td_add_d(r1, r2, 0.0, t0);
    var zh, zm, zl = _sr_km_td_mul(th, tm, tl, th, tm, tl);
    var wh: f64 = -zh;                            # w = −t²
    var wm: f64 = -zm;
    var wl: f64 = -zl;
    var ph: f64 = load64(&_SR_KM_CR_EXP_ACC + 264);  # 1/13! (index 3·(13 − 2))
    var pm: f64 = load64(&_SR_KM_CR_EXP_ACC + 272);
    var pl: f64 = load64(&_SR_KM_CR_EXP_ACC + 280);
    var k = 11;
    while (k >= 3) {                              # 1/k! + w·P for k = 11, 9, …, 3
        var ah, am, al = _sr_km_td_mul(ph, pm, pl, wh, wm, wl);
        var off = (k - 2) * 24;
        var ch: f64 = load64(&_SR_KM_CR_EXP_ACC + off);
        var cm: f64 = load64(&_SR_KM_CR_EXP_ACC + off + 8);
        var cl: f64 = load64(&_SR_KM_CR_EXP_ACC + off + 16);
        var bh, bm, bl = _sr_km_td_add(ch, cm, cl, ah, am, al);
        ph = bh;
        pm = bm;
        pl = bl;
        k = k - 2;
    }
    var sh1, sm1, sl1 = _sr_km_td_mul(ph, pm, pl, wh, wm, wl);
    var sh2, sm2, sl2 = _sr_km_td_add_d(sh1, sm1, sl1, 1.0);
    var snh, snm, snl = _sr_km_td_mul(sh2, sm2, sl2, th, tm, tl);       # sin t
    ph = load64(&_SR_KM_CR_EXP_ACC + 240);           # 1/12!
    pm = load64(&_SR_KM_CR_EXP_ACC + 248);
    pl = load64(&_SR_KM_CR_EXP_ACC + 256);
    k = 10;
    while (k >= 2) {                              # 1/k! + w·P for k = 10, 8, …, 2
        var dh, dm, dl = _sr_km_td_mul(ph, pm, pl, wh, wm, wl);
        var off2 = (k - 2) * 24;
        var eh: f64 = load64(&_SR_KM_CR_EXP_ACC + off2);
        var em: f64 = load64(&_SR_KM_CR_EXP_ACC + off2 + 8);
        var el: f64 = load64(&_SR_KM_CR_EXP_ACC + off2 + 16);
        var fh, fm, fl = _sr_km_td_add(eh, em, el, dh, dm, dl);
        ph = fh;
        pm = fm;
        pl = fl;
        k = k - 2;
    }
    var ch1, cm1, cl1 = _sr_km_td_mul(ph, pm, pl, wh, wm, wl);
    var csh, csm, csl = _sr_km_td_add_d(ch1, cm1, cl1, 1.0);           # cos t
    var ai = i;
    if (i < 0) { ai = 0 - i; }
    var to = ai * 64;
    var buf: f64[12];
    var g = 0;
    while (g < 2) {                               # S then C, each A + B + C + D renormalised
        var xa: f64 = load64(&_SR_KM_CR_SC_T + to + 32 * g);
        var xb: f64 = load64(&_SR_KM_CR_SC_T + to + 32 * g + 8);
        var xc: f64 = load64(&_SR_KM_CR_SC_T + to + 32 * g + 16);
        var xd: f64 = load64(&_SR_KM_CR_SC_T + to + 32 * g + 24);
        var y0, y1a = _sr_km_fast_two_sum(xa, xb);
        var y1, y2a = _sr_km_fast_two_sum(y1a, xc);
        var y2: f64 = y2a + xd;
        if (g == 0 && i < 0) {
            y0 = -y0;
            y1 = -y1;
            y2 = -y2;
        }
        buf[3 * g] = y0;
        buf[3 * g + 1] = y1;
        buf[3 * g + 2] = y2;
        g = g + 1;
    }
    buf[6] = snh;
    buf[7] = snm;
    buf[8] = snl;
    buf[9] = csh;
    buf[10] = csm;
    buf[11] = csl;
    _sr_km_sc_comb(q, &buf, out);
    if (both == 1) { _sr_km_sc_comb(q + 1, &buf, out + 24); }
}

# The accurate path for f(|x|), sel = 0 sin, 1 cos, bits ax with 2^-27 ≤ |x| < ∞.
#must_use
fn _sr_km_sc_acc(ax, sel): f64 {
    var rb: f64[3];
    var k = _sr_km_sc_reduce_acc(ax, &rb);
    var ob: f64[6];
    _sr_km_sc_acc_td((k + sel) & 3, rb[0], rb[1], rb[2], 0, &ob);
    var r: f64 = _sr_km_rn3(ob[0], ob[1], ob[2]);
    return r;
}

# sin(x), correctly rounded. sin(±0) = ±0 (as every |x| < 2^-26: x), NaN for NaN and ±∞. Mirrors `f64::sin`.
#must_use
fn _sr_km_cr_sin(x: f64): f64 {
    var ux = load64(&x);
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E50000000000000) { return x; }   # |x| < 2^-26
    if (ax >= 0x7FF0000000000000) {
        if (ax > 0x7FF0000000000000) { return x; }
        var nan: f64 = _sr_km_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (ax >= 0x4130000000000000) {               # |x| ≥ 2^20: Payne–Hanek, through _sr_km_sc_core
        var ph, pl, pe = _sr_km_sc_core(ax, 0);
        var pu: f64 = ph + (pl - pe);
        var pv: f64 = ph + (pl + pe);
        if (pu != pv) { pu = _sr_km_sc_acc(ax, 0); }
        if (ux < 0) { pu = -pu; }
        return pu;
    }
    var a: f64 = ax;                              # _sr_km_sc_core's Cody–Waite reduction, inline
    var inv: f64 = _SR_KM_CR_SC_INVPIO2;
    var p1: f64 = _SR_KM_CR_SC_P1;
    var p2: f64 = _SR_KM_CR_SC_P2;
    var p3: f64 = _SR_KM_CR_SC_P3;
    var tt: f64 = (a * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var d1: f64 = a - (kd * p1);
    var q2: f64 = kd * p2;
    var nq2: f64 = -q2;
    var s: f64 = d1 + nq2;
    var bb: f64 = s - d1;
    var e: f64 = (d1 - (s - bb)) + (nq2 - bb);
    var w: f64 = e - (kd * p3);
    var rh: f64 = s + w;
    var rl: f64 = w - (rh - s);
    var k119: f64 = 0x3880000000000000;
    var dr: f64 = kd * k119;
    var hi, lo, err = _sr_km_sc_eval(k & 3, rh, rl, dr);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    var r: f64 = u;
    if (u != v) { r = _sr_km_sc_acc(ax, 0); }
    if (ux < 0) { r = -r; }
    return r;
}

# The fast atan core for n = nh + nl, d = dh + dl with 0 < n ≤ d (1 + 2^-50), dh in [1/2, 2), nh ≥ 2^-62·dh:
# (hi, lo, err) for offset ± atan(n/d) by oct.
#must_use
fn _sr_km_atan_core(nh: f64, nl: f64, dh: f64, dl: f64, oct): (f64, f64, f64) {
    var zh: f64 = nh / dh;
    var cz: f64 = zh + 26388279066624.0;          # 1.5·2^44: rounds n/d to a multiple of 2^-8
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var sh: f64 = nh;
    var sl: f64 = nl;
    var eh: f64 = dh;
    var el: f64 = dl;
    if (j != 0) {
        var d1: f64 = (dh + 384.0) - 384.0;       # 1.5·2^8: dh on the 2^-44 grid
        var d2: f64 = dh - d1;
        var n1: f64 = (nh + 384.0) - 384.0;
        var n2: f64 = nh - n1;
        var p1: f64 = c * d1;                     # exact
        var np1: f64 = -p1;
        var u: f64 = nh + np1;                    # TwoSum(nh, −c·d1)
        var ub: f64 = u - nh;
        var ue: f64 = (nh - (u - ub)) + (np1 - ub);
        sh = u;
        sl = ((ue - (c * d2)) + nl) - (c * dl);
        var q1: f64 = c * n1;                     # exact
        var v: f64 = dh + q1;                     # TwoSum(dh, c·n1)
        var vb: f64 = v - dh;
        var ve: f64 = (dh - (v - vb)) + (q1 - vb);
        eh = v;
        el = ((ve + (c * n2)) + dl) + (c * nl);
    }
    var qh: f64 = sh / eh;                        # δ = qh + ql: Dekker's division
    var cq: f64 = 134217729.0 * qh;
    var q1h: f64 = cq - (cq - qh);
    var q1l: f64 = qh - q1h;
    var ce: f64 = 134217729.0 * eh;
    var e1h: f64 = ce - (ce - eh);
    var e1l: f64 = eh - e1h;
    var pp: f64 = qh * eh;
    var pe: f64 = (((q1h * e1h) - pp) + (q1h * e1l) + (q1l * e1h)) + (q1l * e1l);
    var ql: f64 = ((((sh - pp) - pe) + sl) - (qh * el)) / eh;
    var a3: f64 = _SR_KM_CR_SC_A3;
    var a5: f64 = _SR_KM_CR_SC_A5;
    var a7: f64 = _SR_KM_CR_SC_A7;
    var a9: f64 = _SR_KM_CR_SC_A9;
    var z: f64 = qh * qh;
    var pz: f64 = ((qh * z) * (a3 + (z * (a5 + (z * (a7 + (z * a9))))))) - (ql * z);
    var ah: f64 = load64(&_SR_KM_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_SR_KM_CR_ATAN_T + 24 * j + 8);
    var oh: f64 = 0.0;
    var om: f64 = 0.0;
    var sg: f64 = 1.0;
    if (oct == 1) {
        oh = _SR_KM_CR_SC_PIH;
        om = _SR_KM_CR_SC_PIM;
        sg = -1.0;
    }
    if (oct >= 2) {
        oh = _SR_KM_CR_SC_PIO2H;
        om = _SR_KM_CR_SC_PIO2M;
        if (oct == 2) { sg = -1.0; }
    }
    var sah: f64 = sg * ah;
    var h1: f64 = oh + sah;                       # Fast2Sum: |oh| ≥ |ah| or oh = 0
    var f1: f64 = sah - (h1 - oh);
    var sqh: f64 = sg * qh;
    var hi: f64 = h1 + sqh;                       # Fast2Sum: |h1| ≥ |qh| or h1 = 0
    var f2: f64 = sqh - (hi - h1);
    var tl: f64 = (am + ql) + pz;
    var lo: f64 = ((f1 + f2) + om) + (sg * tl);
    var ahi: f64 = f64_abs(hi);
    var k68: f64 = 0x3BA6A09E667F3BCD;            # 2^-68.5 (√2·2^-69)
    var err: f64 = ahi * k68;
    return (hi, lo, err);
}

# A triple-double renormalised (two bottom-up TwoSum passes): after a cancellation _sr_km_td_add's leading word can
# be far from the sum (its last renormalisation does not see the rounded third-order term), and the corrections
# below need the leading word to be the sum to 2^-52. The sum is unchanged (every step is exact).
#must_use
fn _sr_km_td_norm(a0: f64, a1: f64, a2: f64): (f64, f64, f64) {
    var s, e = _sr_km_two_sum(a1, a2);
    var h, u = _sr_km_two_sum(a0, s);
    var m, l = _sr_km_two_sum(u, e);
    var h2, u2 = _sr_km_two_sum(h, m);
    var m2, l2 = _sr_km_two_sum(u2, l);
    return (h2, m2, l2);
}

# (a0, a1, a2)/(b0, b1, b2) as a triple-double at out[0..2], b ≠ 0 normalised: q0 = a0/b0 (a renormalised first),
# then two corrections from the remainder a − q·b, computed in triple-double (each below 2^-153 of a) and
# renormalised: relative error below 2^-151.
fn _sr_km_td_div(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64, out) {
    var n0, n1, n2 = _sr_km_td_norm(a0, a1, a2);
    var q0: f64 = n0 / b0;
    var t0, t1, t2 = _sr_km_td_mul_d(b0, b1, b2, q0);
    var ra, rb, rc = _sr_km_td_add(n0, n1, n2, -t0, -t1, -t2);
    var r0, r1, r2 = _sr_km_td_norm(ra, rb, rc);
    var q1: f64 = r0 / b0;
    var u0, u1, u2 = _sr_km_td_mul_d(b0, b1, b2, q1);
    var sa, sb, sc = _sr_km_td_add(r0, r1, r2, -u0, -u1, -u2);
    var s0, s1, s2 = _sr_km_td_norm(sa, sb, sc);
    var q2: f64 = s0 / b0;
    var h, m0 = _sr_km_fast_two_sum(q0, q1);
    var m, l = _sr_km_two_sum(m0, q2);
    store64(out, h);
    store64(out + 8, m);
    store64(out + 16, l);
}

# offset ± atan(n/d) as a triple-double at out[0..2] (the accurate atan core before its rounding).
fn _sr_km_atan_acc_td(n0: f64, n1: f64, n2: f64, d0: f64, d1: f64, d2: f64, oct, out) {
    var zh: f64 = n0 / d0;
    var cz: f64 = zh + 26388279066624.0;
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var a0: f64 = n0;
    var a1: f64 = n1;
    var a2: f64 = n2;
    var b0: f64 = d0;
    var b1: f64 = d1;
    var b2: f64 = d2;
    if (j != 0) {                                 # num = n − c·d, den = d + c·n
        var cd0, cd1, cd2 = _sr_km_td_mul_d(d0, d1, d2, c);
        var x0, x1, x2 = _sr_km_td_add(n0, n1, n2, -cd0, -cd1, -cd2);
        var cn0, cn1, cn2 = _sr_km_td_mul_d(n0, n1, n2, c);
        var y0, y1, y2 = _sr_km_td_add(d0, d1, d2, cn0, cn1, cn2);
        a0 = x0;
        a1 = x1;
        a2 = x2;
        b0 = y0;
        b1 = y1;
        b2 = y2;
    }
    var db: f64[3];
    _sr_km_td_div(a0, a1, a2, b0, b1, b2, &db);
    var dh: f64 = db[0];
    var dm: f64 = db[1];
    var dl: f64 = db[2];
    var wh, wm, wl = _sr_km_td_mul(dh, dm, dl, dh, dm, dl);
    var ph: f64 = load64(&_SR_KM_CR_ATAN_ACC + 168);  # 1/17 (index 3·(8 − 1))
    var pm: f64 = load64(&_SR_KM_CR_ATAN_ACC + 176);
    var pl: f64 = load64(&_SR_KM_CR_ATAN_ACC + 184);
    var k = 7;
    while (k >= 1) {                              # (−1)^k/(2k + 1) + w·P
        var th, tm, tl = _sr_km_td_mul(ph, pm, pl, wh, wm, wl);
        var off = (k - 1) * 24;
        var ch: f64 = load64(&_SR_KM_CR_ATAN_ACC + off);
        var cm: f64 = load64(&_SR_KM_CR_ATAN_ACC + off + 8);
        var cl: f64 = load64(&_SR_KM_CR_ATAN_ACC + off + 16);
        var uh, um, ul = _sr_km_td_add(ch, cm, cl, th, tm, tl);
        ph = uh;
        pm = um;
        pl = ul;
        k = k - 1;
    }
    var vh, vm, vl = _sr_km_td_mul(wh, wm, wl, ph, pm, pl);
    var xh, xm, xl = _sr_km_td_mul(vh, vm, vl, dh, dm, dl);
    var th2, tm2, tl2 = _sr_km_td_add(dh, dm, dl, xh, xm, xl);          # atan δ
    var ah: f64 = load64(&_SR_KM_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_SR_KM_CR_ATAN_T + 24 * j + 8);
    var al: f64 = load64(&_SR_KM_CR_ATAN_T + 24 * j + 16);
    var gh, gm, gl = _sr_km_td_add(ah, am, al, th2, tm2, tl2);          # θ
    if (oct == 0) {
        store64(out, gh);
        store64(out + 8, gm);
        store64(out + 16, gl);
        return;
    }
    var oh: f64 = _SR_KM_CR_SC_PIO2H;
    var om: f64 = _SR_KM_CR_SC_PIO2M;
    var ol: f64 = _SR_KM_CR_SC_PIO2L;
    if (oct == 1) {
        oh = _SR_KM_CR_SC_PIH;
        om = _SR_KM_CR_SC_PIM;
        ol = _SR_KM_CR_SC_PIL;
    }
    if (oct != 3) {
        gh = -gh;
        gm = -gm;
        gl = -gl;
    }
    var rh, rm, rl = _sr_km_td_add(oh, om, ol, gh, gm, gl);
    store64(out, rh);
    store64(out + 8, rm);
    store64(out + 16, rl);
}

# acos x = atan2(s, x), s = √(1 − x²) ≥ 0: θ = atan(s/|x|) (s ≤ |x|, oct 0 or 1 by x's sign) or
# atan(|x|/s) (oct 2 or 3). Fast path: 1 − x² as a double-double, exact but for a rounding at 2^-106
# ((1 − |x|)·(1 + |x|) for |x| ≥ 1/2, 1 − |x| exact by Sterbenz; 1 − x² by TwoProduct below), s by one Newton
# step from √ (2^-104 relative); the atan core's 2^-69.44 bound absorbs it. Accurate path: 1 − x² as an exact
# sum of four doubles, s by two Newton steps in triple-double (2^-150), the accurate atan core. Special values:
# acos(1) = +0, acos(−1) = π and acos(±0) = π/2 rounded; |x| < 2^-56 gives π/2 (acos x = π/2 − x − …, and
# π/2 is 2^-54.15 inside its rounding interval); NaN for NaN and |x| > 1. Mirrors `f64::acos`.
#must_use
fn _sr_km_cr_acos(x: f64): f64 {
    var axb = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (axb < 0x3C70000000000000 || axb >= 0x3FF0000000000000) {   # |x| < 2^-56, |x| ≥ 1 or NaN: the specials
        var r, ok = _sr_km_acos_special(x);
        return r;
    }
    # 2^-56 ≤ |x| < 1: _sr_km_acos_core's body and its _sr_km_atan_core's, inline (2.0.1), the same operations.
    var ax: f64 = f64_abs(x);
    var wh: f64 = 0.0;
    var wl: f64 = 0.0;
    if (ax >= 0.5) {
        var a: f64 = 1.0 - ax;                    # exact (Sterbenz)
        var bh: f64 = 1.0 + ax;                   # Fast2Sum(1, |x|)
        var bl: f64 = ax - (bh - 1.0);
        var ca: f64 = 134217729.0 * a;            # (1 − |x|)·bh by Dekker's product
        var a1: f64 = ca - (ca - a);
        var a2: f64 = a - a1;
        var cb: f64 = 134217729.0 * bh;
        var b1: f64 = cb - (cb - bh);
        var b2: f64 = bh - b1;
        wh = a * bh;
        var we: f64 = (((a1 * b1) - wh) + (a1 * b2) + (a2 * b1)) + (a2 * b2);
        wl = we + (a * bl);
    } else {
        var cx: f64 = 134217729.0 * ax;           # x² = p + pe (Dekker)
        var x1: f64 = cx - (cx - ax);
        var x2: f64 = ax - x1;
        var px: f64 = ax * ax;
        var pex: f64 = (((x1 * x1) - px) + (2.0 * (x1 * x2))) + (x2 * x2);
        wh = 1.0 - px;                            # Fast2Sum(1, −p)
        var we2: f64 = (1.0 - wh) - px;
        wl = we2 - pex;
    }
    var rh: f64 = f64_sqrt(wh);                   # s = rh + rl, one Newton step
    var cs: f64 = 134217729.0 * rh;
    var s1: f64 = cs - (cs - rh);
    var s2: f64 = rh - s1;
    var sp2: f64 = rh * rh;
    var spe: f64 = (((s1 * s1) - sp2) + (2.0 * (s1 * s2))) + (s2 * s2);
    var rl: f64 = (((wh - sp2) - spe) + wl) / (2.0 * rh);
    var neg = 0;
    if (x < 0.0) { neg = 1; }
    # The atan core's arguments: atan(s/|x|) from the offset by neg when s ≤ |x|, else π/2 ∓ atan(|x|/s).
    var nh: f64 = rh;
    var nl: f64 = rl;
    var dh: f64 = ax;
    var dl: f64 = 0.0;
    var oct = neg;
    if (!(rh <= ax)) {
        nh = ax;
        nl = 0.0;
        dh = rh;
        dl = rl;
        oct = 2 + neg;
    }
    var zh: f64 = nh / dh;
    var cz: f64 = zh + 26388279066624.0;          # 1.5·2^44: rounds n/d to a multiple of 2^-8
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var sh: f64 = nh;
    var sl: f64 = nl;
    var eh: f64 = dh;
    var el: f64 = dl;
    if (j != 0) {
        var d1: f64 = (dh + 384.0) - 384.0;       # 1.5·2^8: dh on the 2^-44 grid
        var d2: f64 = dh - d1;
        var n1: f64 = (nh + 384.0) - 384.0;
        var n2: f64 = nh - n1;
        var p1: f64 = c * d1;                     # exact
        var np1: f64 = -p1;
        var u0: f64 = nh + np1;                   # TwoSum(nh, −c·d1)
        var ub: f64 = u0 - nh;
        var ue: f64 = (nh - (u0 - ub)) + (np1 - ub);
        sh = u0;
        sl = ((ue - (c * d2)) + nl) - (c * dl);
        var q1: f64 = c * n1;                     # exact
        var v0: f64 = dh + q1;                    # TwoSum(dh, c·n1)
        var vb: f64 = v0 - dh;
        var ve: f64 = (dh - (v0 - vb)) + (q1 - vb);
        eh = v0;
        el = ((ve + (c * n2)) + dl) + (c * nl);
    }
    var qh: f64 = sh / eh;                        # δ = qh + ql: Dekker's division
    var cq: f64 = 134217729.0 * qh;
    var q1h: f64 = cq - (cq - qh);
    var q1l: f64 = qh - q1h;
    var ce: f64 = 134217729.0 * eh;
    var e1h: f64 = ce - (ce - eh);
    var e1l: f64 = eh - e1h;
    var pp: f64 = qh * eh;
    var pe: f64 = (((q1h * e1h) - pp) + (q1h * e1l) + (q1l * e1h)) + (q1l * e1l);
    var ql: f64 = ((((sh - pp) - pe) + sl) - (qh * el)) / eh;
    var a3: f64 = _SR_KM_CR_SC_A3;
    var a5: f64 = _SR_KM_CR_SC_A5;
    var a7: f64 = _SR_KM_CR_SC_A7;
    var a9: f64 = _SR_KM_CR_SC_A9;
    var z: f64 = qh * qh;
    var pz: f64 = ((qh * z) * (a3 + (z * (a5 + (z * (a7 + (z * a9))))))) - (ql * z);
    var ah: f64 = load64(&_SR_KM_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_SR_KM_CR_ATAN_T + 24 * j + 8);
    var oh: f64 = 0.0;
    var om: f64 = 0.0;
    var sg: f64 = 1.0;
    if (oct == 1) {
        oh = _SR_KM_CR_SC_PIH;
        om = _SR_KM_CR_SC_PIM;
        sg = -1.0;
    }
    if (oct >= 2) {
        oh = _SR_KM_CR_SC_PIO2H;
        om = _SR_KM_CR_SC_PIO2M;
        if (oct == 2) { sg = -1.0; }
    }
    var sah: f64 = sg * ah;
    var h1: f64 = oh + sah;                       # Fast2Sum: |oh| ≥ |ah| or oh = 0
    var f1: f64 = sah - (h1 - oh);
    var sqh: f64 = sg * qh;
    var hi: f64 = h1 + sqh;                       # Fast2Sum: |h1| ≥ |qh| or h1 = 0
    var f2: f64 = sqh - (hi - h1);
    var tl: f64 = (am + ql) + pz;
    var lo: f64 = ((f1 + f2) + om) + (sg * tl);
    var ahi: f64 = f64_abs(hi);
    var k68: f64 = 0x3BA6A09E667F3BCD;            # 2^-68.5 (√2·2^-69)
    var err: f64 = ahi * k68;
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) { return u; }
    var za: f64 = _sr_km_cr_acos_acc(x);
    return za;
}

# The special values of acos: (result, 1), or (0, 0) for 2^-56 ≤ |x| < 1.
#must_use
fn _sr_km_acos_special(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax > 0x7FF0000000000000) { return (x, 1); }
    if (ax > 0x3FF0000000000000) {
        var nan: f64 = _sr_km_nan();
        return (nan, 1);
    }
    if (x == 1.0) { return (0.0, 1); }
    if (x == -1.0) {
        var pi: f64 = _SR_KM_CR_SC_PIH;
        return (pi, 1);
    }
    if (ax < 0x3C70000000000000) {                # |x| < 2^-56, ±0 included
        var p2: f64 = _SR_KM_CR_SC_PIO2H;
        return (p2, 1);
    }
    return (0.0, 0);
}

# The fast core of acos for 2^-56 ≤ |x| < 1: (hi, lo, err) from the atan core.
#must_use
fn _sr_km_acos_core(x: f64): (f64, f64, f64) {
    var ax: f64 = f64_abs(x);
    var wh: f64 = 0.0;
    var wl: f64 = 0.0;
    if (ax >= 0.5) {
        var a: f64 = 1.0 - ax;                    # exact (Sterbenz)
        var bh: f64 = 1.0 + ax;                   # Fast2Sum(1, |x|)
        var bl: f64 = ax - (bh - 1.0);
        var ca: f64 = 134217729.0 * a;            # (1 − |x|)·bh by Dekker's product
        var a1: f64 = ca - (ca - a);
        var a2: f64 = a - a1;
        var cb: f64 = 134217729.0 * bh;
        var b1: f64 = cb - (cb - bh);
        var b2: f64 = bh - b1;
        wh = a * bh;
        var we: f64 = (((a1 * b1) - wh) + (a1 * b2) + (a2 * b1)) + (a2 * b2);
        wl = we + (a * bl);
    } else {
        var cx: f64 = 134217729.0 * ax;           # x² = p + pe (Dekker)
        var x1: f64 = cx - (cx - ax);
        var x2: f64 = ax - x1;
        var p: f64 = ax * ax;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        wh = 1.0 - p;                             # Fast2Sum(1, −p)
        var we2: f64 = (1.0 - wh) - p;
        wl = we2 - pe;
    }
    var sh: f64 = f64_sqrt(wh);                   # s = sh + sl, one Newton step
    var cs: f64 = 134217729.0 * sh;
    var s1: f64 = cs - (cs - sh);
    var s2: f64 = sh - s1;
    var sp2: f64 = sh * sh;
    var spe: f64 = (((s1 * s1) - sp2) + (2.0 * (s1 * s2))) + (s2 * s2);
    var sl: f64 = (((wh - sp2) - spe) + wl) / (2.0 * sh);
    var neg = 0;
    if (x < 0.0) { neg = 1; }
    if (sh <= ax) {
        var h1, l1, e1 = _sr_km_atan_core(sh, sl, ax, 0.0, neg);
        return (h1, l1, e1);
    }
    var h2, l2, e2 = _sr_km_atan_core(ax, 0.0, sh, sl, 2 + neg);
    return (h2, l2, e2);
}

# √(w0 + w1 + w2) for w > 0 as a triple-double at out[0..2]: two Newton corrections of √w0, each from the
# renormalised residual w − s² (2^-150).
fn _sr_km_td_sqrt(w0: f64, w1: f64, w2: f64, out) {
    var s0: f64 = f64_sqrt(w0);
    var p, pe = _sr_km_two_prod(s0, s0);
    var ra, rb, rc = _sr_km_td_add(w0, w1, w2, -p, -pe, 0.0);
    var r0, r1, r2 = _sr_km_td_norm(ra, rb, rc);     # the residual w − s0², renormalised
    var tw: f64 = 2.0 * s0;
    var c1: f64 = r0 / tw;
    var h, m = _sr_km_fast_two_sum(s0, c1);
    var q0, q1, q2 = _sr_km_td_mul(h, m, 0.0, h, m, 0.0);
    var ua, ub, uc = _sr_km_td_add(w0, w1, w2, -q0, -q1, -q2);
    var u0, u1, u2 = _sr_km_td_norm(ua, ub, uc);
    var c2: f64 = u0 / tw;
    var v0, v1, v2 = _sr_km_td_add_d(h, m, 0.0, c2);
    store64(out, v0);
    store64(out + 8, v1);
    store64(out + 16, v2);
}

# acos x by the accurate path alone.
#must_use
fn _sr_km_cr_acos_acc(x: f64): f64 {
    var s, sp = _sr_km_acos_special(x);
    if (sp == 1) { return s; }
    var rb: f64[3];
    _sr_km_acos_acc_td(x, &rb);
    var r: f64 = _sr_km_rn3(rb[0], rb[1], rb[2]);
    return r;
}

# acos x for 2^-56 ≤ |x| < 1 as a triple-double at out[0..2] (the accurate path before its rounding).
fn _sr_km_acos_acc_td(x: f64, out) {
    var ax: f64 = f64_abs(x);
    var w0: f64 = 0.0;
    var w1: f64 = 0.0;
    var w2: f64 = 0.0;
    if (ax >= 0.5) {                              # (1 − |x|)·(1 + |x|): four exact products
        var a: f64 = 1.0 - ax;
        var bh, bl = _sr_km_fast_two_sum(1.0, ax);
        var p0, e0 = _sr_km_two_prod(a, bh);
        var p1, e1 = _sr_km_two_prod(a, bl);
        var g0, g1, g2 = _sr_km_td_add_d(p0, e0, 0.0, p1);
        var h0, h1, h2 = _sr_km_td_add_d(g0, g1, g2, e1);
        w0 = h0;
        w1 = h1;
        w2 = h2;
    } else {
        var p, pe = _sr_km_two_prod(ax, ax);
        var k0, k1, k2 = _sr_km_td_add_d(1.0, 0.0, 0.0, -p);
        var m0, m1, m2 = _sr_km_td_add_d(k0, k1, k2, -pe);
        w0 = m0;
        w1 = m1;
        w2 = m2;
    }
    var sb: f64[3];
    _sr_km_td_sqrt(w0, w1, w2, &sb);
    var neg = 0;
    if (x < 0.0) { neg = 1; }
    if (sb[0] <= ax) {
        _sr_km_atan_acc_td(sb[0], sb[1], sb[2], ax, 0.0, 0.0, neg, out);
        return;
    }
    _sr_km_atan_acc_td(ax, 0.0, 0.0, sb[0], sb[1], sb[2], 2 + neg, out);
}
