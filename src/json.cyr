# json.cyr — serde-compatible JSON for soorat's serde types: `Color` (M1 part b2), `UvRect` and `Sprite` (M2 part a),
# ADR 0002 #19.
#
# **OPTIONAL.** Outside `[lib]`, bundled by the `[lib.serde]` profile as dist/soorat-serde.cyr. It needs bayan, which
# carries ~372 KB of unicode tables into any binary that includes it (49 KB → 421 KB for soorat's smoke program), so
# only a consumer that wants JSON takes it, and adds "bayan" to its own stdlib leaves. Rust derives serde
# unconditionally.
#
# Rust 1.2.0 derives `Serialize` and `Deserialize`, and its tests go through serde_json. The documents serde_json writes
# decode here to the same bits, and every document written here decodes back to the same bits, here and in serde_json.
# The text is not serde_json's byte for byte: an f32 is written as bayan's round-trip digits of its exact f64 widening
# ("0.10000000149011612" where serde_json writes the f32's shortest, "0.1"); both read back to the same f32. NaN and ±∞
# are written `null`, as serde_json writes them, and like serde_json's such a document doesn't read back. pravash's
# src/json.cyr is the precedent (its ADR 0002 #6, #10).
#
# **Writers.** `SrColor_to_json(c, sb)` appends to a `str_builder` through its non-aborting `_a` calls and returns 0, or
# -1 when a grow failed. Fields go in Rust's declaration order.
#
# **Readers.** `SrColor_from_json(buf, len, out)` parses with bayan's value tree and applies serde's derive semantics,
# as serde_json 1.0.154 (no `float_roundtrip`) reads:
# - a struct reads from an object, by field name (unknown fields ignored, every field required), or from an array of
#   exactly its fields, by position;
# - an f32 takes a JSON integer (`n as f32`, one rounding) or float (the decimal's f64, then `as f32`); serde_json
#   refuses a float whose f64 is infinite (`1e400`), and so does this. A finite f64 beyond f32's range is ±∞, as
#   `as f32` gives;
# - a u64 (`texture_id`) takes a JSON integer ≥ 0, an i32 (`z_order`) a JSON integer in i32's range; a float is
#   refused for both, as serde refuses one;
# - anything else, and trailing text, is Err(SR_ERR_DESERIALIZE), *out untouched.
# serde_json reads a float as its integer significand times or divided by one power of ten. For the documents it
# writes (at most 9 digits, small exponents) that is one correctly rounded step, which is bayan's correctly rounded
# parse. Two bayan policies are stricter than serde_json (pravash found them, filed at bayan): an integer above
# i64::MAX, and a duplicated unknown field, are refused here and read by serde_json. tests/golden/json.tsv names both
# rows (ADR 0002 #19).
#
# Not thread-safe: the decode arena is module state, reset by each read. A parsed tree takes about 20× its document's
# size, so cap an untrusted document's size before reading it.

# ── writer ──────────────────────────────────────────────────────────────────────────

# Appends the C string s: 0, or -1 when the builder can't grow.
#must_use
fn _sr_jw(sb, s): i64 {
    if (str_builder_add_cstr_a(default_alloc(), sb, s) != 0) { return 0 - 1; }
    return 0;
}

# Appends the f32 x (bits) as bayan's round-trip digits of its exact f64, or `null` when x is NaN or ±∞.
#must_use
fn _sr_jw_f32(sb, x): i64 {
    var w: f64 = f32_to(x & 0xFFFFFFFF);
    var buf[40];
    var n = bayan_f64_to_json(w, &buf);
    store8(&buf + n, 0);
    return _sr_jw(sb, &buf);
}

# Appends the u64 n (an i64 holding its bits) in decimal: 0, or -1 when the builder can't grow.
#must_use
fn _sr_jw_u64(sb, n): i64 {
    if (n >= 0) {
        if (str_builder_add_int_a(default_alloc(), sb, n) != 0) { return 0 - 1; }
        return 0;
    }
    var q = ((n >> 1) & 0x7FFFFFFFFFFFFFFF) / 5;
    var d = n - q * 10;
    var rc = 0;
    if (str_builder_add_int_a(default_alloc(), sb, q) != 0) { rc = 0 - 1; }
    if (str_builder_add_int_a(default_alloc(), sb, d) != 0) { rc = 0 - 1; }
    return rc;
}

# Appends the i64 n in decimal: 0, or -1 when the builder can't grow.
#must_use
fn _sr_jw_int(sb, n): i64 {
    if (str_builder_add_int_a(default_alloc(), sb, n) != 0) { return 0 - 1; }
    return 0;
}

# Appends `{"<k0>":…,"<k1>":…,"<k2>":…,"<k3>":…}` for the 4 f32 at p, with the keys given as `"k0":` … text.
#must_use
fn _sr_jw_f32x4(sb, p, k0, k1, k2, k3): i64 {
    var rc = _sr_jw(sb, "{");
    rc = rc | _sr_jw(sb, k0);
    rc = rc | _sr_jw_f32(sb, load32(p));
    rc = rc | _sr_jw(sb, ",");
    rc = rc | _sr_jw(sb, k1);
    rc = rc | _sr_jw_f32(sb, load32(p + 4));
    rc = rc | _sr_jw(sb, ",");
    rc = rc | _sr_jw(sb, k2);
    rc = rc | _sr_jw_f32(sb, load32(p + 8));
    rc = rc | _sr_jw(sb, ",");
    rc = rc | _sr_jw(sb, k3);
    rc = rc | _sr_jw_f32(sb, load32(p + 12));
    rc = rc | _sr_jw(sb, "}");
    return rc;
}

# Appends uv as serde_json writes a `UvRect`: 0, or -1 when the builder can't grow.
#must_use
fn SrUvRect_to_json(uv, sb): i64 {
    return _sr_jw_f32x4(sb, uv, "\"u_min\":", "\"v_min\":", "\"u_max\":", "\"v_max\":");
}

# Appends s as serde_json writes a `Sprite` (fields in Rust's order: x, y, width, height, rotation, color, texture_id,
# z_order, uv): 0, or -1 when the builder can't grow.
#must_use
fn SrSprite_to_json(s, sb): i64 {
    var rc = _sr_jw(sb, "{\"x\":");
    rc = rc | _sr_jw_f32(sb, load32(s + _SR_SP_X));
    rc = rc | _sr_jw(sb, ",\"y\":");
    rc = rc | _sr_jw_f32(sb, load32(s + _SR_SP_Y));
    rc = rc | _sr_jw(sb, ",\"width\":");
    rc = rc | _sr_jw_f32(sb, load32(s + _SR_SP_W));
    rc = rc | _sr_jw(sb, ",\"height\":");
    rc = rc | _sr_jw_f32(sb, load32(s + _SR_SP_H));
    rc = rc | _sr_jw(sb, ",\"rotation\":");
    rc = rc | _sr_jw_f32(sb, load32(s + _SR_SP_ROT));
    rc = rc | _sr_jw(sb, ",\"color\":");
    rc = rc | SrColor_to_json(s + _SR_SP_COLOR, sb);
    rc = rc | _sr_jw(sb, ",\"texture_id\":");
    rc = rc | _sr_jw_u64(sb, load64(s + _SR_SP_TEX));
    rc = rc | _sr_jw(sb, ",\"z_order\":");
    rc = rc | _sr_jw_int(sb, load64(s + _SR_SP_Z));
    rc = rc | _sr_jw(sb, ",\"uv\":");
    rc = rc | SrUvRect_to_json(s + _SR_SP_UV, sb);
    rc = rc | _sr_jw(sb, "}");
    return rc;
}

# Appends c as serde_json writes a `Color` (`{"r":…,"g":…,"b":…,"a":…}`): 0, or -1 when the builder can't grow.
#must_use
fn SrColor_to_json(c, sb): i64 {
    return _sr_jw_f32x4(sb, c, "\"r\":", "\"g\":", "\"b\":", "\"a\":");
}

# ── reader ──────────────────────────────────────────────────────────────────────────

var _sr_json_arena = 0;

# The parsed tree of [buf, buf + len), on the decode arena (reset first), or 0 when the text is not one JSON value
# (or there is no memory).
#must_use
fn _sr_jr_parse(buf, len): i64 {
    if (_sr_json_arena == 0) { _sr_json_arena = arena_allocator_growable(4096); }
    if (_sr_json_arena == 0) { return 0; }
    reset_via(_sr_json_arena);
    return bayan_json_v_parse_buf_a(_sr_json_arena, buf, len);
}

# The form of a struct node with n fields: 1 an object, 2 an array of exactly n elements, 0 anything else.
#must_use
fn _sr_jr_form(v, n): i64 {
    if (v == 0) { return 0; }
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_OBJ) { return 1; }
    if (tag == JTAG_ARR && bayan_json_v_arr_len(v) == n) { return 2; }
    return 0;
}

# Field i, named name, of a struct node in form: its value, or 0 when absent.
#must_use
fn _sr_jr_at(v, form, i, name): i64 {
    if (form == 1) { return bayan_json_v_obj_get_by_cstr(v, name); }
    return bayan_json_v_arr_get(v, i);
}

# A JSON number into the f32 at out, as serde reads an f32: 1, or 0 for anything else (null, a string, a float whose
# f64 is infinite).
fn _sr_jr_f32(v, out): i64 {
    if (v == 0) { return 0; }
    var tag = bayan_json_v_tag(v);
    if (tag == JTAG_INT) {
        store32(out, _sr_i64_to_f32(bayan_json_v_int(v)));
        return 1;
    }
    if (tag != JTAG_FLOAT) { return 0; }
    var x: f64 = bayan_json_v_float(v);
    var d: f64 = x - x;
    var zero: f64 = 0.0;
    if (d != zero) { return 0; }
    store32(out, f32_from(x));
    return 1;
}

# A JSON integer ≥ 0 (a u64, as bayan's tree holds integers up to i64::MAX) into the word at out: 1, or 0.
fn _sr_jr_u64(v, out): i64 {
    if (v == 0 || bayan_json_v_tag(v) != JTAG_INT) { return 0; }
    var n = bayan_json_v_int(v);
    if (n < 0) { return 0; }
    store64(out, n);
    return 1;
}

# A JSON integer in i32's range into the word at out: 1, or 0.
fn _sr_jr_i32(v, out): i64 {
    if (v == 0 || bayan_json_v_tag(v) != JTAG_INT) { return 0; }
    var n = bayan_json_v_int(v);
    if (n < (0 - 2147483648) || n > 2147483647) { return 0; }
    store64(out, n);
    return 1;
}

# A struct node of 4 f32 fields named k0 … k3 (an object, or an array of exactly 4) into the 16 bytes at out: 1, or 0
# (out untouched).
fn _sr_jr_f32x4(v, out, k0, k1, k2, k3): i64 {
    var f = _sr_jr_form(v, 4);
    if (f == 0) { return 0; }
    var w[16];
    var ok = _sr_jr_f32(_sr_jr_at(v, f, 0, k0), &w);
    ok = ok & _sr_jr_f32(_sr_jr_at(v, f, 1, k1), &w + 4);
    ok = ok & _sr_jr_f32(_sr_jr_at(v, f, 2, k2), &w + 8);
    ok = ok & _sr_jr_f32(_sr_jr_at(v, f, 3, k3), &w + 12);
    if (ok == 0) { return 0; }
    store64(out, load64(&w));
    store64(out + 8, load64(&w + 8));
    return 1;
}

# Reads a `Color` document into out: Ok(out), or Err(SR_ERR_DESERIALIZE) with out untouched.
#must_use
fn SrColor_from_json(buf, len, out): Result {
    if (_sr_jr_f32x4(_sr_jr_parse(buf, len), out, "r", "g", "b", "a") == 0) { return Err(SR_ERR_DESERIALIZE); }
    return Ok(out);
}

# Reads a `UvRect` document into out: Ok(out), or Err(SR_ERR_DESERIALIZE) with out untouched.
#must_use
fn SrUvRect_from_json(buf, len, out): Result {
    var v = _sr_jr_parse(buf, len);
    if (_sr_jr_f32x4(v, out, "u_min", "v_min", "u_max", "v_max") == 0) { return Err(SR_ERR_DESERIALIZE); }
    return Ok(out);
}

# Reads a `Sprite` document (an object by field name, or an array of its 9 fields) into out: Ok(out), or
# Err(SR_ERR_DESERIALIZE) with out untouched.
#must_use
fn SrSprite_from_json(buf, len, out): Result {
    var v = _sr_jr_parse(buf, len);
    var f = _sr_jr_form(v, 9);
    if (f == 0) { return Err(SR_ERR_DESERIALIZE); }
    var w[_SR_SPRITE_SIZE];
    var tex[8];
    var z[8];
    var ok = _sr_jr_f32(_sr_jr_at(v, f, 0, "x"), &w + _SR_SP_X);
    ok = ok & _sr_jr_f32(_sr_jr_at(v, f, 1, "y"), &w + _SR_SP_Y);
    ok = ok & _sr_jr_f32(_sr_jr_at(v, f, 2, "width"), &w + _SR_SP_W);
    ok = ok & _sr_jr_f32(_sr_jr_at(v, f, 3, "height"), &w + _SR_SP_H);
    ok = ok & _sr_jr_f32(_sr_jr_at(v, f, 4, "rotation"), &w + _SR_SP_ROT);
    ok = ok & _sr_jr_f32x4(_sr_jr_at(v, f, 5, "color"), &w + _SR_SP_COLOR, "r", "g", "b", "a");
    ok = ok & _sr_jr_u64(_sr_jr_at(v, f, 6, "texture_id"), &tex);
    ok = ok & _sr_jr_i32(_sr_jr_at(v, f, 7, "z_order"), &z);
    ok = ok & _sr_jr_f32x4(_sr_jr_at(v, f, 8, "uv"), &w + _SR_SP_UV, "u_min", "v_min", "u_max", "v_max");
    if (ok == 0) { return Err(SR_ERR_DESERIALIZE); }
    store64(&w + _SR_SP_TEX, load64(&tex));
    store64(&w + _SR_SP_Z, load64(&z));
    _sr_sprite_copy(out, &w);
    return Ok(out);
}
