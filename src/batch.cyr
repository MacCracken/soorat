# batch.cyr — Rust 1.2.0's src/batch.rs (M2 part a): sprite batches → Vertex2D quads and indices.
#
# Each sprite becomes 4 `SrVertex2D` (32 bytes: position, tex_coords, color; src/layout.cyr) and 6 indices, the two
# triangles (0, 1, 2) and (2, 3, 0) offset by 4 per sprite. The u16 forms stop at SR_MAX_SPRITES_PER_BATCH sprites
# (65,535 / 4); the u32 forms have no limit.
#
# **Buffers (ADR 0002 #6).** Rust returns two `Vec`s, or refills the caller's (`_into`). Here `_into` writes into
# caller memory: vertices must hold n × 32 bytes and indices n × 12 (u16) or n × 24 (u32) bytes, n the sprites
# emitted, which `sr_batch_sprite_count` gives. The allocating forms take an allocator (a frame arena, `alloc_via`)
# and fill an SrQuadData with the two arrays and their counts.
#
# **Precision (D4 rule a; plan §5, class B).** Each corner is Rust's f32 sequence: c = (x + w·0.5, y + h·0.5), the
# corner (±w·0.5, ±h·0.5) rotated as (cx·cos − cy·sin) + c. The rotation's sin and cos are correctly rounded
# (ganita's f32 tier) where Rust's are host glibc's, so rows where glibc misrounds are class C against
# tests/golden/sprite.cr.tsv (ADR 0002 #16). A rotation of ±0 skips them (sin 0, cos 1), as Rust does.

# The most sprites one u16-indexed batch holds. Mirrors `MAX_SPRITES_PER_BATCH`.
var SR_MAX_SPRITES_PER_BATCH = 16383;

# The arrays an allocating form returns: `vertices` (vertex_count SrVertex2D) and `indices` (index_count u16 or u32).
struct SrQuadData { vertices; vertex_count; indices; index_count; }

# The number of sprites a u16 form emits for b (all of them, up to SR_MAX_SPRITES_PER_BATCH), or a u32 form
# (all of them) when u32 is 1.
#must_use
fn sr_batch_sprite_count(b, u32): i64 {
    var n = SrSpriteBatch_len(b);
    if (u32 == 0 && n > SR_MAX_SPRITES_PER_BATCH) { return SR_MAX_SPRITES_PER_BATCH; }
    return n;
}

# One corner: position ((kx·cos − ky·sin) + cx, (kx·sin + ky·cos) + cy) in native f32, stored at v.
fn _sr_corner(v, kx: f32, ky: f32, c: f32, s: f32, cx: f32, cy: f32) {
    var px: f32 = ((kx * c) - (ky * s)) + cx;
    var py: f32 = ((kx * s) + (ky * c)) + cy;
    store32(v, px);
    store32(v + 4, py);
    return v;
}

# The centre and half extents of (x, y, w, h) in native f32, into the 4 words at out: cx = x + w·0.5,
# cy = y + h·0.5, hw = w·0.5, hh = h·0.5.
fn _sr_center_half2(out, x: f32, y: f32, w: f32, h: f32, half: f32) {
    var hw: f32 = w * half;
    var hh: f32 = h * half;
    var cx: f32 = x + hw;
    var cy: f32 = y + hh;
    store64(out, cx);
    store64(out + 8, cy);
    store64(out + 16, hw);
    store64(out + 24, hh);
    return out;
}

# Writes the sprite at s as 4 SrVertex2D at v (128 bytes): Rust's `sprite_quad` and `emit_quad`'s vertices.
fn _sr_emit_quad(s, v) {
    var ch[32];
    _sr_center_half2(&ch, load32(s + _SR_SP_X), load32(s + _SR_SP_Y), load32(s + _SR_SP_W), load32(s + _SR_SP_H),
      _SR_SHALF);
    var cx = load64(&ch) & 0xFFFFFFFF;
    var cy = load64(&ch + 8) & 0xFFFFFFFF;
    var hw = load64(&ch + 16) & 0xFFFFFFFF;
    var hh = load64(&ch + 24) & 0xFFFFFFFF;
    var nhw = hw ^ 0x80000000;
    var nhh = hh ^ 0x80000000;
    var rot = load32(s + _SR_SP_ROT);
    var sn = _SR_S0;
    var cs = _SR_S1;
    if ((rot & 0x7FFFFFFF) != 0) {
        sn = ganita_f32_sin(rot);
        cs = ganita_f32_cos(rot);
    }
    _sr_corner(v, nhw, nhh, cs, sn, cx, cy);
    _sr_corner(v + 32, hw, nhh, cs, sn, cx, cy);
    _sr_corner(v + 64, hw, hh, cs, sn, cx, cy);
    _sr_corner(v + 96, nhw, hh, cs, sn, cx, cy);
    var uv = s + _SR_SP_UV;
    var u0 = load32(uv);
    var v0 = load32(uv + 4);
    var u1 = load32(uv + 8);
    var v1 = load32(uv + 12);
    store32(v + 8, u0);
    store32(v + 12, v0);
    store32(v + 40, u1);
    store32(v + 44, v0);
    store32(v + 72, u1);
    store32(v + 76, v1);
    store32(v + 104, u0);
    store32(v + 108, v1);
    var c0 = load64(s + _SR_SP_COLOR);
    var c1 = load64(s + _SR_SP_COLOR + 8);
    var j = 0;
    while (j < 4) {
        store64(v + j * 32 + 16, c0);
        store64(v + j * 32 + 24, c1);
        j = j + 1;
    }
    return v;
}

# Writes the first n sprites of b as quads at vertices, and their indices at indices: u16 when u32 is 0, else u32.
fn _sr_batch_emit(b, n, vertices, indices, u32) {
    var sp = load64(b);
    var i = 0;
    while (i < n) {
        _sr_emit_quad(sp + i * _SR_SPRITE_SIZE, vertices + i * 128);
        var base = i * 4;
        if (u32 == 0) {
            var p = indices + i * 12;
            store16(p, base);
            store16(p + 2, base + 1);
            store16(p + 4, base + 2);
            store16(p + 6, base + 2);
            store16(p + 8, base + 3);
            store16(p + 10, base);
        } else {
            var q = indices + i * 24;
            store32(q, base);
            store32(q + 4, base + 1);
            store32(q + 8, base + 2);
            store32(q + 12, base + 2);
            store32(q + 16, base + 3);
            store32(q + 20, base);
        }
        i = i + 1;
    }
    return n;
}

# Writes b's quads (up to SR_MAX_SPRITES_PER_BATCH sprites) at vertices and their u16 indices at indices, which must
# hold sr_batch_sprite_count(b, 0) × 32 and × 12 bytes. Returns the number of sprites written. Mirrors
# `batch_to_vertices_into`.
fn sr_batch_to_vertices_into(b, vertices, indices): i64 {
    return _sr_batch_emit(b, sr_batch_sprite_count(b, 0), vertices, indices, 0);
}

# As sr_batch_to_vertices_into for every sprite, with u32 indices (n × 24 bytes). Mirrors
# `batch_to_vertices_u32_into`.
fn sr_batch_to_vertices_u32_into(b, vertices, indices): i64 {
    return _sr_batch_emit(b, sr_batch_sprite_count(b, 1), vertices, indices, 1);
}

# Allocates the arrays from the allocator a (a frame arena) and fills them, into out: out, or 0 when an allocation
# fails.
fn _sr_batch_alloc(b, a, out, u32) {
    var n = sr_batch_sprite_count(b, u32);
    var isz = 12;
    if (u32 == 1) { isz = 24; }
    var vb = 0;
    var ib = 0;
    if (n > 0) {
        vb = alloc_via(a, n * 128);
        ib = alloc_via(a, n * isz);
        if (vb == 0 || ib == 0) { return 0; }
    }
    _sr_batch_emit(b, n, vb, ib, u32);
    store64(out, vb);
    store64(out + 8, n * 4);
    store64(out + 16, ib);
    store64(out + 24, n * 6);
    return out;
}

# b's quads and u16 indices (up to SR_MAX_SPRITES_PER_BATCH sprites), allocated from a, into the SrQuadData out:
# out, or 0. Mirrors `batch_to_vertices`.
fn sr_batch_to_vertices(b, a, out) {
    return _sr_batch_alloc(b, a, out, 0);
}

# b's quads and u32 indices (every sprite), allocated from a, into out: out, or 0. Mirrors `batch_to_vertices_u32`.
fn sr_batch_to_vertices_u32(b, a, out) {
    return _sr_batch_alloc(b, a, out, 1);
}
