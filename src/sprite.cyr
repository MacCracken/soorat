# sprite.cyr — Rust 1.2.0's src/sprite.rs (M2 part a): UV rectangles, sprites and sprite batches.
#
# **Layout.** `SrUvRect` is 4 f32 (16 bytes). `SrSprite` is 68 bytes, its fields reordered from Rust's for alignment
# (it is no GPU type): texture_id (u64) at 0, z_order (an i32, sign-extended into 8 bytes) at 8, x, y, width,
# height and rotation (f32) at 16–32, color (an SrColor) at 36, uv (an SrUvRect) at 52. Fields are read and written at
# those offsets (the `_SR_SP_*` constants; tests/sprite.tcyr checks them against the compiled struct). A sprite or
# rectangle result is written through an out pointer; Rust's builders (`with_color(mut self, …) -> Self`) set the
# field in place and return the sprite.
#
# **Precision (D4 rule a).** `center` and `bounds` are Rust's f32 sequence (native f32 helpers); `from_pixel_rect`
# divides in f64 and narrows once, as Rust does: class A and B rows at 0 ulp (tests/golden/sprite.tsv).
#
# **SrSpriteBatch** owns a growable array of sprites from the freelist (`fl_alloc`), so a batch reused every frame
# (`clear`, then `push`) allocates nothing once it has reached its size; free it with SrSpriteBatch_drop. Its
# `sprites` field points at `len` sprites, 68 bytes apart. `sort_by_z` is stable, as Rust's `sort_by_key` is: it sorts
# the keys `(z << 32) | index`, which are all distinct, so ties keep their order, and an already sorted batch costs
# one pass (ADR 0002 #20).

struct SrUvRect { u_min: f32; v_min: f32; u_max: f32; v_max: f32; }
struct SrSprite { texture_id; z_order; x: f32; y: f32; width: f32; height: f32; rotation: f32; color: SrColor;
    uv: SrUvRect; }
struct SrSpriteBatch { sprites; len; cap; keys; scratch; }

# SrSprite field offsets.
const _SR_SP_TEX = 0;
const _SR_SP_Z = 8;
const _SR_SP_X = 16;
const _SR_SP_Y = 20;
const _SR_SP_W = 24;
const _SR_SP_H = 28;
const _SR_SP_ROT = 32;
const _SR_SP_COLOR = 36;
const _SR_SP_UV = 52;
const _SR_SPRITE_SIZE = 68;

# f32 bits of 0, 0.5, 1 and 64.
var _SR_S0 = 0;
var _SR_SHALF = 0x3F000000;
var _SR_S1 = 0x3F800000;
var _SR_S64 = 0x42800000;

# ── UvRect ───────────────────────────────────────────────────────────────────────────

# The full texture, (0, 0) to (1, 1): a pointer to a static rectangle, filled at load. Read or copy it. Mirrors
# `UvRect::FULL`.
var _sr_uv_full_data: u8[16];
var SR_UV_RECT_FULL = &_sr_uv_full_data;

# Writes (u_min, v_min, u_max, v_max) to out.
fn _sr_uv_set(out, u0, v0, u1, v1) {
    store32(out, u0);
    store32(out + 4, v0);
    store32(out + 8, u1);
    store32(out + 12, v1);
    return out;
}
var _sr_uv_full_ready = _sr_uv_set(SR_UV_RECT_FULL, _SR_S0, _SR_S0, _SR_S1, _SR_S1);

# Copies 16 bytes (a UvRect or a Color).
fn _sr_copy16(dst, src) {
    store64(dst, load64(src));
    store64(dst + 8, load64(src + 8));
    return dst;
}

# The full texture, into out. Mirrors `impl Default for UvRect`.
fn SrUvRect_default(out) {
    return _sr_copy16(out, SR_UV_RECT_FULL);
}

# The UV rectangle of the pixel rectangle (x, y, w, h) in an atlas_w × atlas_h atlas, into out: each coordinate
# divided in f64 (so x + w can't overflow) and narrowed once. The full texture when either atlas dimension is 0. The
# arguments are u32 values. Mirrors `UvRect::from_pixel_rect`.
fn SrUvRect_from_pixel_rect(x, y, w, h, atlas_w, atlas_h, out) {
    if (atlas_w == 0 || atlas_h == 0) { return SrUvRect_default(out); }
    var aw: f64 = f64_from(atlas_w & 0xFFFFFFFF);
    var ah: f64 = f64_from(atlas_h & 0xFFFFFFFF);
    var fx: f64 = f64_from(x & 0xFFFFFFFF);
    var fy: f64 = f64_from(y & 0xFFFFFFFF);
    var fw: f64 = f64_from(w & 0xFFFFFFFF);
    var fh: f64 = f64_from(h & 0xFFFFFFFF);
    var u0: f64 = fx / aw;
    var v0: f64 = fy / ah;
    var u1: f64 = (fx + fw) / aw;
    var v1: f64 = (fy + fh) / ah;
    return _sr_uv_set(out, f32_from(u0), f32_from(v0), f32_from(u1), f32_from(v1));
}

# The quad corners' UVs, [top-left, top-right, bottom-right, bottom-left] as 4 (u, v) pairs (8 f32), into out.
# Mirrors `UvRect::corners`.
fn SrUvRect_corners(uv, out) {
    var u0 = load32(uv);
    var v0 = load32(uv + 4);
    var u1 = load32(uv + 8);
    var v1 = load32(uv + 12);
    store32(out, u0);
    store32(out + 4, v0);
    store32(out + 8, u1);
    store32(out + 12, v0);
    store32(out + 16, u1);
    store32(out + 20, v1);
    store32(out + 24, u0);
    store32(out + 28, v1);
    return out;
}

# ── Sprite ───────────────────────────────────────────────────────────────────────────

# Copies a sprite (68 bytes).
fn _sr_sprite_copy(dst, src) {
    var k = 0;
    while (k < 64) {
        store64(dst + k, load64(src + k));
        k = k + 8;
    }
    store32(dst + 64, load32(src + 64));
    return dst;
}

# The default sprite into out: 64 × 64 at (0, 0), no rotation, white, texture 0, z 0, the full texture. Mirrors
# `impl Default for Sprite`.
fn SrSprite_default(out) {
    store64(out + _SR_SP_TEX, 0);
    store64(out + _SR_SP_Z, 0);
    store32(out + _SR_SP_X, _SR_S0);
    store32(out + _SR_SP_Y, _SR_S0);
    store32(out + _SR_SP_W, _SR_S64);
    store32(out + _SR_SP_H, _SR_S64);
    store32(out + _SR_SP_ROT, _SR_S0);
    _sr_copy16(out + _SR_SP_COLOR, SR_COLOR_WHITE);
    _sr_copy16(out + _SR_SP_UV, SR_UV_RECT_FULL);
    return out;
}

# A default sprite at (x, y), width × height (f32 bits), into out. Mirrors `Sprite::new`.
fn SrSprite_new(x, y, width, height, out) {
    SrSprite_default(out);
    store32(out + _SR_SP_X, x);
    store32(out + _SR_SP_Y, y);
    store32(out + _SR_SP_W, width);
    store32(out + _SR_SP_H, height);
    return out;
}

# Sets s's tint to the colour at color; returns s. Mirrors `Sprite::with_color`.
fn SrSprite_with_color(s, color) {
    _sr_copy16(s + _SR_SP_COLOR, color);
    return s;
}

# Sets s's rotation (radians, f32 bits); returns s. Mirrors `Sprite::with_rotation`.
fn SrSprite_with_rotation(s, radians) {
    store32(s + _SR_SP_ROT, radians);
    return s;
}

# Sets s's texture id (a u64); returns s. Mirrors `Sprite::with_texture`.
fn SrSprite_with_texture(s, id) {
    store64(s + _SR_SP_TEX, id);
    return s;
}

# Sets s's z-order to z as an i32 (the low 32 bits, sign-extended); returns s. Mirrors `Sprite::with_z_order`.
fn SrSprite_with_z_order(s, z) {
    store64(s + _SR_SP_Z, ((z & 0xFFFFFFFF) ^ 0x80000000) - 0x80000000);
    return s;
}

# Sets s's UV rectangle to the one at uv; returns s. Mirrors `Sprite::with_uv`.
fn SrSprite_with_uv(s, uv) {
    _sr_copy16(s + _SR_SP_UV, uv);
    return s;
}

# p + q / 2 in native f32.
#must_use
fn _sr_f32_add_half(p: f32, q: f32, two: f32): i64 {
    var r: f32 = p + (q / two);
    return r;
}

# p + q in native f32.
#must_use
fn _sr_f32_add(p: f32, q: f32): i64 {
    var r: f32 = p + q;
    return r;
}

# s's centre, (x + width / 2, y + height / 2) in f32, as 2 f32 at out. Mirrors `Sprite::center`.
fn SrSprite_center(s, out) {
    var two = 0x40000000;
    store32(out, _sr_f32_add_half(load32(s + _SR_SP_X), load32(s + _SR_SP_W), two));
    store32(out + 4, _sr_f32_add_half(load32(s + _SR_SP_Y), load32(s + _SR_SP_H), two));
    return out;
}

# s's bounding box (min_x, min_y, max_x, max_y) = (x, y, x + width, y + height) in f32, as 4 f32 at out. Mirrors
# `Sprite::bounds`.
fn SrSprite_bounds(s, out) {
    var x = load32(s + _SR_SP_X);
    var y = load32(s + _SR_SP_Y);
    store32(out, x);
    store32(out + 4, y);
    store32(out + 8, _sr_f32_add(x, load32(s + _SR_SP_W)));
    store32(out + 12, _sr_f32_add(y, load32(s + _SR_SP_H)));
    return out;
}

# ── SpriteBatch ──────────────────────────────────────────────────────────────────────

# An empty batch with room for capacity sprites (none allocated when 0): an SrSpriteBatch to free with
# SrSpriteBatch_drop, or 0 when an allocation fails. Mirrors `SpriteBatch::with_capacity`.
#must_use
fn SrSpriteBatch_with_capacity(capacity): i64 {
    var b = fl_calloc(sizeof(SrSpriteBatch));
    if (b == 0) { return 0; }
    if (capacity > 0) {
        var p = fl_alloc(capacity * _SR_SPRITE_SIZE);
        if (p == 0) {
            fl_free(b);
            return 0;
        }
        store64(b, p);
        store64(b + 16, capacity);
    }
    return b;
}

# An empty batch: an SrSpriteBatch to free with SrSpriteBatch_drop, or 0. Mirrors `SpriteBatch::new`.
#must_use
fn SrSpriteBatch_new(): i64 {
    return SrSpriteBatch_with_capacity(0);
}

# Frees b and its arrays (0 is ignored).
fn SrSpriteBatch_drop(b) {
    if (b == 0) { return 0; }
    if (load64(b) != 0) { fl_free(load64(b)); }
    if (load64(b + 24) != 0) { fl_free(load64(b + 24) - 8); }
    if (load64(b + 32) != 0) { fl_free(load64(b + 32)); }
    fl_free(b);
    return 0;
}

# Appends a copy of the sprite at s, doubling the array when it is full (4 at first, as Rust's Vec does): 1, or 0 when
# the allocation fails (the batch is unchanged). Mirrors `SpriteBatch::push`.
fn SrSpriteBatch_push(b, s): i64 {
    var len = load64(b + 8);
    var cap = load64(b + 16);
    if (len == cap) {
        var ncap = cap * 2;
        if (ncap < 4) { ncap = 4; }
        var p = fl_alloc(ncap * _SR_SPRITE_SIZE);
        if (p == 0) { return 0; }
        var old = load64(b);
        var i = 0;
        while (i < len) {
            _sr_sprite_copy(p + i * _SR_SPRITE_SIZE, old + i * _SR_SPRITE_SIZE);
            i = i + 1;
        }
        if (old != 0) { fl_free(old); }
        store64(b, p);
        store64(b + 16, ncap);
    }
    _sr_sprite_copy(load64(b) + len * _SR_SPRITE_SIZE, s);
    store64(b + 8, len + 1);
    return 1;
}

# Empties b, keeping its capacity. Mirrors `SpriteBatch::clear`.
fn SrSpriteBatch_clear(b) {
    store64(b + 8, 0);
    return b;
}

# The number of sprites. Mirrors `SpriteBatch::len`.
#must_use
fn SrSpriteBatch_len(b): i64 {
    return load64(b + 8);
}

# 1 when b holds no sprite. Mirrors `SpriteBatch::is_empty`.
#must_use
fn SrSpriteBatch_is_empty(b): i64 {
    if (load64(b + 8) == 0) { return 1; }
    return 0;
}

# The sprite at index i (a pointer into the batch, valid until the next push or sort).
#must_use
fn SrSpriteBatch_get(b, i): i64 {
    return load64(b) + i * _SR_SPRITE_SIZE;
}

# Sorts b's sprites by z-order, ascending, keeping the order of equal z (stable): 1, or 0 when the scratch arrays
# can't be allocated (the batch is unchanged). Mirrors `SpriteBatch::sort_by_z`.
fn SrSpriteBatch_sort_by_z(b): i64 {
    var n = load64(b + 8);
    var sp = load64(b);
    var i = 1;
    while (i < n && load64(sp + i * _SR_SPRITE_SIZE + _SR_SP_Z) >= load64(sp + (i - 1) * _SR_SPRITE_SIZE + _SR_SP_Z)) {
        i = i + 1;
    }
    if (i >= n) { return 1; }
    # The scratch arrays track the capacity: allocated once, reused by every later sort.
    var cap = load64(b + 16);
    if (load64(b + 32) == 0 || _sr_batch_scratch_cap(b) < cap) {
        if (_sr_batch_scratch(b, cap) == 0) { return 0; }
    }
    var keys = load64(b + 24);
    var scratch = load64(b + 32);
    var k = 0;
    while (k < n) {
        store64(keys + k * 8, (load64(sp + k * _SR_SPRITE_SIZE + _SR_SP_Z) << 32) | k);
        k = k + 1;
    }
    _sr_sort_i64(keys, n);
    var j = 0;
    while (j < n) {
        _sr_sprite_copy(scratch + j * _SR_SPRITE_SIZE, sp + (load64(keys + j * 8) & 0xFFFFFFFF) * _SR_SPRITE_SIZE);
        j = j + 1;
    }
    store64(b, scratch);
    store64(b + 32, sp);
    return 1;
}

# The capacity the scratch arrays were allocated for (the word before the keys array).
#must_use
fn _sr_batch_scratch_cap(b): i64 {
    var keys = load64(b + 24);
    if (keys == 0) { return 0; }
    return load64(keys - 8);
}

# (Re)allocates b's keys and sprite scratch arrays for cap sprites: 1, or 0.
fn _sr_batch_scratch(b, cap): i64 {
    var kb = fl_alloc(cap * 8 + 8);
    var sb = fl_alloc(cap * _SR_SPRITE_SIZE);
    if (kb == 0 || sb == 0) {
        if (kb != 0) { fl_free(kb); }
        if (sb != 0) { fl_free(sb); }
        return 0;
    }
    store64(kb, cap);
    if (load64(b + 24) != 0) { fl_free(load64(b + 24) - 8); }
    if (load64(b + 32) != 0) { fl_free(load64(b + 32)); }
    store64(b + 24, kb + 8);
    store64(b + 32, sb);
    return 1;
}
