# debug_geom.cyr — the geometry half of Rust 1.2.0's src/debug_draw.rs (M2 part b): debug lines and wire shapes.
#
# `SrLineBatch` owns a growable array of `SrLineVertex` (28 bytes: position, color; src/layout.cyr) from the
# freelist, two per line, freed by SrLineBatch_drop; `clear` keeps the capacity, so a batch reused every frame
# allocates nothing (as SrSpriteBatch). Points are 3 f32 and colours SrColor, by pointer. The line pipeline that draws
# them is M6 (MB1). `collider` (Rust's `physics-debug` feature, impetus) is src/debug_collider.cyr, its own profile.
#
# **Precision (D4 rule a).** Every coordinate is Rust's f32 sequence: c + r·cos, the step τ / segments and the angle
# step · i in f32. The angles' sin and cos are correctly rounded (ganita's f32 tier) where Rust's are host glibc's, so
# rows where glibc misrounds are class C against tests/golden/debug.cr.tsv (ADR 0002 #16).

struct SrLineBatch { vertices; len; cap; }

# f32 bits of 0, 1, −1 and τ (`std::f32::consts::TAU`).
var _SR_D0 = 0;
var _SR_D1 = 0x3F800000;
var _SR_DM1 = 0xBF800000;
var _SR_DTAU = 0x40C90FDB;

# An empty batch with room for lines lines: an SrLineBatch to free with SrLineBatch_drop, or 0. Mirrors
# `LineBatch::with_capacity`.
#must_use
fn SrLineBatch_with_capacity(lines): i64 {
    var b = fl_calloc(sizeof(SrLineBatch));
    if (b == 0) { return 0; }
    if (lines > 0) {
        var p = fl_alloc(lines * 2 * 28);
        if (p == 0) {
            fl_free(b);
            return 0;
        }
        store64(b, p);
        store64(b + 16, lines * 2);
    }
    return b;
}

# An empty batch, or 0. Mirrors `LineBatch::new`.
#must_use
fn SrLineBatch_new(): i64 {
    return SrLineBatch_with_capacity(0);
}

# Frees b and its vertices (0 is ignored).
fn SrLineBatch_drop(b) {
    if (b == 0) { return 0; }
    if (load64(b) != 0) { fl_free(load64(b)); }
    fl_free(b);
    return 0;
}

# Makes room for 2 more vertices, doubling (from 8): 1, or 0 when the allocation fails.
fn _sr_line_room(b): i64 {
    var len = load64(b + 8);
    var cap = load64(b + 16);
    if (len + 2 <= cap) { return 1; }
    var ncap = cap * 2;
    if (ncap < 8) { ncap = 8; }
    var p = fl_alloc(ncap * 28);
    if (p == 0) { return 0; }
    var old = load64(b);
    var k = 0;
    while (k < len * 28) {
        store32(p + k, load32(old + k));
        k = k + 4;
    }
    if (old != 0) { fl_free(old); }
    store64(b, p);
    store64(b + 16, ncap);
    return 1;
}

# Writes one SrLineVertex (x, y, z, color) at v.
fn _sr_line_vertex(v, x, y, z, color) {
    store32(v, x);
    store32(v + 4, y);
    store32(v + 8, z);
    store64(v + 12, load64(color));
    store64(v + 20, load64(color + 8));
    return v;
}

# Appends the line (ax, ay, az) → (bx, by, bz) (f32 bits) in color: 1, or 0 when an allocation fails. The two vertices
# are written inline: one call per line, not four (port-parity §3.2).
fn _sr_line6(b, ax, ay, az, bx, by, bz, color): i64 {
    var len = load64(b + 8);
    if (len + 2 > load64(b + 16)) {
        if (_sr_line_room(b) == 0) { return 0; }
    }
    var v = load64(b) + len * 28;
    var c0 = load64(color);
    var c1 = load64(color + 8);
    store32(v, ax);
    store32(v + 4, ay);
    store32(v + 8, az);
    store64(v + 12, c0);
    store64(v + 20, c1);
    store32(v + 28, bx);
    store32(v + 32, by);
    store32(v + 36, bz);
    store64(v + 40, c0);
    store64(v + 48, c1);
    store64(b + 8, len + 2);
    return 1;
}

# Appends the line a → b (3 f32 each) in color: 1, or 0 when an allocation fails. Mirrors `LineBatch::line`.
fn SrLineBatch_line(b, pa, pb, color): i64 {
    return _sr_line6(b, load32(pa), load32(pa + 4), load32(pa + 8), load32(pb), load32(pb + 4), load32(pb + 8), color);
}

# Appends the 12 edges of the box min → max (bottom face, top face, then the verticals, as Rust orders them): 1, or 0.
# Mirrors `LineBatch::wire_box`.
fn SrLineBatch_wire_box(b, min, max, color): i64 {
    var x0 = load32(min);
    var y0 = load32(min + 4);
    var z0 = load32(min + 8);
    var x1 = load32(max);
    var y1 = load32(max + 4);
    var z1 = load32(max + 8);
    var ok = _sr_line6(b, x0, y0, z0, x1, y0, z0, color);
    ok = ok & _sr_line6(b, x1, y0, z0, x1, y0, z1, color);
    ok = ok & _sr_line6(b, x1, y0, z1, x0, y0, z1, color);
    ok = ok & _sr_line6(b, x0, y0, z1, x0, y0, z0, color);
    ok = ok & _sr_line6(b, x0, y1, z0, x1, y1, z0, color);
    ok = ok & _sr_line6(b, x1, y1, z0, x1, y1, z1, color);
    ok = ok & _sr_line6(b, x1, y1, z1, x0, y1, z1, color);
    ok = ok & _sr_line6(b, x0, y1, z1, x0, y1, z0, color);
    ok = ok & _sr_line6(b, x0, y0, z0, x0, y1, z0, color);
    ok = ok & _sr_line6(b, x1, y0, z0, x1, y1, z0, color);
    ok = ok & _sr_line6(b, x1, y0, z1, x1, y1, z1, color);
    ok = ok & _sr_line6(b, x0, y0, z1, x0, y1, z1, color);
    return ok;
}

# c + r·k in native f32.
#must_use
fn _sr_f32_cpr(c: f32, r: f32, k: f32): i64 {
    var v: f32 = c + (r * k);
    return v;
}

# τ / segments in native f32 (segments a u32, converted as Rust's `as f32`).
#must_use
fn _sr_circle_step(segments): i64 {
    return _sr_f32_div(_SR_DTAU, _sr_i64_to_f32(segments & 0xFFFFFFFF));
}

# The (sin, cos) table of the angles step · i, i = 0 … segments, for the last segment count used up to
# _SR_TRIG_MAX: a circle or sphere drawn again with the same count reuses it (the values are the ones it would
# compute). Not thread-safe: module state, as src/json.cyr's arena.
var _SR_TRIG_MAX = 256;
var _sr_trig_data: u8[4112];
var _sr_trig_n = 0 - 1;

# The angle step · i in native f32, and its correctly rounded sin and cos, into the 2 words at out (sin, cos).
fn _sr_circle_sc_compute(step, i, out) {
    var a = _sr_f32_mul(step, _sr_i64_to_f32(i));
    store64(out, ganita_f32_sin(a));
    store64(out + 8, ganita_f32_cos(a));
    return out;
}

# A pointer to the (sin, cos) pairs (2 words each) of the angles step · i for i = 0 … segments: the cached table when
# segments ≤ _SR_TRIG_MAX (filled now if it holds another count), else 0 (the caller computes each angle).
fn _sr_trig_table(segments, step): i64 {
    if (segments > _SR_TRIG_MAX) { return 0; }
    var t = &_sr_trig_data;
    if (_sr_trig_n != segments) {
        store64(t, 0);
        store64(t + 8, 0x3F800000);
        var i = 1;
        while (i <= segments) {
            _sr_circle_sc_compute(step, i, t + i * 16);
            i = i + 1;
        }
        _sr_trig_n = segments;
    }
    return t;
}

# The (sin, cos) of angle i into out, from the table tab when there is one.
fn _sr_circle_sc(tab, step, i, out) {
    if (tab != 0) {
        store64(out, load64(tab + i * 16));
        store64(out + 8, load64(tab + i * 16 + 8));
        return out;
    }
    return _sr_circle_sc_compute(step, i, out);
}

# The 8 values c + r·k a circle segment needs, in native f32, at out (8 words): x·pc, x·nc, y·pc, y·nc, y·ps, y·ns,
# z·ps, z·ns, where x, y, z are the centre's coordinates.
fn _sr_circle_pts(out, x: f32, y: f32, z: f32, r: f32, pc: f32, ps: f32, nc: f32, ns: f32) {
    var a: f32 = x + (r * pc);
    var b: f32 = x + (r * nc);
    var c: f32 = y + (r * pc);
    var d: f32 = y + (r * nc);
    var e: f32 = y + (r * ps);
    var f: f32 = y + (r * ns);
    var g: f32 = z + (r * ps);
    var h: f32 = z + (r * ns);
    store64(out, a);
    store64(out + 8, b);
    store64(out + 16, c);
    store64(out + 24, d);
    store64(out + 32, e);
    store64(out + 40, f);
    store64(out + 48, g);
    store64(out + 56, h);
    return out;
}

# Appends a circle of radius r about center in the XZ plane as segments lines, starting at angle 0: 1, or 0. Nothing
# when segments is 0. Mirrors `LineBatch::wire_circle`.
fn SrLineBatch_wire_circle(b, center, radius, segments, color): i64 {
    if ((segments & 0xFFFFFFFF) == 0) { return 1; }
    var c0 = load32(center);
    var c1 = load32(center + 4);
    var c2 = load32(center + 8);
    var n = segments & 0xFFFFFFFF;
    var step = _sr_circle_step(n);
    var tab = _sr_trig_table(n, step);
    var ps = _SR_D0;
    var pc = _SR_D1;
    var sc[16];
    var q[64];
    var ok = 1;
    var i = 1;
    while (i <= n) {
        _sr_circle_sc(tab, step, i, &sc);
        var ns = load64(&sc) & 0xFFFFFFFF;
        var nc = load64(&sc + 8) & 0xFFFFFFFF;
        _sr_circle_pts(&q, c0, c1, c2, radius, pc, ps, nc, ns);
        var ax = load64(&q) & 0xFFFFFFFF;
        var bx = load64(&q + 8) & 0xFFFFFFFF;
        var az = load64(&q + 48) & 0xFFFFFFFF;
        var bz = load64(&q + 56) & 0xFFFFFFFF;
        ok = ok & _sr_line6(b, ax, c1, az, bx, c1, bz, color);
        ps = ns;
        pc = nc;
        i = i + 1;
    }
    return ok;
}

# Appends three great circles of radius r about center (XZ, XY and YZ planes), segments lines each, interleaved per
# segment as Rust does: 1, or 0. Nothing when segments is 0. Mirrors `LineBatch::wire_sphere`.
fn SrLineBatch_wire_sphere(b, center, radius, segments, color): i64 {
    if ((segments & 0xFFFFFFFF) == 0) { return 1; }
    var c0 = load32(center);
    var c1 = load32(center + 4);
    var c2 = load32(center + 8);
    var n = segments & 0xFFFFFFFF;
    var step = _sr_circle_step(n);
    var tab = _sr_trig_table(n, step);
    var ps = _SR_D0;
    var pc = _SR_D1;
    var sc[16];
    var q[64];
    var ok = 1;
    var i = 1;
    while (i <= n) {
        _sr_circle_sc(tab, step, i, &sc);
        var ns = load64(&sc) & 0xFFFFFFFF;
        var nc = load64(&sc + 8) & 0xFFFFFFFF;
        _sr_circle_pts(&q, c0, c1, c2, radius, pc, ps, nc, ns);
        var xpc = load64(&q) & 0xFFFFFFFF;
        var xnc = load64(&q + 8) & 0xFFFFFFFF;
        var ypc = load64(&q + 16) & 0xFFFFFFFF;
        var ync = load64(&q + 24) & 0xFFFFFFFF;
        var yps = load64(&q + 32) & 0xFFFFFFFF;
        var yns = load64(&q + 40) & 0xFFFFFFFF;
        var zps = load64(&q + 48) & 0xFFFFFFFF;
        var zns = load64(&q + 56) & 0xFFFFFFFF;
        ok = ok & _sr_line6(b, xpc, c1, zps, xnc, c1, zns, color);
        ok = ok & _sr_line6(b, xpc, yps, c2, xnc, yns, c2, color);
        ok = ok & _sr_line6(b, c0, ypc, zps, c0, ync, zns, color);
        ps = ns;
        pc = nc;
        i = i + 1;
    }
    return ok;
}

# ceil(x) for an f32 x, as f32 bits (NaN and ±∞ unchanged; −0 kept).
#must_use
fn _sr_ceil32(x): i64 {
    var b = x & 0xFFFFFFFF;
    if ((b & 0x7FFFFFFF) >= 0x4B000000) { return b; }
    var v: f64 = f32_to(b);
    var nv: f64 = 0.0 - v;
    var fl: f64 = f64_floor(nv);
    var r: f64 = 0.0 - fl;
    return f32_from(r) | (b & 0x80000000);
}

# x as i32, as Rust's saturating `as`: NaN → 0, beyond the range → i32::MIN / MAX, else truncated.
#must_use
fn _sr_f32_to_i32(x): i64 {
    if (_sr_f32_is_nan(x) == 1) { return 0; }
    var v: f64 = f32_to(x & 0xFFFFFFFF);
    var top: f64 = 2147483647.0;
    var bottom: f64 = 0.0 - 2147483648.0;
    if (v >= top) { return 2147483647; }
    if (v <= bottom) { return 0 - 2147483648; }
    return f64_to(v);
}

# 1 when the f32 x ≤ 0 (0 for NaN).
#must_use
fn _sr_f32_le0(x): i64 {
    return _sr_f32_le(x, 0);
}

# Appends a grid on the XZ plane (y = 0) from −half_extent to half_extent, a line along Z and one along X at each
# multiple of spacing, i·spacing for i in −count … count, count = ceil(half_extent / spacing) as i32: 1, or 0. Nothing
# when spacing ≤ 0 or half_extent ≤ 0 (a NaN passes, as in Rust: count 0). Mirrors `LineBatch::grid`.
fn SrLineBatch_grid(b, half_extent, spacing, color): i64 {
    if (_sr_f32_le0(spacing) == 1 || _sr_f32_le0(half_extent) == 1) { return 1; }
    var count = _sr_f32_to_i32(_sr_ceil32(_sr_f32_div(half_extent, spacing)));
    var nh = half_extent ^ 0x80000000;
    var ok = 1;
    var i = 0 - count;
    while (i <= count) {
        var pos = _sr_f32_mul(_sr_i64_to_f32(i), spacing);
        ok = ok & _sr_line6(b, pos, _SR_D0, nh, pos, _SR_D0, half_extent, color);
        ok = ok & _sr_line6(b, nh, _SR_D0, pos, half_extent, _SR_D0, pos, color);
        i = i + 1;
    }
    return ok;
}

# p − q in native f32.
#must_use
fn _sr_f32_sub(p: f32, q: f32): i64 {
    var r: f32 = p - q;
    return r;
}

# Appends a capsule about center: circles at ± half_height (XZ plane), and four vertical lines at (±r, 0) and
# (0, ±r): 1, or 0. Mirrors `LineBatch::wire_capsule`.
fn SrLineBatch_wire_capsule(b, center, half_height, radius, segments, color): i64 {
    var top[12];
    var bot[12];
    store32(&top, load32(center));
    store32(&top + 4, _sr_f32_add(load32(center + 4), half_height));
    store32(&top + 8, load32(center + 8));
    store32(&bot, load32(center));
    store32(&bot + 4, _sr_f32_sub(load32(center + 4), half_height));
    store32(&bot + 8, load32(center + 8));
    var ok = SrLineBatch_wire_circle(b, &top, radius, segments, color);
    ok = ok & SrLineBatch_wire_circle(b, &bot, radius, segments, color);
    var dirs[64];
    store64(&dirs, _SR_D1);
    store64(&dirs + 8, _SR_D0);
    store64(&dirs + 16, _SR_DM1);
    store64(&dirs + 24, _SR_D0);
    store64(&dirs + 32, _SR_D0);
    store64(&dirs + 40, _SR_D1);
    store64(&dirs + 48, _SR_D0);
    store64(&dirs + 56, _SR_DM1);
    var k = 0;
    while (k < 4) {
        var dx = load64(&dirs + k * 16);
        var dz = load64(&dirs + k * 16 + 8);
        var tx = _sr_f32_cpr(load32(&top), radius, dx);
        var tz = _sr_f32_cpr(load32(&top + 8), radius, dz);
        var bx2 = _sr_f32_cpr(load32(&bot), radius, dx);
        var bz2 = _sr_f32_cpr(load32(&bot + 8), radius, dz);
        ok = ok & _sr_line6(b, tx, load32(&top + 4), tz, bx2, load32(&bot + 4), bz2, color);
        k = k + 1;
    }
    return ok;
}

# Empties b, keeping its capacity. Mirrors `LineBatch::clear`.
fn SrLineBatch_clear(b) {
    store64(b + 8, 0);
    return b;
}

# The number of lines (vertices / 2). Mirrors `LineBatch::line_count`.
#must_use
fn SrLineBatch_line_count(b): i64 {
    return load64(b + 8) / 2;
}

# 1 when b holds no vertex. Mirrors `LineBatch::is_empty`.
#must_use
fn SrLineBatch_is_empty(b): i64 {
    if (load64(b + 8) == 0) { return 1; }
    return 0;
}

# The number of vertices (2 per line) at b's `vertices`.
#must_use
fn SrLineBatch_vertex_count(b): i64 {
    return load64(b + 8);
}
