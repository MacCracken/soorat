# soorat — Cyrius port
# Ported from 15767 lines of Rust

# Stdlib auto-included via cyrius.cyml

# The program entry: a smoke check that the bundle links, until M1 adds the library.
fn main() {
    alloc_init();
    println("soorat ready");
    return 0;
}

var r = main();
# sys_exit_group, not syscall(SYS_EXIT, ...): SYS_EXIT ends only the calling
# thread, so the bare syscall hangs once this program spawns its first worker.
sys_exit_group(r);
