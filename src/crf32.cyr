# crf32.cyr — correctly rounded f32 transcendentals (ADR 0003, Part 0c).
#
# `_sr_cr_cosf` gives the f32 nearest cos x, for every f32 x, from kimiya's correctly rounded f64 cosine
# (src/crmath.cyr, vendored):
# - A correctly rounded f64 y is within half an f64 ulp of cos x, and every f32 midpoint is an f64. So narrowing y
#   gives the correctly rounded f32, unless y is itself an f32 midpoint.
# - In that case cos x lies on one side of y, and crmath's triple-double accurate path (to about 2^-150) says which.
#   probe P13 lists the f32 arguments that need it, and tests/golden/lights.tsv carries them as rows.
#
# The alternatives are not correct everywhere. ganita's f32 tier narrows an f64 that is only within 1 ulp, and glibc's
# `cosf`, which Rust 1.2.0 calls, misrounds about 1 argument in 75 (probe P3).
#
# This file calls crmath's internals and src/crsum.cyr's f32 order, so it follows both.

# 1 when the f64 y is exactly halfway between two normal f32 values: its low 29 significand bits are a 1 then 28
# zeros, and its exponent is in the f32 normal range. A cosine of an f32 is never below 2^-126 in magnitude unless it
# is 0, so the subnormal midpoints never arise here.
#must_use
fn _sr_f32_is_mid(y: f64): i64 {
    var b = load64(&y);
    var e = (b >> 52) & 0x7FF;
    if (e < 897 || e > 1150) { return 0; }       # 2^-126 … 2^127
    if ((b & 0x1FFFFFFF) == 0x10000000) { return 1; }
    return 0;
}

# cos x for the f32 x (bits), correctly rounded to f32, as bits. NaN for a NaN or an infinity, 1 for ±0.
#must_use
fn _sr_cr_cosf(x): i64 {
    var xd: f64 = f32_to(x & 0xFFFFFFFF);
    var y: f64 = _sr_km_cr_cos(xd);
    var c = f32_from(y);
    if (_sr_f32_is_mid(y) == 0) { return c; }
    # y is an f32 midpoint, and |x| ≥ 2^-27 (crmath returns 1 below that). The accurate path's cos |x| decides, as
    # crmath's own _sr_km_sc_acc computes it (sel = 1).
    var ax = load64(&xd) & 0x7FFFFFFFFFFFFFFF;
    var rb: f64[3];
    var k = _sr_km_sc_reduce_acc(ax, &rb);
    var ob: f64[6];
    _sr_km_sc_acc_td((k + 1) & 3, rb[0], rb[1], rb[2], 0, &ob);
    # The sign of (ob0 + ob1 + ob2) − y. ob0 is within an f64 ulp of y, so ob0 − y is exact. When it is nonzero it
    # outweighs ob1 + ob2, which is below half of ob0's ulp.
    var d0: f64 = ob[0] - y;
    var tail: f64 = ob[1] + ob[2];
    var d: f64 = d0 + tail;
    var zero: f64 = 0.0;
    if (d == zero) { return c; }                  # a tie: impossible for a transcendental value, kept for safety
    var cv: f64 = f32_to(c);
    var lower = c;
    var upper = c;
    if (cv > y) {
        lower = _sr_f32_unord(_sr_f32_ord(c) - 1);
    } else {
        upper = _sr_f32_unord(_sr_f32_ord(c) + 1);
    }
    if (d > zero) { return upper; }
    return lower;
}
