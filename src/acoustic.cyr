# acoustic.cyr — the producer-free half of Rust 1.2.0's src/acoustic_render.rs (M5 part a): its colour mode, the two
# parameter structs and their defaults, and `acoustic_heat_map`. Rust compiles these without the `acoustics` feature,
# so they are in `[lib]`. The renderers, which read goonj's types, are src/acoustic_render.cyr in the
# `[lib.acoustics]` profile.
#
# **Layout.** `SrAcousticVisParams` (32 bytes): color_mode (an SR_ACOUSTIC_COLOR_MODE_*) at 0, base_color (an SrColor)
# at 8, alpha (f32) at 24. `SrDecayCurveParams` (72 bytes): origin as origin_0 … origin_2 (f32, Cyrius has no array
# fields) at 0, time_range, db_range, x_scale and y_scale (f32) at 12–24, steps (a u32 in an 8-byte slot) at 32,
# color_early and color_late (SrColor) at 40 and 56.

enum SrAcousticColorMode {
    SR_ACOUSTIC_COLOR_MODE_PRESSURE = 0;
    SR_ACOUSTIC_COLOR_MODE_SIGNED_PRESSURE = 1;
    SR_ACOUSTIC_COLOR_MODE_ENERGY = 2;
}

struct SrAcousticVisParams { color_mode; base_color: SrColor; alpha: f32; _pad0: f32; }
struct SrDecayCurveParams { origin_0: f32; origin_1: f32; origin_2: f32; time_range: f32; db_range: f32; x_scale: f32;
    y_scale: f32; _pad0: f32; steps; color_early: SrColor; color_late: SrColor; }

# The default parameters into out: Pressure, cornflower blue, alpha 1. Mirrors `impl Default for AcousticVisParams`.
fn SrAcousticVisParams_default(out) {
    store64(out, SR_ACOUSTIC_COLOR_MODE_PRESSURE);
    memcpy(out + 8, SR_COLOR_CORNFLOWER_BLUE, 16);
    store32(out + 24, _SR_C1);
    store32(out + 28, 0);
    return out;
}

# The default decay-curve parameters into out: origin 0, 3 s, −60 dB, scales 1, 100 steps, green early and red late.
# Mirrors `impl Default for DecayCurveParams`.
fn SrDecayCurveParams_default(out) {
    store32(out, 0);
    store32(out + 4, 0);
    store32(out + 8, 0);
    store32(out + 12, 0x40400000);
    store32(out + 16, 0xC2700000);
    store32(out + 20, _SR_C1);
    store32(out + 24, _SR_C1);
    store32(out + 28, 0);
    store64(out + 32, 100);
    memcpy(out + 40, SR_COLOR_GREEN, 16);
    memcpy(out + 56, SR_COLOR_RED, 16);
    return out;
}

# The heat-map colour of t (f32 bits) into out: `visualization_heat_map`'s. Mirrors `acoustic_heat_map`.
fn sr_acoustic_heat_map(t, out) {
    return sr_visualization_heat_map(t, out);
}
