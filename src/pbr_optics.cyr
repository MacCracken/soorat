# pbr_optics.cyr — Rust 1.2.0's `optics` half of src/pbr_material.rs (M4 part b): `MaterialUniforms::from_ior` and
# the BRDF integration LUT.
#
# **OPTIONAL**, as Rust gates them behind `optics`: bundled by the `[lib.optics]` profile after src/color_optics.cyr.
#
# **Rust 1.2.0's values, not prakash 2.15.2's** (ADR 0002 #27). Rust calls prakash 1.2.0's `ior_to_f0` and
# `integrate_brdf_lut`. Cyrius prakash 2.15.2 changed both: `pbr_ior_to_f0` returns NaN for an IOR that is not finite
# and positive, and `pbr_integrate_brdf_lut` uses the image-based-lighting geometry remap (k = α/2) where 1.2.0 used
# the direct-lighting one (k = (r + 1)²/8). The LUTs differ on about 3 bytes in 4, by up to 229. So these transcribe
# prakash 1.2.0's two formulas, in f64 as it computes them; the golden rows are class A on every byte.

# F0 = ((1 − ior) / (1 + ior))² in f64, for any ior (prakash 1.2.0's `ior_to_f0`).
#must_use
fn _sr_ior_to_f0(ior): i64 {
    var x: f64 = ior;
    var one: f64 = 1.0;
    var r: f64 = (one - x) / (one + x);
    var f: f64 = r * r;
    return f;
}

# A dielectric of base_color (an SrColor) whose `_pad0` holds the reflectance F0 of the index of refraction ior (f64
# bits), narrowed to f32; metallic 0. Mirrors `MaterialUniforms::from_ior`.
fn SrMaterialUniforms_from_ior(base_color, ior, roughness, out) {
    _sr_material(base_color, 0, roughness, out);
    var f0: f64 = _sr_ior_to_f0(ior);
    store32(out + 24, f32_from(f0));
    return out;
}

# n/(n·(1 − k) + k + 1e-15), n clamped to [0, 1], k = (r + 1)²/8: prakash 1.2.0's `geometry_schlick_ggx`.
fn _sr_ggx_g1(n: f64, r: f64): f64 {
    var zero: f64 = 0.0;
    var one: f64 = 1.0;
    var eight: f64 = 8.0;
    var eb = 0x3CD203AF9EE75616;
    var eps: f64 = eb;
    var rr: f64 = r + one;
    var k: f64 = (rr * rr) / eight;
    var nd: f64 = n;
    if (nd < zero) { nd = zero; }
    if (nd > one) { nd = one; }
    return nd / (((nd * (one - k)) + k) + eps);
}

# The split-sum (scale, bias) of (n·v, roughness) over samples Hammersley points of importance-sampled GGX, into out
# (2 f64): prakash 1.2.0's `integrate_brdf_lut`, operation for operation (the view clamped to [0.001, 1], the GGX
# half-vector from xi1 = i / samples and the radical inverse of i, the light reflected about it, Smith with the
# direct-lighting k, and (1 − v·h)⁵ as x·((x·x)·(x·x))). samples 0 gives NaN, as in 1.2.0.
fn _sr_brdf_integrate(ndv0: f64, rough: f64, samples, out) {
    var zero: f64 = 0.0;
    var one: f64 = 1.0;
    var two: f64 = 2.0;
    var lob = 0x3F50624DD2F1A9FC;
    var lo: f64 = lob;
    var eb = 0x3CD203AF9EE75616;
    var eps: f64 = eb;
    var taub = 0x401921FB54442D18;
    var tau: f64 = taub;
    var ndv: f64 = ndv0;
    if (ndv < lo) { ndv = lo; }
    if (ndv > one) { ndv = one; }
    var v0: f64 = f64_sqrt(one - (ndv * ndv));
    var scale: f64 = zero;
    var bias: f64 = zero;
    var fs: f64 = f64_from(samples);
    var inv: f64 = one / fs;
    var a: f64 = rough * rough;
    var a2: f64 = a * a;
    var g1v: f64 = _sr_ggx_g1(ndv, rough);
    var i = 0;
    while (i < samples) {
        var fi: f64 = f64_from(i);
        var xi1: f64 = fi * inv;
        var rev = 0;
        var b = i;
        var k = 0;
        while (k < 32) {
            rev = (rev << 1) | (b & 1);
            b = b >> 1;
            k = k + 1;
        }
        var frev: f64 = f64_from(rev);
        var xsb = 0x3DF0000000000000;
        var xscale: f64 = xsb;
        var xi2: f64 = frev * xscale;
        var ct: f64 = f64_sqrt((one - xi1) / (one + ((a2 - one) * xi1)));
        var st2: f64 = one - (ct * ct);
        var st: f64 = zero;
        if (st2 >= zero) { st = f64_sqrt(st2); }
        var phi: f64 = tau * xi2;
        var h0: f64 = st * f64_cos(phi);
        var h1: f64 = st * f64_sin(phi);
        var vdh: f64 = ((v0 * h0) + (zero * h1)) + (ndv * ct);
        if (vdh < zero || vdh != vdh) { vdh = zero; }
        var l2: f64 = ((two * vdh) * ct) - ndv;
        var ndl: f64 = l2;
        if (ndl < zero || ndl != ndl) { ndl = zero; }
        var ndh: f64 = ct;
        if (ndh < zero || ndh != ndh) { ndh = zero; }
        if (ndl > zero) {
            var g: f64 = g1v * _sr_ggx_g1(ndl, rough);
            var gvis: f64 = (g * vdh) / ((ndh * ndv) + eps);
            var x: f64 = one - vdh;
            var fc: f64 = x * ((x * x) * (x * x));
            scale = scale + (gvis * (one - fc));
            bias = bias + (gvis * fc);
        }
        i = i + 1;
    }
    store64(out, scale * inv);
    store64(out + 8, bias * inv);
    return out;
}

# (v.clamp(0, 1) · 255).round() as u8 for an f64 v: NaN gives 0, halves round away from zero (the fraction taken
# exactly, not floor(y + 0.5), which rounds k + 0.49999999999999994 up).
#must_use
fn _sr_lut_q8(v: f64): i64 {
    if (v != v) { return 0; }
    var zero: f64 = 0.0;
    var one: f64 = 1.0;
    var x: f64 = v;
    if (x < zero) { x = zero; }
    if (x > one) { x = one; }
    var k: f64 = 255.0;
    var h: f64 = 0.5;
    var y: f64 = x * k;
    var fl: f64 = f64_floor(y);
    var r = f64_to(fl);
    var frac: f64 = y - fl;
    if (frac >= h) { r = r + 1; }
    return r;
}

# The size × size BRDF integration LUT (RGBA8: red the scale, green the bias, blue 0, alpha 255), samples samples a
# texel, row y at roughness (y + 0.5)/size and column x at n·v (x + 0.5)/size: size²·4 bytes from the allocator a, or
# 0 when the allocation fails. Mirrors `generate_brdf_lut`.
fn sr_generate_brdf_lut(size, samples, a): i64 {
    var s = size & 0xFFFFFFFF;
    var px = alloc_via(a, s * s * 4 + 8);
    if (px == 0) { return 0; }
    var fs: f64 = f64_from(s);
    var h: f64 = 0.5;
    var r[16];
    var y = 0;
    while (y < s) {
        var fy: f64 = f64_from(y);
        var rough: f64 = (fy + h) / fs;
        var x = 0;
        while (x < s) {
            var fx: f64 = f64_from(x);
            var ndv: f64 = (fx + h) / fs;
            _sr_brdf_integrate(ndv, rough, samples & 0xFFFFFFFF, &r);
            var p = px + (y * s + x) * 4;
            var sc: f64 = load64(&r);
            var bi: f64 = load64(&r + 8);
            store8(p, _sr_lut_q8(sc));
            store8(p + 1, _sr_lut_q8(bi));
            store8(p + 2, 0);
            store8(p + 3, 255);
            x = x + 1;
        }
        y = y + 1;
    }
    return px;
}
