# pbr_optics.cyr — Rust 1.2.0's `optics` half of src/pbr_material.rs (M4 part b): `MaterialUniforms::from_ior` and
# the BRDF integration LUT.
#
# **OPTIONAL**, as Rust gates them behind `optics`: bundled by the `[lib.optics]` profile after src/color_optics.cyr,
# which includes prakash.
#
# Rust calls prakash 1.2.0's `ior_to_f0` and `integrate_brdf_lut`; Cyrius prakash 2.15.2 changed both (ADR 0002 #27).
# - **The LUT is prakash 2.15.2's** (`pbr_integrate_brdf_lut`, adopted): the split sum is image-based lighting, and
#   2.15.2 uses its geometry remap (k = α/2), where 1.2.0 used the direct-lighting one (k = (r + 1)²/8). The bytes
#   differ from Rust 1.2.0's on about 3 in 4, by up to 229; those rows are class R, checked against an independent
#   evaluation of 2.15.2's formula (tests/golden/pbr_optics.r.tsv).
# - **F0 stays 1.2.0's formula** (`_sr_ior_to_f0`): 2.15.2's `pbr_ior_to_f0` returns NaN for an index of refraction
#   that is not finite and positive, where 1.2.0 (and Rust's `from_ior`) compute ((1 − n)/(1 + n))² for any n.
#   Otherwise the two agree.

# F0 = ((1 − ior) / (1 + ior))² in f64, for any ior (prakash 1.2.0's `ior_to_f0`).
#must_use
fn _sr_ior_to_f0(ior): i64 {
    var x: f64 = ior;
    var one: f64 = 1.0;
    var r: f64 = (one - x) / (one + x);
    var f: f64 = r * r;
    return f;
}

# A dielectric of base_color (an SrColor) whose `_pad0` holds the reflectance F0 of the index of refraction ior (f64
# bits), narrowed to f32; metallic 0. Mirrors `MaterialUniforms::from_ior`.
fn SrMaterialUniforms_from_ior(base_color, ior, roughness, out) {
    _sr_material(base_color, 0, roughness, out);
    var f0: f64 = _sr_ior_to_f0(ior);
    store32(out + 24, f32_from(f0));
    return out;
}

# (v.clamp(0, 1) · 255).round() as u8 for an f64 v: NaN gives 0, halves round away from zero (the fraction taken
# exactly, not floor(y + 0.5), which rounds k + 0.49999999999999994 up).
#must_use
fn _sr_lut_q8(v: f64): i64 {
    if (v != v) { return 0; }
    var zero: f64 = 0.0;
    var one: f64 = 1.0;
    var x: f64 = v;
    if (x < zero) { x = zero; }
    if (x > one) { x = one; }
    var k: f64 = 255.0;
    var h: f64 = 0.5;
    var y: f64 = x * k;
    var fl: f64 = f64_floor(y);
    var r = f64_to(fl);
    var frac: f64 = y - fl;
    if (frac >= h) { r = r + 1; }
    return r;
}

# The size × size BRDF integration LUT (RGBA8: red the scale, green the bias, blue 0, alpha 255), samples samples a
# texel, row y at roughness (y + 0.5)/size and column x at n·v (x + 0.5)/size: size²·4 bytes from the allocator a, or
# 0 when the allocation fails. Mirrors `generate_brdf_lut`, with prakash 2.15.2's integration (samples 0 gives
# (0, 0, 0, 255) texels, as Rust's NaN did).
fn sr_generate_brdf_lut(size, samples, a): i64 {
    var s = size & 0xFFFFFFFF;
    var px = alloc_via(a, s * s * 4 + 8);
    if (px == 0) { return 0; }
    var fs: f64 = f64_from(s);
    var h: f64 = 0.5;
    var r[16];
    var y = 0;
    while (y < s) {
        var fy: f64 = f64_from(y);
        var rough: f64 = (fy + h) / fs;
        var x = 0;
        while (x < s) {
            var fx: f64 = f64_from(x);
            var ndv: f64 = (fx + h) / fs;
            pbr_integrate_brdf_lut(ndv, rough, samples & 0xFFFFFFFF, &r);
            var p = px + (y * s + x) * 4;
            var sc: f64 = load64(&r);
            var bi: f64 = load64(&r + 8);
            store8(p, _sr_lut_q8(sc));
            store8(p + 1, _sr_lut_q8(bi));
            store8(p + 2, 0);
            store8(p + 3, 255);
            x = x + 1;
        }
        y = y + 1;
    }
    return px;
}
