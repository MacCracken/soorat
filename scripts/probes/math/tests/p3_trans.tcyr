# p3_trans.tcyr — P3 (soorat-port-plan §4 step 1): ganita's f32 transcendentals on the
# arguments soorat 1.2.0 passes (generated by scripts/probes/rust/src/bin/p3_trans.rs into
# out/p3_inputs.txt). Prints one result per case, in order; p3_compare.py joins it with
# Rust's glibc results and the f64-rounded reference.
#
# ganita has no f32 acos and nothing for log10 at all, so those two go through f64:
# acos through ganita_f64_acos; log10 as ln(x) / ln 10 in f64 (a stand-in, not correctly
# rounded by construction; the probe measures it).

var LN10 = 2.302585092994046;

fn f32_acos(x) { return f32_from(ganita_f64_acos(f32_to(x))); }
fn f32_log10(x) { return f32_from(f64_div(f64_ln(f32_to(x)), LN10)); }

fn eval(func, a, b) {
    if (func == 0) { return ganita_f32_sin(a); }
    if (func == 1) { return ganita_f32_cos(a); }
    if (func == 2) { return f32_acos(a); }
    if (func == 3) { return ganita_f32_pow(a, b); }
    if (func == 4) { return ganita_f32_exp(a); }
    if (func == 5) { return ganita_f32_ln(a); }
    return f32_log10(a);
}

# Parse the next unsigned decimal at *pos (a 1-word cell), skipping spaces/newlines.
fn next_uint(buf, len, pos) {
    var p = load64(pos);
    while (p < len) {
        var c = load8(buf + p);
        if (c >= 48) { if (c <= 57) { break; } }
        p = p + 1;
    }
    var v = 0;
    while (p < len) {
        var c = load8(buf + p);
        if (c < 48) { break; }
        if (c > 57) { break; }
        v = v * 10 + (c - 48);
        p = p + 1;
    }
    store64(pos, p);
    return v;
}

fn run() {
    var cap = 16 * 1024 * 1024;
    var buf = alloc(cap);
    var len = file_read_all("out/p3_inputs.txt", buf, cap);
    if (len <= 0) { println("cannot read out/p3_inputs.txt"); return 1; }
    var pos = alloc(8);
    store64(pos, 0);
    var n = 0;
    while (load64(pos) < len) {
        var set = next_uint(buf, len, pos);
        if (load64(pos) >= len) { break; }
        var func = next_uint(buf, len, pos);
        var a = next_uint(buf, len, pos);
        var b = next_uint(buf, len, pos);
        print_num(eval(func, a, b) & 0xFFFFFFFF);
        print("\n", 1);
        n = n + 1;
    }
    return 0;
}

alloc_init();
run();
var r = assert_summary();
