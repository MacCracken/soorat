# P4 "one hisab" (soorat port plan §4 step 1, D9), the D9 shape: soorat declares NO hisab, so the
# hisab diamond (goonj 2.3.2 -> 3.5.0 and ushma 2.0.0 -> 3.4.1, both production scope) is settled by
# the resolver alone. The [deps.X] order is the plan's §4 step 3 order (goonj before ushma).
#   cd scripts/probes/bundle/p4_nopin && cyrius deps && cyrius test --bounds tests/p4_one_hisab.tcyr
[package]
name = "soorat-probes-p4-nopin"
version = "0.0.0"
description = "soorat M0 probe P4: goonj + prakash + ushma + pravash + impetus with no root hisab"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"

[deps]
stdlib = ["syscalls", "string", "alloc", "str", "fmt", "vec", "io", "args", "math", "ganita", "tagged",
    "result", "boxed", "overflow", "slice", "fnptr", "freelist", "callback", "simd", "atomic", "thread",
    "chrono", "log", "bayan", "sakshi"]

[deps.prakash]
git = "https://github.com/MacCracken/prakash.git"
tag = "2.15.2"
modules = ["dist/prakash.cyr"]

[deps.impetus]
git = "https://github.com/MacCracken/impetus.git"
tag = "2.0.0"
modules = ["dist/impetus.cyr"]

[deps.pravash]
git = "https://github.com/MacCracken/pravash.git"
tag = "2.0.1"
modules = ["dist/pravash.cyr"]

[deps.goonj]
git = "https://github.com/MacCracken/goonj.git"
tag = "2.3.2"
modules = ["dist/goonj.cyr"]

[deps.ushma]
git = "https://github.com/MacCracken/ushma.git"
tag = "2.0.0"
modules = ["dist/ushma.cyr"]

[test]
stdlib = ["assert", "bench"]
