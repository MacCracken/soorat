# parity_optics.tcyr — replays the `optics` feature's golden module, tests/golden/color_optics.tsv, against
# src/color_optics.cyr (M1 part b2).
#
# The `optics` code includes prakash, an optional dependency (cyrius.cyml `[features]`), so it has its own harness:
# tests/parity.tcyr replays every other module without prakash in the compile, as a consumer without the feature
# builds. This one replays only `color_optics`. CI resolves `cyrius deps --features optics` so both compile. Format
# and rules: scripts/oracle/README.md; the machinery: tests/parity_core.cyr.

include "tests/lib.cyr"
include "src/color_optics.cyr"
include "tests/ulp.cyr"

alloc_init();

include "tests/parity_core.cyr"

# A prakash Rgb (24 bytes) for one row's input.
var _par_rgb = alloc(24);

# ── hooks ────────────────────────────────────────────────────────────────────────────

# The Rust variant name of an `SR_ERR_*` code.
#must_use
fn _par_error_name(code): i64 {
    return sr_error_name(code);
}

# Fills the got list for one `color_optics` row: 1 handled, 0 pending.
fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    if (_par_eq(fp, fl, "Color::from_prakash") == 1) {
        Rgb_set_r(_par_rgb, _par_in(0));
        Rgb_set_g(_par_rgb, _par_in(1));
        Rgb_set_b(_par_rgb, _par_in(2));
        _par_got_g32s(SrColor_from_prakash(_par_rgb, _par_in(3), _par_gr), 4);
        return 1;
    }
    if (_par_eq(fp, fl, "Color::to_prakash") == 1) {
        _par_in_g32s(0, _par_ga);
        SrColor_to_prakash(_par_ga, _par_rgb);
        _par_got_f(Rgb_r(_par_rgb));
        _par_got_f(Rgb_g(_par_rgb));
        _par_got_f(Rgb_b(_par_rgb));
        return 1;
    }
    if (_par_eq(fp, fl, "Color::from_temperature") == 1) {
        _par_got_g32s(SrColor_from_temperature(_par_in(0), _par_gr), 4);
        return 1;
    }
    if (_par_eq(fp, fl, "Color::from_wavelength") == 1) {
        var t, v = SrColor_from_wavelength(_par_in(0), _par_gr);
        if (is_some(t) == 1) {
            _par_got_g32s(v, 4);
        } else {
            _par_got_none();
        }
        return 1;
    }
    return 0;
}

# No class-C function here.
#must_use
fn _par_c_bound(fp, fl): i64 {
    return 0 - 1;
}

#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    return 0;
}

#must_use
fn _par_accepted_quiet(adr): i64 {
    return 0;
}

fn _par_shadows(mp, ml, fp, fl, cls) {
    return 0;
}

fn _par_module_done(mp, ml) {
    return 0;
}

# Only `color_optics`: tests/parity.tcyr replays the rest.
#must_use
fn _par_skip(mp, ml): i64 {
    if (_par_eq(mp, ml, "color_optics") == 1) { return 0; }
    return 1;
}

var exit_code = _par_main();
sys_exit_group(exit_code);
