# color_optics.bcyr — src/color_optics.cyr's benchmarks (M1 part b2; the `optics` feature). Rust 1.2.0 has no bench
# for these, so they are EXTRA rows. `from_temperature` and `from_wavelength` each leave prakash's 24-byte Rgb on the
# bump heap (ledger L21), so they run 100,000 times (2.4 MB), not 1,000,000.

include "tests/lib.cyr"
include "src/color_optics.cyr"

var N = 100000;

# Runs the optics benches.
fn main(): i64 {
    alloc_init();
    var out = alloc(16);
    var rgb = alloc(24);
    var x: f64 = 0.5;
    Rgb_set_r(rgb, x);
    Rgb_set_g(rgb, x);
    Rgb_set_b(rgb, x);
    var i = 0;

    var bp = bench_new("color_optics/from_prakash");
    bench_batch_start(bp);
    i = 0;
    while (i < N) {
        SrColor_from_prakash(rgb, 0x3F800000, out);
        i = i + 1;
    }
    bench_batch_stop(bp, N);
    bench_report(bp);

    var bt = bench_new("color_optics/from_temperature");
    bench_batch_start(bt);
    i = 0;
    while (i < N) {
        var k: f64 = f64_from(1000 + (i & 8191) * 4);
        SrColor_from_temperature(k, out);
        i = i + 1;
    }
    bench_batch_stop(bt, N);
    bench_report(bt);

    var bw = bench_new("color_optics/from_wavelength");
    bench_batch_start(bw);
    i = 0;
    while (i < N) {
        var nm: f64 = f64_from(380 + (i & 255));
        var t, v = SrColor_from_wavelength(nm, out);
        i = i + 1;
    }
    bench_batch_stop(bw, N);
    bench_report(bw);
    return 0;
}

var r = main();
sys_exit_group(r);
