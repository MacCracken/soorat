# parity_thermo.tcyr — replays the `thermo` feature's golden module, `thermo_render` (src/thermo_render.cyr, ushma
# 2.0.0; M5 part c).
#
# It compiles what a consumer of dist/soorat-thermo.cyr compiles: the library and the renderers on ushma and hisab.
# It is a harness of its own, as the acoustics one is: a test compile with ushma and the renderers holds 105,352
# bytes of static data before the harness, and goonj with src/crmath_ext.cyr (47 KB), or prakash and impetus (40 KB),
# on top would pass the compiler's 128 KiB advisory, a warning that fails the gate (port-parity §6.1, §6.5).
# CI resolves `cyrius deps --features optics,physics-debug,acoustics,thermo`. Format and rules:
# scripts/oracle/README.md; the machinery: tests/parity_core.cyr.
#
# A row's ushma inputs are f64 (`f:`), as ushma's types are on both sides (plan §2.5, ADR 0002 #30).

include "tests/lib.cyr"
include "src/thermo_render.cyr"
include "tests/ulp.cyr"

alloc_init();

include "tests/parity_core.cyr"

var _par_th_arena = 0;
var _par_th_mesh = alloc(48);

# ── hooks ────────────────────────────────────────────────────────────────────────────

# The Rust variant name of an `SR_ERR_*` code.
#must_use
fn _par_error_name(code): i64 {
    return sr_error_name(code);
}

# A vec of the sequence at input token k (`v:n` then n tokens, each value word as is: f64 bits or an integer), and the
# next token's index in *kw.
fn _par_seq_vec(k, kw): i64 {
    var n = _par_in(k) & 0xFFFFFFFF;
    var v = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(v, _par_in(k + 1 + i));
        i = i + 1;
    }
    store64(kw, k + 1 + n);
    return v;
}

# Appends a mesh (an SrMeshData): its vertices as v:12n f32, then its indices as v:m u32.
fn _par_got_mesh(m) {
    _par_got_g32s(load64(m), load64(m + 8) * 12);
    var n = load64(m + 24);
    _par_got_seq(n);
    var i = 0;
    while (i < n) {
        _par_got_i(load32(load64(m + 16) + i * 4) & 0xFFFFFFFF);
        i = i + 1;
    }
    return 0;
}

# Fills the got list for a `thermal_grid_to_mesh` row.
fn _par_th_grid(): i64 {
    if (_par_th_arena == 0) { _par_th_arena = arena_allocator_growable(1 << 20); }
    reset_via(_par_th_arena);
    var kw[8];
    var gm = alloc(sizeof(UsGridVisualization));
    memset(gm, 0, sizeof(UsGridVisualization));
    var g: *UsGridVisualization = _sr_us_grid(gm);
    g.nx = _par_in(0);
    g.ny = _par_in(1);
    g.values = _par_seq_vec(2, &kw);
    var k = load64(&kw);
    var ox: f64 = _par_in(k);
    var oy: f64 = _par_in(k + 1);
    var dx: f64 = _par_in(k + 2);
    var dy: f64 = _par_in(k + 3);
    var lo: f64 = _par_in(k + 4);
    var hi: f64 = _par_in(k + 5);
    g.origin_x = ox;
    g.origin_y = oy;
    g.dx = dx;
    g.dy = dy;
    g.min_temp = lo;
    g.max_temp = hi;
    var prm[32];
    store64(&prm, _par_in(k + 7));
    var kc = _par_in_g32s(k + 8, &prm + 8);
    store32(&prm + 24, _par_in(kc));
    if (sr_thermal_grid_to_mesh(gm, _par_in(k + 6), &prm, _par_th_arena, _par_th_mesh) == 0) { return 0 - 1; }
    _par_got_mesh(_par_th_mesh);
    return 1;
}

# Fills the got list for one line row of `thermo_render` (into lb); 0 for another fn.
fn _par_th_lines(fp, fl, lb): i64 {
    var kw[8];
    if (_par_eq(fp, fl, "temperature_profile_to_lines") == 1) {
        var pm = alloc(sizeof(UsTemperatureProfile));
        memset(pm, 0, sizeof(UsTemperatureProfile));
        var p: *UsTemperatureProfile = _sr_us_profile(pm);
        p.temperatures = _par_seq_vec(0, &kw);
        var k = load64(&kw);
        var dx: f64 = _par_in(k);
        var ox: f64 = _par_in(k + 2);
        var oy: f64 = _par_in(k + 3);
        var oz: f64 = _par_in(k + 4);
        var ex: f64 = _par_in(k + 6);
        var ey: f64 = _par_in(k + 7);
        var ez: f64 = _par_in(k + 8);
        var lo: f64 = _par_in(k + 9);
        var hi: f64 = _par_in(k + 10);
        p.dx = dx;
        p.origin_x = ox;
        p.origin_y = oy;
        p.origin_z = oz;
        p.direction_x = ex;
        p.direction_y = ey;
        p.direction_z = ez;
        p.min_temp = lo;
        p.max_temp = hi;
        sr_temperature_profile_to_lines(pm, lb);
        return 1;
    }
    if (_par_eq(fp, fl, "cycle_diagram_to_lines") == 1) {
        var cm = alloc(sizeof(UsCycleDiagramData));
        memset(cm, 0, sizeof(UsCycleDiagramData));
        var c: *UsCycleDiagramData = _sr_us_cycle(cm);
        c.ts_points = _par_seq_vec(0, &kw);
        c.pv_points = _par_seq_vec(load64(&kw), &kw);
        var prm[56];
        var kp = _par_in_g32s(load64(&kw), &prm);
        store32(&prm + 12, _par_in(kp));
        store32(&prm + 16, _par_in(kp + 1));
        var kq = _par_in_g32s(_par_in_g32s(kp + 2, &prm + 20), &prm + 36);
        sr_cycle_diagram_to_lines(cm, &prm, _par_in(kq), lb);
        return 1;
    }
    if (_par_eq(fp, fl, "thermal_network_to_lines") == 1) {
        var nm = alloc(sizeof(UsNetworkVisualization));
        memset(nm, 0, sizeof(UsNetworkVisualization));
        var nw: *UsNetworkVisualization = _sr_us_network(nm);
        nw.node_temperatures = _par_seq_vec(0, &kw);
        nw.edges = _par_seq_vec(load64(&kw), &kw);
        nw.conductances = _par_seq_vec(load64(&kw), &kw);
        var kn = _par_in_g32s(load64(&kw), _par_ga);
        sr_thermal_network_to_lines(nm, _par_ga, _par_in(kn), _par_in(kn + 1), lb);
        return 1;
    }
    if (_par_eq(fp, fl, "heat_flux_to_arrows") == 1) {
        var fm = alloc(sizeof(UsHeatFluxField));
        memset(fm, 0, sizeof(UsHeatFluxField));
        var fx: *UsHeatFluxField = _sr_us_flux(fm);
        fx.nx = _par_in(0);
        fx.ny = _par_in(1);
        fx.fluxes = _par_seq_vec(2, &kw);
        var kf = load64(&kw);
        var dx: f64 = _par_in(kf);
        var dy: f64 = _par_in(kf + 1);
        var mm: f64 = _par_in(kf + 2);
        fx.dx = dx;
        fx.dy = dy;
        fx.max_magnitude = mm;
        sr_heat_flux_to_arrows(fm, _par_in(kf + 3), _par_in(kf + 4), lb);
        return 1;
    }
    return 0;
}

# Fills the got list for one `thermo_render` row.
fn _par_thermo(fp, fl): i64 {
    if (_par_eq(fp, fl, "thermal_grid_to_mesh") == 1) { return _par_th_grid(); }
    var lb = SrLineBatch_new();
    if (lb == 0) { return 0 - 1; }
    var done = _par_th_lines(fp, fl, lb);
    if (done == 1) { _par_got_g32s(load64(lb), SrLineBatch_vertex_count(lb) * 7); }
    SrLineBatch_drop(lb);
    return done;
}

fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    if (_par_eq(mp, ml, "thermo_render") == 1) { return _par_thermo(fp, fl); }
    return 0;
}

# No class-C rows here.
#must_use
fn _par_c_bound(fp, fl): i64 {
    return 0 - 1;
}

#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    return 0;
}

#must_use
fn _par_accepted_quiet(adr): i64 {
    return 0;
}

fn _par_shadows(mp, ml, fp, fl, cls) {
    return 0;
}

fn _par_module_done(mp, ml) {
    return 0;
}

# Only the `thermo` module: the other harnesses replay the rest.
#must_use
fn _par_skip(mp, ml): i64 {
    if (_par_eq(mp, ml, "thermo_render") == 1) { return 0; }
    return 1;
}

var exit_code = _par_main();
sys_exit_group(exit_code);
