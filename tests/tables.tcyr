# tables.tcyr — the ported tests of Rust 1.2.0's f16 and sRGB conversions (src/environment.rs, M1 part d): 4 of
# environment's tests; its others (downsample, the mip chain, the GPU types) are M4 and M7. The golden rows
# (tests/golden/tables.tsv, 5,215) are replayed by tests/parity.tcyr.

include "tests/lib.cyr"
include "tests/support.cyr"

# Runs the ported f16 and sRGB tests.
fn main() {
    alloc_init();
    var vals = alloc(72);
    # 255.0f32, through a variable: an integer literal passed to an `: f32` parameter warns under --bounds.
    var f255 = 0x437F0000;

    # Each value survives f32 → f16 → f32 exactly: Rust compares as f32 `==`, so −0 → −0 is checked by bits here.
    test_group("f16_roundtrip_exact_values");
    store64(vals, 0);
    store64(vals + 8, 0x80000000);
    store64(vals + 16, 0x3F800000);
    store64(vals + 24, 0xC0200000);
    store64(vals + 32, 0x3F000000);
    store64(vals + 40, 0x477FE000);
    store64(vals + 48, 0x38800000);
    store64(vals + 56, 0x33800000);
    store64(vals + 64, 0x3EAAA000);
    var k = 0;
    while (k < 9) {
        var v = load64(vals + k * 8);
        assert_eq(_sr_f16_to_f32(_sr_f32_to_f16(v)), v, "f32 -> f16 -> f32 is exact");
        k = k + 1;
    }
    assert_eq(_sr_f32_to_f16(0x3F800000), 0x3C00, "1.0");
    assert_eq(_sr_f32_to_f16(0xC0000000), 0xC000, "-2.0");

    test_group("f16_special_values");
    assert_eq(_sr_f32_to_f16(0x7F800000), 0x7C00, "inf");
    assert_eq(_sr_f32_to_f16(0x49742400), 0x7C00, "1e6 overflows to inf");
    assert_eq(_sr_f32_to_f16(0xC9742400), 0xFC00, "-1e6 overflows to -inf");
    assert(t_is_nan32(_sr_f16_to_f32(_sr_f32_to_f16(0x7FC00000))) == 1, "NaN stays NaN");
    assert_eq(_sr_f32_to_f16(0x2EDBE6FF), 0, "1e-10 underflows to 0");
    assert_eq(_sr_f16_to_f32(0x7C00), 0x7F800000, "inf");

    test_group("f16_rounds_to_nearest_even");
    assert_eq(_sr_f32_to_f16(0x3F801000), 0x3C00, "1 + 2^-11 ties to even (1.0)");
    assert_eq(_sr_f32_to_f16(0x3F803000), 0x3C02, "1 + 3*2^-11 ties to even (0x3c02)");
    assert_eq(_sr_f32_to_f16(0x3FFFFC00), 0x4000, "the carry bumps the exponent: 2 - 2^-13 -> 2.0");

    test_group("srgb_transfer_roundtrip");
    var tol: f64 = 0.00001;
    var i = 0;
    while (i < 256) {
        var c = _sr_f32_div(f32_from(f64_from(i)), f255);
        var back = _sr_linear_to_srgb(_sr_srgb_to_linear(c));
        var cb: f64 = f32_to(back);
        var cc: f64 = f32_to(c);
        assert(t_near(cb, cc, tol) == 1, "decode then encode returns the byte's value");
        i = i + 1;
    }

    # Cyrius-only: the class-A replay lets any NaN match any NaN, so the payload and sign are checked here.
    test_group("cyrius: f16 NaN payloads and signed zeros, bit for bit");
    assert_eq(_sr_f16_to_f32(0x7E01), 0x7FC02000, "a quiet NaN keeps its payload");
    assert_eq(_sr_f16_to_f32(0xFC01), 0xFF802000, "a signalling NaN keeps sign and payload");
    assert_eq(_sr_f32_to_f16(0xFF800001), 0xFE00, "a NaN narrows to the quiet NaN, sign kept");
    assert_eq(_sr_f16_to_f32(0x8000), 0x80000000, "-0");
    assert_eq(_sr_f16_to_f32(0x8001), 0xB3800000, "-2^-24");
    assert_eq(_sr_f32_to_f16(0x33000000), 0, "2^-25 ties to even: 0");
    assert_eq(_sr_f32_to_f16(0x33000001), 1, "just above 2^-25: the smallest subnormal");
    assert_eq(_sr_f32_to_f16(0x477FF000), 0x7C00, "65520 ties to even: inf");
    assert_eq(_sr_f32_to_f16(0x477FEFFF), 0x7BFF, "just below 65520: 65504");

    # The generated table is the decode at each byte.
    test_group("cyrius: the generated sRGB decode table");
    var b = 0;
    while (b < 256) {
        var x = _sr_f32_div(f32_from(f64_from(b)), f255);
        assert_eq(_sr_srgb8_decode(b), _sr_srgb_to_linear(x), "table[b] = srgb_to_linear(b / 255)");
        b = b + 1;
    }

    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
