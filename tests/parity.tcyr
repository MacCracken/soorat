# parity.tcyr — replays soorat's golden corpus (tests/golden/*.tsv) against the Cyrius port.
#
# Port plan §4 step 5, adapted from pravash's tests/parity.tcyr (impetus's, kimiya's, tanmatra's). Format and
# comparison rules: scripts/oracle/README.md. The module list is tests/golden/modules.txt, which the generator
# (scripts/oracle) writes. The replay machinery is tests/parity_core.cyr; this file holds the hooks and the
# dispatchers.
#
# Every row of every module is one of:
# - ok: every output matched within its class (A exact, B ≤ 2 ulp, C its function's bound, E bit-identical to
#   the f64-once outputs in <module>.e.tsv where they differ from Rust's, else to Rust's);
# - FAILED: an output differs; the first 10 per module are printed with the row's note and both bit patterns;
# - measured: class C with no bound set yet (recorded, not gated);
# - accepted (cr) / accepted (E): a pass against the correctly rounded (ADR 0002 #16) or class-E (ADR 0002 #4)
#   outputs, where those differ from Rust 1.2.0's;
# - pending: its function isn't ported yet (no dispatcher entry).
#
# Each milestone adds its modules' dispatchers here (`_par_<module>`); the library comes in through tests/lib.cyr,
# above parity_core. A function without a dispatcher entry is pending. The exit code is the number of modules with
# a failure.
# - M1 part a: `math` (all 8 functions) and `constants`' IDENTITY_MAT4.
# - M1 part b: `color` (all but the `optics` functions), the colour constants, and `layout` (every GPU type, measured
#   in Cyrius by tests/layout_probe.cyr).
# - M1 part c: `lights` (the spot cones class C at 0 ulp against lights.cr.tsv) and `lod`; `constants`' MAX_LIGHTS.
# - M1 part d: `tables` (f16 class A; the sRGB transfer functions class C at 0 ulp against tables.cr.tsv).
# - M1 part b2: `json` (`Color::from_json`). Its three `Color::from_json_bayan_*` rows, documents serde_json reads and
#   bayan's tree can't, stay pending until bayan changes (ADR 0002 #19). `color_optics` needs the `optics` feature's
#   prakash and is replayed by tests/parity_features.tcyr.
# - M2 part a: `sprite` (UvRect, Sprite, sort_by_z, batch_to_vertices; the quads class C at 0 ulp against
#   sprite.cr.tsv; the limit batches as FNV-1a digests).
# - M2 part b: `text` (glyph rectangles, text and UI batches) and `debug` (the line batch; circles class C at 0 ulp
#   against debug.cr.tsv). `debug_collider` is tests/parity_features.tcyr's.

# The library first: a file that declares an `enum` (src/error.cyr) must be included before any top-level statement.
include "tests/lib.cyr"
include "src/json.cyr"
include "tests/layout_probe.cyr"
include "tests/ulp.cyr"

alloc_init();

include "tests/parity_core.cyr"

# ── constants (M1: IDENTITY_MAT4; the rest arrive with their modules) ────────────────

fn _par_constants(fp, fl): i64 {
    if (_par_eq(fp, fl, "const::MAX_LIGHTS") == 1) {
        _par_got_i(SR_MAX_LIGHTS);
        return 1;
    }
    if (_par_eq(fp, fl, "const::IDENTITY_MAT4") == 1) {
        _par_got_g32s(SR_IDENTITY_MAT4, 16);
        return 1;
    }
    var c = 0;
    if (_par_eq(fp, fl, "const::Color::WHITE") == 1) { c = SR_COLOR_WHITE; }
    if (_par_eq(fp, fl, "const::Color::BLACK") == 1) { c = SR_COLOR_BLACK; }
    if (_par_eq(fp, fl, "const::Color::RED") == 1) { c = SR_COLOR_RED; }
    if (_par_eq(fp, fl, "const::Color::GREEN") == 1) { c = SR_COLOR_GREEN; }
    if (_par_eq(fp, fl, "const::Color::BLUE") == 1) { c = SR_COLOR_BLUE; }
    if (_par_eq(fp, fl, "const::Color::TRANSPARENT") == 1) { c = SR_COLOR_TRANSPARENT; }
    if (_par_eq(fp, fl, "const::Color::CORNFLOWER_BLUE") == 1) { c = SR_COLOR_CORNFLOWER_BLUE; }
    if (c != 0) {
        _par_got_g32s(c, 4);
        return 1;
    }
    return 0;
}

# ── layout (src/layout.cyr, measured by tests/layout_probe.cyr) ──────────────────────

fn _par_layout(fp, fl): i64 {
    var n = _lp_measure(fp, fl, _par_gr);
    if (n < 0) { return 0; }
    _par_got_i(load64(_par_gr));
    _par_got_seq(n);
    var k = 0;
    while (k < n) {
        _par_got_i(load64(_par_gr + 8 + k * 8));
        k = k + 1;
    }
    return 1;
}

# ── lights (src/lights.cyr) ──────────────────────────────────────────────────────────

var _par_la = alloc(16 * 64);
var _par_lu = alloc(1024);

fn _par_lights(fp, fl): i64 {
    if (_par_eq(fp, fl, "GpuLight::directional") == 1) {
        var k = _par_in_g32s(_par_in_g32s(0, _par_ga), _par_gb);
        _par_got_g32s(SrGpuLight_directional(_par_ga, _par_gb, _par_in(k), _par_gr), 16);
        return 1;
    }
    if (_par_eq(fp, fl, "GpuLight::point") == 1) {
        var kp = _par_in_g32s(_par_in_g32s(0, _par_ga), _par_gb);
        _par_got_g32s(SrGpuLight_point(_par_ga, _par_gb, _par_in(kp), _par_in(kp + 1), _par_gr), 16);
        return 1;
    }
    if (_par_eq(fp, fl, "GpuLight::spot") == 1) {
        var ks = _par_in_g32s(_par_in_g32s(_par_in_g32s(0, _par_ga), _par_gb), _par_gc);
        SrGpuLight_spot(_par_ga, _par_gb, _par_gc, _par_in(ks), _par_in(ks + 1), _par_in(ks + 2), _par_in(ks + 3),
          _par_gr);
        _par_got_g32s(_par_gr, 16);
        return 1;
    }
    if (_par_eq(fp, fl, "LightArrayUniforms::default") == 1) {
        _par_got_g32s(SrLightArrayUniforms_default(_par_lu), 136);
        return 1;
    }
    if (_par_eq(fp, fl, "LightArrayUniforms::set_lights") == 1) {
        var n = _par_in(0);
        var at = 1;
        var i = 0;
        while (i < n) {
            at = _par_in_g32s(at, _par_la + i * 64);
            i = i + 1;
        }
        SrLightArrayUniforms_default(_par_lu);
        _par_got_g32s(SrLightArrayUniforms_set_lights(_par_lu, _par_la, n), 136);
        return 1;
    }
    if (_par_eq(fp, fl, "LightArrayUniforms::set_ambient") == 1) {
        var ka = _par_in_g32s(0, _par_ga);
        SrLightArrayUniforms_default(_par_lu);
        _par_got_g32s(SrLightArrayUniforms_set_ambient(_par_lu, _par_ga, _par_in(ka)), 136);
        return 1;
    }
    return 0;
}

# ── lod (src/lod.cyr) ────────────────────────────────────────────────────────────────

var _par_li = alloc(64);

fn _par_lod(fp, fl): i64 {
    if (_par_eq(fp, fl, "LodChain::new") == 1 || _par_eq(fp, fl, "LodChain::level_count") == 1) {
        _par_in_g32s(0, _par_ga);
        var c = SrLodChain_new(_par_ga, _par_in(0));
        if (c == 0) { return 0 - 1; }
        var n = SrLodChain_level_count(c);
        if (_par_eq(fp, fl, "LodChain::level_count") == 1) {
            _par_got_i(n);
        } else {
            var lv = load64(c);
            _par_got_seq(n);
            var i = 0;
            while (i < n) {
                _par_got_i(load64(lv + i * sizeof(SrLodLevel)));
                i = i + 1;
            }
            _par_got_seq(n);
            var j = 0;
            while (j < n) {
                _par_got_g(load32(lv + j * sizeof(SrLodLevel) + 8));
                j = j + 1;
            }
        }
        SrLodChain_drop(c);
        return 1;
    }
    if (_par_eq(fp, fl, "LodChain::select") == 1) {
        var k = _par_in_g32s(0, _par_ga);
        var cs = SrLodChain_new(_par_ga, _par_in(0));
        if (cs == 0) { return 0 - 1; }
        _par_got_i(SrLodChain_select(cs, _par_in(k)));
        SrLodChain_drop(cs);
        return 1;
    }
    if (_par_eq(fp, fl, "LodChain::select_from_positions") == 1) {
        _par_in_g32s(_par_in_g32s(_par_in_g32s(0, _par_ga), _par_gb), _par_gc);
        var cp = SrLodChain_new(_par_ga, _par_in(0));
        if (cp == 0) { return 0 - 1; }
        _par_got_i(SrLodChain_select_from_positions(cp, _par_gb, _par_gc));
        SrLodChain_drop(cp);
        return 1;
    }
    if (_par_eq(fp, fl, "TerrainLod::new") == 1 || _par_eq(fp, fl, "TerrainLod::select_resolution") == 1) {
        var nr = _par_in(0);
        var r = 0;
        while (r < nr) {
            store32(_par_li + r * 4, _par_in(1 + r));
            r = r + 1;
        }
        var kd = _par_in_g32s(1 + nr, _par_ga);
        var t, v = SrTerrainLod_new(_par_li, nr, _par_ga, _par_in(1 + nr));
        if (_par_eq(fp, fl, "TerrainLod::new") == 1) {
            if (is_err_result(t) == 1) {
                _par_got_err(v);
            } else {
                _par_got_i(1);
                SrTerrainLod_drop(v);
            }
            return 1;
        }
        if (is_err_result(t) == 1) { return 0 - 1; }
        _par_got_i(SrTerrainLod_select_resolution(v, _par_in(kd)));
        SrTerrainLod_drop(v);
        return 1;
    }
    return 0;
}

# ── tables (src/tables.cyr, src/tables_data.cyr) ─────────────────────────────────────

fn _par_tables(fp, fl): i64 {
    if (_par_eq(fp, fl, "f16_to_f32") == 1 || _par_eq(fp, fl, "f32_to_f16") == 1) {
        var to32 = _par_eq(fp, fl, "f16_to_f32");
        var n = _par_in(0);
        _par_got_seq(n);
        var j = 0;
        while (j < n) {
            if (to32 == 1) {
                _par_got_g(_sr_f16_to_f32(_par_in(1 + j)));
            } else {
                _par_got_i(_sr_f32_to_f16(_par_in(1 + j)));
            }
            j = j + 1;
        }
        return 1;
    }
    if (_par_eq(fp, fl, "srgb_to_linear") == 1) {
        _par_got_g(_sr_srgb_to_linear(_par_in(0)));
        return 1;
    }
    if (_par_eq(fp, fl, "linear_to_srgb") == 1) {
        _par_got_g(_sr_linear_to_srgb(_par_in(0)));
        return 1;
    }
    if (_par_eq(fp, fl, "srgb8_decode_table") == 1) {
        _par_got_seq(256);
        var b = 0;
        while (b < 256) {
            _par_got_g(_sr_srgb8_decode(b));
            b = b + 1;
        }
        return 1;
    }
    return 0;
}

# ── sprite (src/sprite.cyr, src/batch.cyr) ───────────────────────────────────────────

var _par_sp = alloc(_SR_SPRITE_SIZE);
var _par_vbuf = 0;
var _par_ibuf = 0;
var _par_bcap = 0;

# Vertex and index buffers for n sprites (u32 indices), grown on demand.
fn _par_batch_bufs(n) {
    if (n <= _par_bcap) { return 0; }
    _par_vbuf = alloc(n * 128 + 128);
    _par_ibuf = alloc(n * 24 + 24);
    _par_bcap = n;
    return 0;
}

# The FNV-1a 64 of [p, p + n) as its two 32-bit halves, appended to the got list.
fn _par_got_fnv(p, n) {
    var h = 0 - 3750763034362895579;
    var i = 0;
    while (i < n) {
        h = (h ^ load8(p + i)) * 1099511628211;
        i = i + 1;
    }
    _par_got_i((h >> 32) & 0xFFFFFFFF);
    _par_got_i(h & 0xFFFFFFFF);
    return 0;
}

# A sprite from 13 f32 (x, y, width, height, rotation, color, uv) at buf, into s.
fn _par_sprite13(buf, s) {
    SrSprite_new(load32(buf), load32(buf + 4), load32(buf + 8), load32(buf + 12), s);
    SrSprite_with_rotation(s, load32(buf + 16));
    SrSprite_with_color(s, buf + 20);
    SrSprite_with_uv(s, buf + 36);
    return s;
}

fn _par_sprite(fp, fl): i64 {
    if (_par_eq(fp, fl, "UvRect::from_pixel_rect") == 1) {
        _par_got_g32s(SrUvRect_from_pixel_rect(_par_in(1), _par_in(2), _par_in(3), _par_in(4), _par_in(5), _par_in(6),
            _par_gr), 4);
        return 1;
    }
    if (_par_eq(fp, fl, "UvRect::corners") == 1) {
        _par_in_g32s(0, _par_ga);
        _par_got_g32s(SrUvRect_corners(_par_ga, _par_gr), 8);
        return 1;
    }
    if (_par_eq(fp, fl, "Sprite::center") == 1 || _par_eq(fp, fl, "Sprite::bounds") == 1) {
        _par_in_g32s(0, _par_ga);
        SrSprite_new(load32(_par_ga), load32(_par_ga + 4), load32(_par_ga + 8), load32(_par_ga + 12), _par_sp);
        var nb = 4;
        if (_par_eq(fp, fl, "Sprite::center") == 1) {
            SrSprite_center(_par_sp, _par_gr);
            nb = 2;
        } else {
            SrSprite_bounds(_par_sp, _par_gr);
        }
        var j = 0;
        while (j < nb) {
            _par_got_g(load32(_par_gr + j * 4));
            j = j + 1;
        }
        return 1;
    }
    if (_par_eq(fp, fl, "Sprite::default") == 1) {
        SrSprite_default(_par_sp);
        _par_got_seq(13);
        var k = 0;
        while (k < 5) {
            _par_got_g(load32(_par_sp + _SR_SP_X + k * 4));
            k = k + 1;
        }
        var c = 0;
        while (c < 8) {
            _par_got_g(load32(_par_sp + _SR_SP_COLOR + c * 4));
            c = c + 1;
        }
        _par_got_i(load64(_par_sp + _SR_SP_TEX));
        _par_got_i(load64(_par_sp + _SR_SP_Z));
        return 1;
    }
    if (_par_eq(fp, fl, "SpriteBatch::sort_by_z") == 1) {
        var n = _par_in(0);
        var b = SrSpriteBatch_with_capacity(n);
        if (b == 0) { return 0 - 1; }
        var i = 0;
        while (i < n) {
            SrSprite_with_z_order(SrSprite_default(_par_sp), _par_in(1 + i));
            SrSpriteBatch_push(b, SrSprite_with_texture(_par_sp, i));
            i = i + 1;
        }
        SrSpriteBatch_sort_by_z(b);
        _par_got_seq(n);
        var q = 0;
        while (q < n) {
            _par_got_i(load64(SrSpriteBatch_get(b, q) + _SR_SP_TEX));
            q = q + 1;
        }
        SrSpriteBatch_drop(b);
        return 1;
    }
    var is16 = _par_eq(fp, fl, "batch_to_vertices");
    var is32 = _par_eq(fp, fl, "batch_to_vertices_u32");
    if (is16 == 1 || is32 == 1) {
        var ns = _par_in(0);
        var bb = SrSpriteBatch_with_capacity(ns);
        if (bb == 0) { return 0 - 1; }
        var at = 1;
        var t = 0;
        while (t < ns) {
            at = _par_in_g32s(at, _par_ga);
            SrSpriteBatch_push(bb, _par_sprite13(_par_ga, _par_sp));
            t = t + 1;
        }
        _par_batch_bufs(ns);
        var m = 0;
        if (is32 == 1) {
            m = sr_batch_to_vertices_u32_into(bb, _par_vbuf, _par_ibuf);
        } else {
            m = sr_batch_to_vertices_into(bb, _par_vbuf, _par_ibuf);
        }
        _par_got_g32s(_par_vbuf, m * 32);
        _par_got_seq(m * 6);
        var x = 0;
        while (x < m * 6) {
            if (is32 == 1) {
                _par_got_i(load32(_par_ibuf + x * 4) & 0xFFFFFFFF);
            } else {
                _par_got_i(load16(_par_ibuf + x * 2) & 0xFFFF);
            }
            x = x + 1;
        }
        SrSpriteBatch_drop(bb);
        return 1;
    }
    var d16 = _par_eq(fp, fl, "batch_to_vertices_digest");
    var d32 = _par_eq(fp, fl, "batch_to_vertices_u32_digest");
    if (d16 == 1 || d32 == 1) {
        var nd = _par_in(0);
        var bd = SrSpriteBatch_with_capacity(nd);
        if (bd == 0) { return 0 - 1; }
        var one = 0x3F800000;
        var y = 0;
        while (y < nd) {
            SrSpriteBatch_push(bd, SrSprite_new(f32_from(f64_from(y)), 0, one, one, _par_sp));
            y = y + 1;
        }
        _par_batch_bufs(nd);
        var md = 0;
        var isz = 2;
        if (d32 == 1) {
            md = sr_batch_to_vertices_u32_into(bd, _par_vbuf, _par_ibuf);
            isz = 4;
        } else {
            md = sr_batch_to_vertices_into(bd, _par_vbuf, _par_ibuf);
        }
        _par_got_i(md * 4);
        _par_got_i(md * 6);
        _par_got_fnv(_par_vbuf, md * 128);
        _par_got_fnv(_par_ibuf, md * 6 * isz);
        SrSpriteBatch_drop(bd);
        return 1;
    }
    return 0;
}

# ── text (src/text.cyr, src/ui.cyr) ──────────────────────────────────────────────────

var _par_font = alloc(64);
var _par_panel = alloc(48);

# Appends a sprite batch's sprites: their count, then each as v:13 f32 and its texture id and z-order.
fn _par_got_sprites(b) {
    var n = SrSpriteBatch_len(b);
    _par_got_i(n);
    var i = 0;
    while (i < n) {
        var sp = SrSpriteBatch_get(b, i);
        _par_got_seq(13);
        var k = 0;
        while (k < 13) {
            _par_got_g(load32(sp + _SR_SP_X + k * 4));
            k = k + 1;
        }
        _par_got_i(load64(sp + _SR_SP_TEX));
        _par_got_i(load64(sp + _SR_SP_Z));
        i = i + 1;
    }
    return 0;
}

fn _par_text(fp, fl): i64 {
    var k = 0;
    while (k < 8) {
        store64(_par_font + k * 8, _par_in(1 + k));
        k = k + 1;
    }
    if (_par_eq(fp, fl, "BitmapFont::glyph_uv") == 1) {
        _par_got_g32s(SrBitmapFont_glyph_uv(_par_font, _par_in(9), _par_gr), 4);
        return 1;
    }
    if (_par_eq(fp, fl, "TextBatch::draw_text_z") == 1) {
        var text = _par_in_cstr(9);
        if (text == 0) { return 0 - 1; }
        _par_in_g32s(13, _par_ga);
        var tb = SrTextBatch_new();
        if (tb == 0) { return 0 - 1; }
        SrTextBatch_draw_text_z(tb, _par_font, text, strlen(text), _par_in(10), _par_in(11), _par_in(12), _par_ga,
          _par_in(18));
        _par_got_sprites(load64(tb));
        SrTextBatch_drop(tb);
        return 1;
    }
    if (_par_eq(fp, fl, "UiBatch::add_panel") == 1) {
        _par_in_g32s(0, _par_ga);
        _par_in_g32s(5, _par_gb);
        SrUiPanel_new(load32(_par_ga), load32(_par_ga + 4), load32(_par_ga + 8), load32(_par_ga + 12), _par_panel);
        SrUiPanel_with_z_order(SrUiPanel_with_texture(SrUiPanel_with_color(_par_panel, _par_gb), _par_in(10)),
          _par_in(11));
        var u = SrUiBatch_new();
        if (u == 0) { return 0 - 1; }
        SrUiBatch_add_panel(u, _par_panel);
        _par_got_sprites(load64(u));
        SrUiBatch_drop(u);
        return 1;
    }
    return 0;
}

# ── debug (src/debug_geom.cyr) ───────────────────────────────────────────────────────

fn _par_debug(fp, fl): i64 {
    var b = SrLineBatch_new();
    if (b == 0) { return 0 - 1; }
    var done = 1;
    if (_par_eq(fp, fl, "LineBatch::line") == 1 || _par_eq(fp, fl, "LineBatch::wire_box") == 1) {
        _par_in_g32s(_par_in_g32s(_par_in_g32s(0, _par_ga), _par_gb), _par_gc);
        if (_par_eq(fp, fl, "LineBatch::line") == 1) {
            SrLineBatch_line(b, _par_ga, _par_gb, _par_gc);
        } else {
            SrLineBatch_wire_box(b, _par_ga, _par_gb, _par_gc);
        }
    } elif (_par_eq(fp, fl, "LineBatch::wire_circle") == 1 || _par_eq(fp, fl, "LineBatch::wire_sphere") == 1) {
        var kc = _par_in_g32s(0, _par_ga);
        _par_in_g32s(kc + 2, _par_gc);
        if (_par_eq(fp, fl, "LineBatch::wire_circle") == 1) {
            SrLineBatch_wire_circle(b, _par_ga, _par_in(kc), _par_in(kc + 1), _par_gc);
        } else {
            SrLineBatch_wire_sphere(b, _par_ga, _par_in(kc), _par_in(kc + 1), _par_gc);
        }
    } elif (_par_eq(fp, fl, "LineBatch::wire_capsule") == 1) {
        var kp = _par_in_g32s(0, _par_ga);
        _par_in_g32s(kp + 3, _par_gc);
        SrLineBatch_wire_capsule(b, _par_ga, _par_in(kp), _par_in(kp + 1), _par_in(kp + 2), _par_gc);
    } elif (_par_eq(fp, fl, "LineBatch::grid") == 1) {
        _par_in_g32s(2, _par_gc);
        SrLineBatch_grid(b, _par_in(0), _par_in(1), _par_gc);
    } else {
        done = 0;
    }
    if (done == 1) { _par_got_g32s(load64(b), SrLineBatch_vertex_count(b) * 7); }
    SrLineBatch_drop(b);
    return done;
}

# ── json (src/json.cyr) ──────────────────────────────────────────────────────────────

fn _par_json(fp, fl): i64 {
    if (_par_eq(fp, fl, "UvRect::from_json") == 1) {
        var ud = _par_in_cstr(0);
        if (ud == 0) { return 0 - 1; }
        var ut, uv = SrUvRect_from_json(ud, strlen(ud), _par_gr);
        if (is_err_result(ut) == 1) {
            _par_got_err(uv);
        } else {
            _par_got_g32s(_par_gr, 4);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "Sprite::from_json") == 1) {
        var sd = _par_in_cstr(0);
        if (sd == 0) { return 0 - 1; }
        var st, sv = SrSprite_from_json(sd, strlen(sd), _par_sp);
        if (is_err_result(st) == 1) {
            _par_got_err(sv);
            return 1;
        }
        _par_got_seq(13);
        var k = 0;
        while (k < 13) {
            _par_got_g(load32(_par_sp + _SR_SP_X + k * 4));
            k = k + 1;
        }
        _par_got_i(load64(_par_sp + _SR_SP_TEX));
        _par_got_i(load64(_par_sp + _SR_SP_Z));
        return 1;
    }
    if (_par_eq(fp, fl, "Color::from_json") == 1) {
        var doc = _par_in_cstr(0);
        if (doc == 0) { return 0 - 1; }
        var t, v = SrColor_from_json(doc, strlen(doc), _par_gr);
        if (is_err_result(t) == 1) {
            _par_got_err(v);
        } else {
            _par_got_g32s(_par_gr, 4);
        }
        return 1;
    }
    return 0;
}

# ── color (src/color.cyr) ────────────────────────────────────────────────────────────

fn _par_color(fp, fl): i64 {
    if (_par_eq(fp, fl, "Color::from_rgba8") == 1) {
        _par_got_g32s(SrColor_from_rgba8(_par_in(1), _par_in(2), _par_in(3), _par_in(4), _par_gr), 4);
        return 1;
    }
    if (_par_eq(fp, fl, "Color::from_hex") == 1) {
        _par_got_g32s(SrColor_from_hex(_par_in(0), _par_gr), 4);
        return 1;
    }
    if (_par_eq(fp, fl, "Color::to_rgba8") == 1) {
        _par_in_g32s(0, _par_ga);
        SrColor_to_rgba8(_par_ga, _par_gr);
        _par_got_seq(4);
        var j = 0;
        while (j < 4) {
            _par_got_i(load8(_par_gr + j));
            j = j + 1;
        }
        return 1;
    }
    if (_par_eq(fp, fl, "Color::to_wgpu") == 1) {
        _par_in_g32s(0, _par_ga);
        SrColor_to_wgpu(_par_ga, _par_gr);
        var k = 0;
        while (k < 4) {
            _par_got_f(load64(_par_gr + k * 8));
            k = k + 1;
        }
        return 1;
    }
    if (_par_eq(fp, fl, "Color::luminance") == 1) {
        _par_in_g32s(0, _par_ga);
        _par_got_g(SrColor_luminance(_par_ga));
        return 1;
    }
    if (_par_eq(fp, fl, "Color::lerp") == 1) {
        var t = _par_in_g32s(_par_in_g32s(0, _par_ga), _par_gb);
        _par_got_g32s(SrColor_lerp(_par_ga, _par_gb, _par_in(t), _par_gr), 4);
        return 1;
    }
    if (_par_eq(fp, fl, "visualization_heat_map") == 1) {
        _par_got_g32s(sr_visualization_heat_map(_par_in(0), _par_gr), 4);
        return 1;
    }
    if (_par_eq(fp, fl, "signed_value_color") == 1) {
        _par_got_g32s(sr_signed_value_color(_par_in(0), _par_gr), 4);
        return 1;
    }
    if (_par_eq(fp, fl, "Color::default") == 1) {
        _par_got_g32s(SrColor_default(_par_gr), 4);
        return 1;
    }
    return 0;
}

# ── math (src/math.cyr) ──────────────────────────────────────────────────────────────

fn _par_math(fp, fl): i64 {
    if (_par_eq(fp, fl, "mul_mat4") == 1) {
        _par_in_g32s(_par_in_g32s(0, _par_ga), _par_gb);
        _par_got_g32s(sr_mul_mat4(_par_ga, _par_gb, _par_gr), 16);
        return 1;
    }
    if (_par_eq(fp, fl, "normalize3") == 1) {
        _par_in_g32s(0, _par_ga);
        _par_got_g32s(sr_normalize3(_par_ga, _par_gr), 3);
        return 1;
    }
    if (_par_eq(fp, fl, "cross") == 1) {
        _par_in_g32s(_par_in_g32s(0, _par_ga), _par_gb);
        _par_got_g32s(sr_cross(_par_ga, _par_gb, _par_gr), 3);
        return 1;
    }
    if (_par_eq(fp, fl, "perspective_90") == 1) {
        _par_got_g32s(sr_perspective_90(_par_in(0), _par_in(1), _par_gr), 16);
        return 1;
    }
    if (_par_eq(fp, fl, "look_at") == 1) {
        _par_in_g32s(_par_in_g32s(_par_in_g32s(0, _par_ga), _par_gb), _par_gc);
        _par_got_g32s(sr_look_at(_par_ga, _par_gb, _par_gc, _par_gr), 16);
        return 1;
    }
    if (_par_eq(fp, fl, "compose_trs") == 1) {
        _par_in_g32s(_par_in_g32s(_par_in_g32s(0, _par_ga), _par_gb), _par_gc);
        _par_got_g32s(sr_compose_trs(_par_ga, _par_gb, _par_gc, _par_gr), 16);
        return 1;
    }
    if (_par_eq(fp, fl, "normal_to_basis") == 1) {
        _par_in_g32s(0, _par_ga);
        sr_normal_to_basis(_par_ga, _par_gr, _par_gu);
        _par_got_g32s(_par_gr, 3);
        _par_got_g32s(_par_gu, 3);
        return 1;
    }
    if (_par_eq(fp, fl, "flatten_mat4") == 1) {
        _par_in_g32s(0, _par_ga);
        _par_got_g32s(sr_flatten_mat4(_par_ga, _par_gr), 16);
        return 1;
    }
    return 0;
}

# ── hooks ────────────────────────────────────────────────────────────────────────────

# The Rust variant name of an `SR_ERR_*` code (src/error.cyr), which a golden `E:<Variant>` token names.
#must_use
fn _par_error_name(code): i64 {
    return sr_error_name(code);
}

# Fills the got list for one row: 1 handled, 0 pending, -1 unusable.
fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    if (_par_eq(mp, ml, "math") == 1) { return _par_math(fp, fl); }
    if (_par_eq(mp, ml, "constants") == 1) { return _par_constants(fp, fl); }
    if (_par_eq(mp, ml, "color") == 1) { return _par_color(fp, fl); }
    if (_par_eq(mp, ml, "layout") == 1) { return _par_layout(fp, fl); }
    if (_par_eq(mp, ml, "lights") == 1) { return _par_lights(fp, fl); }
    if (_par_eq(mp, ml, "lod") == 1) { return _par_lod(fp, fl); }
    if (_par_eq(mp, ml, "tables") == 1) { return _par_tables(fp, fl); }
    if (_par_eq(mp, ml, "json") == 1) { return _par_json(fp, fl); }
    if (_par_eq(mp, ml, "sprite") == 1) { return _par_sprite(fp, fl); }
    if (_par_eq(mp, ml, "text") == 1) { return _par_text(fp, fl); }
    if (_par_eq(mp, ml, "debug") == 1) { return _par_debug(fp, fl); }
    return 0;
}

# A class-C function's ulp bound, or -1 (measured). The spot cones' cos and the sRGB transfer functions' pow are
# correctly rounded (ganita's f32 tier), so they are held to 0 against lights.cr.tsv and tables.cr.tsv where glibc
# misrounds, and to Rust's bits elsewhere (ADR 0002 #16).
#must_use
fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "GpuLight::spot") == 1) { return 0; }
    if (_par_eq(fp, fl, "srgb_to_linear") == 1 || _par_eq(fp, fl, "linear_to_srgb") == 1) { return 0; }
    if (_par_eq(fp, fl, "batch_to_vertices") == 1 || _par_eq(fp, fl, "batch_to_vertices_u32") == 1) { return 0; }
    if (_par_eq(fp, fl, "LineBatch::wire_circle") == 1 || _par_eq(fp, fl, "LineBatch::wire_sphere") == 1) { return 0; }
    if (_par_eq(fp, fl, "LineBatch::wire_capsule") == 1) { return 0; }
    return 0 - 1;
}

# The ADR accepting a divergent row, or 0. Class E and the correctly rounded rows come from their own files.
#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    return 0;
}

#must_use
fn _par_accepted_quiet(adr): i64 {
    return 0;
}

# No shadow comparisons yet.
fn _par_shadows(mp, ml, fp, fl, cls) {
    return 0;
}

# No module-specific summary lines yet.
fn _par_module_done(mp, ml) {
    return 0;
}

# Every module is replayed here except the optional features' (`color_optics`: prakash; `debug_collider`: impetus),
# which tests/parity_features.tcyr replays.
#must_use
fn _par_skip(mp, ml): i64 {
    if (_par_eq(mp, ml, "color_optics") == 1 || _par_eq(mp, ml, "debug_collider") == 1) { return 1; }
    return 0;
}

var exit_code = _par_main();
sys_exit_group(exit_code);
