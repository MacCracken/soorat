# acoustic_render.tcyr — the ported tests of Rust 1.2.0's src/acoustic_render.rs (M5 parts a and b), all 35: the 11
# without the `acoustics` feature (heat map, signed colour, normal basis, params), the 9 for ray paths, portals and
# coupled decays (part a) and the 15 for pressure slices, room modes and directivity balloons (part b). Cyrius-only
# tests check the parameter layouts, a NaN band's energy, the decay curve's ends and the balloon's nearest-azimuth
# ties. The golden rows (tests/golden/acoustic.tsv, acoustic_render.tsv) are replayed by tests/parity.tcyr and
# tests/parity_acoustics.tcyr.

include "tests/lib.cyr"
include "src/crmath_ext.cyr"
include "src/acoustic_render.cyr"
include "tests/support.cyr"

# A goonj HVec3 (f64) from three f32 bit patterns, widened.
fn hv(x, y, z): i64 { return hvec3_new(f32_to(x), f32_to(y), f32_to(z)); }

# A goonj RayBounce at (x, 0, 0) whose 8 band energies are all e (f32 bits), built by goonj's layout.
fn bounce(x, z, e): i64 {
    var b = alloc(RB_SIZE);
    memset(b, 0, RB_SIZE);
    store64(b + RB_POINT, hv(x, 0, z));
    store64(b + RB_NORMAL, hv(0, 0x3F800000, 0));
    var i = 0;
    while (i < NUM_BANDS) {
        store64(b + RB_ENERGY + i * 8, f32_to(e));
        i = i + 1;
    }
    return b;
}

# A RayVisualization from the origin with one path of the n bounces at bs.
fn one_path(bs, n): i64 {
    var bounces = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(bounces, load64(bs + i * 8));
        i = i + 1;
    }
    var p = alloc(RP_SIZE);
    memset(p, 0, RP_SIZE);
    store64(p + RP_BOUNCES, bounces);
    var paths = vec_new();
    vec_push(paths, p);
    return soorat_ray_visualization_new(hv(0, 0, 0), paths);
}

# A goonj CoupledDecay (f32 bits, widened).
fn decay(early, late, amp): i64 {
    var d = alloc(sizeof(CoupledDecay));
    CoupledDecay_set_rt60_early(d, f32_to(early));
    CoupledDecay_set_rt60_late(d, f32_to(late));
    CoupledDecay_set_early_amplitude(d, f32_to(amp));
    CoupledDecay_set_coupling_strength(d, f32_to(0x3E99999A));
    return d;
}

# A goonj vec of the n f32 bit patterns at p, widened.
fn fvec(p, n): i64 {
    var v = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(v, f32_to(load32(p + i * 4)));
        i = i + 1;
    }
    return v;
}

# A goonj PressureMap of the n f32 at p over nx × ny × nz, at the origin, spacing 1.
fn pmap(p, n, nx, ny, nz): i64 {
    return soorat_pressure_map_new(fvec(p, n), nx, ny, nz, hv(0, 0, 0), f32_to(0x3F800000), f32_to(0x447A0000));
}

# A DirectivityBalloon whose azimuths and elevations are the f32 at az (naz) and el (nel), every band's gains the f32
# at g (ng).
fn balloon(az, naz, el, nel, g, ng): i64 {
    var gains = alloc(NUM_BANDS * 8);
    var b = 0;
    while (b < NUM_BANDS) {
        store64(gains + b * 8, fvec(g, ng));
        b = b + 1;
    }
    return directivity_balloon_new(fvec(az, naz), fvec(el, nel), gains);
}

# 1 if every position and colour float of mesh m is finite.
fn mesh_finite(m): i64 {
    var i = 0;
    while (i < load64(m + 8)) {
        var v = load64(m) + i * 48;
        var k = 0;
        while (k < 3) {
            if ((load32(v + k * 4) & 0x7F800000) == 0x7F800000) { return 0; }
            k = k + 1;
        }
        k = 0;
        while (k < 4) {
            if ((load32(v + 32 + k * 4) & 0x7F800000) == 0x7F800000) { return 0; }
            k = k + 1;
        }
        i = i + 1;
    }
    return 1;
}

# 1 if vertex i of batch b has the colour c (4 f32 bits at c).
fn vcolor_is(b, i, c): i64 { return memeq(load64(b) + i * 28 + 12, c, 16); }

# The y of vertex i of batch b, as an f64.
fn vy(b, i): f64 {
    var y: f64 = f32_to(load32(load64(b) + i * 28 + 4));
    return y;
}

# Runs the ported acoustic_render tests of part a and the Cyrius-only ones.
fn main() {
    alloc_init();
    var c = alloc(16);
    var right = alloc(16);
    var up = alloc(16);
    var n = alloc(16);

    test_group("heat_map_endpoints");
    sr_visualization_heat_map(0, c);
    assert_eq(load32(c + 8), 0x3F800000, "cold is blue");
    sr_visualization_heat_map(0x3F800000, c);
    assert(load32(c) == 0x3F800000 && load32(c + 4) == 0, "hot is red");

    test_group("heat_map_clamps");
    sr_visualization_heat_map(0xBF800000, c);
    assert_eq(load32(c + 8), 0x3F800000, "under → blue");
    sr_visualization_heat_map(0x40000000, c);
    assert_eq(load32(c), 0x3F800000, "over → red");

    test_group("heat_map_gradient_smooth");
    var inr = 1;
    var i = 0;
    while (i <= 100) {
        var tf: f64 = f64_from(i);
        var hundred: f64 = 100.0;
        sr_visualization_heat_map(f32_from(tf / hundred), c);
        var k = 0;
        while (k < 3) {
            var ch: f64 = t_f(c, k);
            if (ch < 0.0 || ch > 1.0) { inr = 0; }
            k = k + 1;
        }
        if (load32(c + 12) != 0x3F800000) { inr = 0; }
        i = i + 1;
    }
    assert(inr == 1, "every channel in [0, 1], alpha 1");

    test_group("signed_pressure_color_zero");
    sr_signed_value_color(0, c);
    assert(load32(c) == 0 && load32(c + 8) == 0, "zero → black");

    test_group("signed_pressure_color_positive");
    sr_signed_value_color(0x3F800000, c);
    assert(load32(c) == 0x3F800000 && load32(c + 8) == 0, "+1 → red");

    test_group("signed_pressure_color_negative");
    sr_signed_value_color(0xBF800000, c);
    assert(load32(c) == 0 && load32(c + 8) == 0x3F800000, "-1 → blue");

    test_group("acoustic_heat_map_public");
    sr_acoustic_heat_map(0x3F000000, c);
    assert_eq(load32(c + 4), 0x3F800000, "0.5 → green 1");

    test_group("normal_to_basis_z_forward");
    t_set3(n, 0, 0, 0x3F800000);
    sr_normal_to_basis(n, right, up);
    var tol: f64 = 0.01;
    var zero: f64 = 0.0;
    assert(t_near(t_dot3(right, n), zero, tol) == 1 && t_near(t_dot3(up, n), zero, tol) == 1, "both ⟂ +Z");

    test_group("normal_to_basis_y_up");
    t_set3(n, 0, 0x3F800000, 0);
    sr_normal_to_basis(n, right, up);
    assert(t_near(t_dot3(right, n), zero, tol) == 1 && t_near(t_dot3(up, n), zero, tol) == 1, "both ⟂ +Y");

    test_group("normal_to_basis_orthogonal");
    t_set3(n, 0x3F13B646, 0x3F13B646, 0x3F13B646);
    sr_normal_to_basis(n, right, up);
    assert(t_near(t_dot3(right, up), zero, tol) == 1, "right ⟂ up");

    test_group("acoustic_vis_params_default");
    var vp[32];
    SrAcousticVisParams_default(&vp);
    assert(load64(&vp) == SR_ACOUSTIC_COLOR_MODE_PRESSURE && load32(&vp + 24) == 0x3F800000, "Pressure, alpha 1");

    test_group("ray_first_segment_carries_full_energy");
    var bs[16];
    store64(&bs, bounce(0x3F800000, 0, 0x3F000000));
    store64(&bs + 8, bounce(0x40000000, 0, 0));
    var lb = SrLineBatch_new();
    sr_ray_paths_to_lines(one_path(&bs, 2), SR_COLOR_GREEN, SR_COLOR_RED, lb);
    assert_eq(SrLineBatch_line_count(lb), 2, "2 lines");
    assert(vcolor_is(lb, 0, SR_COLOR_GREEN) == 1, "the first segment at full energy");
    SrColor_lerp(SR_COLOR_GREEN, SR_COLOR_RED, 0x3F000000, c);
    assert(vcolor_is(lb, 2, c) == 1, "the second at the first bounce's 0.5");
    SrLineBatch_drop(lb);

    test_group("ray_paths_empty");
    lb = SrLineBatch_new();
    sr_ray_paths_to_lines(soorat_ray_visualization_new(hv(0, 0, 0), vec_new()), SR_COLOR_GREEN, SR_COLOR_RED, lb);
    assert_eq(SrLineBatch_is_empty(lb), 1, "nothing drawn");
    SrLineBatch_drop(lb);

    test_group("ray_paths_single_bounce");
    store64(&bs, bounce(0x3F800000, 0, 0x3F666666));
    lb = SrLineBatch_new();
    sr_ray_paths_to_lines(one_path(&bs, 1), SR_COLOR_GREEN, SR_COLOR_RED, lb);
    assert_eq(SrLineBatch_line_count(lb), 1, "1 line");
    SrLineBatch_drop(lb);

    test_group("ray_paths_multi_bounce");
    var b3[24];
    store64(&b3, bounce(0x3F800000, 0, 0x3F4CCCCD));
    store64(&b3 + 8, bounce(0x3F800000, 0x3F800000, 0x3F19999A));
    store64(&b3 + 16, bounce(0, 0x3F800000, 0x3ECCCCCD));
    lb = SrLineBatch_new();
    sr_ray_paths_to_lines(one_path(&b3, 3), SR_COLOR_GREEN, SR_COLOR_RED, lb);
    assert_eq(SrLineBatch_line_count(lb), 3, "3 lines");
    SrLineBatch_drop(lb);

    test_group("portal_to_lines_basic");
    lb = SrLineBatch_new();
    sr_portal_to_lines(portal_new(hv(0, 0, 0), hv(0, 0, 0x3F800000), f32_to(0x40000000), f32_to(0x40400000)),
        SR_COLOR_WHITE, 0x3F800000, lb);
    assert_eq(SrLineBatch_line_count(lb), 7, "4 edges, the arrow and its head");
    SrLineBatch_drop(lb);

    test_group("portal_different_normal");
    lb = SrLineBatch_new();
    sr_portal_to_lines(portal_new(hv(0x40A00000, 0, 0), hv(0x3F800000, 0, 0), f32_to(0x3F800000), f32_to(0x40000000)),
        SR_COLOR_RED, 0x3F000000, lb);
    assert_eq(SrLineBatch_line_count(lb), 7, "7 lines");
    SrLineBatch_drop(lb);

    test_group("coupled_decay_basic");
    var dp[72];
    SrDecayCurveParams_default(&dp);
    lb = SrLineBatch_new();
    sr_coupled_decay_to_lines(decay(0x3F000000, 0x40000000, 0x3F333333), &dp, lb);
    assert_eq(SrLineBatch_line_count(lb), 99, "100 steps → 99 lines");
    SrLineBatch_drop(lb);

    test_group("coupled_decay_zero_steps");
    store64(&dp + 32, 0);
    lb = SrLineBatch_new();
    sr_coupled_decay_to_lines(decay(0x3F800000, 0x40000000, 0x3F000000), &dp, lb);
    assert_eq(SrLineBatch_is_empty(lb), 1, "nothing drawn");
    SrLineBatch_drop(lb);

    test_group("coupled_decay_monotonic");
    store64(&dp + 32, 50);
    lb = SrLineBatch_new();
    sr_coupled_decay_to_lines(decay(0x3F000000, 0x40000000, 0x3F333333), &dp, lb);
    var nv = SrLineBatch_vertex_count(lb);
    var oy: f64 = 0.0;
    var eps6: f64 = 0.000001;
    var slack: f64 = 0.001;
    assert(t_near(vy(lb, 0), oy, eps6) == 1, "starts at 0 dB");
    var mono = 1;
    i = 0;
    while (i + 1 < nv) {
        var y0: f64 = vy(lb, i);
        var y1: f64 = vy(lb, i + 1);
        if (y1 > y0 + slack) { mono = 0; }
        i = i + 2;
    }
    var last: f64 = vy(lb, nv - 1);
    assert(mono == 1 && last < oy, "falls, and ends below 0 dB");
    SrLineBatch_drop(lb);

    var A = arena_allocator_growable(1 << 20);
    var M = alloc(48);
    var vp2[32];
    var vals[64];

    test_group("pressure_map_non_finite_values_are_safe");
    store32(&vals, 0);
    store32(&vals + 4, 0x7F800000);
    store32(&vals + 8, 0x7FC00000);
    store32(&vals + 12, 0x3F800000);
    var pm = pmap(&vals, 4, 2, 1, 2);
    var safe = 1;
    var mode = 0;
    while (mode < 3) {
        reset_via(A);
        SrAcousticVisParams_default(&vp2);
        store64(&vp2, mode);
        sr_pressure_map_slice(pm, 0, &vp2, A, M);
        if (load64(M + 8) != 16 || mesh_finite(M) == 0 || t_winding_ok(M) == 0) { safe = 0; }
        mode = mode + 1;
    }
    assert(safe == 1, "16 vertices, finite, upward, in every mode");

    test_group("pressure_map_signed_is_zero_centred");
    store32(&vals + 4, 0);
    store32(&vals + 8, 0);
    reset_via(A);
    SrAcousticVisParams_default(&vp2);
    store64(&vp2, SR_ACOUSTIC_COLOR_MODE_SIGNED_PRESSURE);
    sr_pressure_map_slice(pmap(&vals, 4, 2, 1, 2), 0, &vp2, A, M);
    var v0 = load64(M);
    assert(load32(v0 + 32) == 0 && load32(v0 + 36) == 0 && load32(v0 + 40) == 0, "zero stays black");
    assert(load32(v0 + 12 * 48 + 32) == 0x3F800000 && load32(v0 + 12 * 48 + 36) == 0, "+1 is red");

    test_group("pressure_map_rejects_unbacked_grid_quickly");
    reset_via(A);
    SrAcousticVisParams_default(&vp2);
    sr_pressure_map_slice(pmap(&vals, 0, 100000, 1, 100000), 0, &vp2, A, M);
    assert(load64(M + 8) == 0 && load64(M + 24) == 0, "empty");

    test_group("mode_pattern_winds_upward");
    reset_via(A);
    var w10: f64 = 10.0;
    var w8: f64 = 8.0;
    var c343: f64 = 343.0;
    var mv = soorat_mode_visualization_for_shoebox(1, 1, w10, w8, c343, 6);
    sr_mode_pattern_to_mesh(mv, 0x41200000, 0x41000000, 0x3DCCCCCD, &vp2, A, M);
    assert(load64(M + 24) > 0 && t_winding_ok(M) == 1, "indexed, upward");

    test_group("balloon_faces_outward_and_clamps_segments");
    var az2[8];
    store32(&az2, 0);
    store32(&az2 + 4, 0x40490FDB);
    var el1[4];
    store32(&el1, 0);
    var g2[8];
    store32(&g2, 0x3F800000);
    store32(&g2 + 4, 0x3F4CCCCD);
    var bl = balloon(&az2, 2, &el1, 1, &g2, 2);
    var org[16];
    var fz[16];
    t_set3(&org, 0, 0, 0);
    t_set3(&fz, 0, 0, 0x3F800000);
    reset_via(A);
    sr_directivity_balloon_to_mesh(bl, &org, &fz, 0x3F800000, 0x3DCCCCCD, 6, 8, A, M);
    assert(t_winding_ok(M) == 1, "outward");
    reset_via(A);
    sr_directivity_balloon_to_mesh(bl, &org, &fz, 0x3F800000, 0x3DCCCCCD, 0xFFFFFFFF, 3, A, M);
    assert_eq(load64(M + 8), 1025 * 4, "lat clamped to 1024");

    test_group("pressure_map_slice_empty");
    reset_via(A);
    sr_pressure_map_slice(pmap(&vals, 0, 0, 0, 0), 0, &vp2, A, M);
    assert(load64(M + 8) == 0 && load64(M + 24) == 0, "empty");

    test_group("pressure_map_slice_2x2");
    var v8[32];
    store32(&v8, 0);
    store32(&v8 + 4, 0x3F000000);
    store32(&v8 + 8, 0x3E99999A);
    store32(&v8 + 12, 0x3F800000);
    store32(&v8 + 16, 0x3DCCCCCD);
    store32(&v8 + 20, 0x3F4CCCCD);
    store32(&v8 + 24, 0x3F19999A);
    store32(&v8 + 28, 0x3E4CCCCD);
    reset_via(A);
    sr_pressure_map_slice(pmap(&v8, 8, 2, 2, 2), 0, &vp2, A, M);
    assert(load64(M + 8) == 16 && load64(M + 24) == 24, "4 cells: 16 vertices, 24 indices");

    test_group("pressure_map_out_of_bounds_y");
    reset_via(A);
    sr_pressure_map_slice(pmap(&v8, 8, 2, 2, 2), 5, &vp2, A, M);
    assert_eq(load64(M + 8), 0, "empty");

    test_group("mode_pattern_empty");
    var me = alloc(SMV_SIZE);
    memset(me, 0, SMV_SIZE);
    store64(me + SMV_PATTERN, vec_new());
    reset_via(A);
    sr_mode_pattern_to_mesh(me, 0x41200000, 0x41000000, 0x3F800000, &vp2, A, M);
    assert(load64(M + 8) == 0 && load64(M + 24) == 0, "empty");

    test_group("mode_pattern_3x3");
    reset_via(A);
    sr_mode_pattern_to_mesh(soorat_mode_visualization_for_shoebox(1, 0, w10, w8, c343, 3), 0x41200000, 0x41000000,
        0x3F800000, &vp2, A, M);
    assert(load64(M + 8) == 9 && load64(M + 24) == 24, "9 vertices, 24 indices");

    test_group("mode_pattern_has_height");
    reset_via(A);
    sr_mode_pattern_to_mesh(soorat_mode_visualization_for_shoebox(1, 0, w10, w8, c343, 5), 0x41200000, 0x41000000,
        0x40000000, &vp2, A, M);
    var lifted = 0;
    var cent: f64 = 0.01;
    i = 0;
    while (i < load64(M + 8)) {
        var hy: f64 = f32_to(load32(load64(M) + i * 48 + 4));
        if (hy > cent || hy < 0.0 - cent) { lifted = 1; }
        i = i + 1;
    }
    assert(lifted == 1, "some vertex off y = 0");

    test_group("directivity_balloon_empty");
    reset_via(A);
    sr_directivity_balloon_to_mesh(balloon(&az2, 0, &el1, 0, &g2, 0), &org, &fz, 0x3F800000, 0x3F800000, 8, 8, A, M);
    assert(load64(M + 8) > 0 && load64(M + 24) > 0, "a sphere at gain 1");

    test_group("directivity_balloon_min_segments");
    reset_via(A);
    sr_directivity_balloon_to_mesh(bl, &org, &fz, 0x3F800000, 0x3F800000, 1, 2, A, M);
    assert(load64(M + 8) == 0 && load64(M + 24) == 0, "empty");

    test_group("directivity_balloon_sphere");
    var az3[16];
    store32(&az3, 0);
    store32(&az3 + 4, 0x3FC90FDB);
    store32(&az3 + 8, 0x40490FDB);
    var g3[16];
    store32(&g3, 0x3F800000);
    store32(&g3 + 4, 0x3F000000);
    store32(&g3 + 8, 0x3E4CCCCD);
    reset_via(A);
    sr_directivity_balloon_to_mesh(balloon(&az3, 3, &el1, 1, &g3, 3), &org, &fz, 0x3F000000, 0x40000000, 4, 6, A, M);
    assert(load64(M + 8) == 35 && load64(M + 24) == 144, "35 vertices, 144 indices");

    test_group("pressure_map_single_cell");
    store32(&vals, 0x3F000000);
    reset_via(A);
    sr_pressure_map_slice(pmap(&vals, 1, 1, 1, 1), 0, &vp2, A, M);
    assert(load64(M + 8) == 4 && load64(M + 24) == 6 && mesh_finite(M) == 1, "4 vertices, 6 indices, no NaN");

    # Cyrius-only: the nearest azimuth breaks a tie toward the first, and skips a NaN entry, as Rust's `min_by` on
    # `total_cmp` does.
    test_group("nearest_index_takes_the_first_of_a_tie");
    var tv[16];
    store32(&tv, 0x7FC00000);
    store32(&tv + 4, 0x3F800000);
    store32(&tv + 8, 0x40400000);
    assert_eq(_sr_nearest_index(fvec(&tv, 3), 0x40000000), 1, "1 and 3 tie at distance 1: the first");
    assert_eq(_sr_nearest_index(fvec(&tv, 1), 0x40000000), 0 - 1, "only a NaN: none");

    # Cyrius-only: the parameter structs' layouts (src/acoustic.cyr's header).
    test_group("acoustic_param_layouts");
    assert(sizeof(SrAcousticVisParams) == 32 && sizeof(SrDecayCurveParams) == 72, "32 and 72 bytes");
    SrDecayCurveParams_default(&dp);
    assert(load32(&dp + 12) == 0x40400000 && load32(&dp + 16) == 0xC2700000 && load64(&dp + 32) == 100,
        "3 s, -60 dB, 100 steps at their offsets");
    assert(memeq(&dp + 40, SR_COLOR_GREEN, 16) == 1 && memeq(&dp + 56, SR_COLOR_RED, 16) == 1, "green, red");

    # Cyrius-only: a NaN band makes the average NaN, so the next segment carries no energy (end colour), as Rust's does.
    test_group("a_nan_band_carries_no_energy");
    store64(&bs, bounce(0x3F800000, 0, 0x7FC00000));
    store64(&bs + 8, bounce(0x40000000, 0, 0x3F000000));
    lb = SrLineBatch_new();
    sr_ray_paths_to_lines(one_path(&bs, 2), SR_COLOR_GREEN, SR_COLOR_RED, lb);
    assert(vcolor_is(lb, 2, SR_COLOR_RED) == 1, "red after the NaN bounce");
    SrLineBatch_drop(lb);

    # Cyrius-only: the curve's x runs over [origin, origin + time_range · x_scale], and its last point is the full
    # db_range down (an early RT60 short enough to fall 60 dB in 3 s).
    test_group("the_decay_curve_spans_its_ranges");
    SrDecayCurveParams_default(&dp);
    lb = SrLineBatch_new();
    sr_coupled_decay_to_lines(decay(0x3E4CCCCD, 0x3E99999A, 0x3F333333), &dp, lb);
    nv = SrLineBatch_vertex_count(lb);
    var x0: f64 = f32_to(load32(load64(lb)));
    var xn: f64 = f32_to(load32(load64(lb) + (nv - 1) * 28));
    var three: f64 = 3.0;
    var minus1: f64 = -1.0;
    assert(t_near(x0, oy, eps6) == 1 && t_near(xn, three, eps6) == 1, "x from 0 to 3");
    assert(t_near(vy(lb, nv - 1), minus1, eps6) == 1, "y down to -1 (y_scale) at -60 dB");
    SrLineBatch_drop(lb);

    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
