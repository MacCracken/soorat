# env.bcyr — load-time work M7's image-based lighting will run (M4 part b). Rust 1.2.0 has no bench for these, so they
# are extras: a 128 × 128 sRGB face's CPU mip chain, and a 32 × 32 BRDF LUT at 256 samples a texel.

include "tests/lib.cyr"
include "src/color_optics.cyr"
include "src/pbr_optics.cyr"

var _sink = 0;

# Runs the env and LUT benches.
fn main(): i64 {
    alloc_init();
    var a = arena_allocator_growable(1 << 20);
    var n = 128 * 128;
    var face = alloc(n * 4);
    var i = 0;
    while (i < n * 4) {
        store8(face + i, (i * 37 + (i >> 7) * 11) & 0xFF);
        i = i + 1;
    }
    var lv = alloc(16 * 24);
    var b1 = bench_new("env/face_mip_chain_128_srgb");
    bench_batch_start(b1);
    i = 0;
    while (i < 50) {
        reset_via(a);
        _sink = sr_face_mip_chain(SR_FACE_SRGB8, face, n * 4, 128, sr_mip_level_count(128, 128), a, lv);
        i = i + 1;
    }
    bench_batch_stop(b1, 50);
    bench_report(b1);
    var b2 = bench_new("pbr/brdf_lut_32x32_256");
    bench_batch_start(b2);
    i = 0;
    while (i < 5) {
        reset_via(a);
        _sink = sr_generate_brdf_lut(32, 256, a);
        i = i + 1;
    }
    bench_batch_stop(b2, 5);
    bench_report(b2);
    return 0;
}

var r = main();
sys_exit_group(r);
