# Measures the type named by the golden row's fn (`layout::<Type>`) into out; returns its field count, or -1
# for a type the table doesn't hold.
fn _lp_measure(fp, fl, out): i64 {
    if (_lp_name_is(fp, fl, "layout::GpuParticle") == 1) { return _lp_GpuParticle(out); }
    if (_lp_name_is(fp, fl, "layout::SimParams") == 1) { return _lp_SimParams(out); }
    if (_lp_name_is(fp, fl, "layout::PostProcessUniforms") == 1) { return _lp_PostProcessUniforms(out); }
    if (_lp_name_is(fp, fl, "layout::JointUniforms") == 1) { return _lp_JointUniforms(out); }
    if (_lp_name_is(fp, fl, "layout::BloomUniforms") == 1) { return _lp_BloomUniforms(out); }
    if (_lp_name_is(fp, fl, "layout::LineVertex") == 1) { return _lp_LineVertex(out); }
    if (_lp_name_is(fp, fl, "layout::GpuLight") == 1) { return _lp_GpuLight(out); }
    if (_lp_name_is(fp, fl, "layout::LightArrayUniforms") == 1) { return _lp_LightArrayUniforms(out); }
    if (_lp_name_is(fp, fl, "layout::MaterialUniforms") == 1) { return _lp_MaterialUniforms(out); }
    if (_lp_name_is(fp, fl, "layout::SsaoUniforms") == 1) { return _lp_SsaoUniforms(out); }
    if (_lp_name_is(fp, fl, "layout::CameraUniforms") == 1) { return _lp_CameraUniforms(out); }
    if (_lp_name_is(fp, fl, "layout::LightUniforms") == 1) { return _lp_LightUniforms(out); }
    if (_lp_name_is(fp, fl, "layout::ShadowPassUniforms") == 1) { return _lp_ShadowPassUniforms(out); }
    if (_lp_name_is(fp, fl, "layout::ShadowUniforms") == 1) { return _lp_ShadowUniforms(out); }
    if (_lp_name_is(fp, fl, "layout::CascadeUniforms") == 1) { return _lp_CascadeUniforms(out); }
    if (_lp_name_is(fp, fl, "layout::Vertex2D") == 1) { return _lp_Vertex2D(out); }
    if (_lp_name_is(fp, fl, "layout::Vertex3D") == 1) { return _lp_Vertex3D(out); }
    if (_lp_name_is(fp, fl, "layout::SkinnedVertex3D") == 1) { return _lp_SkinnedVertex3D(out); }
    if (_lp_name_is(fp, fl, "layout::InstanceData") == 1) { return _lp_InstanceData(out); }
    return 0 - 1;
}

# 1 when [p, p + len) is the C string s.
fn _lp_name_is(p, len, s): i64 {
    if (strlen(s) != len) { return 0; }
    return memeq(p, s, len);
}
