# lod.tcyr — the ported tests of Rust 1.2.0's src/lod.rs (M1 part c), all 7. The golden rows
# (tests/golden/lod.tsv, 770) are replayed by tests/parity.tcyr.

include "tests/lib.cyr"
include "tests/support.cyr"

# The f32 bits of the integer k.
fn f(k): i64 { return f32_from(f64_from(k)); }

# The f32 bits of k².
fn sq(k): i64 { return f32_from(f64_from(k * k)); }

# Runs the ported lod tests.
fn main() {
    alloc_init();
    var d = alloc(64);
    var res = alloc(64);
    var cam = alloc(16);
    var obj = alloc(16);

    test_group("lod_chain_select");
    t_set3(d, f(10), f(30), f(100));
    var c = SrLodChain_new(d, 3);
    assert_eq(SrLodChain_select(c, sq(5)), 0, "close = high detail");
    assert_eq(SrLodChain_select(c, sq(20)), 1, "mid");
    assert_eq(SrLodChain_select(c, sq(50)), 2, "far = low detail");
    SrLodChain_drop(c);

    test_group("lod_chain_beyond_range");
    t_set3(d, f(10), f(30), 0);
    c = SrLodChain_new(d, 2);
    assert_eq(SrLodChain_select(c, sq(999)), 1, "beyond all = last");
    SrLodChain_drop(c);

    test_group("lod_chain_from_positions");
    t_set3(d, f(10), f(50), f(200));
    c = SrLodChain_new(d, 3);
    assert_eq(SrLodChain_select_from_positions(c, t_set3(cam, 0, 0, 0), t_set3(obj, f(5), 0, 0)), 0, "5 away");
    assert_eq(SrLodChain_select_from_positions(c, cam, t_set3(obj, f(100), 0, 0)), 2, "100 away");
    SrLodChain_drop(c);

    test_group("lod_chain_single_level");
    store32(d, f(100));
    c = SrLodChain_new(d, 1);
    assert_eq(SrLodChain_select(c, 0), 0, "at 0");
    assert_eq(SrLodChain_level_count(c), 1, "one level");
    SrLodChain_drop(c);

    test_group("terrain_lod_select");
    t_set4(res, 64, 32, 16, 8);
    t_set4(d, f(50), f(100), f(200), f(500));
    var t, v = SrTerrainLod_new(res, 4, d, 4);
    assert(is_ok(t) == 1, "Ok");
    assert_eq(SrTerrainLod_select_resolution(v, f(30)), 64, "30");
    assert_eq(SrTerrainLod_select_resolution(v, f(75)), 32, "75");
    assert_eq(SrTerrainLod_select_resolution(v, f(150)), 16, "150");
    assert_eq(SrTerrainLod_select_resolution(v, f(300)), 8, "300");
    SrTerrainLod_drop(v);

    test_group("terrain_lod_beyond");
    store32(res, 64);
    store32(res + 4, 8);
    store32(d, f(50));
    store32(d + 4, f(200));
    var t2, v2 = SrTerrainLod_new(res, 2, d, 2);
    assert_eq(SrTerrainLod_select_resolution(v2, f(999)), 8, "beyond = last");
    SrTerrainLod_drop(v2);

    # Adversarial: different lengths are an Err (Rust: RenderError::Pipeline), not a crash.
    test_group("terrain_lod_mismatched_lengths");
    t_set3(res, 64, 32, 16);
    t_set3(d, f(50), f(100), f(200));
    var t3, v3 = SrTerrainLod_new(res, 3, d, 2);
    assert(is_err_result(t3) == 1, "3 resolutions, 2 distances");
    assert_eq(v3, SR_ERR_PIPELINE, "Pipeline");
    var t4, v4 = SrTerrainLod_new(res, 1, d, 3);
    assert(is_err_result(t4) == 1, "1 resolution, 3 distances");
    var t5, v5 = SrTerrainLod_new(res, 2, d, 2);
    assert(is_ok(t5) == 1, "equal lengths");
    SrTerrainLod_drop(v5);

    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
