# soorat — the Cyrius port (2.0.0 in progress). The Rust 1.2.0 oracle is frozen in rust-old/.
# Plan of record: docs/development/soorat-port-plan.md. Dependencies are added milestone by
# milestone (§4 step 3 lists the full set and its order: goonj before ushma, agnodrm behind `drm`).

[package]
name = "soorat"
version = "${file:VERSION}"
description = "Soorat — GPU rendering engine for AGNOS (Cyrius port of the Rust 1.2.0 crate in rust-old/)"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/soorat"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/soorat"
dce = true

# stdlib leaves, vendored into lib/ by `cyrius deps` and prepended to every compile:
#   math / ganita — f64_sqrt and the f32 tier (f32_to / f32_from, ganita_f32_*), port plan §9.1
#   sakshi        — tracing's events (src/log.cyr), port plan §1.1
#   tagged / result — the value-form Option and Result (src/error.cyr)
#   fnptr         — fncall: Rust's closures as function pointers (src/viz.cyr)
#   freelist      — fl_alloc / fl_free: storage an object owns and frees in its `_drop` (src/lod.cyr), port plan §9.4
[deps]
stdlib = ["string", "fmt", "alloc", "vec", "str", "syscalls", "io", "args", "math", "ganita", "tagged", "result",
    "freelist", "sakshi", "fnptr"]

# Optional dependencies, each behind a feature (ADR 0002 #9: Rust's Cargo features). A feature's code is a separate
# file outside `[lib]`, bundled by its `[lib.<feature>]` profile (dist/soorat-<feature>.cyr) and including its
# dependency itself; a consumer that wants it takes that bundle and declares the dependency (ranga's `spectral`).
# The repository's tests use every feature, so CI resolves them all: `cyrius deps --features optics`.
[features]
default = []
optics = ["prakash"]
physics-debug = ["impetus"]

# prakash 2.15.2 (`optics`): Color's spectral conversions (src/color_optics.cyr). Its bundle is 1.19 MB, which is
# why it is optional.
[deps.prakash]
git = "https://github.com/MacCracken/prakash.git"
tag = "2.15.2"
modules = ["dist/prakash.cyr"]
optional = true

# impetus 2.0.0 (`physics-debug`): LineBatch::collider draws its collider shapes (src/debug_collider.cyr). The 3D
# bundle, as soorat's colliders are 3D; 647 KB, which is why it is optional.
[deps.impetus]
git = "https://github.com/MacCracken/impetus.git"
tag = "2.0.0"
modules = ["dist/impetus-3d.cyr"]
optional = true

[test]
# `bench` too: the port template omits it, so tests/soorat.bcyr and `cyrius audit` failed
# (cyrius issue 2026-11-08-cyrius-port-clobbers-project-docs-and-omits-bench.md, item 3).
# bayan: src/json.cyr (the `serde` profile) for the tests that read and write JSON. It is no production leaf: bayan
# carries ~372 KB of unicode tables into every binary that includes it (bayan's open issue
# 2026-10-31-bundle-carries-unicode-tables-into-every-binary.md), so only the serde bundle's consumers take it.
stdlib = ["assert", "bench", "overflow", "bayan"]

# `[lib]` is the bundle `cyrius distlib` writes to dist/soorat.cyr. The list IS the concatenation order and it is
# load-bearing: no src/ file includes another, so each module resolves at file scope against what precedes it (port
# plan §4 step 3). tests/lib.cyr mirrors this list for test compiles (`cyrius test` never prepends [lib]). Modules
# are appended as their milestone lands.
[lib]
modules = [
    "src/error.cyr",
    "src/log.cyr",
    "src/mathx.cyr",
    "src/crmath.cyr",
    "src/tables_data.cyr",
    "src/tables.cyr",
    "src/math.cyr",
    "src/layout.cyr",
    "src/color.cyr",
    "src/lights.cyr",
    "src/lod.cyr",
    "src/sprite.cyr",
    "src/batch.cyr",
    "src/text.cyr",
    "src/ui.cyr",
    "src/debug_geom.cyr",
    "src/viz.cyr",
    "src/primitives.cyr",
    "src/terrain.cyr",
    "src/animation.cyr",
]

# The `optics` feature's bundle, dist/soorat-optics.cyr: the library plus Color's prakash conversions.
[lib.optics]
modules = [
    "src/error.cyr",
    "src/log.cyr",
    "src/mathx.cyr",
    "src/crmath.cyr",
    "src/tables_data.cyr",
    "src/tables.cyr",
    "src/math.cyr",
    "src/layout.cyr",
    "src/color.cyr",
    "src/lights.cyr",
    "src/lod.cyr",
    "src/sprite.cyr",
    "src/batch.cyr",
    "src/text.cyr",
    "src/ui.cyr",
    "src/debug_geom.cyr",
    "src/viz.cyr",
    "src/primitives.cyr",
    "src/terrain.cyr",
    "src/animation.cyr",
    "src/color_optics.cyr",
]

# The `serde` bundle, dist/soorat-serde.cyr: the library plus Color's serde_json documents (src/json.cyr, on bayan).
# Rust derives serde unconditionally; here it is opt-in because bayan costs every binary ~372 KB (ADR 0002 #19). A
# consumer takes this bundle and adds "bayan" to its own `[deps] stdlib`.
[lib.serde]
modules = [
    "src/error.cyr",
    "src/log.cyr",
    "src/mathx.cyr",
    "src/crmath.cyr",
    "src/tables_data.cyr",
    "src/tables.cyr",
    "src/math.cyr",
    "src/layout.cyr",
    "src/color.cyr",
    "src/lights.cyr",
    "src/lod.cyr",
    "src/sprite.cyr",
    "src/batch.cyr",
    "src/text.cyr",
    "src/ui.cyr",
    "src/debug_geom.cyr",
    "src/viz.cyr",
    "src/primitives.cyr",
    "src/terrain.cyr",
    "src/animation.cyr",
    "src/json.cyr",
]

# The `physics-debug` feature's bundle, dist/soorat-physics-debug.cyr: the library plus LineBatch::collider (impetus).
[lib.physics-debug]
modules = [
    "src/error.cyr",
    "src/log.cyr",
    "src/mathx.cyr",
    "src/crmath.cyr",
    "src/tables_data.cyr",
    "src/tables.cyr",
    "src/math.cyr",
    "src/layout.cyr",
    "src/color.cyr",
    "src/lights.cyr",
    "src/lod.cyr",
    "src/sprite.cyr",
    "src/batch.cyr",
    "src/text.cyr",
    "src/ui.cyr",
    "src/debug_geom.cyr",
    "src/viz.cyr",
    "src/primitives.cyr",
    "src/terrain.cyr",
    "src/animation.cyr",
    "src/debug_collider.cyr",
]
